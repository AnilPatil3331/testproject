    <style>
        .navbar-vertical.navbar-expand-xs .navbar-nav > .nav-item > .nav-link.active {
            background: var(--primary-color, #4874dc);
            color: white;
            margin-right: 0.0rem !important;
            margin-left: 0.0rem !important;
            border-radius: .375rem !important;
        }

            .navbar-vertical.navbar-expand-xs .navbar-nav > .nav-item > .nav-link.active i {
                color: #fff !important;
            }


        /* Sidebar slide-in animation on load */
        @@keyframes sidebarSlideIn {
            from {
                transform: translateX(-100%);
            }
            to {
                transform: translateX(0);
            }
        }

        /* Styles for collapsed navbar */
        .sidenav.collapsed {
            width: 60px !important;
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        }

        /* Styles for expanded navbar */
        .sidenav {
            width: 250px !important;
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
            animation: sidebarSlideIn 0.5s cubic-bezier(0.25, 0.8, 0.25, 1) both;
        }

            /* Adjustments for nav text visibility */
            .sidenav.collapsed .nav-link-text {
                display: none !important;
            }

            .sidenav.collapsed .CollIcon {
                display: none !important;
            }

        .navbar-vertical.navbar-expand-xs {
            max-width: none !important;
        }

        /* Modern hover animations for nav items */
        .navbar-vertical .navbar-nav .nav-link {
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
            position: relative;
        }

        .sidenav:not(.collapsed) .navbar-nav .nav-link:hover {
            padding-left: 2rem !important;
            background-color: rgba(94, 114, 228, 0.08) !important;
            color: #5e72e4 !important;
            border-radius: 0.375rem !important;
        }

        .sidenav.collapsed .navbar-nav .nav-link:hover {
            background-color: rgba(94, 114, 228, 0.08) !important;
            color: #5e72e4 !important;
            border-radius: 0.375rem !important;
        }

        .navbar-vertical .navbar-nav .nav-link:hover i {
            color: #5e72e4 !important;
            transform: scale(1.15);
            transition: transform 0.25s ease !important;
        }

        /* Glowing vertical indicator on hover */
        .navbar-vertical .navbar-nav .nav-link::before {
            content: '';
            position: absolute;
            left: 0;
            top: 15%;
            height: 70%;
            width: 4px;
            background-color: #5e72e4;
            border-radius: 0 4px 4px 0;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.2s ease !important;
        }

        .navbar-vertical .navbar-nav .nav-link:hover::before {
            transform: scaleX(1);
        }

        .dropdown-menu {
            display: none;
        }

            .dropdown-menu.show {
                display: block;
            }

        @@media (max-width: 768px) {
            #QRDemoDoc {
                display: none;
            }
        }
    </style>
