<script>

    document.addEventListener("DOMContentLoaded", function () {
        // Select all nav-link elements inside the navbar
        const navLinks = document.querySelectorAll(".navbar-nav .nav-link");

        // Get the current pathname
        const currentPath = window.location.pathname;

        // Loop through all nav links to check the default active link
        navLinks.forEach(link => {
            // Check if the link's href matches the current path
            if (link.getAttribute("href") === currentPath) {
                link.classList.add("router-link-active", "active");
            }

            // Add click event to dynamically change the active class
            link.addEventListener("click", function (event) {
                // Remove 'router-link-active' and 'active' from all nav-link elements
                navLinks.forEach(nav => {
                    nav.classList.remove("router-link-active", "active");
                });

                // Add 'router-link-active' and 'active' to the clicked nav-link
                this.classList.add("router-link-active", "active");

                // Optionally, you can navigate manually after this (if needed)
                // const targetUrl = this.getAttribute("href");
                // window.location.href = targetUrl; // Uncomment if you want to navigate manually
            });
        });
    });




</script>



