        }

        .fc-popover .fc-header .fc-close {
            cursor: pointer;
            opacity: 0.65;
            font-size: 1.1em;
        }

        /* Misc Reusable Components
            --------------------------------------------------------------------------------------------------*/
        .fc-divider {
            border-style: solid;
            border-width: 1px;
        }

