            --------------------------------------------------------------------------------------------------*/
        /* bigger touch area when selected */
        .fc-h-event.fc-selected:before {
            content: "";
            position: absolute;
            z-index: 3;
            /* below resizers */
            top: -10px;
            bottom: -10px;
            left: 0;
            right: 0;
