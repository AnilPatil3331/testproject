    <style>
        /* संपूर्ण ॲप्लिकेशनसाठी नवीन फॉन्ट (आयकॉन्सवर कोणताही परिणाम होणार नाही) */
        body, html, input, button, select, optgroup, textarea {
            font-family: 'Poppins', 'Noto Sans Devanagari', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
        }

        /* Custom SweetAlert styles to make them compact and professional across the app */
        .swal2-popup {
            width: 400px !important; /* balanced width */
            border-radius: 10px !important;
            padding: 20px !important;
            font-family: inherit !important;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
        }
        .swal2-title {
            font-size: 18px !important; /* balanced title size */
            font-weight: 700 !important;
            margin-bottom: 6px !important;
            color: inherit !important;
        }
        .swal2-html-container {
            font-size: 13.5px !important; /* balanced content size */
            color: #4a5568 !important;
            line-height: 1.45 !important;
            margin: 10px 0 !important;
        }
        .swal2-actions {
            margin-top: 12px !important;
        }
        .swal2-confirm, .swal2-cancel {
            padding: 6px 14px !important;
            font-size: 12.5px !important; /* balanced button size */
            border-radius: 5px !important;
            margin: 5px !important;
            font-weight: 500 !important;
        }
        .swal2-icon {
            transform: scale(0.75) !important; /* balanced icon size */
            margin: 10px auto -5px auto !important;
        }

        /* Global Modal popup size and font size increase */
        .modal-dialog {
            max-width: 90% !important;
            width: auto !important;
        }
        @@media (min-width: 768px) {
            .modal-dialog {
                max-width: 680px !important;
            }
        }
        @@media (min-width: 1200px) {
            .modal-dialog {
                max-width: 800px !important;
            }
        }

        .modal-content {
            font-size: 13.5px !important; /* balanced modal font size */
            border-radius: 10px !important;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.18) !important;
        }

        .modal-header h2, .modal-header h3, .modal-header h4, .modal-header h5 {
            font-size: 20px !important;
            font-weight: 600 !important;
        }

        .modal-body {
            font-size: 13.5px !important;
        }

        .modal-body label {
            font-size: 13px !important;
            font-weight: 600 !important;
        }

        .modal-body input, 
        .modal-body select, 
        .modal-body textarea, 
        .modal-body button,
        .modal-body .form-control {
            font-size: 13px !important;
        }

        .modal-body table, 
        .modal-body table th, 
        .modal-body table td {
            font-size: 13px !important;
        }

        .modal-body p, 
        .modal-body span {
            font-size: 13.5px !important;
        }
    </style>


