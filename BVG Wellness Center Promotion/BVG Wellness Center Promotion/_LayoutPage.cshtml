            --------------------------------------------------------------------------------------------------*/
        .fc-event.fc-dragging.fc-selected {
            box-shadow: 0 2px 7px rgba(0, 0, 0, 0.3);
        }

        .fc-event.fc-dragging:not(.fc-selected) {
            opacity: 0.75;
        }

