<script>
    $(document).ready(function () {

        debugger
        // Check window width on page load
        if ($(window).width() > 768) { // Only apply styles for desktop and larger screens
            // Apply expanded layout styles for larger screens by default
            adjustLayout(true);
        } else {
            // Collapse the sidenav by default on smaller screens
            $('#sidenav-main').addClass('collapsed');
            $('#toggle-button').attr('aria-expanded', 'true');
            adjustLayout(false); // Apply collapsed layout styles
        }

        // Toggle the sidenav on button click (for mobile and desktop)
        $('#toggle-button').on('click', function () {
            debugger;
            // For debugging in browser DevTools
            const sidenav = $('#sidenav-main');

            // Toggle the 'collapsed' class on the sidenav
            sidenav.toggleClass('collapsed');

            // Update the aria-expanded attribute dynamically
            if (sidenav.hasClass('collapsed')) {
                $(this).attr('aria-expanded', 'true');
                adjustLayout(false); // Apply layout for collapsed state (only on desktop)
            } else {
                $(this).attr('aria-expanded', 'false');
                adjustLayout(true); // Apply layout for expanded state (only on desktop)
            }
        });

        $("#ImageClick").on('click', function () {
            debugger
            const sidenav = $('#sidenav-main');

            // Toggle the 'collapsed' class on the sidenav
            sidenav.toggleClass('collapsed');

            // Update the aria-expanded attribute dynamically
            if (sidenav.hasClass('collapsed')) {
                $(this).attr('aria-expanded', 'true');
                adjustLayout(false); // Apply layout for collapsed state (only on desktop)
            } else {
                $(this).attr('aria-expanded', 'false');
                adjustLayout(true); // Apply layout for expanded state (only on desktop)
            }
        });

        // Target both IDs created in the previous step
        $("#ImageClickSwagram, #ImageClickJnana").on('click', function (e) {
            debugger
            e.preventDefault();
            const sidenav = $('#sidenav-main');

            sidenav.toggleClass('collapsed');

            if (sidenav.hasClass('collapsed')) {
                $(this).attr('aria-expanded', 'true');
                adjustLayout(false);
            } else {
                $(this).attr('aria-expanded', 'false');
                adjustLayout(true);
            }
        });

        // Adjust the sidenav state on window resize (to ensure it behaves correctly)
        $(window).resize(function () {
            if ($(window).width() > 768) { // Only apply these changes for desktop and larger screens
                // Ensure the sidenav is expanded on larger screens
                $('#sidenav-main').removeClass('collapsed');
                $('#toggle-button').attr('aria-expanded', 'false');
                adjustLayout(true); // Apply expanded layout styles
            } else {
                // For mobile or smaller screens, don't apply layout styles dynamically
                $('#sidenav-main').addClass('collapsed');
                $('#toggle-button').attr('aria-expanded', 'true');
                adjustLayout(false); // Remove expanded layout styles on mobile
            }
        });

        // Function to adjust layout styles dynamically (applied only on desktop)
        function adjustLayout(isExpanded) {
            if ($(window).width() > 768) { // Apply this only on desktop and larger screens
                if (isExpanded) {
                    // Apply styles when navbar is expanded
                    $('.container-fluid, .container-lg, .container-md, .container-sm, .container-xl').css({
                        'padding-right': '10px',
                        'padding-left': '134px', // Adjust padding when expanded
                    });
                } else {
                    // Reset styles when navbar is collapsed
                    $('.container-fluid, .container-lg, .container-md, .container-sm, .container-xl').css({
                        'padding-right': '10px',
                        'padding-left': '40px', // Reset padding when collapsed
                    });
                }
            }
        }

        $('#toggle-buttonMobile').on('click', function () {
            // For debugging in browser DevTools
            const sidenav = $('#sidenav-main');

            // Toggle the 'collapsed' class on the sidenav
            sidenav.toggleClass('collapsed');

            // Update the aria-expanded attribute dynamically
            if (sidenav.hasClass('collapsed')) {
                $(this).attr('aria-expanded', 'true');
            } else {
                $(this).attr('aria-expanded', 'false');
            }
        });
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const dropdownButton = document.querySelector(".dropdown-toggle");
        const dropdownMenu = document.querySelector(".dropdown-menu");

        dropdownButton.addEventListener("click", function (e) {
            e.stopPropagation(); // Prevents click from propagating to the document
            dropdownMenu.classList.toggle("show");
        });

        // Close dropdown when clicking outside
        document.addEventListener("click", function () {
            dropdownMenu.classList.remove("show");
        });
    });

</script>
