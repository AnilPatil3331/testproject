        .fc-bgevent-skeleton,
        .fc-highlight-skeleton,
        .fc-mirror-skeleton {
            /* these element should always cling to top-left/right corners */
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
        }

        .fc-bg {
            bottom: 0;
            /* strech bg to bottom edge */
        }

            .fc-bg table {
                height: 100%;
                /* strech bg to bottom edge */
            }

