<script>
document.addEventListener('DOMContentLoaded', function() {
    // महत्त्वाचे: तुमची minimized class 'collapsed' आहे
    function isMenuMinimized() {
        var sidenav = document.querySelector('#sidenav-main');
        if (sidenav) {
            return sidenav.classList.contains('collapsed');
        }
        return false;
    }

    // कस्टम टूलटिप फंक्शन (Bootstrap टूलटिप ओव्हरराइड करण्यासाठी)
    function showCustomTooltip(element, text, event) {
        var existingTooltip = document.querySelector('.custom-nav-tooltip');
        if (existingTooltip) {
            existingTooltip.remove();
        }

        var tooltip = document.createElement('div');
        tooltip.className = 'custom-nav-tooltip';
        tooltip.textContent = text;

        // एलिमेंटची पोझिशन कॅल्क्युलेट करा
        var rect = element.getBoundingClientRect();

        tooltip.style.position = 'fixed';
        tooltip.style.left = (rect.right + 8) + 'px';
        tooltip.style.top = (rect.top + (rect.height / 2) - 12) + 'px';
        tooltip.style.backgroundColor = '#2c3e50';
        tooltip.style.color = '#fff';
        tooltip.style.padding = '6px 12px';
        tooltip.style.borderRadius = '6px';
        tooltip.style.fontSize = '13px';
        tooltip.style.fontWeight = '500';
        tooltip.style.zIndex = '9999';
        tooltip.style.whiteSpace = 'nowrap';
        tooltip.style.boxShadow = '0 2px 8px rgba(0,0,0,0.2)';
        tooltip.style.pointerEvents = 'none';

        // छोटा त्रिकोण (arrow)
        tooltip.style.position = 'relative';

        document.body.appendChild(tooltip);

        // एरो ऍड करा
        var arrow = document.createElement('div');
        arrow.style.position = 'absolute';
        arrow.style.left = '-6px';
        arrow.style.top = '50%';
        arrow.style.transform = 'translateY(-50%)';
        arrow.style.width = '0';
        arrow.style.height = '0';
        arrow.style.borderRight = '6px solid #2c3e50';
        arrow.style.borderTop = '6px solid transparent';
        arrow.style.borderBottom = '6px solid transparent';
        tooltip.appendChild(arrow);

        // पोझिशन री-कॅल्क्युलेट करा
        var tooltipRect = tooltip.getBoundingClientRect();
        tooltip.style.position = 'fixed';
        tooltip.style.left = (rect.right + 8) + 'px';
        tooltip.style.top = (rect.top + (rect.height / 2) - (tooltipRect.height / 2)) + 'px';

        // एरोची पोझिशन ऍडजस्ट करा
        arrow.style.top = '50%';
        arrow.style.transform = 'translateY(-50%)';
    }

    function removeCustomTooltip() {
        var tooltip = document.querySelector('.custom-nav-tooltip');
        if (tooltip) {
            tooltip.remove();
        }
    }

    // सर्व nav-link वर होवर इव्हेंट ऍड करा (सबमेन्यूसह)
    function initCustomTooltips() {
        // सर्व nav-link एलिमेंट्स निवडा (सबमेन्यूतील लिंकसह)
        var allNavLinks = document.querySelectorAll('.navbar-nav .nav-link, .navbar-nav .nav-item .nav-link');

        allNavLinks.forEach(function(link) {
            // पूर्वीचे इव्हेंट्स रिमूव करा (डुप्लिकेट टाळण्यासाठी)
            link.removeEventListener('mouseenter', handleMouseEnter);
            link.removeEventListener('mouseleave', handleMouseLeave);

            // नवीन इव्हेंट्स ऍड करा
            link.addEventListener('mouseenter', handleMouseEnter);
            link.addEventListener('mouseleave', handleMouseLeave);
        });
    }

    function handleMouseEnter(event) {
        var link = event.currentTarget;
        var spanText = link.querySelector('.nav-link-text');

        if (spanText && spanText.textContent.trim() !== '') {
            var text = spanText.textContent.trim();

            // फक्त जेव्हा मेन्यू minimized असेल तेव्हाच टूलटिप दाखवा
            if (isMenuMinimized()) {
                showCustomTooltip(link, text, event);
            }
        }
    }

    function handleMouseLeave() {
        removeCustomTooltip();
    }

    // सुरुवातीला टूलटिप्स इनिशियलाइज करा
    setTimeout(function() {
        initCustomTooltips();
    }, 500);

    // टॉगल बटणावर क्लिक केल्यावर पुन्हा इनिशियलाइज करा
    var toggleBtn = document.querySelector('#toggle-button, #toggle-buttonMobile');
    if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
            setTimeout(function() {
                initCustomTooltips();
                // माउस लीव्ह झाल्यावर टूलटिप रिमूव करा
                removeCustomTooltip();
            }, 200);
        });
    }

    // साइडबारवर class बदल झाल्यास ऐका
    var sidenav = document.querySelector('#sidenav-main');
    if (sidenav) {
        var observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.attributeName === 'class') {
                    setTimeout(function() {
                        initCustomTooltips();
                        removeCustomTooltip();
                    }, 100);
                }
            });
        });
        observer.observe(sidenav, { attributes: true });
    }

    // डायनॅमिकली ऍड झालेल्या एलिमेंट्ससाठी (जर असेल तर)
    var observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.type === 'childList') {
                initCustomTooltips();
            }
        });
    });
    observer.observe(document.body, { childList: true, subtree: true });
});
</script>
<script>
// Target the class instead of the ID to cover both cases
$(".clinic-logo-click").on('click', function (e) {
    e.preventDefault(); // Stop page refresh

    const sidenav = $('#sidenav-main');

    // Toggle the 'collapsed' class
    sidenav.toggleClass('collapsed');

    // Logic updated for correct Accessibility (ARIA)
    if (sidenav.hasClass('collapsed')) {
        $(this).attr('aria-expanded', 'false'); // Sidenav is now closed
        adjustLayout(false);
    } else {
        $(this).attr('aria-expanded', 'true'); // Sidenav is now open
        adjustLayout(true);
    }
});


</script>
<script>
function toggleMenu() {
    var menu = document.getElementById("NavMenu");

    if (menu.style.display === "block") {
        menu.style.display = "none";
        localStorage.removeItem("NavMenu");
    } else {
        menu.style.display = "block";
        localStorage.setItem("NavMenu", "open");
    }
}


function toggleBillingMenu() {
    var menu = document.getElementById("NavMenu3");

    if (menu.style.display === "block") {
        menu.style.display = "none";
        localStorage.removeItem("NavMenu3");
    } else {
        menu.style.display = "block";
        localStorage.setItem("NavMenu3", "open");
    }
}


function toggleMenuById(id) {
    var menu = document.getElementById(id);

    if (menu.style.display === "block") {
        menu.style.display = "none";
        localStorage.removeItem(id); // close झाला तर remove
    } else {
        menu.style.display = "block";
        localStorage.setItem(id, "open"); // open झाला तर save
    }
}
document.addEventListener("DOMContentLoaded", function () {

    var menus = ["NavMenu", "NavMenu2", "NavMenu3", "NavMenuIPD"];

    menus.forEach(function (id) {
        var menu = document.getElementById(id);

        if (!menu) return;

        if (localStorage.getItem(id) === "open") {
            menu.style.display = "block";
        } else {
            menu.style.display = "none";
        }
    });

});
function keepMenuOpen(id) {
    localStorage.setItem(id, "open");
}

function generateDispensingBill(appointmentFid, appointmentFidEncrypted) {
    Swal.fire({
        title: 'Generating Bill...',
        text: 'Please wait while we generate the dispensing bill from prescription items.',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
    });

    $.ajax({
        url: '/Patient/BillingRecord/AutoGenerateBillFromPrescription',
        type: 'POST',
        data: { AppointmentFid: appointmentFid },
        success: function (res) {
            Swal.close();
            if (res.success) {
                Swal.fire({
                    title: 'Success!',
                    text: res.message,
                    icon: 'success',
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => {
                    if (typeof CloseAppointmentStatus === 'function') {
                        CloseAppointmentStatus(appointmentFidEncrypted, appointmentFid);
                    } else {
                        location.reload();
                    }
                });
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        },
        error: function () {
            Swal.close();
            Swal.fire('Error', 'Failed to generate dispensing bill.', 'error');
        }
    });
}
</script>