    <style>
        /* Detect when menu is minimized - adjust based on your sidebar class */
        #toggle-button {
            padding: 0; /* Tumhala havi tashi value taka, e.g., 2px kiva 5px */
        }

        .sidenav-toggler-inner {
            padding: 0;
            margin: 8px;
        }

        /* Logo chi height ani width set karnyasaathi */
        .navbar-brand.clinic-logo-click .navbar-brand-img {
            max-height: 4rem !important; /* Tumhi garje nusar he 5rem kiva 6rem karu shakta */
            width: 100% !important;
            display: block;
        }

        /* Padding kadhun taknyasathi */
        .navbar-brand.clinic-logo-click {
            padding: 0 !important;
            display: block;
            width: 100%;
        }

        .fullscreen-popup {
            width: 30vw !important; /* Width of the popup */
            height: auto; /* Adjust height based on content */
            max-height: none !important; /* Limit max height */
            max-width: none;
            border-radius: 0;
            display: flex;
            flex-direction: column; /* Stack elements vertically */
            justify-content: center;
            align-items: center;
            padding: 20px; /* Add spacing around content */
            background-color: #d1e1e3; /* Light blue background */
            color: black; /* Text color changed to black for contrast */
            overflow: auto; /* Scroll if content overflows */
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1); /* Add slight shadow for effect */
        }

            .fullscreen-popup button {
                margin-top: 10px; /* Space between buttons and other content */
                padding: 10px 20px; /* Adjust button padding */
                background-color: #007bff; /* Button background color */
                color: white; /* Button text color */
                border: none; /* Remove border */
                border-radius: 5px; /* Rounded corners */
                cursor: pointer; /* Pointer cursor on hover */
                font-size: 14px;
            }

                .fullscreen-popup button:hover {
                    background-color: #0056b3; /* Darker shade on hover */
                }

        div:where(.swal2-icon) {
            position: relative;
            box-sizing: content-box;
            justify-content: center;
            width: 3em !important;
            height: 3em !important;
            margin: 0.0em auto .0em !important;
            border: 0.25em solid rgba(0, 0, 0, 0);
            border-radius: 50%;
            border-color: #000;
            font-family: inherit;
            line-height: 3em;
            cursor: default;
            user-select: none;
        }
    </style>
