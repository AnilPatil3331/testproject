@model BVG_Wellness_Center_Promotion.Models.UserMaster
@{
    Layout = null;
}

<link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
<link href="~/assets/css/app.min.css" rel="stylesheet" />
<link href="~/assets/css/font-awesome-all.min.css" rel="stylesheet" />
<link href="~/assets/css/CustomeAlertCSS/customAlert.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script src="~/assets/js/CustomeAlert/customAlert.js"></script>

<div class="container-fluid" style="background-image: url('/images/BackGroundImage.jpg'); background-size: cover; background-position: center; height: 100vh;">
    <div class="row justify-content-center align-items-center" style="height: 100%; width:100%">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4" style="margin-left: 64%;">
            <div class="card shadow border-0">
                <div class="card-header text-center" style="background-color: #5881ed; color: white; padding: 15px;">
                    <h5 class="mb-0" style="font-weight: bold; color:white;">Forgot Password</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-center text-muted mb-4" style="font-size: 0.85rem;">Enter details to receive an OTP on your email.</p>

                    <form action="/Home/SendOTP" method="post">
                        <div class="form-group mb-3">
                            <label class="form-label font-weight-bold">Clinic Code:</label>
                            <input type="text" class="form-control" name="ClinicCode" value="@ViewBag.ClinicCode" required placeholder="e.g. JYA001" style="text-transform: uppercase;">
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label font-weight-bold">Login ID / Username:</label>
                            <input type="text" class="form-control" name="LoginId" value="@ViewBag.LoginId" required placeholder="e.g. SARIKA">
                        </div>
                        <div class="form-group mb-4">
                            <label class="form-label font-weight-bold">Registered Email ID:</label>
                            <input type="email" class="form-control" name="Email" value="@ViewBag.Email" required placeholder="example@mail.com">
                        </div>


                        <button type="submit" class="btn btn-primary w-100 mb-3" style="background-color: #5881ed; border:none; height: 45px; font-weight:bold;">
                            <i class="fa fa-paper-plane"></i> Send OTP
                        </button>

                        <div class="text-center">
                            <a href="@Url.Action("Login", "Home")" class="text-primary font-weight-bold" style="text-decoration: none; font-size: 0.9rem;">
                                <i class="fa fa-arrow-left"></i> Back to Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@if (TempData["Message"] != null)
{
    <script>
        $(document).ready(function() {
            // फक्त अलर्ट शो करा, बाकीचे इमेज हाइड करण्याचे लॉजिक आपण customAlert.js मध्ये केले आहे
            showCustomAlert('@TempData["Message"]', '@TempData["Icon"]', "");

            var iconType = '@TempData["Icon"]';
            if (iconType === 'success') {
                setTimeout(function () {
                    window.location.href = '@Url.Action("Login", "Home")';
                }, 3000);
            }
        });
    </script>
}
