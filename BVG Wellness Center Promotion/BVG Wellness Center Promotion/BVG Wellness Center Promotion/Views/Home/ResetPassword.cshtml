@model BVG_Wellness_Center_Promotion.Models.UserMaster
@{
    Layout = null;
}

<link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
<link href="~/assets/css/app.min.css" rel="stylesheet" />
<link href="~/assets/css/font-awesome-all.min.css" rel="stylesheet" />
<link href="~/assets/css/CustomeAlertCSS/customAlert.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script src="~/assets/js/CustomeAlert/customAlert.js?v=1.1"></script>


<div class="container-fluid" style="background-image: url('/images/BackGroundImage.jpg'); background-size: cover; background-position: center; height: 100vh;">
    <div class="row justify-content-center align-items-center" style="height: 100%; width:100%">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4" style="margin-left: 64%;">
            <div class="card shadow border-0">
                <div class="card-header text-center" style="background-color: #5881ed; color: white; padding: 15px;">
                    <h5 class="mb-0" style="font-weight: bold; color:white;">Reset Password</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Home/UpdateForgottenPassword" method="post" id="resetForm">
                        <div class="form-group mb-3">
                            <label class="form-label font-weight-bold">New Password:</label>
                            <input type="password" id="txtNew" name="NewPassword" class="form-control" required placeholder="Enter New Password">
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label font-weight-bold">Confirm Password:</label>
                            <input type="password" id="txtConfirm" class="form-control" required placeholder="Confirm Password">
                        </div>

                        <button type="submit" class="btn btn-primary w-100" style="background-color: #5881ed; border:none; height: 45px; font-weight:bold;">
                            Update Password
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Password Match Validation
    $("#resetForm").submit(function (e) {
        if ($("#txtNew").val() !== $("#txtConfirm").val()) {
            // Default browser alert for quick check
            showCustomAlert("Passwords do not match!", "error", "");
            e.preventDefault();
            return false;
        }
    });

    // 2. Success Message Logic
     $(document).ready(function () {
        var message = '@TempData["Message"]';
        var icon = '@TempData["Icon"]';

        if (message != "") {
            showCustomAlert(message, icon, "");

            if (icon === 'success') {
                setTimeout(function () {
                    window.location.href = '@Url.Action("Login", "Home")';
                }, 3000);
            }
        }
    });

</script>