                                    </span> <span class="hidden-xs-down">Dispensing Medicine</span>
                                </a>
                            </li>

                        </ul>
                        <!-- Tab panes -->
                        <div class="tab-content">
                            @*tab close div*@

                            <div class="tab-pane  p-20 active show " id="medicine" role="tabpanel">

                                <form id="prescriptionForm">
                                    <!-- Added ID to form -->
                                    <!-- R ow 1: Frequency, Normal (new), Duration, Instruction -->
                                    <div class="row" style="margin:19px;">
                                      <input type="hidden" id="PatientID" name="PatientID" value="@(ViewBag.TodayPatients?.PatientFid ?? "")" />




                                        <div class="col-md-4 form-group">
                                            @Html.DropDownListFor(m => m.ItemName, new SelectList(ViewBag.Getdata, "Id", "Name"), "Select Services", new { @class = "form-control", id ="ddlServiceName", required = "required" })
                                            <label class="floating-label">Service Name</label>
                                        </div>
                                        
                                        <div class="col-md-3 form-group">
                                            @Html.TextBoxFor(m => m.Rate, new { @class = "form-control", id = "Rate" })
                                            <label class="floating-label">Rate</label>
                                        </div>

                                        <div class="col-md-2 form-group">
                                            @Html.TextBoxFor(m => m.Count, new { @class = "form-control",id = "Quantity", type = "number", value = "1", min = "1" })
                                            <label class="floating-label">Quantity</label>
                                        </div>

                                        <div class="col-md-3 form-group">
                                            @Html.TextBoxFor(m => m.Discount, new { @class = "form-control", id = "Discount", value = "0", min = "0" })
                                            <label class="floating-label">Discount</label>
                                        </div>


                                        <div class="col-md-3 form-group">
                                            @Html.DropDownListFor(m => m.DoctorFid, new SelectList(ViewBag.GetDoctorName, "Id", "Name"), "Select Doctor", new { @class = "form-control", id = "DoctorFid", required = "required" })
                                            <label class="floating-label">Suggested By</label>
                                        </div>

                                        <div class="col-md-3 form-group">
                                            @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", placeholder = " ", id = "Amount" })
                                            <label class="floating-label">Amount</label>
                                        </div>
             
                                        <!-- Row 3: Note -->
                                        @*<div class="row">*@
                                        <div class="col-md-6 form-group">
                                            @Html.TextBoxFor(m => m.Note, new { @class = "form-control", placeholder = " ", id = "Note" })
                                            <label class="floating-label">Note</label>
                                        </div>


                                    </div>

                                    @*</div>*@

                                    <div class="d-flex justify-content-end mt-3">
                                        <button type="button" id="addButton" class="btn btn-primary me-2">ADD</button>
                                        <button type="button" id="updateButton" class="btn btn-success me-2" style="display: none;">UPDATE</button>
                                        <button type="button" id="cancelButton" class="btn btn-secondary" style="display: none;">CANCEL</button>
                                    </div>
                                </form>

                                <div class="table-responsive mt-4" style="max-height: 200px; overflow-y: auto; border: 1px solid #ccc; border-radius: 6px;">
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                                            <tr>
                                                <th>Action</th>
                                                <th>Service Name</th>
                                                <th>Rate</th>
                                                <th>Quantity</th>
                                                <th>Discount</th>
                                                @*<th>Suggested By</th>*@
                                                <th>Amount</th>
                                                <th>Note</th>
                                                @*<th>Qty</th>
                                                <th>Note</th>*@

                                            </tr>
                                        </thead>
                                        <tbody id="prescriptionTableBody">
                                            <!-- Table rows will be added dynamically -->

                                            @if(ViewBag.GetServicesList != null)
                                            {
                                                foreach (var item in ViewBag.GetServicesList)
                                                {
                                                    <tr>
                                                        <td>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-danger"
                                                                    onclick="deletePrescription()">
                                                                🗑
                                                            </button>
                                                       </td>
                                                        <td>@item.ServiceName</td>
                                                        <td>@item.Rate</td>
                                                        <td>@item.Quantity</td>
                                                        <td>@item.Discount</td>
                                                        <td>@item.Amount</td>
                                                        <td>@item.Note</td>
                                                    </tr>
                                                }
                                            }





                                        </tbody>
                                    </table>
                                </div>

                                <div class="btnBx">
                                    <button type="submit" class="btn btn-md btn-success mr-1">Submit</button>                              
                                </div>




                            </div>

                            <div class="tab-pane p-20" id="Dispensing" role="tabpanel">


                            </div>


                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>
    <!-- ============================================================== -->
    <!-- End Container fluid  -->
    <!-- ============================================================== -->
</div>



