        <div class="row">
            <div class="col-md-12">
                <div class="card mb-0">
                    <div class="card-body p-b-0">
                        <!-- Nav tabs -->
                        <ul class="nav nav-tabs customtab2" role="tablist">
                            <li class="nav-item">

                                <a class="nav-link active" data-bs-target="#medicine" type="button" role="tab" aria-selected="true" data-bs-toggle="tab">
                                    <span class="hidden-sm-up"><i class="ti-user"></i></span> <span class="hidden-xs-down">Medicine</span>
                                </a>
                            </li>

                            <li class="nav-item">
