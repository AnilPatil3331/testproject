<script>
$(document).ready(function () {

    let prescriptions = [];

    /* =========================
       SERVICE CHANGE → RATE
    ========================== */
    $('#ddlServiceName').on('change', function () {

        var serviceId = $(this).val();
        if (!serviceId) return;

        $.ajax({
            url: '@Url.Action("GetServicePrice", "Encounter")',
            type: 'GET',
            data: { GetServiceId: serviceId },
            success: function (price) {

                price = parseFloat(price) || 0;

                $('#Rate').val(price.toFixed(2));
                $('#Quantity').val(1);
                $('#Discount').val(0);

                calculateAmount();   // ⭐ IMPORTANT
            }
        });
    });

    /* =========================
       QTY / DISCOUNT → AMOUNT
    ========================== */
    $('#Quantity, #Discount').on('input', function () {
        calculateAmount();
    });

    function calculateAmount() {

        let rate = parseFloat($('#Rate').val()) || 0;
        let qty = parseInt($('#Quantity').val()) || 1;
        let discount = parseFloat($('#Discount').val()) || 0;

        let total = (rate * qty) - discount;
        if (total < 0) total = 0;

        $('#Amount').val(total.toFixed(2));
    }

    /* =========================
       ADD BUTTON
    ========================== */
    $('#addButton').on('click', function () {

        if (!$('#ddlServiceName').val()) {
            alert('Service select करा');
            return;
        }

        if (!$('#DoctorFid').val()) {
            alert('Doctor select करा');
            return;
        }

        addPrescription();
        clearForm();
    });

    function addPrescription() {

        const prescription = {
            ServiceFid: $('#ddlServiceName').val(),
            ServiceName: $('#ddlServiceName option:selected').text(),
            Rate: $('#Rate').val(),
            Quantity: $('#Quantity').val(),
            Discount: $('#Discount').val(),
            Amount: $('#Amount').val(),
            Note: $('#Note').val(),
            DoctorFid: $('#DoctorFid').val(),
            PatientID: $('#PatientID').val()
        };

        prescriptions.push(prescription);
        renderTable();
    }

    /* =========================
       TABLE RENDER
    ========================== */
    function renderTable() {

        $('#prescriptionTableBody').empty();

        $.each(prescriptions, function (index, p) {

            $('#prescriptionTableBody').append(`
                <tr>
                    <td>
                        <button type="button"
                                class="btn btn-sm btn-danger"
                                onclick="deletePrescription(${index})">🗑</button>
                    </td>
                    <td>${p.ServiceName}</td>
                    <td>${p.Rate}</td>
                    <td>${p.Quantity}</td>
                    <td>${p.Discount}</td>
                    <td>${p.Amount}</td>
                    <td>${p.Note}</td>
                </tr>
            `);
        });
    }

    window.deletePrescription = function (index) {
        prescriptions.splice(index, 1);
        renderTable();
    };

    function clearForm() {
        $('#prescriptionForm')[0].reset();
        $('#Quantity').val(1);
        $('#Discount').val(0);
        $('#Amount').val('');
    }

    /* =========================
       SUBMIT → SAVE → REDIRECT
    ========================== */
    $('.btnBx button[type="submit"]').on('click', function (e) {

        e.preventDefault();

        if (prescriptions.length === 0) {
            alert('कृपया किमान एक service add करा');
            return;
        }


        let manualPatient = null;

        if ($('#PatientID').val() === "") {

            manualPatient = {
                PatientName: $('#ManualPatientName').val(),
                MobileNo: $('#ManualMobileNo').val(),
                Age: $('#ManualAge').val(),
                Gender: $('#ManualGender').val(),
                VisitDate: $('#ManualVisitDate').val()
            };

            if (!manualPatient.PatientName || !manualPatient.MobileNo) {
                alert('Manual patient details आवश्यक आहेत');
                return;
            }
        }


        $.ajax({
            url: '@Url.Action("SaveServices")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                services: prescriptions,
                manualPatient: manualPatient
            }),
            success: function (res) {

           if (res.success) {
        // ✅ Get patientId from response or hidden field
        var patientId = res.patientID || $('#PatientID').val();

        // ✅ IMPORTANT: Always pass both FlageId and PatientFid
        var redirectUrl = '@Url.Action("AddServices")' +
                         '?ServicesPFid=' + res.servicePFid +
                         '&FlageId=' + res.flageId;

        // ✅ Add PatientFid only if it exists
        if (patientId && patientId != "") {
            redirectUrl += '&PatientFid=' + patientId;
        }

        window.location.href = redirectUrl;
    } else {
        alert(res.message);
    }
            },
            error: function () {
                alert('Something went wrong');
            }
        });
    });

});
</script>

@*table script End*@

@*search table script*@

<script>
    $(document).ready(function () {
        $('#searchInput').on('input', function () {
            var query = $(this).val().trim();

            if (query.length >= 1) {
                $.ajax({
                    url: '@Url.Action("SearchOPD")',
                    type: 'GET',
                    data: { searchTerm: query },
                    success: function (data) {
                        debugger;
                        let html = "";
                        if (data.length > 0) {
                            html += "<ul class='list-group mb-0'>";

                            $.each(data, function (i, item) {
                                html += "<li class='list-group-item list-group-item-action' " + "style='cursor:pointer;' onclick='selectPatient(" + item.PatientFid + ")'>";

                                html += "<span>" + item.FullName + " | " + item.ContactNumber + " | " + item.UHIDNO + "</span>";

                                html += "</li>";

                            });

                            html += "</ul>";
                        } else {
                            //html = "<div class='p-2 text-muted'>No matches found</div>";

                            html = `
                                <div class='p-2 text-muted'
                                     style='cursor:pointer;'
                                     onclick="selectOtherPatient()">
                                     No matches found (Click to add Other)
                                </div>`;

                        }

                        $('#searchResult').html(html).show();
                    },
                    error: function () {
                        $('#searchResult').html('<div class="p-2 text-danger">Error fetching data</div>').show();
                    }
                });
            } else {
                $('#searchResult').hide();
            }
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#searchInput, #searchResult').length) {
                $('#searchResult').hide();
            }
        });
    });

       function selectPatient(PatientFid) {
           window.location.href = '/patient/ServicesBill/AddServices/?PatientFid=' + PatientFid;
       }


       function selectOtherPatient() {
           // 🔥 string pass to controller
           window.location.href =
               '/patient/ServicesBill/AddServices?Source=other';
       }
</script>

@*search table script End *@




