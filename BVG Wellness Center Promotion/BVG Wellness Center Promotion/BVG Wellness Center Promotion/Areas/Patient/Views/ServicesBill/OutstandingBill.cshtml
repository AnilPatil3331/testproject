        debugger;
        var PatientDeatialsData = @Html.Raw(Json.Encode(ViewBag.GetPatientEncounterDetails));
        if(PatientDeatialsData!=null && PatientDeatialsData!="")
        {
            $("#bill-details-modal___BV_modal_outer_")
                 .css("display", "block")  
                 .attr("aria-hidden", "false")  
                 .addClass("show");
        }

        $("#BillDetailsModelClose").click(function () {
            const modalOuter = $("#bill-details-modal___BV_modal_outer_");
            modalOuter.css("display", "none").attr("aria-hidden", "true");
            var url='@Url.Action("OutstandingBill")';
            window.location.href = url;
        });

        document.getElementById("billPrint").addEventListener("click", function() {
            var modalContent = document.querySelector("#bill-details-modal___BV_modal_outer_ .modal-content");
            if (!modalContent) {
                alert("Error: Bill details not found.");
                return;
            }
            var clonedContent = modalContent.cloneNode(true);
            var footerNav = clonedContent.querySelector("#PrintFooter");
            if (footerNav) {
                footerNav.remove();
            }
            var printclinicaldetails = clonedContent.innerHTML;
            var printWindow = window.open("", "", "width=800,height=600");
            printWindow.document.write(`
                <html>
                <head>
                    <title>Print</title>
                    <link rel="stylesheet" type="text/css" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
                    <style>
                        body { font-family: Arial, sans-serif; margin: 20px; }
                        .hidden-print { display: none; }
                    </style>
                </head>
                <body>
                    ${printclinicaldetails}
                    <script>
                        window.onload = function() {
                            window.print();
                            window.close();
                        };
                    <\/script>
                </body>
                </html>
            `);
            printWindow.document.close();
        });
    });

</script>
