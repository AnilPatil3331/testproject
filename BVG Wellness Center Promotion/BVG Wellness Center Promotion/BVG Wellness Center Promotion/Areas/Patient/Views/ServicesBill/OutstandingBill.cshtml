<script>
    $(document).ready(function () {
        $('#Closemodel').click(function () {
            @*window.location.href = '@Url.Action("OutstandingBill", "BillingRecord")';*@
            const modalOuter = $("#bill-modal___BV_modal_outer_");

            // Hide modal and remove aria-modal attribute
            modalOuter.css("display", "none").attr("aria-hidden", "true");
        });

        $('#Cancel').click(function () {
            @*window.location.href = '@Url.Action("OutstandingBill", "BillingRecord")';*@
            const modalOuter = $("#bill-modal___BV_modal_outer_");

            // Hide modal and remove aria-modal attribute
            modalOuter.css("display", "none").attr("aria-hidden", "true");
        });
    });


    document.addEventListener("DOMContentLoaded", function () {
        const table = document.getElementById('tblBillingRecords');
        if (!table) return;

        const rowsPerPageSelect = document.getElementById('PageOption');
        const prevButton = document.getElementById('prev-btn');
        const nextButton = document.getElementById('next-btn');
        const currentPageInput = document.getElementById('InputPage');
        const totalPagesElement = document.getElementById('total-pages');

        // Select only actual data rows, ignore empty rows or "No Data Found"
        const allRows = Array.from(table.querySelectorAll('tbody tr')).filter(row => {
            const text = row.textContent.trim();
            return text !== '' && !text.includes('No Data Found');
        });

        let currentPage = 1;
        let rowsPerPage = rowsPerPageSelect ? parseInt(rowsPerPageSelect.value, 10) || 10 : 10;
        let filteredRows = [...allRows];

        function updateTable() {
            if (!rowsPerPageSelect) return;

            // Hide all rows first
            allRows.forEach(row => row.style.display = 'none');

            if (rowsPerPage === -1) {
                filteredRows.forEach(row => row.style.display = '');
                currentPageInput.value = 1;
                totalPagesElement.textContent = 1;
            } else {
                const start = (currentPage - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                filteredRows.forEach((row, index) => {
                    if (index >= start && index < end) {
                        row.style.display = '';
                    }
                });

                currentPageInput.value = currentPage;
                totalPagesElement.textContent = Math.ceil(filteredRows.length / rowsPerPage) || 1;
            }

            const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;
            prevButton.classList.toggle('disabled', currentPage <= 1);
            nextButton.classList.toggle('disabled', currentPage >= totalPages);
        }

        if (rowsPerPageSelect) {
            rowsPerPageSelect.addEventListener('change', function () {
                rowsPerPage = parseInt(this.value, 10);
                currentPage = 1;
                updateTable();
            });
        }

        if (prevButton) {
            prevButton.addEventListener('click', function () {
                if (currentPage > 1) {
                    currentPage--;
                    updateTable();
                }
            });
        }

        if (nextButton) {
            nextButton.addEventListener('click', function () {
                const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;
                if (currentPage < totalPages) {
                    currentPage++;
                    updateTable();
                }
            });
        }

        function applyFilters() {
            const searchInput = document.getElementById('SearchInput');
            const globalFilterText = searchInput ? searchInput.value.trim().toLowerCase() : '';
            const specificInputs = Array.from(table.querySelectorAll('thead .filter-th input'));

            filteredRows = allRows.filter(row => {
                let matches = true;
                const cells = row.querySelectorAll('td');

                if (globalFilterText !== '') {
                    const rowMatch = Array.from(cells).some(cell => cell.textContent.toLowerCase().includes(globalFilterText));
                    if (!rowMatch) matches = false;
                }

                specificInputs.forEach(input => {
                    const filterText = input.value.trim().toLowerCase();
                    if (filterText !== '') {
                        const rowMatch = Array.from(cells).some(cell => cell.textContent.toLowerCase().includes(filterText));
                        if (!rowMatch) matches = false;
                    }
                });

                return matches;
            });

            currentPage = 1;
            updateTable();
        }

        const filterInputIds = ['SearchInput', 'FilterAmoutDue', 'FilterByDiscount', 'filterByTotal', 'FilterByPatient', 'FilterByClinic', 'FilterByDoctor', 'FilterDate'];
        filterInputIds.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.addEventListener('input', applyFilters);
        });

        updateTable();
    });






    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("paidRadio").setAttribute("required", "required");
    });

