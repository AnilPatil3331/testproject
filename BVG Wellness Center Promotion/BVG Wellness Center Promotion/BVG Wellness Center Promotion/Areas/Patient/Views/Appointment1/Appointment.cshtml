            <script>
document.addEventListener("DOMContentLoaded", function () {

    const table = document.getElementById("tblAppoinment");
    const rows = Array.from(table.querySelectorAll("tbody tr"));

    const searchInput = document.getElementById("SearchInput");
    const rowsPerPageSelect = document.getElementById("PageOption");
    const prevButton = document.getElementById("prev-btn");
    const nextButton = document.getElementById("next-btn");
    const currentPageInput = document.getElementById("InputPage");
    const totalPagesElement = document.getElementById("total-pages");

    let currentPage = 1;
    let rowsPerPage = parseInt(rowsPerPageSelect.value) || 10;
    let currentFilter = "today";
    let searchText = "";

    const dateColumnIndex = 9; // ✅ change if needed

    function parseDate(dateString) {
        const parts = dateString.split("-");
        if (parts.length !== 3) return null;
        return new Date(parts[2], parts[1] - 1, parts[0]);
    }

    function applyFilters() {

        const today = new Date();
        today.setHours(0,0,0,0);

        let filteredRows = rows.filter(row => {

            // 🔎 SEARCH FILTER
            const matchSearch = Array.from(row.querySelectorAll("td"))
                .some(cell => cell.textContent.toLowerCase().includes(searchText));

            if (!matchSearch) return false;

            // 📅 DATE FILTER
            const dateCell = row.children[dateColumnIndex];
            if (!dateCell) return false;

            const rowDate = parseDate(dateCell.textContent.trim());
            if (!rowDate) return false;

            rowDate.setHours(0,0,0,0);

            if (currentFilter === "today")
                return rowDate.getTime() === today.getTime();

            if (currentFilter === "upcoming")
                return rowDate > today;

            if (currentFilter === "past")
                return rowDate < today;

            return true; // all
        });

        // 📄 PAGINATION
        const totalPages = rowsPerPage === -1 ? 1 : Math.ceil(filteredRows.length / rowsPerPage);
        totalPagesElement.textContent = totalPages;

        if (currentPage > totalPages) currentPage = 1;
        currentPageInput.value = currentPage;

        rows.forEach(r => r.style.display = "none");

        if (rowsPerPage === -1) {
            filteredRows.forEach(r => r.style.display = "");
        } else {
            const start = (currentPage - 1) * rowsPerPage;
            const end = start + rowsPerPage;
            filteredRows.slice(start, end).forEach(r => r.style.display = "");
        }

        prevButton.classList.toggle("disabled", currentPage <= 1);
        nextButton.classList.toggle("disabled", currentPage >= totalPages);
    }

    // 🔎 SEARCH EVENT
    searchInput.addEventListener("input", function () {
        searchText = this.value.trim().toLowerCase();
        currentPage = 1;
        applyFilters();
    });

    // 📄 ROWS PER PAGE
    rowsPerPageSelect.addEventListener("change", function () {
        rowsPerPage = parseInt(this.value);
        currentPage = 1;
        applyFilters();
    });

    // ⬅ PREV
    prevButton.addEventListener("click", function () {
        if (currentPage > 1) {
            currentPage--;
            applyFilters();
        }
    });

    // ➡ NEXT
    nextButton.addEventListener("click", function () {
        currentPage++;
        applyFilters();
    });

    // 📅 DATE BADGES (ONLY data-filter)
    document.querySelectorAll("[data-filter]").forEach(badge => {
        badge.addEventListener("click", function () {

            currentFilter = this.getAttribute("data-filter").toLowerCase();
            currentPage = 1;

            document.querySelectorAll("[data-filter]").forEach(b => {
                b.classList.remove("badge-primary");
                b.classList.add("badge-outline-primary");
            });

            this.classList.remove("badge-outline-primary");
            this.classList.add("badge-primary");

            applyFilters();
        });
    });


    document.querySelector('[data-filter="today"]').classList.add("badge-primary");
    document.querySelector('[data-filter="today"]').classList.remove("badge-outline-primary");
    applyFilters();
});
</script>
          
