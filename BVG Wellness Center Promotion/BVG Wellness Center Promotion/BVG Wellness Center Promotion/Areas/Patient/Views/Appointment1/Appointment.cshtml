<script>

$("#doctorFid, #appointmentDate").change(function () {

    var doctorId = $("#doctorFid").val();
    var date = $("#appointmentDate").val();
    // 🔴 CLEAR OLD SLOTS
    $("#timeSlotsContainer").html("");
    $("#noSlotsMessage").show();

    if (doctorId != "" && date != "") {

        $.ajax({
            url: '/Patient/Appointment/GetDoctorSlots',
            type: 'GET',
            data: {
                doctorFid: doctorId,
                date: date
            },
            success: function(result){

                $(".TimeDiv").removeClass("slot-booked");

                result.forEach(function(slot){

                    var cleanTime = slot.SloteStartTime.replace(':','');

                    $("#slot_" + cleanTime).addClass("slot-booked");

                });

            }
        });

    }

});


