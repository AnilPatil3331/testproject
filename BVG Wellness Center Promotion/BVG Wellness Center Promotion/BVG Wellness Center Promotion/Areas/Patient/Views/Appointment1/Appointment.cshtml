        });
    });

    /// Get Doctor Session on doctor change
    $("#doctorFid").change(function () {
        debugger;
        // $("#serviceFid").find("option").remove();
        $("#serviceFid").empty();
        var DoctorID = $("#doctorFid").val();
        var PatientFid = $("#patientFid").val();
        //var AppointmentFid = $("input[name='AppointmentFid']").val();
        $.ajax({
            type: 'GET',
            dataType: 'json',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetTimeSlots", "Appointment")',
            data: { DoctorID: DoctorID, PatientFid: PatientFid },
            success: function (data) {
                debugger;
                var DataServiceName = data.GetServiceName;
                var TimeSlote = data.GetDoctorSlote;



                // Add the service options if available
                if (DataServiceName != null) {
                    $("#serviceFid").append("<option value=''>--Select--</option>");
                    $.each(DataServiceName, function (i, p) {
                        $("#serviceFid").append("<option value='" + p.Id + "'>" + p.Name + "</option>");
                    });
                    // 🔥 prevent auto select
                    $("#serviceFid").val('');
                    $("#serviceFid").prop("selectedIndex", 0);
                    $("#serviceFid").val('').trigger('change');
                } else {
                    $('#ErrorESSPassword').html(" ");
                }

                if (TimeSlote && TimeSlote.length > 0) {
                    $('#noSlotsMessage').hide(); // Hide the "No time slots found" message
                    $('.time-slot').css('height', 'auto');
                    let timeSlotHtml = '';

                    // Loop through the returned data and create time slot badges
                    $.each(TimeSlote, function (i, item) {
                        let slotStartTime = "";
                        let slotEndTime = "";

                        // Extract the time slot values from the key-value pairs
                        $.each(item, function (index, pair) {
                            if (pair.Key === "SlotStartTime") {
                                slotStartTime = pair.Value;
                            } else if (pair.Key === "SlotEndTime") {
                                slotEndTime = pair.Value;
                            }
                        });

                        // Add time slot to the HTML
                        timeSlotHtml += `
