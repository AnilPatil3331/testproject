                document.addEventListener("DOMContentLoaded", function () {
                    var appointmentDate = document.getElementById("appointmentDate");

                    var today = new Date();

                    // Calculate 30 days before today
                    var thirtyDaysBefore = new Date();
                    thirtyDaysBefore.setDate(today.getDate() - 30);

                    // Get the first day of the previous month
                    var firstDayOfPreviousMonth = new Date(today.getFullYear(), today.getMonth() - 1, 1);

                    // Set the min date as the **earlier** of the two
                    var minDate = (thirtyDaysBefore < firstDayOfPreviousMonth)
                        ? firstDayOfPreviousMonth
                        : thirtyDaysBefore;

                    var formattedMinDate = minDate.toISOString().split('T')[0]; // Format as YYYY-MM-DD

                    // Set the min attribute
                    appointmentDate.setAttribute("min", formattedMinDate);

                    // Prevent form submission if an invalid date is selected
                    appointmentDate.addEventListener("change", function () {
                        if (this.value < formattedMinDate) {
                            this.value = formattedMinDate; // Reset to the minimum allowed date
                        }
                    });
                });



