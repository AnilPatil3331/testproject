        // Service change नाही
        $("#OpenBillPopup").val("0");
    }

});
</script>

<script>

    // 🔥 Discount Input Handler
    function handleDiscountInput(el) {

        let val = el.value;

        // ❌ only numbers allow
        val = val.replace(/[^0-9]/g, '');

        // ❌ max 100
        if (parseInt(val) > 100) {
            val = "100";
        }

        el.value = val;

        // 🔥 Calculate Payable
        let total = parseFloat($("#txtFinalTotal").val()) || 0;
        let discount = parseFloat(val) || 0;

        let finalAmount = total - ((total * discount) / 100);

        $("#txtFinalPaybalAmount").val(finalAmount.toFixed(2));

        // first payment row auto fill
        $(".amount").first().val(finalAmount.toFixed(2));

        checkAmountMatch();
    }


    // 🔥 Amount Match Check
    function checkAmountMatch() {

        let payable = parseFloat($("#txtFinalPaybalAmount").val()) || 0;
        let sum = 0;

        $(".amount").each(function () {
            sum += parseFloat($(this).val()) || 0;
        });

        if (sum !== payable) {
            $("#idmismatchAmount").text("⚠ Amount mismatch");
        } else {
            $("#idmismatchAmount").text("");
        }
    }


    $(document).ready(function () {

        // 🔥 Payment Status (Paid / Unpaid)
        function handlePaymentStatus() {

            let status = $("input[name='PaymentStatus']:checked").val();

            if (status === "Unpaid") {

                // all readonly
                $(".paymentType").css("pointer-events", "none");
                $(".referenceNumber").val("").prop("readonly", true);
                $(".amount").prop("readonly", true);

            } else {

                $(".paymentType").css("pointer-events", "auto");
                $(".amount").prop("readonly", false);

                // each row check
                $(".payment-row").each(function () {

                    let type = $(this).find(".paymentType").val();
                    let ref = $(this).find(".referenceNumber");

                    if (type === "Cash") {
                        ref.val("");                 // 🔥 clear
                        ref.prop("readonly", true); // 🔥 lock
                    } else {
                        ref.prop("readonly", false);
                    }
                });
            }
        }


        // 🔥 Payment Type Change (Cash logic)
        $(document).on("change", ".paymentType", function () {

            let row = $(this).closest(".payment-row");
            let type = $(this).val();
            let ref = row.find(".referenceNumber");

            if (type === "Cash") {
                ref.val("");                 // 🔥 clear immediately
                ref.prop("readonly", true); // 🔥 readonly
            } else {
                ref.prop("readonly", false);
            }
        });


        // 🔥 Amount Validation (no minus / chars)
        $(document).on("input", ".amount", function () {

            let val = $(this).val();

            // ❌ remove non-numeric
            val = val.replace(/[^0-9.]/g, '');

            // ❌ remove minus
            val = val.replace('-', '');

            $(this).val(val);

            checkAmountMatch();
        });


        // 🔥 Payment Status change
        $("input[name='PaymentStatus']").change(function () {
            handlePaymentStatus();
        });

        // 🔥 Page load la run
        handlePaymentStatus();

    });

</script>

<script>
    $(document).ready(function () {
        debugger;
        function calculateTotal() {
            var price = parseFloat($("#txtPrice").val()) || 0;
            var qty = parseInt($("#txtQuantity").val()) || 0;

            if (price > 0 && qty > 0) {
                var total = price * qty;
                $("#txtTotal").val(total);
            } else {
                $("#txtTotal").val('');
            }
        }

        // Auto calculate on change
        $("#txtPrice, #txtQuantity").on("keyup change", function () {
            calculateTotal();
        });

        // Validation on save button click
        $("#BtnSaveBill").click(function (e) {

            var price = $("#txtPrice").val();
            var qty = $("#txtQuantity").val();

            if (price == "" || parseFloat(price) <= 0) {
                alert("Please enter valid Price");
                $("#txtPrice").focus();
                return false;
            }

            if (qty == "" || parseInt(qty) <= 0) {
                alert("Please enter valid Quantity");
                $("#txtQuantity").focus();
                return false;
            }

            if ($("#txtTotal").val() == "" || parseFloat($("#txtTotal").val()) <= 0) {
                alert("Total is invalid");
                return false;
            }
        });

        // Only numbers allow
        $("#txtPrice, #txtQuantity").on("keypress", function (e) {
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }
        });

    });

    //quanity value by default 1 set
    $(document).ready(function () {
        if ($("#txtQuantity").val() === "" || $("#txtQuantity").val() === "0") {
            $("#txtQuantity").val(1);
        }
    });

