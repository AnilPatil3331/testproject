            <script>
             if ($('#timeSlotsContainer').is(':empty')) {
                    debugger;
                    // Set the height of .time-slot to 234px if the container is empty
                    $('.time-slot').css('height', '234px');
                }

                //==================================Show Time Slote===============================================
                var timeSloteValue = @(Html.Raw(Json.Encode(ViewBag.timeSlote)));
                debugger;
                if (timeSloteValue != null) {
                    debugger;
                    var timeSlote = @(Html.Raw(Json.Encode(ViewBag.DoctorSlote)));
                    var targetStartTime = "@(ViewBag.targetStartTime)";  // Ensure this is a valid string value
                    var targetEndTime = "@(ViewBag.targetEndTime)";
                    let timeSlotHtml = '';
                    $('#noSlotsMessage').hide(); // Hide the "No time slots found" message
                    $('.time-slot').css('height', 'auto');
                    // Loop through each item in the timeSlote array
                    $.each(timeSlote, function (i, item) {
                        let slotStartTime = "";
                        let slotEndTime = "";

                        // Loop through the properties of each time slot (assuming item is a dictionary or object)
                        $.each(item, function (index, pair) {
                            if (pair.Key === "SlotStartTime") {
                                slotStartTime = pair.Value;
                            } else if (pair.Key === "SlotEndTime") {
                                slotEndTime = pair.Value;
                            }
                        });

                        // Add the time slot HTML structure dynamically
                        timeSlotHtml += `
<div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 TimeDiv"
     style="margin-bottom: 15px;"
     id="slot_${slotStartTime.replace(':','')}">

<span class="badge badge-custom mr-2 mb-2 cursor-pointer badge-outline-primary time-slot-badge"
      data-slot-start="${slotStartTime}"
      data-slot-end="${slotEndTime}">

${slotStartTime} - ${slotEndTime}

</span>
</div>`;
                    });
                    timeSlotHtml = `<div class="row d-flex justify-content-start flex-wrap mb-3">${timeSlotHtml}</div>`;
                    $('#timeSlotContainer').html(timeSlotHtml);

                    // Insert the generated time slots into the container
                    if (timeSlotHtml) {
                        $('#timeSlotsContainer').html(timeSlotHtml);
                    } else {
                        $('#noSlotsMessage').show();
                        $('#timeSlotsContainer').html('');
                    }
                    $('.time-slot-badge').each(function () {
                        var slotStartTime = $(this).data('slot-start');
                        var slotEndTime = $(this).data('slot-end');

                        // Compare the times with target start and end time
                        if (slotStartTime === targetStartTime && slotEndTime === targetEndTime) {
                            debugger;
                            // Remove highlight from all badges
                            $('.badge').removeClass('highlight');

                            // Highlight the matching badge
                            $(this).addClass('highlight');
                            $('#selectedStartTime').val(slotStartTime);  // Assuming there's a hidden input for start time
                            $('#selectedEndTime').val(slotEndTime);
                        }
                    });
                }



