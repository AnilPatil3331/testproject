    function GenereteBillTable(GenerateBill)
    {
        GenerateBill = GenerateBill || [];
        var tableBody = $("#tblGenerateBill tbody");

        // Clear any existing rows
        tableBody.empty();

        // Check if data exists
        if (GenerateBill.length > 0) {
            // Iterate through the prescription list and append rows
            var TotalAmount = 0; // Initialize TotalAmount
            var Count = 1;
            $.each(GenerateBill, function (i, item) {
                var row = "";
                var ServiceName = "";
                var MedicineName = "";
                var Price = "";
                var Quantity = "";
                var Total = "";
                var Bill_Fid = "";
                var Bill_Fid_Encrapted = "";
                var EncounterFid="";

                // Iterate over key-value pairs in the item
                $.each(item, function (index, pair) {
                    if (pair.Key === "Bill_Fid_Encrapted") {
                        Bill_Fid_Encrapted = pair.Value;
                    }
                    if (pair.Key === "Bill_Fid") {
                        Bill_Fid = pair.Value;
                    }
                    if (pair.Key === "ServiceName") {
                        ServiceName = pair.Value;
                    }
                    if (pair.Key === "MedicineName") {
                        MedicineName = pair.Value;
                    }
                    if (pair.Key === "Price") {
                        Price = pair.Value;
                    }
                    if (pair.Key === "Quantity") {
                        Quantity = pair.Value;
                    }
                    if (pair.Key === "Total") {
                        //Total = pair.Value;
                        Total = parseFloat(pair.Value) || 0; // Ensure Total is parsed as a number
                        TotalAmount += Total;
                    }
                    if (pair.Key === "EncounterFid") {
                        EncounterFid = pair.Value;
                    }

                });
                $("#txtFinalTotal").val(TotalAmount.toFixed(2));
                $("#txtFinalPaybalAmount").val(TotalAmount.toFixed(2));
                $("#txtAmount").val(TotalAmount);
                Count++;
                // Construct the row dynamically
                row = `
                <tr class ="animated fadeInUp">

                <td>${Count}</td>
                              <td class="fixed-width">
        <span>${MedicineName && MedicineName.trim() !== "" ? MedicineName : ServiceName}</span>
    </td>
                     <td>${Price}</td>
                     <td>${Quantity}</td>
                     <td>${Total}</td>
                    <td>
                        <div role="group" class="btn-group btn-group-sm">
                              <button title="Edit" type="button" class ="btn btn-sm btn-outline-primary" onclick="UpdateBill('${Bill_Fid_Encrapted}')">
                                 <i class ="fa fa-pen-alt"></i>
                            </button>
                            <button title="Delete" type="button" class="btn btn-outline-danger" onclick="DeleteBill('${Bill_Fid_Encrapted}','${AppointmentFid}')">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>`;

                // Append the row to the table body
                tableBody.append(row);
            });
        } else {
            // Show "No prescription found" if no data exists
            var noDataRow = `
            <tr>
                <td colspan="4" class="text-center text-primary">
                    <h4>No records found</h4>
                </td>
            </tr>`;
            tableBody.append(noDataRow);
        }
    }

    function DeleteBill(Bill_Fid_Encrapted,AppointmentFid) {
        Swal.fire({
            title: 'Are You Sure!',
            text: "Are you absolutely sure about this?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#f44336',
            cancelButtonColor: '#4caf50',
            confirmButtonText: 'Yes, go ahead!',
            cancelButtonText: 'No, cancel!',
            customClass: {
                popup: 'fullscreen-popup',
            },
        }).then((result) => {
            if (result.isConfirmed) {
                // Perform the desired action
                $.ajax({
                    type: 'GET',
                    dataType: 'JSON',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteBill", "Encounter")',
                    data: { Bill_Fid_Encrapted: Bill_Fid_Encrapted,AppointmentFid:AppointmentFid },
                    success: function (data) {
                        debugger;
                        if (data != null) {
                            debugger

                            var GenerateBill = data.GenerateBill || []; // Use null-coalescing operator for safety

                            GenereteBillTable(GenerateBill);      // Bind Table  by function

                        }
                    }

                })
            }
        });

    }
</script>


