    }

    /* For smaller screens (Mobile and Tablet) */
    @@media (max-width: 767px) {
        .TimeDiv {
            flex: 1 0 48%; /* 2 items per row (48% is approximately 1/2) */
            max-width: 48%; /* Adjusted to fit 2 items per row */
