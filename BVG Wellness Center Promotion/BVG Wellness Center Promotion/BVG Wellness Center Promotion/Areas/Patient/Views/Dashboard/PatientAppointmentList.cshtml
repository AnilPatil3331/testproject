            prevButton.classList.toggle('disabled', currentPage <= 1);
            nextButton.classList.toggle('disabled', currentPage >= Math.ceil(rows.length / rowsPerPage));
        }

        // Event listener for Rows per Page change
        rowsPerPageSelect.addEventListener('change', function () {
            rowsPerPage = parseInt(this.value, 10);
            currentPage = 1; // Reset to the first page
            updateTable();
        });

        // Event listener for Prev button
        prevButton.addEventListener('click', function () {
            if (currentPage > 1) {
                currentPage--;
                updateTable();
            }
        });

        // Event listener for Next button
        nextButton.addEventListener('click', function () {
            if (currentPage < Math.ceil(rows.length / rowsPerPage)) {
                currentPage++;
                updateTable();
            }
        });

        // Initial call to display the table correctly
        updateTable();

        //Filter By upcoming ,past,all
        const badges = document.querySelectorAll('.badge');

        badges.forEach(badge => {
            badge.addEventListener('click', function () {
                debugger;
                const filterType = this.getAttribute('data-filter');
                filterTableByDate(filterType);
            });
        });

        function filterTableByDate(filterType) {
            const today = new Date();
            // Normalize today's date to midnight (00:00:00) for comparison
            today.setHours(0, 0, 0, 0);
            const yesterday = new Date(today);
            yesterday.setDate(today.getDate() - 1); // Subtract 1 day to get yesterday's date
            yesterday.setHours(0, 0, 0, 0); // Normalize yesterday to midnight


            const columnIndex = 3; // The index of the date column (zero-based)

            rows.forEach(row => {
                const dateCell = row.children[columnIndex]; // Get the cell at the specified column index
                if (!dateCell) return; // Skip rows without the specified column

                const dateText = dateCell.textContent.trim(); // Get the text content of the cell
                const rowDate = new Date(dateText); // Parse the text into a Date object

                // Normalize the row date to midnight for comparison
                rowDate.setHours(0, 0, 0, 0);

                let showRow = false;

                if (filterType === 'all') {
                    showRow = true; // Show all rows
                } else if (filterType === 'upcoming') {
                    debugger;
                    if( rowDate >= today){
                        showRow =true;
                    }

                } else if (filterType === 'past') {
                    debugger;
                    if( rowDate.getTime() === yesterday.getTime()){
                        showRow = true;
                    }

                }

                row.style.display = showRow ? '' : 'none'; // Show or hide the row
            });
        }
    });

</script>*@

