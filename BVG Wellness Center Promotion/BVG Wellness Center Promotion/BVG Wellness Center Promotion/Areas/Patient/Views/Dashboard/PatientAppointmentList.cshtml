<style>
    #noSlotsMessage {
        text-align: center; /* Horizontally centers the text */
        display: block; /* Ensure the element behaves as a block element */
    }

    .badge-custom {
        padding: 8px 14px !important;
        font-size: 80% !important;
        font-weight: 100 !important;
    }

    #timeSlotsContainer {
        display: flex;
        flex-wrap: wrap;
        gap: 15px; /* Adjust the gap between items */
        max-height: 500px !important; /* Adjust the height to your preference */
        padding-bottom: 20px; /* To avoid content being hidden under the scrollbar */
    }

    .time-slot {
        overflow-x: auto;
        overflow-y: auto;
    }

    .TimeDiv {
        flex: 1 0 32%; /* 3 items per row (32% is approximately 1/3) */
