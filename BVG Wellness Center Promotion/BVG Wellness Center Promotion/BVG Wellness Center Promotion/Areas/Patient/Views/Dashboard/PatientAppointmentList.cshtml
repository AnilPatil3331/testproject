        window.location.href = url;
    }
    $("#ClosePatientDetailsModel").click(function () {
        debugger;
        // Correct the URL assignment
        const modalOuter = $("#appointment-details-modal");
        modalOuter.css("display", "none").attr("aria-hidden", "true");
        var Url = '@Url.Action("PatientAppointmentList", "Dashboard")';
        window.location.href = Url;
    });

