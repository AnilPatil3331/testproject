<style>
    @@media (max-width: 767.98px) {
        .row {
            margin-top: 0px;
        }
    }

    #tblAppointment {
        border: none !important;
        width: 100% !important;
    }

        #tblAppointment th,
        #tblAppointment td {
            border: none !important; /* Remove the cell borders */
        }

    #appointmentsChart {
        width: 100%;
        max-width: 100%;
        height: 300px;
        overflow: hidden; /* Prevent overflow */
    }

    /* Animation for dashboard stats cards */
    .dashboard-card-animate {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: none !important;
        border-radius: 0.5rem !important;
    }
    .dashboard-card-animate:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.12) !important;
    }
    
    /* Entrance animation for cards */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translate3d(0, 20px, 0);
            -webkit-transform: translate3d(0, 20px, 0);
        }
        to {
            opacity: 1;
            transform: translate3d(0, 0, 0);
            -webkit-transform: translate3d(0, 0, 0);
        }
    }
    .card-animate-delay-1 { animation: fadeInUp 0.4s both; }
    .card-animate-delay-2 { animation: fadeInUp 0.5s both; }
    .card-animate-delay-3 { animation: fadeInUp 0.6s both; }
    .card-animate-delay-4 { animation: fadeInUp 0.7s both; }
    .card-animate-delay-5 { animation: fadeInUp 0.8s both; }

    /* Custom styles for tables and elements */
    .appointment-row {
        transition: background-color 0.2s ease;
    }
    .appointment-row:hover {
        background-color: #f8f9fa;
    }

    /* Beautiful slim scrollbar for table container */
    .card-body::-webkit-scrollbar {
        width: 6px;
    }
    .card-body::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }
    .card-body::-webkit-scrollbar-thumb {
        background: #cfd4da;
        border-radius: 4px;
    }
    .card-body::-webkit-scrollbar-thumb:hover {
        background: #b1b5ba;
    }

    /* Badge pulse animation */
    @@keyframes pulseSubtle {
        0% {
            transform: scale(1);
            box-shadow: 0 2px 4px rgba(94, 114, 228, 0.4);
        }
        50% {
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(94, 114, 228, 0.6);
        }
        100% {
            transform: scale(1);
            box-shadow: 0 2px 4px rgba(94, 114, 228, 0.4);
        }
    }
    .animate-pulse-subtle {
        animation: pulseSubtle 2s infinite ease-in-out;
    }
</style>

