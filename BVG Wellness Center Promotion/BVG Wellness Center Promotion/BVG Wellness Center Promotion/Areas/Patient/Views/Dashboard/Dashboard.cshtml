                        </div>
                        <span class="font-weight-bold mb-0 text-dark" style="font-size: 1.25rem; white-space: nowrap; display: flex; align-items: center; overflow: hidden; text-overflow: ellipsis;" title="Total Revenue">
                            <i class="fa fa-rupee-sign" style="font-size: 1rem; margin-right: 5px;"></i> 
                            <span id="totalRevenueAmount" style="display: none;">@ViewBag.TotalRevenue/-</span>
                            <span id="totalRevenueHidden">******</span>
                            <i class="fas fa-eye text-primary" id="toggleRevenueBtn" style="font-size: 1rem; margin-left: 10px; cursor: pointer;" onclick="toggleRevenueVisibility()" title="Show/Hide Revenue"></i>
                        </span>
                        <script>
                            function toggleRevenueVisibility() {
                                var amount = document.getElementById('totalRevenueAmount');
                                var hidden = document.getElementById('totalRevenueHidden');
                                var icon = document.getElementById('toggleRevenueBtn');
                                
                                if (amount.style.display === 'none') {
                                    amount.style.display = 'inline';
                                    hidden.style.display = 'none';
                                    icon.classList.remove('fa-eye');
                                    icon.classList.add('fa-eye-slash');
                                } else {
                                    amount.style.display = 'none';
                                    hidden.style.display = 'inline';
                                    icon.classList.remove('fa-eye-slash');
                                    icon.classList.add('fa-eye');
                                }
                            }
                        </script>
                    </div>
                    <div class="col-auto" style="padding-left: 0; padding-right: 0; flex-shrink: 0;">
                        <div class="icon icon-shape bg-gradient-info text-white rounded-circle shadow">
                            <i class="fas fa-money-check-alt"></i>
                        </div>
                    </div>
