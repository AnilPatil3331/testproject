        })
         .then((willDelete) => {
             if (willDelete) {
        var url = '@Url.Action("CancelAppointment", "Dashboard")' + '?AppointmentFid_Encrypted=' + AppointmentFid_Encrypted;
        window.location.href = url;
      }
    });
               }
