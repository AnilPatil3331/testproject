<script>
   

    function initializeChart() {
        debugger;
        var appointmentCounts = @Html.Raw(Json.Encode(ViewBag.getWeeklyAppointCount)) || [];  
        var categories = @Html.Raw(Json.Encode(ViewBag.categories)) || [];  
       
        if (!Array.isArray(appointmentCounts)) {
            appointmentCounts = [];
        }
        if (!Array.isArray(categories)) {
            categories = [];
        }

        renderAppointmentsChart(appointmentCounts, categories);
    }

    var chart; // Global chart variable

    function renderAppointmentsChart(appointmentCounts, categories) {
        let chartContainer = document.querySelector("#appointmentsChart");    

        var options = {
            chart: {
                type: 'bar',
                height: 235,
                toolbar: {
                    show: true,
                    autoSelected: 'zoom',
                    tools: {
                        download: false,
                        selection: false,
                        zoom: true,
                        zoomin: true,
                        zoomout: true,
                        pan: false,
                        reset: true
                    }
                },
                zoom: {
                    enabled: true,
                    type: 'x'
                },
                fontFamily: 'Open Sans, sans-serif',
                animations: {
                    enabled: true,
                    easing: 'easeinout',
                    speed: 1000,
                    animateGradually: {
                        enabled: true,
                        delay: 150
                    },
                    dynamicAnimation: {
                        enabled: true,
                        speed: 350
                    }
                }
            },
            plotOptions: {
                bar: {
                    horizontal: false,
                    columnWidth: '35%',
                    borderRadius: 6,
                    dataLabels: {
                        position: 'top'
                    }
                }
            },
            dataLabels: {
                enabled: true,
                formatter: function (val) {
                    return val > 0 ? val : '';
                },
                offsetY: -20,
                style: {
                    fontSize: '11px',
                    fontWeight: 'bold',
                    colors: ["#32325d"]
                }
            },
            stroke: {
                show: true,
                width: 2,
                colors: ['transparent']
            },
            series: [{
                name: 'Appointments',
                data: appointmentCounts
            }],
            xaxis: {
                categories: categories,
                labels: {
                    style: {
                        colors: '#8898aa',
                        fontSize: '12px',
                        fontWeight: 500
                    }
                },
                axisBorder: {
                    show: false
                },
                axisTicks: {
                    show: false
                }
            },
            yaxis: {
                title: {
                    text: "Appointments Count (@ViewBag.WeeklyTotalAppointments)",
                    style: {
                        color: '#32325d',
                        fontSize: '13px',
                        fontWeight: 600
                    }
                },
                labels: {
                    style: {
                        colors: '#8898aa',
                        fontSize: '12px'
                    },
                    formatter: function (value) {
                        return Math.round(value);
                    }
                }
            },
            fill: {
                type: 'gradient',
                gradient: {
                    shade: 'light',
                    type: "vertical",
                    shadeIntensity: 0.25,
                    gradientToColors: undefined,
                    inverseColors: true,
                    opacityFrom: 0.85,
                    opacityTo: 0.85,
                    stops: [50, 0, 100]
                }
            },
            grid: {
                borderColor: '#e9ecef',
                strokeDashArray: 4,
                padding: {
                    right: 20,
                    left: 20
                }
            },
            colors: ['#5e72e4'],
            tooltip: {
                theme: 'light',
                y: {
                    formatter: function (val) {
                        return val + " Appointments"
                    }
                }
            }
        };

        try {
            chart = new ApexCharts(chartContainer, options);
            chart.render();           
        } catch (error) {
            console.error("Error rendering chart:", error);
        }
    }

    var currentColumnWidthPercent = 35;
    function zoomColumns(direction) {
        if (direction === 'in') {
            currentColumnWidthPercent = Math.min(65, currentColumnWidthPercent + 10);
        } else {
            currentColumnWidthPercent = Math.max(10, currentColumnWidthPercent - 10);
        }
        if (chart) {
            chart.updateOptions({
                plotOptions: {
                    bar: {
                        columnWidth: currentColumnWidthPercent + '%'
                    }
                }
            });
        }
    }

</script>
