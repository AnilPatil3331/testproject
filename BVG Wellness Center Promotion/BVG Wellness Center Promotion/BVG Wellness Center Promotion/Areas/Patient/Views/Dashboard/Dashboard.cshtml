function CloseAppointmentStatus(AppointmentFid_Encrypted, AppointmentFid) {

    Swal.fire({
        title: "Process Checkout?",
        text: "Do you want to verify billing and proceed with checkout?",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Yes, Verify",
        cancelButtonText: "No"
    }).then((initialResult) => {

        if (initialResult.isConfirmed) {

            Swal.fire({
                title: 'Verifying Payments...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '@Url.Action("GetBillSummary", "BillingRecord", new { area = "Patient" })',
                type: 'GET',
                data: { AppointmentFid: AppointmentFid },
                success: function (res) {
                    Swal.close();

                    if (!res.success) {
                        Swal.fire("Error", res.message, "error");
                        return;
                    }

                    let html = "";
                    let validBillsCount = 0;

                    res.BillSummary.forEach(item => {
                        let status = item.Status ? item.Status.toLowerCase().trim() : "";

                        if (!status || status === "" || status === "unknown") {
                            return;
                        }

                        validBillsCount++;

                        if (status === "paid") {
                            html += `${item.BillName}: <b style="color:green;">Paid \u2705</b><br>`;
                        } else if (status === "unpaid") {
                            html += `${item.BillName}: <b style="color:red;">Unpaid \u274C</b><br>`;
                        } else if (status === "outstanding") {
                            html += `${item.BillName}: <b style="color:orange;">Outstanding \u26A0</b><br>`;
                        } else if (status === "notgenerated") {
                            html += `${item.BillName}: <b style="color:red;">Bill Not Generated \u274C</b><br>`;
                        }
                    });

                    if (validBillsCount === 0) {
                        html = "<i>No billing records found for this appointment.</i><br>";
                    }

                    if (res.hasPrescriptionWithoutBill) {
                        html += `<br><button type="button" class="btn btn-warning btn-sm mt-2" onclick="generateDispensingBill(${AppointmentFid}, '${AppointmentFid_Encrypted}')"><i class="fa fa-cogs"></i> Generate Dispensing Bill</button><br>`;
                    }

                    // 🔥 ALWAYS allow checkout (no blocking condition)
                    Swal.fire({
                        title: "Billing Details",
                        html: html + "<br><br><b>You can proceed with checkout.</b>",
                        icon: "info",
                        showCancelButton: true,
                        confirmButtonText: "Checkout",   // 🔥 always available
                        cancelButtonText: "OK",          // close only
                        confirmButtonColor: "#28a745",
                        cancelButtonColor: "#6c757d"
                    }).then((result) => {

                        if (result.isConfirmed) {
                            var url = '@Url.Action("CloseAppointmentStatus", "Dashboard")'
                                + '?AppointmentFid_Encrypted=' + encodeURIComponent(AppointmentFid_Encrypted)
                                + '&AppointmentFid=' + encodeURIComponent(AppointmentFid);

                            window.location.href = url;
                        }

                        // OK click → do nothing
                    });

                },
                error: function () {
                    Swal.close();
                    Swal.fire("Error", "Could not connect to billing server.", "error");
                }
            });
        }
    });
}

