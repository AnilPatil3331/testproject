<script>
    $(document).ready(function(){
        debugger
        $("#MedicineRevenue").select2();
        initializeChart();
        var totalRevenue=@Html.Raw(Json.Encode(ViewBag.TotalRevenue));
        renderTotalRevenueChart(totalRevenue);
      
    });
    var TotalMedicineRevanue=@Html.Raw(Json.Encode(ViewBag.TotalMedicineRevenue));
    renderTotalMedicineRevenueChart(TotalMedicineRevanue,"All Medicine");


    $("#MedicineRevenue").change(function(){
        var MedicineID=$("#MedicineRevenue").val();
        $.ajax({
            type: 'GET',
            dataType: 'JSON',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetMedicineTotalRevanue", "Reports")',
            data: { MedicineID: MedicineID},
            success: function (data) {
                debugger;
                var GetMedicineRevenue = data.TotalMedicineRevenue[0].Value;
                var GetMedicineName = data.GetMedicineName[0].Value;
                renderTotalMedicineRevenueChart(GetMedicineRevenue,GetMedicineName);
            }
        })
    });
    function initializeChart() {
        debugger;
        var MonthYear = @Html.Raw(Json.Encode(ViewBag.MonthYear));
        var TotalAmount = @Html.Raw(Json.Encode(ViewBag.TotalAmount));

        renderAppointmentsChart(TotalAmount, MonthYear);
    }

    var chart; // Global chart variable

    function renderAppointmentsChart(TotalAmount, MonthYear) {
        debugger

        let chartContainer = document.querySelector("#ClinicRevenueDetail");
        var GetClinicName=@Html.Raw(Json.Encode(ViewBag.ClinicName));

        var options = {
            chart: {
                type: 'bar',
                height: 320
            },
            series: [{
                name: 'Total amount',
                data: TotalAmount
            }],
            xaxis: {
                categories: MonthYear,
                type: 'Month',
                title: {
                    text: GetClinicName
                },
                labels: {
                    style: {
                        colors: '#333',
                        fontSize: '10px'
                    }
                },
                scrollbar: {
                    enabled: true // 🔹 Enable scrollbar when overflow
                },
                tickPlacement: 'on'
            },
            yaxis: {              
                labels: {
                    formatter: function (value) {
                        return value.toFixed(0);
                    }
                }
            },
            stroke: {
                width: 2,
                curve: 'smooth'
            },
            markers: {
                size: 5,
                colors: ['#FF4560']
            },
            colors: ['#008FFB']
        };

        try {
            chart = new ApexCharts(chartContainer, options);
            chart.render();
        } catch (error) {
            console.error("Error rendering chart:", error);
            alert("Error rendering chart: " + error);
        }
    }

    function renderTotalRevenueChart(totalRevenue) {
        debugger;
        let chartContainer = document.querySelector("#TotalClinicRevenueChart");
        if (totalRevenue === null || totalRevenue === undefined || totalRevenue === '') {
            console.warn("Total revenue data not found:", totalRevenue);
            chartContainer.innerHTML = "<div style='color: red; font-size: 16px; text-align: center;'>Data Not Found</div>";
            return;
        }

        var options = {
            chart: {
                type: 'radialBar',
                height: 350
            },
            series: [totalRevenue],  // Total revenue as single value
            labels: ['Total Revenue'],
            colors: ['#00E396'],
            plotOptions: {
                radialBar: {
                    dataLabels: {
                        name: {
                            fontSize: '22px'
                        },
                        value: {
                            fontSize: '16px',
                            formatter: function (value) {
                                return "₹" + value.toFixed(2);
                            }
                        }
                    }
                }
            }
        };

        try {
            var chart = new ApexCharts(chartContainer, options);
            chart.render();
        } catch (error) {
            console.error("Error rendering total revenue chart:", error);
            alert("Error rendering chart: " + error);
        }
    }


    function renderTotalMedicineRevenueChart(totalRevenue,medicineName) {
        debugger;
        let chartContainer = document.querySelector("#MedicineRevenueChart");
       
        if (totalRevenue === null || totalRevenue === undefined || totalRevenue === '') {
            console.warn("Total revenue data not found:", totalRevenue);
            chartContainer.innerHTML = "<div style='color: red; font-size: 16px; text-align: center;'>Data Not Found</div>";
            return;
        }

        var options = {
            chart: {
                type: 'radialBar',
                height: 350
            },
            series: [totalRevenue],  // Total revenue as single value
            labels: ['Total Revenue'],  // Show medicine name in label
            colors: ['#008FFB'],
            plotOptions: {
                radialBar: {
                    dataLabels: {
                        name: {
                            fontSize: '22px'
                        },
                        value: {
                            fontSize: '16px',
                            formatter: function (value) {
                                return "₹" + value.toFixed(2);
                            }
                        }
                    }
                }
            },
            tooltip: {
                enabled: true,
                y: {
                    formatter: function (val) {
                        return medicineName + " Revenue: ₹" + val.toFixed(2); // Medicine name + revenue on hover
                    }
                }
            }
        };

        try {
            var chart = new ApexCharts(chartContainer, options);
            chart.render();
        } catch (error) {
            console.error("Error rendering total revenue chart:", error);
            alert("Error rendering chart: " + error);
        }
    }
</script>

