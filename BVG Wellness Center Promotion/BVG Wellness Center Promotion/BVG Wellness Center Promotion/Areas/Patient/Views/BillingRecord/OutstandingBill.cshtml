<script>
    $("#FilterDate").on("change", function () {

        let selectedDate = $(this).val(); // yyyy-MM-dd

        if (!selectedDate) {
            $("#tblBillingRecords tbody tr").show();
            return;
        }

        $("#tblBillingRecords tbody tr").each(function () {

            // 👉 DATE COLUMN = LAST COLUMN (correct index = 8)
            let rowText = $(this).find("td").eq(8).text().trim();

            // remove time if exists
            let clean = rowText.split(" ")[0];

            // convert 27/03/2026 → 2026-03-27
            let p = clean.split("/");

            if (p.length !== 3) return;

            let rowDate = p[2] + "-" + p[1] + "-" + p[0];

            if (rowDate === selectedDate) {
                $(this).show();
            } else {
                $(this).hide();
            }

        });

    });
</script>
