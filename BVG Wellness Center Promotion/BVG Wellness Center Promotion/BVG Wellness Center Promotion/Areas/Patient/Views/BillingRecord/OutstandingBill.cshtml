                                            *
                                        </span>

                                    </label>
                                    <div>
                                        <div role="group" class="input-group input-group-md">
                                            <div class="input-group-prepend">
                                                <div class="input-group-text">
                                                    Rs
                                                </div>
                                            </div>
                                            @Html.TextBoxFor(m => m.TotalPaid, new { @class = "form-control", type = "number", id = "TotalPaid", placeholder = "Enter discount", autocomplete = "off", @readonly = "readonly" })


