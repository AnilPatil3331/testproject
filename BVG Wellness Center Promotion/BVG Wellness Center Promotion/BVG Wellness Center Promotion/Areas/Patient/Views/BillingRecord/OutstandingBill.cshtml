                    <h2 class="text-primary w-100 text-center">
                        Generate invoice
                    </h2>
                    <button type="button" aria-label="Close" class="close" id="Closemodel">
                        ×
                    </button>
                </header>
                <div id="bill-modal___BV_modal_body_" class="modal-body pt-0">
                    <form id="patientBillDataForm" novalidate="novalidate">
                        @Html.HiddenFor(m => m.AppointmentFid, new { id = "txtAppointmentFid" })
                        @Html.HiddenFor(m => m.PatientFid, new { id = "txtPatientFid" })
                        @Html.HiddenFor(m => m.EncounterFid, new { id = "txtEncounterFid" })
                        @Html.HiddenFor(m => m.Bill_Fid, new { id = "Id" })
                        @*@Html.HiddenFor(m => m.finalAmount, new { id = "txtFinalTotal" })*@
                        @Html.HiddenFor(m => m.FinalPaybalAmount, new { id = "txtFinalPaybalAmount" })
                        @Html.HiddenFor(m => m.Discount, new { id = "txtDiscount" })


                        <hr class="my-4">
                        <div class="row">
                            <div class="col-md-4 col-sm-12">
                                <div class="form-group">
                                    <label for="total_amount" class="form-control-label">
                                        Total
                                        <span class="text-danger">
                                            *
                                        </span>
                                    </label>
                                    <div>
                                        <div role="group" class="input-group input-group-md">
                                            <div class="input-group-prepend">
                                                <div class="input-group-text">
                                                    Rs
                                                </div>
                                            </div>
                                            @Html.TextBoxFor(m => m.finalAmount, new { @class = "form-control", id = "txtFinalTotal", placeholder = "Total Amount", autocomplete = "off", @readonly = "readonly" })

                                            <div class="input-group-append">
                                                <div class="input-group-text">
                                                    /-
                                                </div>
                                            </div>
                                        </div>
                                        <!---->
                                    </div>
                                </div>
                            </div>
                            <!---->
