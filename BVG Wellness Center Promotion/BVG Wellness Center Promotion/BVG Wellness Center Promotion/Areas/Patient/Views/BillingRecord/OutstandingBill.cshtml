            //$("#").val(totalPayableAmount.toFixed(2));

            // set Total + Remaining


            // Reset dynamic rows container
            $("#paymentRowsContainer").find(".payment-row").not(":first").remove();

            // If previous payment exists, refill
            var FinalBills = data.GetFinalbillDetails || [];
            if (FinalBills.length > 0) {
                let usedAmount = 0;
                let count = 1;

                $.each(FinalBills, function (i, item) {
                    function getVal(key) {
                        let f = item.find(obj => obj.Key === key);
                        return f ? f.Value : "";
                    }

                    let pMode = getVal("PaymentMode");
                    let pRef = getVal("PaymentReferenceNumber");
                    let amt = parseFloat(getVal("Amount")) || 0;

                    if (count === 1) {
                        $("#ddlPaymentType").val(pMode);
                        $("#txtReference").val(pRef);
                        $("#txtAmount").val(amt);
                    } else {
                        addPaymentRow(pMode, pRef, amt);
                    }
                    usedAmount += amt;
                    count++;
                });

                let remaining = TotalAmount - usedAmount;
                $("#RemainingAmount").val(remaining.toFixed(2));
            }

            $("#bill-modal___BV_modal_outer_").show().addClass("show");
        }
    });
}

