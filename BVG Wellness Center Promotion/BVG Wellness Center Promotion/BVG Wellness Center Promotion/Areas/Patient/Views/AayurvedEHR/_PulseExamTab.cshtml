                                                            <div class="col-md-4 mb-2">
                                                                @Html.CheckBoxFor(m => m.PittaVatKaf, new { @id = "पित्तवातकफPVK", @class = "form-check-input" })
                                                                <label class="form-check-label" for="पित्तवातकफPVK">पित्तवातकफ PVK</label>
