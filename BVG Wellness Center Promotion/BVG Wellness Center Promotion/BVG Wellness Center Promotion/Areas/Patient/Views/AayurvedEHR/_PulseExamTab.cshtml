                                                                <label class="form-check-label" for="हरीMonkey">हरी Monkey</label>
                                                            </div>
                                                            <div class="col-md-4 mb-2">
                                                                @Html.CheckBoxFor(m => m.Frog, new { @id = "भेकमण्डूकFrog", @class = "form-check-input" })
