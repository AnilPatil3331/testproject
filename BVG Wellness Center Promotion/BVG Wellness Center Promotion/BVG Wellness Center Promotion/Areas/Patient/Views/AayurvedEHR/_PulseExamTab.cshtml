                                                        <!-- Row 4 -->
                                                        <div class="row">
                                                            <div class="col-md-4 mb-2">
                                                                @Html.CheckBoxFor(m => m.Sparrow, new { @id = "कुलिंगSparrow", @class = "form-check-input" })
                                                                <label class="form-check-label" for="कुलिंगSparrow">कुलिंग Sparrow</label>
