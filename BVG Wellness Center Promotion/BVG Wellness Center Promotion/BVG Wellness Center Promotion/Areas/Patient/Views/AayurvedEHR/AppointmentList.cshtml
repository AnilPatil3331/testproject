@{
    ViewBag.Title = "Appointment History";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
    var patient = ViewBag.PatientInfo;
    var appointments = ViewBag.AppointmentList as IEnumerable<dynamic>;
}


<div style="margin-left: 115px; padding: 0px;">

    <!-- Patient Info Card -->
    @if (patient != null)
    {
        <div class="card shadow mb-3">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0 text-white"><i class="fas fa-user"></i> &nbsp; Patient Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3"><strong>Name:</strong> @patient.PatientFullName</div>
                    <div class="col-md-2"><strong>Age:</strong> @patient.Age</div>
                    <div class="col-md-2"><strong>Gender:</strong> @patient.Gender</div>
                    <div class="col-md-2"><strong>Blood Group:</strong> @patient.BloodGroup</div>
                    <div class="col-md-3"><strong>Mobile:</strong> @patient.ContactNumber</div>
                </div>
            </div>
        </div>
    }

    <!-- Appointment List -->
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-white">
                <i class="fas fa-calendar-alt"></i> &nbsp; All Appointments
                @if (appointments != null)
                {
                    <span class="badge badge-light ml-2">@appointments.Count() Total</span>
                }
            </h5>
            <a href="javascript:history.back();" class="btn btn-sm btn-light">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
        <div class="card-body p-0">
            @if (appointments != null && appointments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm mb-0">
                        <thead class="thead-dark">
                            <tr>
                                <th>#</th>
                                <th>Visit Date</th>
                                <th>Time</th>
                                <th>Doctor</th>
                                <th>Department</th>
                                <th>Clinic</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int sr = 1; }
                            @foreach (var visit in appointments)
                            {
                                <tr style="cursor:pointer;"
                                    onclick="location.href='@Url.Action("PatientHistory", "AayurvedEHR", new { AppoinmentID = visit.AppointmentFid })'">
                                    <td>@sr</td>
                                    <td>
                                        @(visit.AppoinmentDate != null
                                            ? ((DateTime)visit.AppoinmentDate).ToString("dd-MM-yyyy")
                                            : "-")
                                    </td>
                                    <td>@(visit.SloteStartTime ?? "-") - @(visit.SloteEndTime ?? "-")</td>
                                    <td>@(visit.DoctorName ?? "-")</td>
                                    <td>@(visit.DepartmentName ?? "-")</td>
                                    <td>@(visit.ClinicName ?? "-")</td>
                                    <td>
                                        @if (visit.Status == "Completed" || visit.EncounterStatus == "Completed")
                                        {
                                            <span class="badge badge-success">Completed</span>
                                        }
                                        else if (visit.Status == "Check In")
                                        {
                                            <span class="badge badge-warning">Check In</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">@(visit.Status ?? "-")</span>
                                        }
                                    </td>
                                    <td onclick="event.stopPropagation();">
                                        <a href="@Url.Action("PatientHistory", "AayurvedEHR", new { AppoinmentID = visit.AppointmentFid })"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-eye"></i> View EHR
                                        </a>
                                    </td>
                                </tr>
                                sr++;
                            }
                        </tbody>
                    </table>
                </div>
                                }
                                else
                                {
                                    <div class="alert alert-info m-3">
                                        <i class="fas fa-info-circle"></i> No appointments found for this patient.
                                    </div>
                                }
        </div>
    </div>
</div>