<script>
    $(document).ready(function () {
        debugger;
        $("#addBill").click(function () {
            // Toggle the visibility of the bill item add form
            $("#bill-item-add").slideToggle(function () {
                // Change button text based on the updated state of the form
                if ($("#bill-item-add").is(":visible")) {
                    // If the form is visible, change the button text to "Close"
                    $("#addBill").html('<i class="fa fa-times"></i> Close');
                } else {
                    // If the form is hidden, change the button text back to "Add Bill Item"
                    $("#addBill").html('<i class="fa fa-plus"></i> Add Bill Item');
                    $("#txtTotal").val("");
                    $("#txtQuantity").val("");
                    $("#txtPrice").val("");
                    $("#txtServiceName").val("");
                }
            });
        });
        $("#BtnAddRow").click(function () {
            debugger;
            var FinalPaybalAmt = parseFloat($("#txtFinalPaybalAmount").val());
            var PayAmount=parseFloat($("#txtAmount").val());

            var FinalTotal=0;
            var DiffenceAmount=0;
            $(".payment-row").each(function () {
                debugger;
                var amount = $(this).find(".amount").val();
                FinalTotal += parseFloat(amount) || 0;

            });

            DiffenceAmount=FinalPaybalAmt-FinalTotal;


            var newRow = `
        <div class="row payment-row dynamic-row"">
            <div class="col-md-4">
                <label class="form-control-label mt-1">Payment Type</label>
                <select class="form-control custom-select paymentType">
                    <option value="">Select Status</option>
                    <option value="UPI">UPI</option>
                    <option value="Cash">Cash</option>
                    <option value="CreditCard">Credit Card</option>
                    <option value="DebitCard">Debit Card</option>

                </select>
            </div>
            <div class="col-md-4">
                <label class="form-control-label mt-1">Reference</label>
                <input type="text" class="form-control referenceNumber" placeholder="Enter Reference">
            </div>
            <div class="col-md-3">
                <label class="form-control-label mt-1">Amount</label>
                <input type="number" class="form-control amount" placeholder="Enter Amount" value=${DiffenceAmount}>
            </div>
             <div class="col-md-1 mt-3 dynamic-btn">
               <button title="Remove" class="btn btn-sm btn-outline-danger btn-remove-row">
                <i class="fa fa-trash"></i>
            </button>
            </div>
        </div>`;

            // Append new row to container
            $("#paymentRowsContainer").append(newRow);
        });

        $(document).on("click", ".btn-remove-row", function () {
            var FinalPaybalAmt = parseFloat($("#txtFinalPaybalAmount").val());

            $(this).closest(".dynamic-row").remove();
            $("#txtAmount").val(FinalPaybalAmt);
        });
    });
</script>


<script>
    $("#CHKService").change(function () {
        debugger
    
        const serviceck = document.getElementById('CHKService');
        if (serviceck && serviceck.checked) {
            $("#ddlServiceName").find("option").remove();
            var check = "Checked"
            $.ajax({
                type: 'GET',
                dataType: 'JSON',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GetServices", "AayurvedEHR")',
                data: { check: check },
                success: function (data) {
                    debugger;
                    if (data != null) {
                        var Servicedata = data.GetData;
                        $("#ddlServiceName").append("<option value=''>--Select-- </option>");
                        $.each(Servicedata, function (i, p) {
                            $("#ddlServiceName").append("<option value='" + p.Id + "'>" + p.Name + "</option>");
                        });
                    }
                    return false;
                }
            })

            debugger
            document.getElementById('MedicineName').innerHTML = 'Medicine';
        }
    });
</script>






<script>
    $(document).ready(function () {
        $('#searchInput').on('input', function () {
            var query = $(this).val();

            if (query.length >= 2) {
                $.ajax({
                    url: '@Url.Action("SearchOPD", "AayurvedEHR")',
                    type: 'GET',
                    data: { searchTerm: query },
                    success: function (data) {
                        debugger;
                        let html = "";
                        if (data.length > 0) {
                            html += "<ul class='list-group mb-0'>";

                            $.each(data, function (i, item) {
                                html += "<li class='list-group-item list-group-item-action' " + "style='cursor:pointer;' onclick='selectPatient(" + item.AppointmentFid + ")'>";

                                html += "<span>" + item.FullName + " | " + item.ContactNumber + " | " + item.FDate + "</span>";

                                html += "</li>";

                            });

                            html += "</ul>";
                        } else {
                            html = "<div class='p-2 text-muted'>No matches found</div>";
                        }

                        $('#searchResult').html(html).show();
                    },
                    error: function () {
                        $('#searchResult').html('<div class="p-2 text-danger">Error fetching data</div>').show();
                    }
                });
            } else {
                $('#searchResult').hide();
            }
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#searchInput, #searchResult').length) {
                $('#searchResult').hide();
            }
        });
    });

    function selectPatient(appointmentId) {
        window.location.href = '/patient/AayurvedEHR/MedicinePrescription?AppoinmentID=' + appointmentId;
    }
</script>


