                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (ViewBag.PrescriptionList != null)
                                            {
                                                foreach (var item in ViewBag.PrescriptionList)
                                                {
                                            <tr>

                                                <td class="text-wrap">
                                                    @($"{item.FormName} {item.PackageName} {item.NumberLeft} = {item.MixingDetails} = {item.DoseNumber} {item.Dose} {item.TimeName} {item.FluidVehicle}")
                                                </td>

                                                <td class="text-center">
                                                    <input type="checkbox" name="selectedIds" value="@item.PrescriptionID" class="form-check-input" style="transform: scale(1.3);" />
                                                </td>

                                            </tr>
                                                }
                                            }




                                            </tbody>
                                        </table>


                                        </div>


                                        <div class="button-row">
