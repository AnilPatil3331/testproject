            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

    /* CONTAINER */
    .dispensing-container {
        max-height: 600px;
        overflow-y: auto;
        padding-right: 5px;
    }

    /* CARD */
    .medicine-card {
        display: flex;
        gap: 15px;
        padding: 14px;
        margin-bottom: 12px;
        border-radius: 12px;
        background: #fff;
        transition: 0.2s;
        border: 1px solid #eee;
    }

        .medicine-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.08);
        }

        /* TYPES */
        .medicine-card.saved {
            border-left: 5px solid #28a745;
            background: #f6fff8;
        }

        .medicine-card.new {
            border-left: 5px solid #007bff;
            background: #f4f8ff;
        }

    /* BADGE */
    .med-badge {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: bold;
    }

        .med-badge.success {
            background: #28a745;
        }

        .med-badge.primary {
            background: #007bff;
        }

    /* CONTENT */
    .med-content {
        flex: 1;
    }

    .med-title {
        font-size: 13px;
        font-weight: 600;
        color: #555;
    }

    .med-desc {
        font-size: 14px;
        margin-bottom: 8px;
        color: #222;
    }

    .med-sub {
        font-size: 12px;
        font-weight: 600;
        color: #777;
    }

    .med-instruction {
        background: #fff;
        padding: 8px;
        border-radius: 6px;
        border: 1px solid #eee;
        font-size: 13px;
        white-space: pre-line;
    }

    /* NOT SAVED */
    .not-saved {
        display: inline-block;
        margin-top: 8px;
        background: #fff3cd;
        color: #856404;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 12px;
    }

