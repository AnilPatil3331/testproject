<script>

    //// Duration ? only number + max 4 digit
    //$(document).on("input", ".durationField", function () {

    //    this.value = this.value.replace(/[^0-9]/g, '');

    //    if (this.value.length > 3) {
    //        this.value = this.value.slice(0, 3);
    //    }

    //});
    $(document).on("input", ".durationField", function () {

        let input = this;
        let value = input.value;

        // ?? Allow only numbers + decimal
        value = value.replace(/[^0-9.]/g, '');

        // ?? Only one decimal allowed
        let parts = value.split('.');
        if (parts.length > 2) {
            value = parts[0] + '.' + parts[1];
        }

        // ?? Handle "." ? "0."
        if (value === ".") {
            input.value = "0.";
            return;
        }

        parts = value.split('.');

        // ?? Max 4 digits before decimal
        if (parts[0].length > 4) {
            parts[0] = parts[0].slice(0, 4);
        }

        value = parts.join('.');

        // ?? Get same row elements
        let row = $(input).closest(".form-row");
        let unitDropdown = row.find(".durationUnit")[0];
        let errorSpan = row.find(".error-msg")[0];

        let unitText = unitDropdown.options[unitDropdown.selectedIndex].text.toLowerCase();

        let num = parseFloat(value) || 0;
        let max = 999;
        let message = "";

        // ?? Unit wise validation
        let isInvalid = false;

        if (unitText.includes("day") && num > 365) {
            message = "More than 365 days? Select Weeks";
            isInvalid = true;
        }
        else if (unitText.includes("week") && num > 99) {
            message = "More than 99 weeks? Select Months";
            isInvalid = true;
        }
        else if (unitText.includes("month") && num > 99) {
            message = "More than 99 months? Select Years";
            isInvalid = true;
        }
        else if (unitText.includes("year") && num > 120) {
            message = "Maximum 120 years allowed";
            isInvalid = true;
        }

        // ?? Show error (NO auto change)
        if (isInvalid) {

            if (errorSpan) {
                errorSpan.innerText = message;
                errorSpan.style.display = "block";
            }

            input.style.borderColor = "red";

        } else {

            if (errorSpan) errorSpan.style.display = "none";
            input.style.borderColor = "";
        }



        input.value = value;
    });


    // ?? Unit change var pan validation run kara
    $(document).on("change", ".durationUnit", function () {
        let row = $(this).closest(".form-row");
        let input = row.find(".durationField");
        input.trigger("input");
    });
    // PreviousTreatmentOther ? only letters + numbers
    $(document).on("input", ".previousTreatmentText", function () {

        this.value = this.value.replace(/[^a-zA-Z0-9 ]/g, '');

        if (this.value.length > 100) {
            this.value = this.value.slice(0, 100);
        }

    });

</script>

