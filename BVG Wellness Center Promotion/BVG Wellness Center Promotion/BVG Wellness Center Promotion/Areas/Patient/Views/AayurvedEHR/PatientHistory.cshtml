<script>
    var suchanaGrouped = @Html.Raw(Json.Encode(ViewBag.SuchanaGrouped));

    $(document).ready(function () {

        // Populate all dropdowns
        $('.suchanaDropdown').each(function () {

            var formId = $(this).data('formid');
            var $ddl = $(this);

            if (suchanaGrouped[formId]) {
                suchanaGrouped[formId].forEach(function (item) {
                    $ddl.append(
                        $('<option>', {
                            value: item.Fid,
                            text: item.InstructionName
                        })
                    );
                });
            }
        });

        // On change ? fill correct textarea
        $(document).on('change', '.suchanaDropdown', function () {

            var selectedValue = $(this).val();
            var targetId = $(this).data('target');
            var description = "";

            Object.values(suchanaGrouped).forEach(function (list) {
                list.forEach(function (s) {
                    if (s.Fid == selectedValue) {
                        description = s.Description;
                    }
                });
            });

            $('#' + targetId).val(description);
        });
    });
</script>


<script>
    $(document).ready(function () {
        $('.quick-date').on('click', function () {
            let daysToAdd = parseInt($(this).data('days'));
            let today = new Date();

            // Calculate new date
            today.setDate(today.getDate() + daysToAdd);

            // Format date to yyyy-MM-dd
            let formattedDate = today.toISOString().split('T')[0];

            // Set value in textbox
            $('#MedicineDate').val(formattedDate);

            // Button active style
            $('.quick-date').removeClass('btn-primary').addClass('btn-outline-primary');
            $(this).removeClass('btn-outline-primary').addClass('btn-primary');
        });
    });
</script>




