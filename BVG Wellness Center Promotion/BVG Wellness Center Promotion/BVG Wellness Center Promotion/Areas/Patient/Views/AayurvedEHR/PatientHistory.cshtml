                        <b>Service:</b> ${item.ServiceName}<br/>
                        <b>Category:</b> ${item.ServiceCategories}<br/>
                       <b>Days:</b> ${item.DaysNumberText}
                        <b>Frequency:</b> ${item.Frequency}<br/>
                        <b>Patient:</b> ${item.InstructionPatinet}<br/>
                        <b>Therapist:</b> ${item.InstructionTherapist}<br/>

                    </td>

                </tr>
            `);
        });
    }

    function removeRow1(index) {
        debugger
        var item = advisedTherapyList[index];

        // ?? ?? DB ???? record ???? ?? delete call
        if (item.ATId && item.ATId != 0) {

            $.ajax({
                url: '/Patient/AayurvedEHR/DeleteAdvisedTherapy',
                type: 'POST',
                data: { id: item.ATId },
                success: function () {
                    console.log("Deleted from DB");
                }
            });
        }

        advisedTherapyList.splice(index, 1);
        renderTable();

        $('#AdvisedTherapyJson').val(JSON.stringify(advisedTherapyList));
    }

    function editRow1(index, e) {
        if (e) e.preventDefault();

        var item = advisedTherapyList[index];

        $('#ATserviceFid').val(item.ServiceFid);
        $('#ATDaysNumber').val(item.DaysNumberId);

