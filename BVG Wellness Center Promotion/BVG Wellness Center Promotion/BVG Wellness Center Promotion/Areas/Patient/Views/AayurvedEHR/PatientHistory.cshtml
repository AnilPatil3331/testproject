                    //if (pair.Key === "Quantity") Quantity = pair.Value;
                    if (pair.Key.toLowerCase().includes("qty") || pair.Key.toLowerCase().includes("quantity")) {
                        Quantity = pair.Value;
                    }

                    if (pair.Key === "Total") {
                        Total = parseFloat(pair.Value) || 0;
                        TotalAmount += Total;
                    }
                    // Check if your backend sends 'AppointmentFid' or 'EncounterFid'
                    if (pair.Key === "AppointmentFid" || pair.Key === "EncounterFid") {
                        AppointmentFid = pair.Value;
                    }

