            if (this.id === 'Kapha_Other' && this.checked) {
                document.getElementById('KaphaOtherText').disabled = false;
            } else if (this.id === 'Kapha_Pandhara' && this.checked) {
                document.getElementById('KaphaOtherText').disabled = true;
            }

            if (this.id === 'Pitta_Other' && this.checked) {
                document.getElementById('PittaOtherText').disabled = false;
            } else if (this.id === 'Pitta_Pivala' && this.checked) {
                document.getElementById('PittaOtherText').disabled = true;
            }

            if (this.id === 'NaturalStateTongue_OthersTongue' && this.checked) {
                document.getElementById('NaturalStateOtherTongue').disabled = false;
            } else if (this.id === 'NaturalStateTongue_PrakrutSam' && this.checked) {
