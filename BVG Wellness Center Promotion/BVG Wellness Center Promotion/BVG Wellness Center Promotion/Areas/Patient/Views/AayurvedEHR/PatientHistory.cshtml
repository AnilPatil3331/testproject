    $("#txtAmount").on("keypress", function (e) {
        var keyCode = e.which ? e.which : e.keyCode;

        // Allow: 0-9 (48-57) and one dot (46)
        if (!(keyCode >= 48 && keyCode <= 57) && keyCode !== 46) {
            e.preventDefault();
        }

        // Prevent multiple dots
        if (keyCode === 46 && $(this).val().indexOf('.') !== -1) {
            e.preventDefault();
        }
    });

