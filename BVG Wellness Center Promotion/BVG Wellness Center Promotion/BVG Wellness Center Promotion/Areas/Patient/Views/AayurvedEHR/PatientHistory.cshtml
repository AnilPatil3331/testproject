            event.target.style.height = (event.target.scrollHeight) + "px"; // fit content
        }
    });

    // Run once on page load to fit default text
    window.addEventListener("load", function () {
        document.querySelectorAll(".autosize-textarea").forEach(function (el) {
            el.style.height = "auto";
            el.style.height = el.scrollHeight + "px";
        });
    });
</script>


