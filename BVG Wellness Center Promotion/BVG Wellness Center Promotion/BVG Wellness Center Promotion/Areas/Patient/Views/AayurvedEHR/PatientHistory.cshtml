                            <div class="tab-pane p-3" id="Dispensing" role="tabpanel">

                                <!-- Header -->
                                @{
                                    var activePrescriptions = (ViewBag.PrescriptionList as IEnumerable<dynamic>)
                                                              ?.ToList() ?? new List<dynamic>();
                                }



                                @{
                                    var savedDispensing = ViewBag.ResultView as IEnumerable<dynamic>;
                                    var medicineInstructions = ViewBag.MedicineInstructions as IEnumerable<dynamic>;
                                    var processedPrescriptionIds = new HashSet<int>();
                                    int medicineIndex = 1;
                                }

                                <div class="dispensing-container">

                                    @if ((savedDispensing != null && savedDispensing.Any()) || (medicineInstructions != null && medicineInstructions.Any()))
                                    {
                                        <!-- SAVED -->
                                        if (savedDispensing != null)
                                        {
                                            foreach (var savedItem in savedDispensing)
                                            {
                                                processedPrescriptionIds.Add((int)savedItem.PrescriptionID);
                                                var prescription = activePrescriptions
.FirstOrDefault(p => p.PrescriptionID == savedItem.PrescriptionID);
                                                string instructionText = "";
                                                if (prescription != null)
                                                {
                                                    instructionText =
                                                        $"{prescription.FormName} {prescription.PackageName} {prescription.NumberLeft} = {prescription.MixingDetails} = " +
                                                        $"{(prescription.ProcessingNumber ?? "")} {(prescription.ProcessingUnitType ?? "")} {prescription.DoseNumber} {prescription.Dose} {prescription.TimeName} ={prescription.MixingDetailsFluid}" +
                                                        $" ( {prescription.DaysNumber} Days )";
                                                }

                                                <div class="medicine-card saved">
                                                    <div class="med-left">
                                                        <div class="med-badge success">@medicineIndex</div>
                                                    </div>
                                                    <!-- ?? Prescription Instruction (TOP) -->

                                                    <div class="med-content">
                                                        @if (!string.IsNullOrEmpty(instructionText))
                                                        {
                                                            <div class="med-prescription text-muted mb-1">
                                                                <small>@instructionText</small>
                                                            </div>
                                                        }
                                                        <div class="med-title">Saved Medicine</div>
                                                        <div class="med-desc">@savedItem.MedicineDescription</div>

                                                        <div class="med-sub">Instruction</div>
                                                        <div class="med-instruction">@savedItem.MorningSuchana</div>
                                                    </div>
                                                </div>

                                                medicineIndex++;
                                            }
                                        }

                                        <!-- NEW -->
                                        if (medicineInstructions != null)
                                        {
                                            foreach (var item in medicineInstructions)
                                            {
                                                if (processedPrescriptionIds.Contains((int)item.PrescriptionID)) { continue; }

                                                var parts = new List<string>();
                                                string basePart = (item.FormResult ?? "") + " " + (item.PackageResult ?? "");
                                                if (item.NumberLeft != null) { basePart += " नं. " + item.NumberLeft; }

                                                parts.Add(basePart.Trim());
                                                if (item.DoseNumber != null || item.Dose != null)
                                                {
                                                    parts.Add((item.DoseNumber + " " + item.Dose).Trim());
                                                }
                                                if (item.TimeResult != null) { parts.Add(item.TimeResult.Trim()); }
                                                if (item.DaysNumber != null) { parts.Add("(" + item.DaysNumber + " Days)"); }

                                                string finalText = string.Join(" | ", parts.Where(s => !string.IsNullOrEmpty(s)));

                                                <div class="medicine-card new">
                                                    <div class="med-left">
                                                        <div class="med-badge primary">@medicineIndex</div>
                                                    </div>

                                                    <div class="med-content">
                                                        <div class="med-title">New Medicine</div>
                                                        <div class="med-desc">@finalText</div>

                                                        <div class="not-saved">
                                                            <i class="fas fa-exclamation-circle"></i> Not Saved Yet
                                                        </div>
                                                    </div>
                                                </div>

                                                medicineIndex++;
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <div class="empty-box">
                                            <i class="fas fa-info-circle"></i>
                                            <p>कोणतेही औषध उपलब्ध नाही</p>
                                        </div>
                                    }

                                </div>
                            </div>



