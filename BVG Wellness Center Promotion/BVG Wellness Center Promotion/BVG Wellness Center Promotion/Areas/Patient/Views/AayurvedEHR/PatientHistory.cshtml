<script>
// ========== DROPDOWN VALIDATION FUNCTIONS ==========

// Get all selected values in container (excluding current row)
function getSelectedValues(containerId, currentRow) {
    var selectedValues = [];
    var container = $('#' + containerId);

    container.find('.history-row').each(function() {
        // Skip the current row
        if (this !== currentRow[0]) {
            var mainField = $(this).find('.main-field');
            var value = mainField.val();
            if (value && value !== "") {
                selectedValues.push(value);
            }
        }
    });

    return selectedValues;
}

// Update dropdown options to remove already selected values
function updateDropdownOptions(containerId, currentRow) {
    var container = $('#' + containerId);
    var selectedValues = getSelectedValues(containerId, currentRow);

    // Get current value of the row we're updating
    var currentMainField = currentRow.find('.main-field');
    var currentValue = currentMainField.val();

    // Store original options if not already stored for ALL dropdowns in this container
    container.find('.main-field').each(function() {
        var $dropdown = $(this);

        // Store original options if not already stored
        if (!$dropdown.data('original-options')) {
            var options = [];
            $dropdown.find('option').each(function() {
                options.push({
                    value: $(this).val(),
                    text: $(this).text()
                });
            });
            $dropdown.data('original-options', options);
        }
    });

    // Update EACH dropdown individually
    container.find('.main-field').each(function() {
        var $dropdown = $(this);
        var originalOptions = $dropdown.data('original-options');

        if (!originalOptions) return;

        // Get this dropdown's current value
        var dropdownCurrentValue = $dropdown.val();

        // Clear current options
        $dropdown.empty();

        // Add placeholder option
        $dropdown.append('<option value="">Select Option</option>');

        // Add back options except those that are selected in other rows
        $.each(originalOptions, function(i, opt) {
            // Skip if option value is empty (placeholder)
            if (opt.value === "") return;

            // Check if this value is selected in other rows
            var isSelectedElsewhere = false;

            container.find('.history-row').each(function() {
                var rowMainField = $(this).find('.main-field');
                var rowValue = rowMainField.val();

                // If this row is the current dropdown's row, skip comparison
                if (rowMainField[0] === $dropdown[0]) {
                    return;
                }

                // If value matches a selected value in another row
                if (rowValue && rowValue === opt.value) {
                    isSelectedElsewhere = true;
                    return false; // break the loop
                }
            });

            // Add option if not selected elsewhere, OR if it's this dropdown's current value
            if (!isSelectedElsewhere || (dropdownCurrentValue && dropdownCurrentValue === opt.value)) {
                $dropdown.append($('<option></option>').val(opt.value).html(opt.text));
            }
        });

        // Restore current value if it exists and is still available
        if (dropdownCurrentValue && dropdownCurrentValue !== "") {
            // Check if the value still exists in dropdown
            if ($dropdown.find('option[value="' + dropdownCurrentValue + '"]').length > 0) {
                $dropdown.val(dropdownCurrentValue);
            } else {
                $dropdown.val('');
            }
        }
    });
}

// ? DROPDOWN CHANGE HANDLER
function handleDropdownChange(element) {

    if ($(element).hasClass("locked-dropdown")) {
        return false;
    }

    var $row = $(element).closest('.history-row');
    var $unit = $row.find('.durationUnit');
    var $duration = $row.find('.durationField');
    var containerId = $row.closest('.history-container').attr('id');

    if ($(element).val() !== "") {
        $unit.prop('disabled', false);
    } else {
        $unit.val('').prop('disabled', true);
        $duration.val('').prop('disabled', true)
            .css("background-color", "#e9ecef");
        $row.find('.error-msg').hide();
    }

    // Update all dropdowns in this container to remove duplicates
    updateDropdownOptions(containerId, $row);
}

// ? VALIDATION FUNCTION
function validateDuration(element) {
    var row = element.closest('.history-row');
    if (!row) return;

    var unitDropdown = row.querySelector('.durationUnit');
    var durationInput = row.querySelector('.durationField');
    var errorSpan = row.querySelector('.error-msg');

    if (!unitDropdown || !durationInput) return;

    if (unitDropdown.value === "") {
        durationInput.value = "";
        durationInput.disabled = true;
        durationInput.style.backgroundColor = "#e9ecef";
        return;
    } else {
        durationInput.disabled = false;
        durationInput.style.backgroundColor = "#ffffff";
    }

    if (durationInput.value !== "") {
        var unitText = unitDropdown.options[unitDropdown.selectedIndex].text.toLowerCase();
        var value = parseInt(durationInput.value) || 0;
        var max = 999;
        var message = "";

        if (unitText.includes("day") && value > 365) {
            max = 365;
            message = "More than 365 days? Select Weeks";
        }
        else if (unitText.includes("week") && value > 99) {
            max = 99;
            message = "More than 99 weeks? Select Months";
        }
        else if (unitText.includes("month") && value > 99) {
            max = 99;
            message = "More than 99 months? Select Years";
        }
        else if (unitText.includes("year") && value > 120) {
            max = 120;
            message = "Maximum 120 years allowed";
        }

        if (value > max) {
            durationInput.value = max;
            if (errorSpan) {
                errorSpan.innerText = message;
                errorSpan.style.display = "block";
            }
            durationInput.style.borderColor = "red";
        } else {
            if (errorSpan) errorSpan.style.display = "none";
            durationInput.style.borderColor = "";
        }
    }
}



// ========== FUNCTIONS FOR LOADING DATA ==========

// Load existing data into dynamic rows
function loadExistingData(containerId, dataList) {
    var container = $('#' + containerId);

    // Clear all existing rows except the first one
    var firstRow = container.find('.history-row:first');
    container.find('.history-row:not(:first)').remove();

    // Store original options for first row if not already stored
    var firstMainField = firstRow.find('.main-field');
    if (!firstMainField.data('original-options')) {
        var originalOptions = [];
        firstMainField.find('option').each(function() {
            originalOptions.push({
                value: $(this).val(),
                text: $(this).text()
            });
        });
        firstMainField.data('original-options', originalOptions);
    }

    if (dataList && dataList.length > 0) {
        // Update first row with data
        updateRowWithData(firstRow, dataList[0], 0);

        // Add additional rows for remaining items
        for (var i = 1; i < dataList.length; i++) {
            addNewRowWithData(containerId, dataList[i], i);
        }

        // After loading all data, update dropdown options to prevent duplicates
        updateDropdownOptions(containerId, firstRow);
    } else {
        // Reset first row to empty
        resetRow(firstRow);
        // Trigger change to update dropdowns
        firstRow.find('.main-field').val('').trigger('change');
    }
}

function updateRowWithData(row, data, index) {
    var mainField = row.find('.main-field');
    var unitField = row.find('.durationUnit');
    var durationField = row.find('.durationField');
    var idField = row.find('.record-id');

    // Set the ID if exists
    if (data.Id && data.Id > 0) {
        idField.val(data.Id);
    } else {
        idField.val('');
    }

    // Set values based on the container type
    // Chronic Illness
    if (data.ChronicIllnessId !== undefined) {
        mainField.val(data.ChronicIllnessId);
        if (data.DurationUnit) unitField.val(data.DurationUnit);
        if (data.Duration) durationField.val(data.Duration);
    }
    // Past Surgery
    else if (data.PastSurgeryId !== undefined) {
        mainField.val(data.PastSurgeryId);
        if (data.PastSurgeryDurationUnit) unitField.val(data.PastSurgeryDurationUnit);
        if (data.PastSurgeryDuration) durationField.val(data.PastSurgeryDuration);
    }
    // Trauma
    else if (data.TraumaHistoryId !== undefined) {
        mainField.val(data.TraumaHistoryId);
        if (data.TraumaHistoryDurationUnit) unitField.val(data.TraumaHistoryDurationUnit);
        if (data.TraumaHistoryDuration) durationField.val(data.TraumaHistoryDuration);
    }
    // Allergy
    else if (data.AllergyId !== undefined) {
        mainField.val(data.AllergyId);
        if (data.AllergyHistoryDurationUnit) unitField.val(data.AllergyHistoryDurationUnit);
        if (data.AllergyHistoryDuration) durationField.val(data.AllergyHistoryDuration);
    }
    // Medication
    else if (data.LongTermMedicationId !== undefined) {
        mainField.val(data.LongTermMedicationId);
        if (data.LongTermMedicationDurationUnit) unitField.val(data.LongTermMedicationDurationUnit);
        if (data.LongTermMedicationDuration) durationField.val(data.LongTermMedicationDuration);
    }

    // Enable fields if data exists
    var mainValue = mainField.val();
    if (mainValue && mainValue !== "") {
        unitField.prop('disabled', false);
        durationField.prop('disabled', false);
        durationField.css('background-color', '#ffffff');
    }

    // Update name attributes with proper index
    updateRowNames(row, index);
}

function addNewRowWithData(containerId, data, index) {

    var container = $('#' + containerId);
    var newRow = container.find('.history-row:first').clone();

    // Clear values
    resetRow(newRow);

    // Store original options for the new row
    var newMainField = newRow.find('.main-field');
    var originalOptions = [];
    newMainField.find('option').each(function() {
        originalOptions.push({
            value: $(this).val(),
            text: $(this).text()
        });
    });
    newMainField.data('original-options', originalOptions);

    // Update with data
    updateRowWithData(newRow, data, index);

    // Set remove button
    newRow.find('.btn-container').html(`
        <button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">Remove</button>
    `);

    container.append(newRow);

    // Re-attach event handlers
    newMainField.on('change', function() { handleDropdownChange(this); });
    newRow.find('.durationField').on('input', function() { validateDuration(this); });
    newRow.find('.durationUnit').on('change', function() { validateDuration(this); });
}

function resetRow(row) {
    row.find('input[type="text"]').val('');
    row.find('select').val('');
    row.find('.record-id').val('');
    row.find('.durationUnit').prop('disabled', true);
    row.find('.durationField').prop('disabled', true).css('background-color', '#e9ecef');
    row.find('.error-msg').hide();
}

function updateRowNames(row, index) {
    // Update main dropdown name
    var mainField = row.find('.main-field');
    if (mainField.length) {
        var mainName = mainField.attr('name');
        if (mainName) {
            var newMainName = mainName.replace(/\[\d+\]/, '[' + index + ']');
            mainField.attr('name', newMainName);
        }
    }

    // Update duration field name
    var durationField = row.find('.durationField');
    if (durationField.length) {
        var durationName = durationField.attr('name');
        if (durationName) {
            var newDurationName = durationName.replace(/\[\d+\]/, '[' + index + ']');
            durationField.attr('name', newDurationName);
        }
    }

    // Update unit dropdown name
    var unitField = row.find('.durationUnit');
    if (unitField.length) {
        var unitName = unitField.attr('name');
        if (unitName) {
            var newUnitName = unitName.replace(/\[\d+\]/, '[' + index + ']');
            unitField.attr('name', newUnitName);
        }
    }

    // Update hidden ID field name
    var idField = row.find('.record-id');
    if (idField.length) {
        var idName = idField.attr('name');
        if (idName) {
            var newIdName = idName.replace(/\[\d+\]/, '[' + index + ']');
            idField.attr('name', newIdName);
        }
    }
}

function renumberRows(container) {
    var rows = container.find('.history-row');
    rows.each(function(newIndex) {
        updateRowNames($(this), newIndex);
    });
}

// ========== PAGE LOAD INITIALIZATION ==========

