    if (tab) {
        setTimeout(function () {
            let triggerEl = document.querySelector('[href="#' + tab + '"]');
            if (triggerEl) {
                let tabInstance = new bootstrap.Tab(triggerEl);
                tabInstance.show();
            }
        }, 200); // ?? delay important
    }
    // -- Appointments Dropdown Load --
    function loadAppointments(patientFid, selectedAppointmentFid) {
        $.ajax({
            url: '/Patient/AayurvedEHR/GetPatientAppointments',
            type: 'GET',
            data: { patientFid: patientFid },
            success: function (data) {
                let dropdown = $('#appointmentDropdown');
                dropdown.html('<option value="">-- Select --</option>');

                if (data && data.length > 0) {
                    $.each(data, function (i, itemArray) {
                        let appt = {};
                        $.each(itemArray, function (j, kv) {
                            appt[kv.Key] = kv.Value;
                        });
                        let label = (appt.AppoinmentDate || "-")
                                  + " | " + (appt.DoctorName);

                        let selected = (appt.AppointmentFid == selectedAppointmentFid) ? "selected" : "";
                        dropdown.append('<option value="' + appt.AppointmentFid + '" ' + selected + '>' + label + '</option>');
                    });
                } else {
                    dropdown.html('<option value="">No appointments found</option>');
                }
            },
            error: function () {
                $('#appointmentDropdown').html('<option value="">Error loading</option>');
            }
        });
    }

    // -- Search Input --
    $(document).ready(function () {

        $('#searchInput').off('input').on('input', function () {
            var query = $(this).val().trim();

            if (query.length >= 1) {
                $.ajax({
                    url: '/Patient/AayurvedEHR/SearchPatient',
                    type: 'GET',
                    data: { searchTerm: query },
                    success: function (data) {
                        let html = "";
                        if (data.length > 0) {
                            let seen = {};
                            html += "<ul class='list-group mb-0'>";
                            $.each(data, function (i, itemArray) {
                                let item = {};
                                $.each(itemArray, function (j, kv) {
                                    item[kv.Key] = kv.Value;
                                });

                                let key = item.PatientFid;
                                if (!seen[key]) {
                                    seen[key] = true;

                                    let fullName = (item.FullName || "").replace(/"/g, '').replace(/'/g, '');
                                    let contact  = (item.ContactNumber || "");
                                    let uhid     = (item.UHIDNO || "");

                                    html += "<li class='list-group-item list-group-item-action' "
                                        + "style='cursor:pointer; padding:8px 12px;' "
                                        + "onclick='selectPatient(" + item.PatientFid + ")'>"
                                        + "<i class='fa fa-user' style='color:#007bff; margin-right:6px;'></i>"
                                        + "<strong>" + (item.FullName || "") + "</strong>"
                                        + " &nbsp;|&nbsp; " + contact
                                        + " &nbsp;|&nbsp; " + uhid
                                        + "</li>";
                                }
                            });
                            html += "</ul>";
                        } else {
                            html = "<div class='p-2 text-muted'>No matches found</div>";
                        }
                        $('#searchResult').html(html).show();
                    },
                    error: function () {
                        $('#searchResult').html('<div class="p-2 text-danger">Error fetching data</div>').show();
                    }
                });
            } else {
                $('#searchResult').hide();
            }
        });

        // Outside click ? hide search result
        $(document).on('click', function (e) {
            if (!$(e.target).closest('#searchInput, #searchResult').length) {
                $('#searchResult').hide();
            }
        });
    });

    // -- Patient Select ? Latest Appointment ?? Page Reload --
    function selectPatient(patientFid) {
        $('#searchResult').hide();

        $.ajax({
            url: '/Patient/AayurvedEHR/GetPatientAppointments',
            type: 'GET',
            data: { patientFid: patientFid },
            success: function (data) {
                if (data && data.length > 0) {
                    // Latest appointment (पहिला — ORDER BY DESC आहे)
                    let appt = {};
                    $.each(data[0], function (j, kv) {
                        appt[kv.Key] = kv.Value;
                    });
                    // ? Page reload
                    //window.location.href = '/Patient/AayurvedEHR/PatientHistory?AppoinmentID=' + appt.AppointmentFid;
                    window.location.href = '/Patient/AayurvedEHR/PatientHistory?AppoinmentID='
    + appt.AppointmentFid + '&tab=CasePaper';
                } else {
                    alert('No appointments found for this patient.');
                }
            },
            error: function () {
                alert('Error loading patient appointments.');
            }
        });
    }

    // -- Appointment Dropdown Change ? Page Reload --
    function goToAppointment(select) {
        var appointmentFid = $(select).val();
        if (appointmentFid && appointmentFid !== "") {
            // ? Page reload
            window.location.href = '/Patient/AayurvedEHR/PatientHistory?AppoinmentID='
     + appointmentFid + '&tab=CasePaper';
        }
    }
</script>
