    $(document).ready(function () {
        @if (ViewBag.AdvisedTherapyResult != null)
        {
            foreach (var item in ViewBag.AdvisedTherapyResult)
            {
                <text>
                advisedTherapyList.push({
                    ATId: @item.ATId,
