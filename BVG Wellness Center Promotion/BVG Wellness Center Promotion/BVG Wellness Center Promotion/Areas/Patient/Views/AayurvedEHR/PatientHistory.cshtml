<script>
    $(document).ready(function () {
        debugger

        var sections = [

            { id: "CasePaper", key: "CasePaperId" },
            { id: "PulseExam", key: "Fid" },
            { id: "AyurvedaDiagnosis", key: "AyurvedaDiagnosisID" },
            { id: "Medicine", key: "PrescriptionID" },

            // Dispensing tab ? textarea check
            { id: "Dispensing", key: "txtMedicine" },

            // Counter Medicine ? table row check
            { id: "CounterMedicine", key: "prescriptionTableCounter" },

            // Counter Dispensing ? textarea
            { id: "CounterDispensing", key: "txtMedicine" },

            // Advised Therapy ? hidden json
            { id: "AdvisedTherapy", key: "AdvisedTherapyJson" }

        ];

        var nextTab = sections[0].id;

        for (var i = 0; i < sections.length; i++) {

            var tabId = sections[i].id;
            var key = sections[i].key;
            var value = "";

            // hidden input check
            var hidden = $("#" + tabId + " input[name='" + key + "']");
            if (hidden.length) {
                value = hidden.val();
            }

            // textarea check
            var textarea = $("#" + tabId + " textarea[id='" + key + "']");
            if (textarea.length) {
                value = textarea.val();
            }

            // table check
            if (key === "prescriptionTableCounter") {
                var rows = $("#" + key + " tbody tr").length;
                value = rows;
            }

            //console.log(tabId + " = " + value);

            if (!value || value === "0" || value === "") {
                nextTab = tabId;
                break;
            }

        }

        // remove active
        $(".tab-pane").removeClass("active show");
        $(".nav-link").removeClass("active");

        // activate tab
        $("#" + nextTab).addClass("active show");
        $('.nav-tabs a[data-bs-target="#' + nextTab + '"]').addClass("active");

    });

    function RefreshTabNavigation() {
        debugger;
        var sections = [
            { id: "CasePaper", key: "CasePaperId" },
            { id: "PulseExam", key: "Fid" },
            { id: "AyurvedaDiagnosis", key: "AyurvedaDiagnosisID" },
            { id: "Medicine", key: "PrescriptionID" },
            { id: "Dispensing", key: "txtMedicine" },
            { id: "CounterMedicine", key: "prescriptionTableCounter" },
            { id: "CounterDispensing", key: "txtMedicine" },
            { id: "AdvisedTherapy", key: "AdvisedTherapyJson" }
        ];

        var nextTab = sections[0].id;

        for (var i = 0; i < sections.length; i++) {
            var tabId = sections[i].id;
            var key = sections[i].key;
            var value = "";

            // Check hidden input or normal input
            var hidden = $("#" + tabId + " [name='" + key + "'], #" + tabId + " #" + key);
            if (hidden.length) {
                value = hidden.val();
            }

            // Check textarea
            var textarea = $("#" + tabId + " textarea[id='" + key + "']");
            if (textarea.length) {
                value = textarea.val();
            }

            // Table check
            if (key === "prescriptionTableCounter") {
                value = $("#" + key + " tbody tr").length > 0 ? "1" : "";
            }

            // If empty, this is the tab we stop at
            if (!value || value === "0" || value.trim() === "") {
                nextTab = tabId;
                break;
            }
        }

        // Switch the tabs visually
        $(".tab-pane").removeClass("active show");
        $(".nav-link").removeClass("active");

        $("#" + nextTab).addClass("active show");
        // This line handles both bootstrap 4 and 5 selectors
        $('.nav-tabs a[data-bs-target="#' + nextTab + '"], .nav-tabs a[href="#' + nextTab + '"]').addClass("active");
    }

    $(document).ready(function () {
        RefreshTabNavigation(); // Run once on load
    });
</script>


