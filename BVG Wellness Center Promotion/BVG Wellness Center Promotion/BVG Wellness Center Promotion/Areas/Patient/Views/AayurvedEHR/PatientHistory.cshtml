            font-size: 30px;
            margin-bottom: 10px;
        }

    input[readonly] {
        background-color: #e9ecef !important;
        cursor: not-allowed;
    }
    /* Select2 search dropdown chi height dusrya dropdown sarki (31px) karnyasaathi */
    .select2-container--default .select2-selection--single {
        height: 40px !important;
        padding: 2px 5px !important;
        font-size: 13px !important;
        border: 1px solid #ced4da !important;
    }

    .collapse {
        display: none;
    }

        .collapse.show {
            display: grid !important; /* Reports दिसण्यासाठी */
        }
    /* Dropdown chya aatla arrow/text center karnyasaathi */
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 26px !important; /* Height peksha thodi kami */
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 30px !important;
    }

