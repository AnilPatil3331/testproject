<div class="tab-pane p-20 active show" id="CasePaper" role="tabpanel">



    @using (Html.BeginForm("CasePaper", "AayurvedEHR", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <input type="hidden" name="isCasePaperOnly" value="@Request.QueryString["isCasePaperOnly"]" />


        <div class="section" id="casePaperSummaryBlock">
            <!-- === SHORT SUMMARY START === -->
            @{
                var patFid = ViewBag.TodayPatients?.PatientFid ?? 0;
                var currentAppFid = ViewBag.TodayPatients?.AppointmentFid ?? 0;

                var pastChiefComplaints = new List<string>();
                var pastTreatments = new List<string>();
                var pastInvestigations = new List<string>();

                var currentChiefComplaints = new List<string>();
                var currentTreatments = new List<string>();
                var currentInvestigations = new List<string>();

                var allChronicNames = new List<string>();
                var allAllergyNames = new List<string>();
                var allMedNames = new List<string>();

                if (patFid > 0)
                {
                    Dapper.DynamicParameters qParam = new Dapper.DynamicParameters();
                    qParam.Add("@p_Query", $"SELECT AppointmentFid FROM PatientAppoinment WHERE PatientFid = {patFid} ORDER BY AppointmentFid ASC");
                    var allAppointments = BVG_Wellness_Center_Promotion.Models.BVGWellnessCenterDapparORM.ReturnList<dynamic>("sp_ExecuteQuery", qParam);

                    if (allAppointments != null)
                    {
                        // Find the immediate previous appointment
                        int previousAppFid = 0;
                        foreach (var app in allAppointments)
                        {
                            int aFid = Convert.ToInt32(app.AppointmentFid);
                            if (aFid < currentAppFid)
                            {
                                previousAppFid = aFid; // Will hold the max aFid < currentAppFid because it's ordered ASC
                            }
                        }

                        int lastSeenCasePaperId = 0;
                        foreach (var app in allAppointments)
                        {
                            int appFid = Convert.ToInt32(app.AppointmentFid);
                            if (appFid > currentAppFid) { continue; } // Ignore future appointments

                            bool isCurrent = (appFid == currentAppFid);
                            bool isPrevious = (appFid == previousAppFid);

                            var paramEHR = new Dapper.DynamicParameters();
                            paramEHR.Add("@AppointmentFid", appFid);
                            var ehrData = BVG_Wellness_Center_Promotion.Models.BVGWellnessCenterDapparORM.ReturnList<BVG_Wellness_Center_Promotion.Areas.Patient.Models.EHR>("Sp_GetFullEHR_ByAppointment", paramEHR).FirstOrDefault();

                            if (ehrData != null)
                            {
                                int casePaperId = ehrData.CasePaperId;

                                // 1. Chronic Illnesses (Red Flag - collect from all past up to current)
                                var cParam = new Dapper.DynamicParameters();
                                cParam.Add("@p_Query", $"SELECT IllnessId AS ChronicIllnessId FROM CasePaper_ChronicIllness WHERE CasePaperId = {casePaperId}");
                                var chronicIds = BVG_Wellness_Center_Promotion.Models.BVGWellnessCenterDapparORM.ReturnList<BVG_Wellness_Center_Promotion.Areas.Patient.Models.EHR.ChronicIllnessModel>("sp_ExecuteQuery", cParam);
                                if (chronicIds != null && ViewBag.ChronicIllness != null)
                                {
                                    foreach (var cid in chronicIds)
                                    {
                                        if (cid.ChronicIllnessId != null)
                                        {
                                            foreach (dynamic item in ViewBag.ChronicIllness)
                                            {
                                                if (item.Id.ToString() == cid.ChronicIllnessId.ToString())
                                                {
                                                    var name = item.Name.ToString();
                                                    if (!allChronicNames.Contains(name)) { allChronicNames.Add(name); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // 2. Allergies (Red Flag)
                                var aParam = new Dapper.DynamicParameters();
                                aParam.Add("@p_Query", $"SELECT AllergyId FROM CasePaper_Allergy WHERE CasePaperId = {casePaperId}");
                                var allergyIds = BVG_Wellness_Center_Promotion.Models.BVGWellnessCenterDapparORM.ReturnList<BVG_Wellness_Center_Promotion.Areas.Patient.Models.EHR.AllergyModel>("sp_ExecuteQuery", aParam);
                                if (allergyIds != null && ViewBag.Allergy != null)
                                {
                                    foreach (var aid in allergyIds)
                                    {
                                        if (aid.AllergyId != null)
                                        {
                                            foreach (dynamic item in ViewBag.Allergy)
                                            {
                                                if (item.Id.ToString() == aid.AllergyId.ToString())
                                                {
                                                    var name = item.Name.ToString();
                                                    if (!allAllergyNames.Contains(name)) { allAllergyNames.Add(name); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // 3. Long Term Medication (Red Flag)
                                var mParam = new Dapper.DynamicParameters();
                                mParam.Add("@p_Query", $"SELECT MedicationId AS LongTermMedicationId FROM CasePaper_Medication WHERE CasePaperId = {casePaperId}");
                                var medIds = BVG_Wellness_Center_Promotion.Models.BVGWellnessCenterDapparORM.ReturnList<BVG_Wellness_Center_Promotion.Areas.Patient.Models.EHR.LongTermMedicationModel>("sp_ExecuteQuery", mParam);
                                if (medIds != null && ViewBag.Medication != null)
                                {
                                    foreach (var mid in medIds)
                                    {
                                        if (mid.LongTermMedicationId != null)
                                        {
                                            foreach (dynamic item in ViewBag.Medication)
                                            {
                                                if (item.Id.ToString() == mid.LongTermMedicationId.ToString())
                                                {
                                                    var name = item.Name.ToString();
                                                    if (!allMedNames.Contains(name)) { allMedNames.Add(name); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Only get Investigations & Complaints if it's Current or Previous
                                bool isRealCurrent = false;
                                if (isCurrent)
                                {
                                    var checkParam = new Dapper.DynamicParameters();
                                    checkParam.Add("@p_Query", $"SELECT COUNT(1) FROM CasePaper_Result WHERE AppointmentFid = {appFid}");
                                    int saveCount = BVG_Wellness_Center_Promotion.Models.BVGWellnessCenterDapparORM.ReturnList<int>("sp_ExecuteQuery", checkParam).FirstOrDefault();
                                    isRealCurrent = (saveCount > 0);
                                }
                                if (ehrData.CasePaperId > 0) { lastSeenCasePaperId = ehrData.CasePaperId; }
                                if (isRealCurrent || isPrevious)
                                {
                                    // 4. Investigations (Lab + Imaging)
                                    if (!string.IsNullOrEmpty(ehrData.LabTestsAdvisedIds))
                                    {
                                        var ids = ehrData.LabTestsAdvisedIds.Split(',');
                                        if (ViewBag.LabTests != null)
                                        {
                                            foreach (var id in ids)
                                            {
                                                if (!string.IsNullOrWhiteSpace(id))
                                                {
                                                    foreach (dynamic item in ViewBag.LabTests)
                                                    {
                                                        if (item.Id.ToString() == id.Trim())
                                                        {
                                                            var name = item.Name.ToString();
                                                            if (isRealCurrent) { if (!currentInvestigations.Contains("Lab: " + name)) { currentInvestigations.Add("Lab: " + name); } }
                                                            else { if (!pastInvestigations.Contains("Lab: " + name)) { pastInvestigations.Add("Lab: " + name); } }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if (!string.IsNullOrEmpty(ehrData.ImagingAdvisedIds))
                                    {
                                        var ids = ehrData.ImagingAdvisedIds.Split(',');
                                        if (ViewBag.Imaging != null)
                                        {
                                            foreach (var id in ids)
                                            {
                                                if (!string.IsNullOrWhiteSpace(id))
                                                {
                                                    foreach (dynamic item in ViewBag.Imaging)
                                                    {
                                                        if (item.Id.ToString() == id.Trim())
                                                        {
                                                            var name = item.Name.ToString();
                                                            if (isRealCurrent) { if (!currentInvestigations.Contains("Imaging: " + name)) { currentInvestigations.Add("Imaging: " + name); } }
                                                            else { if (!pastInvestigations.Contains("Imaging: " + name)) { pastInvestigations.Add("Imaging: " + name); } }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // 5. Chief Complaints & Previous Treatment
                                    var ccParam = new Dapper.DynamicParameters();
                                    ccParam.Add("@p_Query", $"SELECT ComplaintId, PreviousTreatment, PreviousTreatmentOther FROM CasePaperComplaints WHERE CasePaperId = {casePaperId}");
                                    var compIds = BVG_Wellness_Center_Promotion.Models.BVGWellnessCenterDapparORM.ReturnList<dynamic>("sp_ExecuteQuery", ccParam);

                                    if (compIds != null)
                                    {
                                        foreach (var comp in compIds)
                                        {
                                            if (ViewBag.Complaints != null && comp.ComplaintId != null)
                                            {
                                                foreach (dynamic item in ViewBag.Complaints)
                                                {
                                                    if (item.Id.ToString() == comp.ComplaintId.ToString())
                                                    {
                                                        var name = item.Name.ToString();
                                                        if (isRealCurrent) { if (!currentChiefComplaints.Contains(name)) { currentChiefComplaints.Add(name); } }
                                                        else { if (!pastChiefComplaints.Contains(name)) { pastChiefComplaints.Add(name); } }
                                                    }
                                                }
                                            }

                                            string trt = "";

                                            if (comp.PreviousTreatment != null && comp.PreviousTreatment.ToString() != "null")
                                            {

                                                string matchedName = null;

                                                var prevTreatList = ViewBag.PreviousTreatments as IEnumerable<dynamic>;

                                                if (prevTreatList != null)
                                                {

                                                    foreach (var pt in prevTreatList)
                                                    {

                                                        if (Convert.ToString(pt.Id) == comp.PreviousTreatment.ToString())
                                                        {

                                                            matchedName = Convert.ToString(pt.Name);

                                                            break;

                                                        }

                                                    }

                                                }

                                                trt += string.IsNullOrEmpty(matchedName) ? comp.PreviousTreatment.ToString() : matchedName;

                                            }
                                            if (comp.PreviousTreatmentOther != null && comp.PreviousTreatmentOther.ToString() != "null" && comp.PreviousTreatmentOther.ToString().Trim() != "")
                                            {
                                                trt += (trt != "" ? " - " : "") + comp.PreviousTreatmentOther.ToString();
                                            }

                                            if (!string.IsNullOrWhiteSpace(trt))
                                            {
                                                if (isRealCurrent) { if (!currentTreatments.Contains(trt)) { currentTreatments.Add(trt); } }
                                                else { if (!pastTreatments.Contains(trt)) { pastTreatments.Add(trt); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            <div class="card mb-3" style="border: 1px solid #ddd; background-color: #f9f9f9; border-radius: 5px;">
                <div class="card-body p-3">
                    <h5 class="font-weight-bold text-center" style="text-decoration: underline; margin-bottom: 15px;">CASE PAPER SUMMARY</h5>
                    <div class="row">
                        <!-- 1st Column: PAST CONSULTATION -->
                        <div class="col-md-4">
                            <h6 class="font-weight-bold text-primary" style="border-bottom: 2px solid #e0e0e0; padding-bottom: 5px;">PAST CONSULTATION</h6>

                            <strong style="font-size: 13px;">Chief Complaint:</strong>
                            @if (pastChiefComplaints.Count > 0)
                            {
                                <ul class="pl-3 mb-2" style="font-size: 13px;">
                                    @foreach (var item in pastChiefComplaints)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            }
                            else
                            { <p class="mb-2 text-muted" style="font-size: 12px;">None</p>}

                            <strong style="font-size: 13px;">Previous Treatment:</strong>
                            @if (pastTreatments.Count > 0)
                            {
                                <ul class="pl-3 mb-2" style="font-size: 13px;">
                                    @foreach (var item in pastTreatments)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            }
                            else
                            { <p class="mb-2 text-muted" style="font-size: 12px;">None</p>}

                            <strong style="font-size: 13px;">Investigations:</strong>
                            @if (pastInvestigations.Count > 0)
                            {
                                <ul class="pl-3 mb-2" style="font-size: 13px;">
                                    @foreach (var item in pastInvestigations)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            }
                            else
                            { <p class="mb-2 text-muted" style="font-size: 12px;">None</p>}
                        </div>

                        <!-- 2nd Column: CURRENT CONSULTATION -->
                        <div class="col-md-4" style="border-left: 1px solid #ddd;">
                            <h6 class="font-weight-bold text-primary" style="border-bottom: 2px solid #e0e0e0; padding-bottom: 5px;">CURRENT CONSULTATION</h6>

                            <strong style="font-size: 13px;">Chief Complaint:</strong>
                            @if (currentChiefComplaints.Count > 0)
                            {
                                <ul class="pl-3 mb-2" style="font-size: 13px;">
                                    @foreach (var item in currentChiefComplaints)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            }
                            else
                            { <p class="mb-2 text-muted" style="font-size: 12px;">None</p>}

                            <strong style="font-size: 13px;">Previous Treatment:</strong>
                            @if (currentTreatments.Count > 0)
                            {
                                <ul class="pl-3 mb-2" style="font-size: 13px;">
                                    @foreach (var item in currentTreatments)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            }
                            else
                            { <p class="mb-2 text-muted" style="font-size: 12px;">None</p>}

                            <strong style="font-size: 13px;">Investigations:</strong>
                            @if (currentInvestigations.Count > 0)
                            {
                                <ul class="pl-3 mb-2" style="font-size: 13px;">
                                    @foreach (var item in currentInvestigations)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            }
                            else
                            { <p class="mb-2 text-muted" style="font-size: 12px;">None</p>}
                        </div>

                        <!-- 3rd Column: RED FLAG -->
                        <div class="col-md-4" style="border-left: 1px solid #ddd;">
                            <h6 class="font-weight-bold text-danger" style="border-bottom: 2px solid #e0e0e0; padding-bottom: 5px;">MEDICAL HISTORY</h6>

                            <strong style="font-size: 13px;">Chronic Illnesses:</strong>
                            @if (allChronicNames.Count > 0)
                            {
                                <ul class="pl-3 mb-2" style="font-size: 13px;">
                                    @foreach (var name in allChronicNames)
                                    {
                                        <li>@name</li>
                                    }
                                </ul>
                            }
                            else
                            { <p class="mb-2 text-muted" style="font-size: 12px;">None</p>}

                            <strong style="font-size: 13px;">Drug / Food Allergies:</strong>
                            @if (allAllergyNames.Count > 0)
                            {
                                <ul class="pl-3 mb-2" style="font-size: 13px;">
                                    @foreach (var name in allAllergyNames)
                                    {
                                        <li>@name</li>
                                    }
                                </ul>
                            }
                            else
                            { <p class="mb-2 text-muted" style="font-size: 12px;">None</p>}

                            <strong style="font-size: 13px;">Long-term Medication:</strong>
                            @if (allMedNames.Count > 0)
                            {
                                <ul class="pl-3 mb-2" style="font-size: 13px;">
                                    @foreach (var name in allMedNames)
                                    {
                                        <li>@name</li>
                                    }
                                </ul>
                            }
                            else
                            { <p class="mb-2 text-muted" style="font-size: 12px;">None</p>}
                        </div>
                    </div>
                </div>
            </div>
            <!-- === SHORT SUMMARY END === -->
        </div>

        <div class="section">
            <div class="section-heading">
                <h4 class="card-title">GENERAL EXAMINATION</h4>
                <button type="button" class="btn btn-md toggle-btn" onclick="toggleSection(this)">
                    -
                </button>
            </div>

            <input type="hidden" name="CasePaperId" value="@Model.CasePaperId" />
            <input type="hidden" name="AppointmentFid" value="@(ViewBag.TodayPatients?.AppointmentFid ?? "")" />
            <input type="hidden" name="PatientFid" value="@(ViewBag.TodayPatients?.PatientFid ?? "")" />

            <div class="row">
                <div class="col-md-4 form-group">
                    <label class="font-weight-bold">Height (cm)</label>
                    @Html.TextBoxFor(m => m.Height, new
{
@class = "form-control",
type = "number",
placeholder = "cm",
id = "Height",
min = "30",
max = "250",
required = "required",
oninput = "calculateBMI()"
