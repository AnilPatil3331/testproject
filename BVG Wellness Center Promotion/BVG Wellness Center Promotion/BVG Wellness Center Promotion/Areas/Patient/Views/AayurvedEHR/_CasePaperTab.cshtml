                <div class="col-md-4 form-group">
                    <label class="font-weight-bold">Weight (kg)</label>
                    @Html.TextBoxFor(m => m.Weight, new
{
@class = "form-control",
type = "number",
placeholder = "kg",
id = "Weight",
min = "1",
max = "300",
required = "required",
oninput = "calculateBMI()"
})
