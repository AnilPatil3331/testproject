                </div>

                <div class="col-md-2 form-group">
                    <label>BP (Sys/Dia)</label>
                    <div class="d-flex">
                        <input type="text" id="BPSys" class="form-control me-1" placeholder="Sys" required />
                        <span class="mx-1">/</span>
                        <input type="text" id="BPDia" class="form-control ms-1" placeholder="Dia" required />

                    </div>
                    <span class="error-text" id="BPError"></span>
                    @*@Html.TextBoxFor(m => m.BloodPressure,
                        new { @class = "form-control", placeholder = "120/80", id = "BloodPressure" })*@
                    @Html.TextBoxFor(m => m.BloodPressure, new { style = "display:none;", id = "BloodPressure", required = "required" })

                </div>

                <div class="col-md-2 form-group">
                    <label>Temperature</label>
                    @*@Html.TextBoxFor(m => m.TemperatureCasepaper,
                        new { @class = "form-control", placeholder = "°F / °C", id = "TemperatureCasepaper" })*@
                    @Html.TextBoxFor(m => m.TemperatureCasepaper, new { @class = "form-control", placeholder = "Value", id = "TemperatureCasepaper", type = "number", step = "0.1", required = "required" })
                    <span class="error-text" id="TemperatureCasepaperError"></span>
                </div>


                <div class="col-md-2 form-group">
                    <label>Temperature Unit</label>
                    @Html.DropDownListFor(m => m.TempUnitCP,
new SelectList(new[] {
new { Value = "°F", Text = "°F" }
