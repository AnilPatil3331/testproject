        <hr />
        <div class="section">
            <div class="section-heading">
                <h4 class="card-title">VITAL SIGNS</h4>
                <button type="button" class="btn btn-md toggle-btn"
                        onclick="toggleSection(this)">
                    -
                </button>
            </div>

            <div class="form-row align-items-end">
                <div class="col-md-2 form-group">
                    <label>Pulse(bpm)</label>
                    @*@Html.TextBoxFor(m => m.Pulse,
                        new { @class = "form-control" , id= "Pulse" })*@
                    @Html.TextBoxFor(m => m.Pulse, new { @class = "form-control", id = "Pulse", type = "number", required = "required" })
