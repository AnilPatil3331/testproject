<script>
    $(document).ready(function () {
        $('#Closemodel').click(function () {
            window.location.href = '@Url.Action("MedicineOutstandingBill")';
        });

        $('#Cancel').click(function () {
            window.location.href = '@Url.Action("MedicineOutstandingBill")';
        });
    });


    function filterTable(inputId, tableId) {
        debugger;
        document.getElementById(inputId).addEventListener('input', function () {
            const filterText = this.value.trim().toLowerCase(); // Get input text
            const table = document.getElementById(tableId);
            const rows = table.querySelectorAll('tbody tr'); // Get all rows in the table

            rows.forEach(row => {
                const cells = row.querySelectorAll('td'); // Get all cells in the row
                // Check if any cell contains the filter text
                const match = Array.from(cells).some(cell => cell.textContent.toLowerCase().includes(filterText));
                row.style.display = match ? '' : 'none'; // Show or hide the row
            });
        });
    }
    filterTable('SearchInput', 'tblBillingRecords');
    filterTable('FilterAmoutDue', 'tblBillingRecords');
    filterTable('FilterByDiscount', 'tblBillingRecords');
    filterTable('filterByTotal', 'tblBillingRecords');
    filterTable('FilterByPatient', 'tblBillingRecords');
    filterTable('FilterByClinic', 'tblBillingRecords');
    filterTable('FilterByDoctor', 'tblBillingRecords');
    filterTable('FilterDate', 'tblBillingRecords');


    document.addEventListener("DOMContentLoaded", function () {
        debugger;
        const rowsPerPageSelect = document.getElementById('PageOption');
        const prevButton = document.getElementById('prev-btn');
        const nextButton = document.getElementById('next-btn');
        const currentPageInput = document.getElementById('InputPage');
        const totalPagesElement = document.getElementById('total-pages');
        const table = document.getElementById('tblBillingRecords');
        const rows = table.querySelectorAll('tbody tr');

        let currentPage = 1;
        let rowsPerPage = parseInt(rowsPerPageSelect.value, 10) || 10; // Default to 10 rows per page

        // Function to update the table display based on page and rows per page
        function updateTable() {
            // If "All" is selected, display all rows
            if (rowsPerPage === -1) {
                rows.forEach(row => {
                    row.style.display = ''; // Show all rows
                });
                currentPageInput.value = 1;
                totalPagesElement.textContent = 1; // Only 1 page when all rows are shown
                updateButtonStates();
            } else {
                const start = (currentPage - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                // Show rows for the current page
                rows.forEach((row, index) => {
                    if (index >= start && index < end) {
                        row.style.display = ''; // Show the row
                    } else {
                        row.style.display = 'none'; // Hide the row
                    }
                });

                // Update page info
                currentPageInput.value = currentPage;
                totalPagesElement.textContent = Math.ceil(rows.length / rowsPerPage);
                updateButtonStates();
            }
        }

        // Function to update the state of the Prev/Next buttons
        function updateButtonStates() {
            prevButton.classList.toggle('disabled', currentPage <= 1);
            nextButton.classList.toggle('disabled', currentPage >= Math.ceil(rows.length / rowsPerPage));
        }

        // Event listener for Rows per Page change
        rowsPerPageSelect.addEventListener('change', function () {
            rowsPerPage = parseInt(this.value, 10);
            currentPage = 1; // Reset to the first page
            updateTable();
        });

        // Event listener for Prev button
        prevButton.addEventListener('click', function () {
            if (currentPage > 1) {
                currentPage--;
                updateTable();
            }
        });

        // Event listener for Next button
        nextButton.addEventListener('click', function () {
            if (currentPage < Math.ceil(rows.length / rowsPerPage)) {
                currentPage++;
                updateTable();
            }
        });
        // Event listener for manual page input (Enter key)
        currentPageInput.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();

                let enteredPage = parseInt(this.value);
                let totalPages = Math.ceil(rows.length / rowsPerPage);

                if (!isNaN(enteredPage) && enteredPage >= 1 && enteredPage <= totalPages) {
                    currentPage = enteredPage;
                    updateTable();
                } else {
                    alert("Invalid page number");
                    this.value = currentPage;
                }
            }
        });


        // Initial call to display the table correctly
        updateTable();
    });


</script>

<script>
$(document).ready(function () {

    // 🔹 Enable / Disable logic (without using disabled)
    function toggleFields() {
        var paymentStatus = $("input[name='PaymentStatus']:checked").val();

        $(".payment-row").each(function () {

            var paymentType = $(this).find(".paymentType").val();

            if (paymentStatus === "Unpaid") {

                // clear + readonly
                $(this).find(".paymentType").val('').css("pointer-events", "none");
                $(this).find(".referenceNumber").val('').prop("readonly", true);


                // TotalPaid = 0
                $("#TotalPaid").val(0).prop("readonly", true);
                $("#RemainingAmount").val($("#txtFinalTotal").val());

            } else {

                // enable
                $(this).find(".paymentType").css("pointer-events", "auto");
                $(this).find(".amount").prop("readonly", false);

                $("#TotalPaid").prop("readonly", false);

                // Cash condition
                if (paymentType === "Cash") {
                    $(this).find(".referenceNumber").val('').prop("readonly", true);
                } else {
                    $(this).find(".referenceNumber").prop("readonly", false);
                }
            }
        });
    }

    // 🔹 Payment Status change
    $("input[name='PaymentStatus']").change(function () {
        toggleFields();
    });

    // 🔹 Payment Type change
    $(document).on("change", ".paymentType", function () {
        toggleFields();
    });

    // 🔹 Only numbers allow (amount fields)
    $(document).on("keypress", ".amount, #TotalPaid", function (e) {
        if ((e.which != 46 || $(this).val().indexOf('.') != -1) &&
            (e.which < 48 || e.which > 57) &&
            e.which != 8) {
            return false;
        }
    });

    // 🔹 Calculate Total Paid from rows
    function calculateTotalPaid() {
        var total = 0;

        $(".amount").each(function () {
            total += parseFloat($(this).val()) || 0;
        });

        $("#TotalPaid").val(total);

        var finalTotal = parseFloat($("#txtFinalTotal").val()) || 0;
        var remaining = finalTotal - total;

        $("#RemainingAmount").val(remaining);

        if (total > finalTotal) {
            $("#idmismatchAmount").text("Paid amount exceeds total!");
        } else {
            $("#idmismatchAmount").text("");
        }
    }

