<script>

function OpenBillModel(Id, AppointmentFid) {
    $('#Id').val(Id);
    $('#AppointmentFid').val(AppointmentFid);

    $.ajax({
        type: 'GET',
        dataType: 'JSON',
        url: '@Url.Action("GetOutstandingBillDetails")',
        data: { Id: Id, AppointmentFid: AppointmentFid },
        success: function (data) {
            debugger
            //var GenerateBill = data.GetBillList || [];
            //var tableBody = $("#tblGenerateBillRecord tbody");
            //tableBody.empty();
            var TotalAmount = data.TotalAmount;
            var TotalPaid = data.TotalPaid;
            var RemainingAmount = data.RemainingAmount;
            var PatientFid = data.PatientFid;

            $("#txtFinalTotal").val(TotalAmount.toFixed(2));
            $("#RemainingAmount").val(RemainingAmount.toFixed(2));
            $("#TotalPaid").val(TotalPaid.toFixed(2));
            $("#txtAmount").val(RemainingAmount.toFixed(2));

            $("#txtAppointmentFid").val(AppointmentFid);
            $("#PatientFid").val(data.PatientFid);
            $("#txtEncounterFid").val(data.EncounterFid);
            $("#txtBill_Fid").val(data.FinalBillFid);
            $("#txtDiscount").val(data.DiscountAmt);
            $("#txtFinalPaybalAmount").val(data.TotalAmount);

            //$("#").val(totalPayableAmount.toFixed(2));

            // set Total + Remaining


            // Reset dynamic rows container
            $("#paymentRowsContainer").find(".payment-row").not(":first").remove();

            // If previous payment exists, refill
            var FinalBills = data.GetFinalbillDetails || [];
            if (FinalBills.length > 0) {
                let usedAmount = 0;
                let count = 1;

                $.each(FinalBills, function (i, item) {
                    function getVal(key) {
                        let f = item.find(obj => obj.Key === key);
                        return f ? f.Value : "";
                    }

                    let pMode = getVal("PaymentMode");
                    let pRef = getVal("PaymentReferenceNumber");
                    let amt = parseFloat(getVal("Amount")) || 0;

                    if (count === 1) {
                        $("#ddlPaymentType").val(pMode);
                        $("#txtReference").val(pRef);
                        $("#txtAmount").val(amt);
                    } else {
                        addPaymentRow(pMode, pRef, amt);
                    }
                    usedAmount += amt;
                    count++;
                });

                let remaining = TotalAmount - usedAmount;
                $("#RemainingAmount").val(remaining.toFixed(2));
            }

            $("#bill-modal___BV_modal_outer_").show().addClass("show");
        }
    });
}

