$(document).ready(function () {

    // 1. Reference Number Readonly Logic (For Cash)
    $(document).on('change', '.paymentType', function () {
        var row = $(this).closest('.payment-row');
        var refInput = row.find('.referenceNumber');

        if ($(this).val() === "Cash") {
            refInput.val('').attr('readonly', true).css('background-color', '#e9ecef');
        } else {
            refInput.attr('readonly', false).css('background-color', '#ffffff');
        }
    });

    // 2. Real-time Amount Comparison
    $(document).on('keyup input', '.amount', function () {
        var enteredAmount = parseFloat($(this).val()) || 0;
        var payableAmount = parseFloat($("#RemainingAmount").val()) || 0;

        if (enteredAmount > payableAmount) {
            $(this).css('border', '2px solid red');
            $("#idmismatchAmount").text("Warning: Entered amount exceeds the remaining payable balance.")
                                 .css('color', 'red').show();
        } else {
            $(this).css('border', '1px solid #ced4da');
            $("#idmismatchAmount").hide();
        }
    });

    // 3. Submit Button Logic
    $("#submitButton").click(function (e) {

        debugger;
        var isValid = true;
        var errorMessage = "";
        var totalPayableLimit = parseFloat($("#RemainingAmount").val()) || 0;
        var totalUserEntered = 0;

        // Clear previous errors
        $("#idmismatchAmount").hide().text("");

        // Payment Status selection check
        if (!$("input[name='PaymentStatus']:checked").val()) {
            errorMessage = "Please select a Payment Status.";
            isValid = false;
        }

        // Row-wise Validation
        if (isValid) {
            $(".payment-row").each(function (index) {
                var rowNum = index + 1;
                var type = $(this).find(".paymentType").val();
                var ref = $(this).find(".referenceNumber").val();
                var amt = parseFloat($(this).find(".amount").val()) || 0;
                totalUserEntered += amt;

                if (type === "") {
                    errorMessage = "Please select Payment Type" ;
                    isValid = false; return false;
                }

                //if (type !== "Cash" && ref.trim() === "") {
                //    errorMessage = "Reference Number is mandatory .";
                //    isValid = false; return false;
                //}

                if (amt <= 0) {
                    errorMessage = "Please enter a valid amount " ;
                    isValid = false; return false;
                }
            });
        }

        // Final Total Check
        if (isValid && totalUserEntered > totalPayableLimit) {
            errorMessage = "Total Paid amount (" + totalUserEntered + ") cannot be greater than Payable amount (" + totalPayableLimit + ").";
            isValid = false;
        }

        // If validation fails, show error in #idmismatchAmount and stop
        if (!isValid) {
            $("#idmismatchAmount").text(errorMessage).css('color', 'red').show();
            return false;
        }

        // --- AJAX Start ---
        var paymentList = [];
        $(".payment-row").each(function () {
            paymentList.push({
                PaymentType: $(this).find(".paymentType").val(),
                ReferenceNumber: $(this).find(".referenceNumber").val(),
                Amount: $(this).find(".amount").val(),
                AppointmentFid: $("#txtAppointmentFid").val(),
                PatientFid: $("#txtPatientFid").val(),
           
                EncounterFid: $("#txtEncounterFid").val(),
                Id: $("#Id").val(),
                PatientFid: $("#PatientFid").val(),
                Discount: $("#txtDiscount").val(),
                FinalPaybalAmount: $("#txtFinalPaybalAmount").val(),
                finalAmount: $("#txtFinalTotal").val(),
                PaymentStatus: $("input[name='PaymentStatus']:checked").val()
            });
        });
        //var finalbill1 = {
        //    PaymentType: $(this).find(".paymentType").val(),
        //    ReferenceNumber: $(this).find(".referenceNumber").val(),
        //    Amount: $(this).find(".amount").val(),

        //    AppointmentFid: $("#txtAppointmentFid").val(),
        //    PatientFid: $("#txtPatientFid").val(),
        //    EncounterFid: $("#txtEncounterFid").val(),
        //    Id: $("#Id").val(),
        //    PatientFid: $("#PatientFid").val(),
        //    Discount: $("#txtDiscount").val(),
        //    FinalPaybalAmount: $("#txtFinalPaybalAmount").val(),
        //    finalAmount: $("#txtFinalTotal").val(),

        //    PaymentStatus: $("input[name='PaymentStatus']:checked").val()
        //};

        $.ajax({
            type: 'POST',
            url: '@Url.Action("SaveAndCloseEncounter")',
            data: JSON.stringify({ paymentList: paymentList, ISOutStandingAmt: "Yes" }),
            contentType: "application/json; charset=utf-8",
            dataType: 'JSON',
            success: function (data) {
                if (data.success) {
                    window.location.href = '@Url.Action("MedicineOutstandingBill")';
