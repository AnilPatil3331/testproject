<style>
    .body {
        background-color: white !important;
    }

    .card {
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    }

    .form-group {
        position: relative;
    }

    hr {
        margin: 0;
        margin-bottom: 10px;
    }

    .form-control {
        border: 1px solid #ccc;
        background: transparent;
        width: 100%;
        color: #000;
        border-radius: 0;
        min-height: 38px;
    }

        .form-control::placeholder {
            color: transparent;
        }

        .form-control:focus {
            outline: none;
            border-color: #007bff;
            background: transparent;
        }

    .form-row .form-title {
        font-weight: 600;
        color: #000;
        margin: 10px;
    }

    .form-check {
        margin: 0 10px;
    }

    .form-check-input {
        margin-left: -1rem;
    }

    .floating-label {
        position: absolute;
        top: 0.5rem;
        left: 0.75rem;
        transition: all 0.2s ease;
        pointer-events: none;
        color: #3f5368;
        font-size: 14px;
        z-index: 2;
        padding: 0 5px;
        background-color: white;
    }

    .form-control:focus ~ .floating-label,
    .form-control:not(:placeholder-shown) ~ .floating-label {
        top: -0.6rem;
        left: 0.65rem;
        font-size: 12px;
        color: #007bff;
        z-index: 2;
        background-color: #fff;
    }

    .card-title {
        font-weight: 600;
        color: #333;
    }

    input::placeholder {
        color: gray !important;
        opacity: 1;
        /* Ensure it's not faded */
    }

    .input-group-supportx {
        height: max-content;
        padding: .375rem .75rem;
        font-size: .875rem;
        line-height: 1.5;
        color: #4F5467;
        text-align: center;
        background-color: #f8f9fa;
