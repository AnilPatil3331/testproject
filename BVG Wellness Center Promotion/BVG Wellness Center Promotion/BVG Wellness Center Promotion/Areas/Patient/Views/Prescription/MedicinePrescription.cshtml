<script>
    $(document).ready(function () {
        $('#searchInput').on('input', function () {
            var query = $(this).val().trim();

            if (query.length >= 1) {
                $.ajax({
                    url: '@Url.Action("SearchOPD", "Prescription")',
                    type: 'GET',
                    data: { searchTerm: query },
                    success: function (data) {
                        debugger;
                        let html = "";
                        if (data.length > 0) {
                            html += "<ul class='list-group mb-0'>";

                            $.each(data, function (i, item) {
                                html += "<li class='list-group-item list-group-item-action' " + "style='cursor:pointer;' onclick='selectPatient(" + item.AppointmentFid + ")'>";

                                html += "<span>" + item.FullName + " | " + item.ContactNumber + " | " + item.UHIDNO + " | " + item.FDate + "</span>";

                                html += "</li>";

                            });

                            html += "</ul>";
                        } else {
                            html = "<div class='p-2 text-muted'>No matches found</div>";
                        }

                        $('#searchResult').html(html).show();
                    },
                    error: function () {
                        $('#searchResult').html('<div class="p-2 text-danger">Error fetching data</div>').show();
                    }
                });
            } else {
                $('#searchResult').hide();
            }
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#searchInput, #searchResult').length) {
                $('#searchResult').hide();
            }
        });
    });

    function selectPatient(appointmentId) {
        window.location.href = '/patient/Prescription/MedicinePrescription?AppoinmentID=' + appointmentId;
    }
</script>

<script>
    document.getElementById("billPrint").addEventListener("click", function () {

        // Get printable area
        var printArea = document.getElementById("PrintArea");

        if (!printArea) {
            alert("Print content not found");
            return;
        }

        // Clone content
        var clonedContent = printArea.cloneNode(true);

        // Convert textarea to plain text (remove border in print)
        clonedContent.querySelectorAll("textarea").forEach(function (t) {
            var text = document.createElement("div");
            text.style.whiteSpace = "pre-wrap";
            text.innerText = t.value.trim();
            t.parentNode.replaceChild(text, t);
        }); 4

        // Remove footer buttons from print
        var footer = clonedContent.querySelector("#PrintFooter");
        if (footer) {
            footer.remove();
        }

        // Open print window
        var printWindow = window.open("", "", "width=900,height=650");

        printWindow.document.write(`
            <html>
            <head>
                <title>Invoice Print</title>

