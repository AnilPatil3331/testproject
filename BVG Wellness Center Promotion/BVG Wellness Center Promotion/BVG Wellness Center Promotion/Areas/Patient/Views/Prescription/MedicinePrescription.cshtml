<script>
    var isUpdateMode = false;
    $(document).on("change", "#ddlServiceName", function (){
        debugger;
        if (isUpdateMode) {
            return; // 🚫 update mode मध्ये auto भरू नको
        }
        var GetServiceId=$("#ddlServiceName").val();
        var selectedServiceName = $("#ddlServiceName option:selected").text();
        $("#txtServiceName").val(selectedServiceName);
        $.ajax({
            type: 'GET',
            dataType: 'JSON',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetMedicinePrice", "Prescription")',
            data: { GetServiceId: GetServiceId },
            success: function (data) {
                debugger;
                if (data != null) {
                    debugger
                    var Price=data.GetServicePrice;
                    $("#txtPrice").val(data);
                    if (!isUpdateMode) {
                        $("#txtQuantity").val(1);
                    }
                    $("#txtTotal").val(data);
                }
            }

        })
        isUpdateMode = false;
    });
    $(document).on("input", "#txtPrice, #txtQuantity, #txtTotal", function () {

        let value = $(this).val();

        // ❌ remove special char
        value = value.replace(/[^0-9.]/g, '');

        let parts = value.split('.');

        // 🔹 max 4 digit before decimal
        if (parts[0].length > 4) {
            parts[0] = parts[0].substring(0, 4);
        }

        // 🔹 max 2 decimal
        if (parts.length > 1) {
            parts[1] = parts[1].substring(0, 2);
            value = parts[0] + '.' + parts[1];
        } else {
            value = parts[0];
        }

        $(this).val(value);
    });
    $("#txtQuantity").on("keyup", function () {
        debugger
        var GetPrice = parseFloat($("#txtPrice").val()) || 0; // Ensure Price is selected correctly and defaults to 0 if empty

        var Quantity = parseFloat($(this).val()) || 0; // Parse quantity and handle non-numeric input
        var TotalPrice = GetPrice * Quantity;
        $("#txtTotal").val(TotalPrice.toFixed(2)); // Fix total to 2 decimal places
    });


    $("#txtDiscount").on("keyup", function () {
        debugger

        var totalAmount = parseFloat($("#txtFinalTotal").val()) || 0;


        // Ensure Discount is parsed correctly or defaults to 0
        var discount = parseFloat($(this).val()) || 0;

        //var totalPayableAmount = totalAmount - discount;
        var totalPayableAmount = totalAmount - (totalAmount * discount / 100);

        // Ensure the total payable amount is not negative
        if (totalPayableAmount < 0) {
            $("#txtFinalPaybalAmount").val(totalAmount.toFixed(2));
        }

        // Set the calculated total payable amount to 2 decimal places in the input field
        $("#txtFinalPaybalAmount").val(totalPayableAmount.toFixed(2));
        $("#txtAmount").val(totalPayableAmount.toFixed(2));
    });

    $("#BtnSaveBill").click(function(){
        debugger;
        //var Bill = {
        let isValid = true;
        let errorMessage = "";

        let product = $("#ddlServiceName").val();
        let price = parseFloat($("#txtPrice").val()) || 0;
        let qty = parseFloat($("#txtQuantity").val()) || 0;
        let total = parseFloat($("#txtTotal").val()) || 0;

        // Product
        if (!product) {
            isValid = false;
            errorMessage += "Please select Product.\n";
        }

        // Price
        if (price <= 0) {
            isValid = false;
            errorMessage += "Enter valid Price.\n";
        }

        // Quantity
        if (qty <= 0) {
            isValid = false;
            errorMessage += "Enter valid Quantity.\n";
        }

        // Total check
        if (total <= 0) {
            isValid = false;
            errorMessage += "Total should be greater than 0.\n";
        }

        // 🔥 Total mismatch check
        if (total !== parseFloat((price * qty).toFixed(2))) {
            isValid = false;
            errorMessage += "Total should be Price × Quantity.\n";
        }

        if (!isValid) {
            alert(errorMessage);
            return false;
        }

        var Bill_Fid = $("#txtBill_Fid").val();
        var Bill_Fid_Encrapted= $("#txtBill_Fid_Encrapted").val();
        var  ServiceFid= $("#ddlServiceName").val();
        var Price=$("#txtPrice").val();
        var Quantity=$("#txtQuantity").val();
        var Total=$("#txtTotal").val();
        var  EncounterFid=$("#EncounterFid").val();
        //AppointmentFid:$("#AppointmentFid").val(),
        var  Service_Fid=$("#Service_Fid").val();

        //};
        var AppointmentFid=$("#AppointmentFid").val();
        var PatientID=$("#PatientID").val();
        $.ajax({

            //dataType: 'JSON',
            //contentType: "application/json; charset=utf-8",
            url: '@Url.Action("SaveGenerateBill")',
            type: 'Post',
            data:{AppointmentFid:AppointmentFid ,PatientID:PatientID, Bill_Fid:Bill_Fid,  Bill_Fid_Encrapted:Bill_Fid_Encrapted, ServiceFid:ServiceFid, Price:Price , Quantity:Quantity ,Total:Total , EncounterFid:EncounterFid,Service_Fid:Service_Fid},
            //data: JSON.stringify({
            //    Bill: Bill,
            //    AppointmentFid: AppointmentFid
            //}),
            success: function (data) {
                debugger;
                if (data != null) {
                    debugger
                    var GenerateBill = data.GetBillList || [];

                    // Get the table body where rows should be added
                    var tableBody = $("#tblGenerateBill tbody");

                    // Clear any existing rows
                    tableBody.empty();

                    // Check if data exists
                    if (GenerateBill.length > 0) {
                        // Iterate through the prescription list and append rows
                        var TotalAmount = 0; // Initialize TotalAmount
                        var Count = 0;
                        $.each(GenerateBill, function (i, item) {
                            var row = "";
                            var ServiceName = "";
                            var MedicineName = "";
                            var Price = "";
                            var Quantity = "";
                            var Total = "";
                            var Bill_Fid = "";
                            var Bill_Fid_Encrapted = "";
                            var EncounterFid="";

                            // Iterate over key-value pairs in the item
                            $.each(item, function (index, pair) {
                                if (pair.Key === "Bill_Fid_Encrapted") {
                                    Bill_Fid_Encrapted = pair.Value;
                                }
                                if (pair.Key === "Bill_Fid") {
                                    Bill_Fid = pair.Value;
                                }
                                if (pair.Key === "ServiceName") {
                                    ServiceName = pair.Value;
                                }
                                if(pair.Key=="MedicineName")
                                {
