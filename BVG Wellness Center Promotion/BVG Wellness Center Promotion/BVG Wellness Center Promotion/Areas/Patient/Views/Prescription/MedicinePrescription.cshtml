            if (data.success) {
            //    alert("Data Saved Successfully!");

                //// 1. Modal band kara (CSS ne)
                //$("#bill-modal___BV_modal_outer_")
                //    .css("display", "none")
                //    .attr("aria-hidden", "true")
                //    .removeClass("show");

                //// 2. Background cha grey parda (backdrop) kadhun taka
                //$(".modal-backdrop").remove();
                //$("body").removeClass("modal-open");
            // Tumchya ViewBag pramane 'AppoinmentID' vapra
        var appId = $("#AppointmentFid").val();

        // Controller chya parameter name shi match kara (AppoinmentID)
        window.location.href = '@Url.Action("MedicinePrescription")' + '?AppoinmentID=' + appId;
            } else {
                alert(data.message);
            }
        }
    });
});
    $(document).on("input", ".amount", function () {

        let value = $(this).val();

        // allow only numbers and dot
        value = value.replace(/[^0-9.]/g, '');

        // split integer & decimal
        let parts = value.split('.');

        // 🔹 integer part max 4 digits
        if (parts[0].length > 4) {
            parts[0] = parts[0].substring(0, 4);
        }

        // 🔹 decimal part max 2 digits (optional but recommended)
        if (parts.length > 1) {
            parts[1] = parts[1].substring(0, 2);
            value = parts[0] + '.' + parts[1];
        } else {
            value = parts[0];
        }

        $(this).val(value);
    });
</script>
