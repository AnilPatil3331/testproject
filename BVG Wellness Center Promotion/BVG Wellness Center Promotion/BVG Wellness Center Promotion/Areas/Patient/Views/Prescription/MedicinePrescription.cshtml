<script>
    $(document).ready(function () {

        // =========================
        // 🔹 DISCOUNT VALIDATION (0–100, no minus, no char)
        // =========================
        $("#txtDiscount").on("input", function () {

            let val = $(this).val();

            // only number
            val = val.replace(/[^0-9]/g, '');

            // max 100
            if (parseInt(val) > 100) {
                val = "100";
            }

            $(this).val(val);

            calculatePayable();
        });


        // =========================
        // 🔹 CALCULATE PAYABLE
        // =========================
        function calculatePayable() {

            let total = parseFloat($("#txtFinalTotal").val()) || 0;
            let discount = parseFloat($("#txtDiscount").val()) || 0;

            let finalAmount = total - ((total * discount) / 100);

            $("#txtFinalPaybalAmount").val(finalAmount.toFixed(2));

            // first row auto fill
            $(".amount").first().val(finalAmount.toFixed(2));

            checkAmountMatch();
        }


        // =========================
        // 🔹 AMOUNT VALIDATION (no minus, no char)
        // =========================
        $(document).on("input", ".amount", function () {

            let val = $(this).val();

            val = val.replace(/[^0-9.]/g, '');

            // only one decimal
            if ((val.match(/\./g) || []).length > 1) {
                val = val.slice(0, -1);
            }

            $(this).val(val);

            checkAmountMatch();
        });


        // =========================
        // 🔹 PAYMENT TYPE (Cash → reference readonly)
        // =========================
        $(document).on("change", ".paymentType", function () {

            let row = $(this).closest(".payment-row");
            let type = $(this).val();

            if (type === "Cash") {
                row.find(".referenceNumber").val("").prop("readonly", true);
            } else {
                row.find(".referenceNumber").prop("readonly", false);
            }
        });


        // =========================
        // 🔹 PAID / UNPAID
        // =========================
        $("input[name='PaymentStatus']").change(function () {

            let status = $("input[name='PaymentStatus']:checked").val();

            if (status === "Unpaid") {

                $(".paymentType").css("pointer-events", "none");
                $(".referenceNumber").val("").prop("readonly", true);
                $(".amount").prop("readonly", true);

            } else {

                $(".paymentType").css("pointer-events", "auto");
                $(".amount").prop("readonly", false);

                $(".paymentType").each(function () {

                    let row = $(this).closest(".payment-row");
                    let type = $(this).val();

                    if (type === "Cash") {
                        row.find(".referenceNumber").val("").prop("readonly", true);
                    } else {
                        row.find(".referenceNumber").prop("readonly", false);
                    }
                });
            }
        });


        // =========================
        // 🔹 AMOUNT MATCH CHECK
        // =========================
        function checkAmountMatch() {

            let payable = parseFloat($("#txtFinalPaybalAmount").val()) || 0;
            let sum = 0;

            $(".amount").each(function () {
                sum += parseFloat($(this).val()) || 0;
            });

            if (sum !== payable) {
                $("#idmismatchAmount").text("⚠ Amount mismatch");
            } else {
                $("#idmismatchAmount").text("");
            }
        }

    });


</script>
 
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>
@if (PatientDetails != null && PatientDetails != "")
{
    <text>
    $(document).on("click", "#sendToPatient", function (e) {
        e.preventDefault();

        var isCounter = $(this).closest("#PrintAreaCounter").length > 0;
        var containerId = isCounter ? "PrintAreaCounter" : "PrintArea";
        var printArea = document.getElementById(containerId);

        if (!printArea) {
            alert("Print content not found!");
            return;
        }

        var patientName = @Html.Raw(Json.Encode(PatientDetails.PatientName)) || "Patient";
        var patientMobile = @Html.Raw(Json.Encode(PatientDetails.PatientContactNumber)) || "";

        // १. प्रिंट एरियाचा हुबेहूब क्लोन (Copy) तयार करणे
        var clonedContent = printArea.cloneNode(true);

        // २. Textareas चे रुपांतर प्लेन टेक्स्ट डिव्हमध्ये (Div) करणे (जसे प्रिंट बटणावर होते)
        clonedContent.querySelectorAll("textarea").forEach(function (t) {
            var text = document.createElement("div");
            text.style.whiteSpace = "pre-wrap";
            text.style.border = "none";
            text.style.padding = "5px";
            text.style.fontSize = "14px";
            text.innerText = t.value.trim();
            t.parentNode.replaceChild(text, t);
        });

        // ३. खालील प्रिंट आणि सेंड बटन्स पीडीएफमधून काढून टाकणे
        var footer = clonedContent.querySelector("#PrintFooter");
        if (footer) {
            footer.remove();
        }

        // ४. क्लोन केलेला भाग तात्पुरता स्क्रीनच्या बाहेर ठेवणे जेणेकरून html2canvas त्याचा फोटो काढू शकेल
        clonedContent.style.position = "absolute";
        clonedContent.style.left = "-9999px";
        clonedContent.style.top = "0";
        clonedContent.style.width = "900px"; // प्रिंटचे मूळ रुंदी
        document.body.appendChild(clonedContent);

        // ५. html2canvas द्वारे डिझाईन इमेजमध्ये रूपांतरित करणे
        html2canvas(clonedContent, { scale: 2 }).then(function (canvas) {
            // तात्पुरती जोडलेली कॉपी बॉडीमधून काढून टाकणे
            document.body.removeChild(clonedContent);

            const { jsPDF } = window.jspdf;
            var pdf = new jsPDF('p', 'mm', 'a4');

            var imgData = canvas.toDataURL("image/png");
            var imgWidth = 210; // A4 Width in mm
            var pageHeight = 295; // A4 Height in mm
            var imgHeight = (canvas.height * imgWidth) / canvas.width;
            var heightLeft = imgHeight;
            var position = 0;

            pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
            heightLeft -= pageHeight;

            while (heightLeft >= 0) {
                position = heightLeft - imgHeight;
                pdf.addPage();
                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;
            }

            // ६. पीडीएफ ऑटोमॅटिकली डाऊनलोड करणे
            var filename = "Prescription_" + patientName.replace(/\s+/g, "_") + ".pdf";
            pdf.save(filename);

            // ७. व्हॉट्सॲप चॅट उघडणे
            if (patientMobile) {
                var phone = patientMobile.replace(/\D/g, '');
                if (phone.length === 10) {
                    phone = "91" + phone;
                }
                var msg = "नमस्कार, तुमची प्रिस्क्रिप्शन PDF जनरेट केली आहे. (कृपया डाऊनलोड झालेली '" + filename + "' फाईल येथे सेंड करा)";
                var whatsappUrl = "https://api.whatsapp.com/send?phone=" + phone + "&text=" + encodeURIComponent(msg);
                window.open(whatsappUrl, '_blank');
            } else {
                alert("Patient mobile number not found!");
            }
        }).catch(function (error) {
            // एरर आल्यास तात्पुरती कॉपी डिलीट करणे
            if (document.body.contains(clonedContent)) {
                document.body.removeChild(clonedContent);
            }
            console.error("PDF generation error:", error);
            alert("PDF generation failed: " + error);
        });
    });
    </text>
}
</script>
