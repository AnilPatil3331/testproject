<script>
$("#submitButton").click(function (e) {

    debugger;

    let isValid = true;
    let errorMessage = "";

    // 1. Payment Status
    if (!$('input[name="PaymentStatus"]:checked').val()) {
        isValid = false;
        errorMessage += "Please select Payment Status (Paid/Unpaid).\n";
    }
    var reference = $(this).find(".referenceNumber").val();

    if (reference && reference.length > 50) {
        errorMsg = "Reference cannot be more than 50 characters";
        isValid = false;
        return false;
    }
    // 2. If Paid
    if ($('#paidRadio').is(':checked')) {

        const paymentType = $('#ddlPaymentType').val();
        const reference = $('#txtReference').val().trim();
        const amount = $('#txtAmount').val().trim();

        if (paymentType === "") {
            isValid = false;
            errorMessage += "Please select a Payment Type.\n";
        }

        //if (paymentType !== "Cash" && paymentType !== "" && reference === "") {
        //    isValid = false;
        //    errorMessage += "Reference number is required for " + paymentType + ".\n";
        //}

        if (amount === "" || parseFloat(amount) <= 0) {
            isValid = false;
            errorMessage += "Please enter a valid Amount.\n";
        }

        // 🔹 Payable vs Amount Validation (🔥 OUTSIDE)
        var payable = parseFloat($("#txtFinalPaybalAmount").val()) || 0;
        var totalEnteredAmount = 0;

        // multiple rows sum
        $(".payment-row .amount").each(function () {
            let amt = parseFloat($(this).val()) || 0;
            totalEnteredAmount += amt;
        });

        // decimal fix
        totalEnteredAmount = parseFloat(totalEnteredAmount.toFixed(2));
        payable = parseFloat(payable.toFixed(2));

        // ❌ If amount greater than payable
        if (totalEnteredAmount > payable) {
            isValid = false;
            errorMessage += "Entered amount cannot be greater than Payable amount.\n";
        }
    }

    // ❌ STOP if invalid
    if (!isValid) {
        e.preventDefault();
        alert(errorMessage);
        return false;
    }

    // ✅ AJAX only if valid
    var paymentList = [];

    $(".payment-row").each(function () {

        var paymentType = $(this).find(".paymentType").val();
