<script>
    $(document).ready(function () {

        $("#txtDiscount").on("input", function () {

            let val = $(this).val();

            // ❌ remove special characters (only number + dot)
            val = val.replace(/[^0-9.]/g, '');

            // ❌ only one decimal allowed
            if ((val.match(/\./g) || []).length > 1) {
                val = val.substring(0, val.length - 1);
            }

            // ❌ no leading dot
            if (val.startsWith(".")) {
                val = val.substring(1);
            }

            // ❌ limit to 100
            if (parseFloat(val) > 100) {
                val = "100";
            }

            $(this).val(val);
        });

        // ❌ negative value prevent (extra safety)
        $("#txtDiscount").on("keydown", function (e) {
            if (e.key === "-" || e.key === "e") {
                e.preventDefault();
            }
        });

        // ❌ blur validation (final check)
        $("#txtDiscount").on("blur", function () {
            let val = parseFloat($(this).val());

            if (isNaN(val) || val < 0) {
                $(this).val("0");
            }

            if (val > 100) {
                $(this).val("100");
            }
        });

    });
</script>

<script>
    $(document).ready(function () {

        function handlePaymentFields() {

            var status = $("input[name='PaymentStatus']:checked").val();
            var paymentType = $("#ddlPaymentType").val();

            // 🔴 UNPAID
            if (status === "Unpaid") {

                // ❌ disable nahi — readonly kara
                $("#ddlPaymentType").css("pointer-events", "none"); // dropdown readonly feel
                $("#txtReference").val("").prop("readonly", true);
                $("#txtAmount").prop("readonly", true);

            } 
            else {

                // enable back
                $("#ddlPaymentType").css("pointer-events", "auto");
                $("#txtAmount").prop("readonly", false);

                // 🟢 CASH
                if (paymentType === "Cash") {
                    $("#txtReference").val("").prop("readonly", true);
                } 
                else {
                    $("#txtReference").prop("readonly", false);
                }
            }
        }

        // on load
        handlePaymentFields();

        // status change
        $("input[name='PaymentStatus']").change(function () {
            handlePaymentFields();
        });

        // payment type change
        $("#ddlPaymentType").change(function () {
            handlePaymentFields();
        });

    });
    $(document).ready(function () {

        // ❌ minus & e block
        $("#txtAmount").on("keydown", function (e) {
            if (e.key === "-" || e.key === "e") {
                e.preventDefault();
            }
        });

        // ❌ special characters remove (only number + decimal)
        $("#txtAmount").on("input", function () {

            let val = $(this).val();

            // allow only numbers & dot
            val = val.replace(/[^0-9.]/g, '');

            // only one dot allow
            if ((val.match(/\./g) || []).length > 1) {
                val = val.substring(0, val.length - 1);
            }

            $(this).val(val);
        });

        // ❌ blur validation (final check)
        $("#txtAmount").on("blur", function () {
            let val = parseFloat($(this).val());

            if (isNaN(val) || val < 0) {
                $(this).val("0");
            }
        });

    });
</script>
