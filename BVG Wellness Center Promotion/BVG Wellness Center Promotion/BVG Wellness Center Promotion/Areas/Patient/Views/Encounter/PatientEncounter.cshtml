        height: 50px !important; /* Adjust as needed */
        line-height: 50px !important;
    }

    /* Increase the height of the selected text inside select2 */
    #ddlServiceName + .select2-container .select2-selection__rendered {
        line-height: 50px !important;
        padding-top: 5px !important;
    }

    /* Increase the height of the dropdown options */
