        $("#uploadButton").click(function () {
            debugger;
            let btn = $(this);
            let originalHtml = btn.html();
            btn.html('<span class="spinner-border spinner-border-sm"></span> Uploading...').prop("disabled", true);

            var formData = new FormData(); // Create a new FormData object

            // Append multiple files for each input field
            function appendFiles(inputId, fieldName) {
                let input = $(inputId)[0];
                if (input.files.length > 0) {
                    for (let i = 0; i < input.files.length; i++) {
                        formData.append(fieldName, input.files[i]); // Append each file with array notation
                    }
                }
            }

            appendFiles("#casePaper", "casePaper");
            appendFiles("#consentForm", "consentForm");
            appendFiles("#patientReport1", "patientReport1");

            // Append additional form fields
            formData.append("PatientFid", $("#PatientFid").val());
            formData.append("EncounterFid", $("#EncounterFid").val());

            // Log selected file details for debugging
            console.log("Selected Files:");
            for (let pair of formData.entries()) {
                if (pair[1] instanceof File) {
                    console.log(`Field: ${pair[0]}, Name: ${pair[1].name}, Size: ${pair[1].size} bytes, Type: ${pair[1].type}`);
                }
            }

            $.ajax({
                url: '/Encounter/SaveEncounterReport',
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    btn.html(originalHtml).prop("disabled", false);
                    $("#uploadReportModal").modal("hide"); // Close modal
                    var message = response.Message;
                    var alertType = response.Icon;
                    var imageUrl = '@Url.Content("~/assets/images/check-circle.gif")';
                    showCustomAlert(message, alertType, imageUrl);
                },
                error: function () {
                    alert("Error uploading files.");
                    btn.html(originalHtml).prop("disabled", false);
                }
            });
        });


