        padding: 10px !important;
    }
    /* Style the dropdown to ensure consistency */
    .dropdown-menu {
        width: 100%;
        max-height: 200px;
        overflow-y: auto;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }

    /* Style individual options */
    #dropdownList option {
        padding: 8px;
        cursor: pointer;
        color: #000; /* Default text color */
        background-color: #fff; /* Default background color */
    }

        /* Hover effect for options */
        #dropdownList option:hover {
            background-color: #007bff; /* Blue background on hover */
            color: #fff; /* White text color on hover */
        }

    #ddlObservations option {
        padding: 8px;
        cursor: pointer;
        color: #000; /* Default text color */
        background-color: #fff; /* Default background color */
    }

        /* Hover effect for options */
        #ddlObservations option:hover {
            background-color: #007bff; /* Blue background on hover */
            color: #fff; /* White text color on hover */
        }



    #ddlMedecineName option:hover {
        background-color: #007bff; /* Blue background on hover S*/
        color: #fff; /* White text color on hover */
    }

    #prescriptionTable {
        border: none; /* Removes table border */
        border-collapse: collapse; /* Ensures no extra space between cells */
    }

        #prescriptionTable th, #prescriptionTable td {
            border: none; /* Removes cell borders */
        }
</style>
