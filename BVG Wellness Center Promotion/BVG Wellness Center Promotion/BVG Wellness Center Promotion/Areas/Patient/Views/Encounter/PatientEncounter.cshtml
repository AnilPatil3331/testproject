        $("#ddlServiceName").select2();

        $("#UploadReportBtn").click(function () {
            var patientId = $(this).data("patient-id");
            $("#patientId").val(patientId); // Set patient ID in hidden field
            $("#uploadReportModal").modal("show");
        });

        $("#ViewReportBtn").click(function () {

            $("#ViewReportModal").modal("show");
        });

        $("#CloseFileModel").click(function(){
            $("#uploadReportModal").modal("hide"); // Close modal
        });
        $("#CloseViewFileModel").click(function(){
            $("#ViewReportModal").modal("hide"); // Close modal
        });
        var GetSpecialNote=@Html.Raw(Json.Encode(ViewBag.SpecialNote));
