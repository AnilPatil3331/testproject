    //================================Function For show Prescription in Table=====================================
    function GeneratePrescriptionTable(prescriptionList) {
        // Ensure the list is an array, default to an empty array if null/undefined
        prescriptionList = prescriptionList || [];

        // Get the table body where rows should be added
        var tableBody = $("#prescriptionTable tbody");

        // Clear any existing rows
        tableBody.empty();

        // Check if data exists
        if (prescriptionList.length > 0) {
            // Iterate through the prescription list and append rows
            $.each(prescriptionList, function (i, item) {
                var row = "";
                var medicineName = "";
                var Frequency = "";
                var Duration = "";
                var Instruction = "";
                var Fid_Encrypted = "";

                // Iterate over key-value pairs in the item
                $.each(item, function (index, pair) {
                    if (pair.Key === "Fid_Encrypted") {
                        Fid_Encrypted = pair.Value;
                    }
                    if (pair.Key === "MedicineName") {
                        medicineName = pair.Value;
                    }
                    if (pair.Key === "Frequency") {
                        Frequency = pair.Value;
                    }
                    if (pair.Key === "Duration") {
                        Duration = pair.Value;
                    }
                    if (pair.Key === "Instruction") {
                        Instruction = pair.Value;
                    }

                });

                // Construct the row dynamically
                row = `
                <tr class ="animated fadeInUp">
                   <td class ="fixed-width">
                          <span style="color: #4874dc;font-weight: bold;">${medicineName}</span><br>
                         <span class ="instruction">${Instruction}</span>
                     </td>
                     <td>${Frequency}</td>
                     <td>${Duration} Days</td>
                    <td>
                        <div role="group" class="btn-group btn-group-sm">
                              <button title="Edit" type="button" class ="btn btn-sm btn-outline-primary" onclick="UpdatePrescription('${Fid_Encrypted}')">
                                 <i class ="fa fa-pen-alt"></i>
                            </button>
                            <button title="Delete" type="button" class="btn btn-outline-danger" onclick="DeletePrescription('${Fid_Encrypted}')">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>`;

                // Append the row to the table body
                tableBody.append(row);
            });
        } else {
            // Show "No prescription found" if no data exists
            var noDataRow = `
