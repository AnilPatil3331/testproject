<script>
    $(document).ready(function () {
        debugger;
        const loader = document.getElementById('loader');
        loader.classList.add('hidden');

        $("#ddlclinicFid").select2();
        $("#ddlDoctorFid").select2();
        $("#ddlPatientFid").select2();

        var fromDoctorAppointmentList=@Html.Raw(Json.Encode(ViewBag.fromDoctorAppointmentList));
        if(fromDoctorAppointmentList!=null)
        {
            $("#encounterDataForm").show();
            // Update the button text to "Close"
            $("#AddEncounter").html('<i class="fa fa-times"></i> Close');
        }
        var ShowAddPatientForm=@Html.Raw(Json.Encode(ViewBag.ShowAddPatientForm));
        if(ShowAddPatientForm!=null)
        {
            $("#encounterDataForm").show();
            // Update the button text to "Close"
            $("#AddEncounter").html('<i class="fa fa-times"></i> Close');
        }

        $("#AddEncounter").click(function () {
            // Toggle the visibility of the bill item add form
            $("#encounterDataForm").slideToggle(function () {
                // Change button text based on the updated state of the form
                if ($("#encounterDataForm").is(":visible")) {
                    // If the form is visible, change the button text to "Close"
                    $("#AddEncounter").html('<i class="fa fa-times"></i> Close');
                } else {
                    // If the form is hidden, change the button text back to "Add Bill Item"
                    $("#AddEncounter").html('<i class="fa fa-plus"></i> Add Encounter');
                }
            });
        });


        $("#btnCancel").click(function () {
            // Toggle the visibility of the bill item add form
            $("#encounterDataForm").slideToggle(function () {
                // Change button text based on the updated state of the form
                if ($("#encounterDataForm").is(":visible")) {
                    // If the form is visible, change the button text to "Close"
                    $("#AddEncounter").html('<i class="fa fa-times"></i> Close Form');
                    var url = '@Url.Action("EncounterList", "Encounter")'; // Ensure server-side helper is properly rendered
                    window.location.href = url; // Navigate to the new URL
                } else {
                    // If the form is hidden, change the button text back to "Add Bill Item"
                    $("#AddEncounter").html('<i class="fa fa-plus"></i> Add Service');
                    var url = '@Url.Action("EncounterList", "Encounter")'; // Ensure server-side helper is properly rendered
                    window.location.href = url; // Navigate to the new URL
                }
            });
