                                $("#ddlPatientFid").append("<option value='" + p.Id + "'>" + p.Name + "</option>");
                            });
                        }
                    } else {
                        $('#ErrorESSPassword').html(" ");
                    }


                }
            })
        });      
    });

    $('#file').on('change', function () {
        var fileName = $(this).val().split('\\').pop(); // Get the file name
