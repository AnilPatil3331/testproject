                                    <div id="collapseCasePaper2" style="display: block; transition: all 0.3s ease;">
                                        <div class="diagnosis-results mb-4 p-3" style="background: #f9f9f9; border-radius: 8px; border: 1px solid #ddd;">
                                            <div class="table-responsive">
                                                <table class="table table-bordered mb-0">
                                                    <tbody>
                                                        @* 1. Vitals (शारीरिक तपासणी) *@
                                                        @if (Model.Height.HasValue || Model.Weight.HasValue || !string.IsNullOrEmpty(Model.BloodPressure) || Model.Pulse.HasValue)
                                                        {
                                                            <tr>
                                                                <td style="width: 25%; background:#f1f1f1;"><b>Vitals (तपासणी):</b></td>
