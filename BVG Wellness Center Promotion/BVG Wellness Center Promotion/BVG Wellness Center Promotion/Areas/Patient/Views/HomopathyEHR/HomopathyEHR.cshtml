                                                                    @if (!string.IsNullOrEmpty(Model.ExpectedOutcome))
                                                                    {<div><b>Expected Outcome:</b> @Model.ExpectedOutcome</div>}
                                                                </td>
                                                            </tr>
                                                        }

                                                        @* 11. Red-Flag Advice (धोक्याची लक्षणे) *@
                                                        @if (Model.RF_FeverIncrease || Model.RF_SeverePain || Model.RF_SuddenWorsening || Model.RF_VomitingBleeding || Model.RF_DizzinessFainting || Model.RF_NoImprovement || !string.IsNullOrEmpty(Model.RF_Other))
                                                        {
