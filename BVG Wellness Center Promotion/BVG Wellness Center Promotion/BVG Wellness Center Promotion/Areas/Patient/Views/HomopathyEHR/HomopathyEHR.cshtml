            <div class="col-md-4 form-group">
                <select class="form-control fluidQuantityCounter">
                    ${$("#FluidQuantityIDCounter").html()}
                </select>
            </div>
            <div class="col-md-3 form-group">
                <select class="form-control fluidVehicleCounter">
                    ${$("#FluidVehicleIDCounter").html()}
                </select>
            </div>
            <div class="col-md-1 mt-2">
                <button type="button" class="btn btn-sm btn-danger removeFluidMixCounter">x</button>
            </div>
        </div>`;
            $(".fluidMixSectionCounter").append(row);
        });

        /* ===============================
           ❌ REMOVE FLUID MIX
        =============================== */
        $(document).on("click", ".removeFluidMixCounter", function () {
            debugger
            $(this).closest(".fluidMixRowCounter").remove();
        });

        /* ===============================
           ➕ ADD PRESCRIPTION
        =============================== */
        $(document).on("click", ".addPrescriptionCounter", function () {
            debugger
            if (!$("#FormIDCounter").val() ||
                !$("#PackageIDCounter").val() ||
                !$("#NumberLeftIDCounter").val() ||
                !$("#formulaIdCounter").val()) {
                alert("⚠ Please select Form, Package and Pack Number");
                return;
            }
            // 🔹 Prescription ID ghyaycha (Jar 0 nasel tar hi Edit case aahe)
            let currentId = $("#PrescriptionIDCounter").val() || 0;

            let instruction =
                $("#FormIDCounter option:selected").text() + " " +
                $("#PackageIDCounter option:selected").text() + " " +
                $("#NumberLeftIDCounter option:selected").text() + " " +
                $("#formulaIdCounter option:selected").text() + " = ";





            /* 🔹 DOSE */
            if ($("#DoseNumberIDCounter").val() &&
                $("#QuantityIDDoseCounter").val() &&
                $("#TimeIDCounter").val()) {

                instruction +=
                    $("#DoseNumberIDCounter option:selected").text() + " " +
                    $("#QuantityIDDoseCounter option:selected").text() + " " +
                    $("#TimeIDCounter option:selected").text();
            }

            /* 🔹 FLUID MIXING */
            let fluidMixing = [];
            debugger
            if ($("#FluidNumberIDCounter").val() &&
                $("#FluidQuantityIDCounter").val() &&
                $("#FluidVehicleIDCounter").val()) {

                fluidMixing.push({
                    FluidNumberID: $("#FluidNumberIDCounter").val(),
                    FluidQuantityID: $("#FluidQuantityIDCounter").val(),
                    FluidVehicleID: $("#FluidVehicleIDCounter").val()
                });

                instruction += " + " +
                    $("#FluidNumberIDCounter option:selected").text() + " " +
                    $("#FluidQuantityIDCounter option:selected").text() + " " +
                    $("#FluidVehicleIDCounter option:selected").text();
            }

            $(".fluidMixRowCounter").each(function () {
                debugger
                let fn = $(this).find(".fluidNumberCounter").val();
                let fq = $(this).find(".fluidQuantityCounter").val();
                let fv = $(this).find(".fluidVehicleCounter").val();

                if (fn && fq && fv) {
                    fluidMixing.push({
                        FluidNumberID: fn,
                        FluidQuantityID: fq,
                        FluidVehicleID: fv
                    });

                    instruction += " + " +
                        $(this).find(".fluidNumberCounter option:selected").text() + " " +
                        $(this).find(".fluidQuantityCounter option:selected").text() + " " +
                        $(this).find(".fluidVehicleCounter option:selected").text();
                }
            });

            /* 🔹 DAYS */
            if ($("#DaysNumberCounter").val()) {
                instruction += " (" +
                    $("#DaysNumberCounter option:selected").text() +
                    " Days)";
            }

            /* 🔹 PUSH OBJECT */
            /* 🔹 OBJECT BANVANE */
            let prescriptionObj = {
                PrescriptionID: currentId,
                FormID: $("#FormIDCounter").val(),
                PackageID: $("#PackageIDCounter").val(),
                NumberLeftID: $("#NumberLeftIDCounter").val(),
                FormulaID: $("#formulaIdCounter").val(),
                DoseNumberID: $("#DoseNumberIDCounter").val(),
                QuantityIDDose: $("#QuantityIDDoseCounter").val(),
                TimeID: $("#TimeIDCounter").val(),
                DaysNumber: $("#DaysNumberCounter").val(),
                MixingDataFluid: fluidMixing.length ? JSON.stringify(fluidMixing) : null,
                DisplayText: instruction
            };

            // --- इथून बदल सुरू ---
            let editIndex = $(".addPrescriptionCounter").data("edit-index");

            if (editIndex !== undefined && editIndex !== "") {
                // १. जर Edit मोड असेल तर जुन्या index वर डेटा अपडेट करा
                prescriptionsCounter[editIndex] = prescriptionObj;

                // २. बटण परत 'Add' मोड मध्ये आणा
                $(".addPrescriptionCounter").text("Add")
                    .removeClass("btn-warning").addClass("btn-success")
                    .removeData("edit-index");
                $("#PrescriptionIDCounter").val("");
            } else {
                // ३. जर नवीन असेल तर नेहमीप्रमाणे Push करा
                prescriptionsCounter.push(prescriptionObj);
            }

            // ४. टेबल रिफ्रेश करण्यासाठी हे फंक्शन कॉल करा


            renderCounterTable();
            resetForm();
        });

        /* ===============================
        📝 EDIT LOCAL ROW (Dynamic Row)
     =============================== */
        $(document).on("click", ".editRowLocal", function () {
            // 1. Index ghyaycha
            let index = parseInt($(this).closest("tr").attr("data-index"));
            let data = prescriptionsCounter[index];

            // 2. Varchya inputs madhe data fill karne
            $("#FormIDCounter").val(data.FormID).trigger('change');

            // Dropdowns populate honyasathi thoda delay dyaवा lagto
            setTimeout(function () {
                $("#PackageIDCounter").val(data.PackageID);
                $("#NumberLeftIDCounter").val(data.NumberLeftID);
                $("#formulaIdCounter").val(data.FormulaID);
                $("#DoseNumberIDCounter").val(data.DoseNumberID);
                $("#QuantityIDDoseCounter").val(data.QuantityIDDose);
                $("#TimeIDCounter").val(data.TimeID);
                $("#DaysNumberCounter").val(data.DaysNumber);
            }, 300);

            // 3. Add button cha text badlun 'Update' kara ani index store kara
            $(".addPrescriptionCounter").text("Update Medicine")
                .removeClass("btn-success")
                .addClass("btn-warning")
                .data("edit-index", index); // Ha index update sathi lagto

            // 4. Form kade scroll kara
            $('html, body').animate({ scrollTop: $("#CountermedicineForm").offset().top - 100 }, 500);
        });
        /* ===============================
           🗑 DELETE ROW
        =============================== */
        $(document).on("click", ".deleteRowCounter", function () {

            var row = $(this).closest("tr");
            var prescriptionId = row.attr("data-id");
            var deleteUrlCounter = '/Patient/HomopathyEHR/DeleteCounterPrescriptionHomeopathy';
            let index = row.data("index");   // 🔥 IMPORTANT

            console.log("Deleting ID:", prescriptionId);

            // 🔥 array मधून remove
            if (index !== undefined) {
                prescriptionsCounter.splice(index, 1);
                $("#prescriptionJsonCounter").val(JSON.stringify(prescriptionsCounter));
            }

            if (prescriptionId && prescriptionId != "0") {

                $.ajax({
                    url: deleteUrlCounter,
                    type: 'POST',
                    data: { id: prescriptionId },

                    success: function () {
                        console.log("Deleted from DB ✅");
                        row.remove();
                        window.location.reload();
                    }
                });

            } else {
                row.remove();
            }
        });
        function renderCounterTable() {

            let tbody = $("#prescriptionTableCounter tbody");



            prescriptionsCounter.forEach((item, i) => {
                let existingRow = tbody.find("tr[data-index='" + i + "']");
                if (existingRow.length > 0) {
                    // ✅ UPDATE EXISTING ROW
                    existingRow.find("td:first").text(item.DisplayText);
                } else {
                    tbody.append(`
            <tr data-index="${i}" data-id="${item.PrescriptionID}">
                <td>${item.DisplayText}</td>
                <td>
                    <i class="fa fa-edit text-primary editRowLocal" style="cursor:pointer; margin-right:10px;" title="Edit"></i>
                    <i class="fa fa-trash text-danger deleteRowCounter" style="cursor:pointer;" title="Delete"></i>
                </td>
            </tr>
        `);
                }
            });

            $("#prescriptionJsonCounter").val(JSON.stringify(prescriptionsCounter));

            $("#FormIDCounter").val("").trigger('change');
            $("#DaysNumberCounter").val("");
        }
    });
    /* ===============================
     ♻ RESET FORM
    =============================== */
    function resetForm() {

        $("#FormIDCounter").val("").trigger('change');
        $("#PackageIDCounter").val("");
        $("#NumberLeftIDCounter").val("");
        $("#formulaIdCounter").val("");
        $("#DoseNumberIDCounter").val("");
        $("#QuantityIDDoseCounter").val("");
        $("#TimeIDCounter").val("");
        $("#DaysNumberCounter").val("");

        $(".fluidMixRowCounter").remove();

        $(".addPrescriptionCounter")
            .text("Add")
            .removeClass("btn-warning")
            .addClass("btn-success")
            .removeData("edit-index");
    }

</script>


