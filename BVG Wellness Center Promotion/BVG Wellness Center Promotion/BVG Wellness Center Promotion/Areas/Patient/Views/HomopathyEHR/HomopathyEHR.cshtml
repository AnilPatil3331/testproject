function loadExistingFamilyHistoryData(containerId, dataList) {
    var container = $('#' + containerId);

    // Clear all except first row
    container.find('.family-history-row:not(:first)').remove();

    var firstRow = container.find('.family-history-row:first');

    if (dataList && dataList.length > 0) {
        var firstItem = dataList[0];
        firstRow.find('.record-id').val(firstItem.Id || '');
        firstRow.find('.relation-dropdown').val(firstItem.Relation || '');

        var ids = firstItem.FamilyHistoryIds || [];
        firstRow.find('.family-history-dropdown').val(ids);

        firstRow.find('.family-history-dropdown').select2({
            placeholder: "Select Family History",
            allowClear: true,
            width: '100%'
        });
        firstRow.find('.relation-dropdown').select2({
            placeholder: "Select Relation",
            allowClear: true,
            width: '100%'
        });

        for (var i = 1; i < dataList.length; i++) {
            addNewFamilyHistoryRowWithData(containerId, dataList[i], i);
        }
    } else {
        firstRow.find('.record-id').val('');
        firstRow.find('.relation-dropdown').val('');
        firstRow.find('.family-history-dropdown').val([]);
        firstRow.find('.family-history-dropdown').select2({
            placeholder: "Select Family History",
            allowClear: true,
            width: '100%'
        });
        firstRow.find('.relation-dropdown').select2({
            placeholder: "Select Relation",
            allowClear: true,
            width: '100%'
        });
    }

    updateFamilyHistoryButtons(containerId);
}

function addNewFamilyHistoryRow(btn, containerId) {
    var container = $('#' + containerId);
    var row = container.find('.family-history-row:first').clone();

    row.find('.select2-container').remove();
    row.find('.family-history-dropdown')
       .removeClass('select2-hidden-accessible')
