function addNewRow(btn, containerId) {
    // 1. Destroy Select2 safely
    debugger

    var container = $('#' + containerId);

    // GET THE LAST ROW
    var lastRow = container.find('.history-row:last');

    // CHECK IF LAST ROW HAS VALID DATA
    var mainField = lastRow.find('.main-field');
    var mainValue = mainField.val();

    // IF LAST ROW IS EMPTY, DON'T ADD NEW ROW
    if (!mainValue || mainValue === "") {
        alert("Please fill the current row first before adding a new one!");
        lastRow.css('border', '1px solid red');
        setTimeout(function() {
            lastRow.css('border', '');
        }, 2000);
        return;
    }

    // CHECK IF DURATION IS FILLED WHEN UNIT IS SELECTED
    var unitField = lastRow.find('.durationUnit');
    var durationField = lastRow.find('.durationField');

    if (unitField.val() !== "" && (!durationField.val() || durationField.val() === "")) {
        alert("Please fill the duration before adding a new row!");
        durationField.focus();
        durationField.css('border', '1px solid red');
        setTimeout(function() {
            durationField.css('border', '');
        }, 2000);
        return;
    }

    // Proceed with adding new row
    var rowCount = container.find('.history-row').length;

    // Clone the first row
    var newRow = container.find('.history-row:first').clone();

    // Select2 mule tayaar jhalela span (container) kadhun taka jar copy jhala asel tar
    newRow.find('.select2-container').remove();
    newRow.find('select').show(); // Original select dakva
    // Clear all values in the new row
    resetRow(newRow);

    // Update name attributes with new index
    updateRowNames(newRow, rowCount);

    // Set up the remove button for the new row
    newRow.find('.btn-container').html(`
        <button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">Remove</button>
    `);

    // Append the new row to container
    container.append(newRow);

    // Store original options for the new dropdown
    var newMainField = newRow.find('.main-field');
    var originalOptions = [];
    newMainField.find('option').each(function() {
        originalOptions.push({
            value: $(this).val(),
            text: $(this).text()
        });
    });
    newMainField.data('original-options', originalOptions);

    // Re-attach event handlers for the new row
    newMainField.on('change', function() { handleDropdownChange(this); });
    newRow.find('.durationField').on('input', function() { validateDuration(this); });
    newRow.find('.durationUnit').on('change', function() { validateDuration(this); });

    // Update all dropdowns to remove duplicates
    updateDropdownOptions(containerId, newRow);

    // Scroll to the new row
    newRow[0].scrollIntoView({ behavior: 'smooth', block: 'center' });

    // 2. NAVIN CODE: Navin row add zalya-zalya Select2 apply kara
    // IMPORTANT: 100ms nantar Select2 re-apply kara
    // ✅ ONLY NEW ROW ला SELECT2 लाव
    newRow.find('.search-dropdown').select2({
        placeholder: "Select",
        allowClear: true,
        width: '100%',
        minimumResultsForSearch: 0
    });
}


// ✅ REMOVE ROW
function removeRow(btn) {
    var row = $(btn).closest('.history-row');
    var container = row.closest('.history-container');
    var containerId = container.attr('id');

    // Don't remove if it's the last row
    if (container.find('.history-row').length <= 1) {
        // Just clear the row instead of removing
        resetRow(row);
        // Make sure first row has Add button
        row.find('.btn-container').html(`
            <button type="button" class="btn btn-sm btn-success add-btn px-2" onclick="addNewRow(this, '${containerId}')">Add +</button>
        `);

        // Clear the value and update dropdowns
        row.find('.main-field').val('').trigger('change');
        return;
    }

    row.remove();

    // Renumber remaining rows
    renumberRows(container);

    // Update dropdown options for all rows in this container
    var firstRow = container.find('.history-row:first');
    updateDropdownOptions(containerId, firstRow);
}

// ========== FUNCTIONS FOR LOADING DATA ==========

// Load existing data into dynamic rows
function loadExistingData(containerId, dataList) {
    var container = $('#' + containerId);

    // Clear all existing rows except the first one
    var firstRow = container.find('.history-row:first');
    container.find('.history-row:not(:first)').remove();

    // Store original options for first row if not already stored
    var firstMainField = firstRow.find('.main-field');
    if (!firstMainField.data('original-options')) {
        var originalOptions = [];
        firstMainField.find('option').each(function() {
            originalOptions.push({
                value: $(this).val(),
                text: $(this).text()
            });
        });
        firstMainField.data('original-options', originalOptions);
    }

    if (dataList && dataList.length > 0) {
        // Update first row with data
        updateRowWithData(firstRow, dataList[0], 0);

        // Add additional rows for remaining items
        for (var i = 1; i < dataList.length; i++) {
            addNewRowWithData(containerId, dataList[i], i);
        }

        // After loading all data, update dropdown options to prevent duplicates
        updateDropdownOptions(containerId, firstRow);
    } else {
        // Reset first row to empty
        resetRow(firstRow);
        // Trigger change to update dropdowns
        firstRow.find('.main-field').val('').trigger('change');
    }
}

function updateRowWithData(row, data, index) {
    var mainField = row.find('.main-field');
    var unitField = row.find('.durationUnit');
    var durationField = row.find('.durationField');
    var idField = row.find('.record-id');

    // Set the ID if exists
    if (data.Id && data.Id > 0) {
        idField.val(data.Id);
    } else {
        idField.val('');
    }

    // Set values based on the container type
    // Chronic Illness
    if (data.ChronicIllnessId !== undefined) {
        mainField.val(data.ChronicIllnessId);
        if (data.DurationUnit) unitField.val(data.DurationUnit);
        if (data.Duration) durationField.val(data.Duration);
    }
    // Past Surgery
    else if (data.PastSurgeryId !== undefined) {
        mainField.val(data.PastSurgeryId);
        if (data.PastSurgeryDurationUnit) unitField.val(data.PastSurgeryDurationUnit);
        if (data.PastSurgeryDuration) durationField.val(data.PastSurgeryDuration);
    }
    // Trauma
    else if (data.TraumaHistoryId !== undefined) {
        mainField.val(data.TraumaHistoryId);
        if (data.TraumaHistoryDurationUnit) unitField.val(data.TraumaHistoryDurationUnit);
        if (data.TraumaHistoryDuration) durationField.val(data.TraumaHistoryDuration);
    }
    // Allergy
    else if (data.AllergyId !== undefined) {
        mainField.val(data.AllergyId);
        if (data.AllergyHistoryDurationUnit) unitField.val(data.AllergyHistoryDurationUnit);
        if (data.AllergyHistoryDuration) durationField.val(data.AllergyHistoryDuration);
    }
    // Medication
    else if (data.LongTermMedicationId !== undefined) {
        mainField.val(data.LongTermMedicationId);
        if (data.LongTermMedicationDurationUnit) unitField.val(data.LongTermMedicationDurationUnit);
        if (data.LongTermMedicationDuration) durationField.val(data.LongTermMedicationDuration);
    }

    // Enable fields if data exists
    var mainValue = mainField.val();
    if (mainValue && mainValue !== "") {
        unitField.prop('disabled', false);
        durationField.prop('disabled', false);
        durationField.css('background-color', '#ffffff');
    }

    // Update name attributes with proper index
    updateRowNames(row, index);
}

function addNewRowWithData(containerId, data, index) {

    var container = $('#' + containerId);
    var newRow = container.find('.history-row:first').clone();

    // Clear values
    resetRow(newRow);

    // Store original options for the new row
    var newMainField = newRow.find('.main-field');
    var originalOptions = [];
    newMainField.find('option').each(function() {
        originalOptions.push({
            value: $(this).val(),
            text: $(this).text()
        });
    });
    newMainField.data('original-options', originalOptions);

    // Update with data
    updateRowWithData(newRow, data, index);

    // Set remove button
    newRow.find('.btn-container').html(`
        <button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">Remove</button>
    `);

    container.append(newRow);

    // Re-attach event handlers
    newMainField.on('change', function() { handleDropdownChange(this); });
    newRow.find('.durationField').on('input', function() { validateDuration(this); });
    newRow.find('.durationUnit').on('change', function() { validateDuration(this); });
}

function resetRow(row) {
    row.find('input[type="text"]').val('');
    row.find('select').val('');
    row.find('.record-id').val('');
    row.find('.durationUnit').prop('disabled', true);
    row.find('.durationField').prop('disabled', true).css('background-color', '#e9ecef');
    row.find('.error-msg').hide();
}

function updateRowNames(row, index) {
    // Update main dropdown name
    var mainField = row.find('.main-field');
    if (mainField.length) {
        var mainName = mainField.attr('name');
        if (mainName) {
            var newMainName = mainName.replace(/\[\d+\]/, '[' + index + ']');
            mainField.attr('name', newMainName);
        }
    }

    // Update duration field name
    var durationField = row.find('.durationField');
    if (durationField.length) {
        var durationName = durationField.attr('name');
        if (durationName) {
            var newDurationName = durationName.replace(/\[\d+\]/, '[' + index + ']');
            durationField.attr('name', newDurationName);
        }
    }

    // Update unit dropdown name
    var unitField = row.find('.durationUnit');
    if (unitField.length) {
        var unitName = unitField.attr('name');
        if (unitName) {
            var newUnitName = unitName.replace(/\[\d+\]/, '[' + index + ']');
            unitField.attr('name', newUnitName);
        }
    }

    // Update hidden ID field name
    var idField = row.find('.record-id');
    if (idField.length) {
        var idName = idField.attr('name');
        if (idName) {
            var newIdName = idName.replace(/\[\d+\]/, '[' + index + ']');
            idField.attr('name', newIdName);
        }
    }
}

function renumberRows(container) {
    var rows = container.find('.history-row');
    rows.each(function(newIndex) {
        updateRowNames($(this), newIndex);
    });
}

