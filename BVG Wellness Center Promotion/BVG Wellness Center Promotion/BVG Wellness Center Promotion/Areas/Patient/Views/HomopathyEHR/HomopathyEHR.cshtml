<script>
    $(document).ready(function () {
        debugger

        var sections = [

            { id: "CasePaper", key: "CasePaperId" },
            { id: "PulseExam", key: "Fid" },
            { id: "AyurvedaDiagnosis", key: "AyurvedaDiagnosisID" },
            { id: "Medicine", key: "PrescriptionID" },

            // Dispensing tab → textarea check
            { id: "Dispensing", key: "txtMedicine" },

            // Counter Medicine → table row check
            { id: "CounterMedicine", key: "prescriptionTableCounter" },

            // Counter Dispensing → textarea
            { id: "CounterDispensing", key: "txtMedicine" },

            // Advised Therapy → hidden json
            { id: "AdvisedTherapy", key: "AdvisedTherapyJson" }

        ];

        var nextTab = sections[0].id;

        for (var i = 0; i < sections.length; i++) {

            var tabId = sections[i].id;
            var key = sections[i].key;
            var value = "";

            // hidden input check
            var hidden = $("#" + tabId + " input[name='" + key + "']");
            if (hidden.length) {
                value = hidden.val();
            }

            // textarea check
            var textarea = $("#" + tabId + " textarea[id='" + key + "']");
            if (textarea.length) {
                value = textarea.val();
            }

            // table check
            if (key === "prescriptionTableCounter") {
                var rows = $("#" + key + " tbody tr").length;
                value = rows;
            }

            //console.log(tabId + " = " + value);

            if (!value || value === "0" || value === "") {
                nextTab = tabId;
                break;
            }

        }

        // remove active
        $(".tab-pane").removeClass("active show");
        $(".nav-link").removeClass("active");

        // activate tab
        $("#" + nextTab).addClass("active show");
        $('.nav-tabs a[data-bs-target="#' + nextTab + '"]').addClass("active");

    });

    function RefreshTabNavigation() {
        debugger;
        var sections = [
            { id: "CasePaper", key: "CasePaperId" },
            { id: "PulseExam", key: "Fid" },
            { id: "AyurvedaDiagnosis", key: "AyurvedaDiagnosisID" },
            { id: "Medicine", key: "PrescriptionID" },
            { id: "Dispensing", key: "txtMedicine" },
            { id: "CounterMedicine", key: "prescriptionTableCounter" },
            { id: "CounterDispensing", key: "txtMedicine" },
            { id: "AdvisedTherapy", key: "AdvisedTherapyJson" }
        ];

        var nextTab = sections[0].id;

        for (var i = 0; i < sections.length; i++) {
            var tabId = sections[i].id;
            var key = sections[i].key;
            var value = "";

            // Check hidden input or normal input
            var hidden = $("#" + tabId + " [name='" + key + "'], #" + tabId + " #" + key);
            if (hidden.length) {
                value = hidden.val();
            }

            // Check textarea
            var textarea = $("#" + tabId + " textarea[id='" + key + "']");
            if (textarea.length) {
                value = textarea.val();
            }

            // Table check
            if (key === "prescriptionTableCounter") {
                value = $("#" + key + " tbody tr").length > 0 ? "1" : "";
            }

            // If empty, this is the tab we stop at
            if (!value || value === "0" || value.trim() === "") {
                nextTab = tabId;
                break;
            }
        }

        // Switch the tabs visually
        $(".tab-pane").removeClass("active show");
        $(".nav-link").removeClass("active");

        $("#" + nextTab).addClass("active show");
        // This line handles both bootstrap 4 and 5 selectors
        $('.nav-tabs a[data-bs-target="#' + nextTab + '"], .nav-tabs a[href="#' + nextTab + '"]').addClass("active");
    }

    $(document).ready(function () {
        RefreshTabNavigation(); // Run once on load
    });
</script>


<script>
    $(document).ready(function () {
        $('#searchInput').on('input', function () {
            var query = $(this).val();

            if (query.length >= 2) {
                $.ajax({
                    url: '@Url.Action("SearchOPD", "reception")', // Make sure this is correct
                    type: 'GET',
                    data: { searchTerm: query },
                    success: function (data) {
                        let html = "";
                        if (data.length > 0) {
                            html += "<ul class='list-group'>";
                            $.each(data, function (i, item) {
                                html += "<li class='list-group-item' style='cursor:pointer;' onclick='selectPatient(" + item.OPDNO + ")'>";
                                html += "<strong>" + item.FirstName + "</strong> - " + item.MobileNumber + " (" + item.UHID + ")";
                                html += "</li>";
                            });
                            html += "</ul>";
                        } else {
                            html = "<div class='p-2 text-muted'>No matches found</div>";
                        }
                        $('#searchResult').html(html).show();
                    },
                    error: function () {
                        $('#searchResult').html('<div class="p-2 text-danger">Error fetching data</div>').show();
                    }
                });
            } else {
                $('#searchResult').hide();
            }
        });

        // Hide results if clicked outside
        $(document).on('click', function (e) {
            if (!$(e.target).closest('#searchInput, #searchResult').length) {
                $('#searchResult').hide();
            }
        });
    });

    function selectPatient(opdNo) {
        window.location.href = '/receptionist/reception/Index?OPDNO=' + opdNo;
    }
</script>


<script>
    var suchanaGrouped = @Html.Raw(Json.Encode(ViewBag.SuchanaGrouped));

    $(document).ready(function () {

        // Populate all dropdowns
        $('.suchanaDropdown').each(function () {

            var formId = $(this).data('formid');
            var $ddl = $(this);

            if (suchanaGrouped[formId]) {
                suchanaGrouped[formId].forEach(function (item) {
                    $ddl.append(
                        $('<option>', {
                            value: item.Fid,
                            text: item.InstructionName
                        })
                    );
                });
            }
        });

        // On change → fill correct textarea
        $(document).on('change', '.suchanaDropdown', function () {

            var selectedValue = $(this).val();
            var targetId = $(this).data('target');
            var description = "";

            Object.values(suchanaGrouped).forEach(function (list) {
                list.forEach(function (s) {
                    if (s.Fid == selectedValue) {
                        description = s.Description;
                    }
                });
            });

            $('#' + targetId).val(description);
        });
    });
</script>


<script>
    $(document).ready(function () {
        $('.quick-date').on('click', function () {
            let daysToAdd = parseInt($(this).data('days'));
            let today = new Date();

            // Calculate new date
            today.setDate(today.getDate() + daysToAdd);

            // Format date to yyyy-MM-dd
            let formattedDate = today.toISOString().split('T')[0];

            // Set value in textbox
            $('#MedicineDate').val(formattedDate);

            // Button active style
            $('.quick-date').removeClass('btn-primary').addClass('btn-outline-primary');
            $(this).removeClass('btn-outline-primary').addClass('btn-primary');
        });
    });
</script>




