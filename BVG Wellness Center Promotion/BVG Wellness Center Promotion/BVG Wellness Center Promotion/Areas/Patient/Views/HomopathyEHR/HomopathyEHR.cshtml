<script>
    @*========================Prescription Delete===============*@
    function DeletePrescription(Fid_Encrypted) {
        Swal.fire({
            title: 'Are You Sure!',
            text: "Are you sure you want to delete this record?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#f44336',
            cancelButtonColor: '#4caf50',
            confirmButtonText: 'Yes, go ahead!',
            cancelButtonText: 'No, cancel!',
            customClass: {
                popup: 'fullscreen-popup',
            },
        }).then((result) => {
            if (result.isConfirmed) {
                var  EncounterFid= $("#EncounterFid").val();
                $.ajax({
                    type: 'GET',
                    dataType: 'JSON',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeletePrescription", "Encounter")',
                    data: { Fid_Encrypted: Fid_Encrypted,EncounterFid:EncounterFid },
                    success: function (data) {
                        debugger;
                        if (data != null) {
                            debugger
                            var prescriptionList = data.GetPrescriptionList || []; // Use null-coalescing operator for safety

                            GeneratePrescriptionTable(prescriptionList);      // Bind Table  by function

                            var SuccesMessage = data.SuccesMsg;
                            var SuccesIcon = data.Icon;
                            SuccesAlert(SuccesMessage, SuccesIcon);
                        }
                    }

                })
            }
        });

    }
    @*========================Prescription Delete End===============*@

    @*========================Open Prescription model for update ===============*@

    function UpdatePrescription(Fid_Encrypted){
        $.ajax({
            type: 'GET',
            dataType: 'JSON',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("UpdatePrescription", "Encounter")',
            data: { Fid_Encrypted: Fid_Encrypted },
            success: function (data) {
                debugger;
                if (data != null) {
                    debugger
                    //$("#txtMedicineName").val(data.MedicineName);
                    $("#txtMedicineName option").each(function() {
                        debugger;
                        if ($.trim($(this).val()) === $.trim(data.MedicineName)) {
                            $(this).prop("selected", true);
                        }
                    });
                    $("#ddlMedecineName").val(data.MedicineName).select2();
                    //$("#ddlMedecineName").trigger('change');
                    $("#frequency").val(data.Frequency);
                    $("#duration").val(data.Duration);
                    $("#instruction").val(data.Instruction);
                    $("#EncryptedFid").val(data.FidEncrypted);
                    $("#appointment-details-modal___BV_modal_outer_")
             .css("display", "block")  // Remove 'display: none' by setting it to 'block'
             .attr("aria-hidden", "false")  // Update ARIA attribute to indicate visibility
             .addClass("show");

                }
            }

        })
    }
    @*========================Open Prescription model for update End===============*@

    //================================Function For show Prescription in Table=====================================
    function GeneratePrescriptionTable(prescriptionList) {
        // Ensure the list is an array, default to an empty array if null/undefined
        prescriptionList = prescriptionList || [];

        // Get the table body where rows should be added
        var tableBody = $("#prescriptionTable tbody");

        // Clear any existing rows
        tableBody.empty();

        // Check if data exists
        if (prescriptionList.length > 0) {
            // Iterate through the prescription list and append rows
            $.each(prescriptionList, function (i, item) {
                var row = "";
                var medicineName = "";
                var Frequency = "";
                var Duration = "";
                var Instruction = "";
                var Fid_Encrypted = "";

                // Iterate over key-value pairs in the item
                $.each(item, function (index, pair) {
                    if (pair.Key === "Fid_Encrypted") {
                        Fid_Encrypted = pair.Value;
                    }
                    if (pair.Key === "MedicineName") {
                        medicineName = pair.Value;
                    }
                    if (pair.Key === "Frequency") {
                        Frequency = pair.Value;
                    }
                    if (pair.Key === "Duration") {
                        Duration = pair.Value;
                    }
                    if (pair.Key === "Instruction") {
                        Instruction = pair.Value;
                    }

                });

                // Construct the row dynamically
                row = `
                <tr class ="animated fadeInUp">
                   <td class ="fixed-width">
                          <span style="color: #4874dc;font-weight: bold;">${medicineName}</span><br>
                         <span class ="instruction">${Instruction}</span>
                     </td>
                     <td>${Frequency}</td>
                     <td>${Duration} Days</td>
                    <td>
                        <div role="group" class="btn-group btn-group-sm">
                              <button title="Edit" type="button" class ="btn btn-sm btn-outline-primary" onclick="UpdatePrescription('${Fid_Encrypted}')">
                                 <i class ="fa fa-pen-alt"></i>
                            </button>
                            <button title="Delete" type="button" class="btn btn-outline-danger" onclick="DeletePrescription('${Fid_Encrypted}')">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>`;

                // Append the row to the table body
                tableBody.append(row);
            });
        } else {
            // Show "No prescription found" if no data exists
            var noDataRow = `
            <tr>
                <td colspan="4" class="text-center text-danger">
                    <h4>No prescription found</h4>
                </td>
            </tr>`;
            tableBody.append(noDataRow);
        }
    }
    //================================Function For show Prescription in Table=====================================


    function SuccesAlert(Message, Icon) {
        debugger;
        try {
            var imageUrl = '@Url.Content("~/assets/images/check-circle.gif")';
            showCustomAlert(Message, Icon, imageUrl);
        } catch (error) {
            console.error('Error:', error);
        }
    }

</script>

