<script>
    $(document).ready(function () {

        // ✅ Discount validation
        $("#txtDiscount").on("input", function () {
            var discount = parseFloat($(this).val()) || 0;

            if (discount > 100) {
                $("#idmismatchAmount").html("Error : Discount cannot be greater than 100%.");
                $(this).val(100);
                return false;
            } else {
                $("#idmismatchAmount").html("");
            }
        });

    });

    $(document).on("input", ".referenceNumber", function () {

        var value = $(this).val();

        // remove special characters
        value = value.replace(/[^a-zA-Z0-9]/g, '');

        $(this).val(value);

    });
    $("#txtAmount").on("keypress", function (e) {
        var keyCode = e.which ? e.which : e.keyCode;

        // Allow: 0-9 (48-57) and one dot (46)
        if (!(keyCode >= 48 && keyCode <= 57) && keyCode !== 46) {
            e.preventDefault();
        }

        // Prevent multiple dots
        if (keyCode === 46 && $(this).val().indexOf('.') !== -1) {
            e.preventDefault();
        }
    });

    // Also prevent pasting invalid text
    $("#txtAmount").on("blur", function() {
        this.value = this.value.replace(/[^0-9.]/g, '');
    });


