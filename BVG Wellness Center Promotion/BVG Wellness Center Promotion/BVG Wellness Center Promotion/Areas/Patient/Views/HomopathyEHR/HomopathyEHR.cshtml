    /* --- Vertical Tabs Layout (Compact & Fully Visible Tabs + Full Height Content) --- */
    @@media (min-width: 768px) {
        .vertical-tab-container {
            display: flex;
            flex-direction: row;
            align-items: flex-start;
            gap: 15px;
        }
            /* डाव्या बाजूचे टॅब्स */
