<script>
// ========== DROPDOWN VALIDATION FUNCTIONS ==========

// Get all selected values in container (excluding current row)
function getSelectedValues(containerId, currentRow) {
    var selectedValues = [];
    var container = $('#' + containerId);

    container.find('.history-row').each(function() {
        // Skip the current row
        if (this !== currentRow[0]) {
            var mainField = $(this).find('.main-field');
            var value = mainField.val();
            if (value && value !== "") {
                selectedValues.push(value);
            }
        }
    });

    return selectedValues;
}

// Update dropdown options to remove already selected values
function updateDropdownOptions(containerId, currentRow) {
    var container = $('#' + containerId);
    var selectedValues = getSelectedValues(containerId, currentRow);

    // Get current value of the row we're updating
    var currentMainField = currentRow.find('.main-field');
    var currentValue = currentMainField.val();

    // Store original options if not already stored for ALL dropdowns in this container
    container.find('.main-field').each(function() {
        var $dropdown = $(this);

        // Store original options if not already stored
        if (!$dropdown.data('original-options')) {
            var options = [];
            $dropdown.find('option').each(function() {
                options.push({
                    value: $(this).val(),
                    text: $(this).text()
                });
            });
            $dropdown.data('original-options', options);
        }
    });

    // Update EACH dropdown individually
    container.find('.main-field').each(function() {
        var $dropdown = $(this);
        var originalOptions = $dropdown.data('original-options');

        if (!originalOptions) return;

        // Get this dropdown's current value
        var dropdownCurrentValue = $dropdown.val();

        // Clear current options
        $dropdown.empty();

        // Add placeholder option
       /* $dropdown.append('<option value="">Select Option</option>');*/

        // Add back options except those that are selected in other rows
        $.each(originalOptions, function(i, opt) {
            // Skip if option value is empty (placeholder)
          //  if (opt.value === "") return;

            // Check if this value is selected in other rows
            var isSelectedElsewhere = false;

            container.find('.history-row').each(function() {
                var rowMainField = $(this).find('.main-field');
                var rowValue = rowMainField.val();

                // If this row is the current dropdown's row, skip comparison
                if (rowMainField[0] === $dropdown[0]) {
                    return;
                }

                // If value matches a selected value in another row
                if (rowValue && rowValue === opt.value) {
                    isSelectedElsewhere = true;
                    return false; // break the loop
                }
            });

            // Add option if not selected elsewhere, OR if it's this dropdown's current value
            if (!isSelectedElsewhere || (dropdownCurrentValue && dropdownCurrentValue === opt.value)) {
                $dropdown.append($('<option></option>').val(opt.value).html(opt.text));
            }
        });

        // Restore current value if it exists and is still available
        if (dropdownCurrentValue && dropdownCurrentValue !== "") {
            // Check if the value still exists in dropdown
            if ($dropdown.find('option[value="' + dropdownCurrentValue + '"]').length > 0) {
                $dropdown.val(dropdownCurrentValue);
            } else {
                $dropdown.val('');
            }
        }
    });
}

// ✅ DROPDOWN CHANGE HANDLER
function handleDropdownChange(element) {
    var $row = $(element).closest('.history-row');
    var $unit = $row.find('.durationUnit');
    var $duration = $row.find('.durationField');
    var containerId = $row.closest('.history-container').attr('id');

    if ($(element).val() !== "") {
        $unit.prop('disabled', false);
    } else {
        $unit.val('').prop('disabled', true);
        $duration.val('').prop('disabled', true)
            .css("background-color", "#e9ecef");
        $row.find('.error-msg').hide();
    }

    // Update all dropdowns in this container to remove duplicates
    updateDropdownOptions(containerId, $row);
}

// ✅ VALIDATION FUNCTION
function validateDuration(element) {
    debugger
    var rawValue = element.value;

    // 🔥 KEY FIX: agar trailing dot ya incomplete decimal hai to validation skip karo
    if (rawValue === "" || rawValue === "." || rawValue.endsWith(".") || rawValue === "0.") {
        return;
    }
    var row = element.closest('.history-row');
    if (!row) return;

    var unitDropdown = row.querySelector('.durationUnit');
    var durationInput = row.querySelector('.durationField');
    var errorSpan = row.querySelector('.error-msg');

    if (!unitDropdown || !durationInput) return;

    if (unitDropdown.value === "") {
        durationInput.value = "";
        durationInput.disabled = true;
        durationInput.style.backgroundColor = "#e9ecef";
        return;
    } else {
        durationInput.disabled = false;
        durationInput.style.backgroundColor = "#ffffff";
    }

    if (durationInput.value !== "") {
        var unitText = unitDropdown.options[unitDropdown.selectedIndex].text.toLowerCase();
        var value = parseFloat(element.value) || 0;
        var max = 999;
        var message = "";

        if (unitText.includes("day") && value > 365) {
            max = 365;
            message = "More than 365 days? Select Weeks";
        }
        else if (unitText.includes("week") && value > 99) {
            max = 99;
            message = "More than 99 weeks? Select Months";
        }
        else if (unitText.includes("month") && value > 99) {
            max = 99;
            message = "More than 99 months? Select Years";
        }
        else if (unitText.includes("year") && value > 120) {
            max = 120;
            message = "Maximum 120 years allowed";
        }

        if (value > max) {
            element.value = max;
            if (errorSpan) {
                errorSpan.innerText = message;
                errorSpan.style.display = "block";
            }
            durationInput.style.borderColor = "red";
        } else {
            if (errorSpan) errorSpan.style.display = "none";
            durationInput.style.borderColor = "";
        }
    }
}

