                }
            });

            // Old rows → remove button
            container.find('.btn-container').html(`
            <button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">X</button>
        `);

            // New row → add button
            row.find('.btn-container').html(`
            <button type="button" class="btn btn-sm btn-success" onclick="addNewRow(this,'${containerId}')">Add +</button>
        `);

            container.append(row);
