                                                    width: '100%'
                                                });

                                                $('#globalPathyaDropdown').on('change', function() {
                                                    updateGlobalPathya();
                                                });
                                            });

                                            function updateGlobalPathya() {
                                                var selectedOptions = $('#globalPathyaDropdown').find('option:selected');
                                                var instructions = [];
                                                var firstPathyaId = "";

                                                selectedOptions.each(function(index) {
                                                    var val = $(this).val();
                                                    if (val) {
                                                        if (index === 0) firstPathyaId = val;
                                                        var inst = $(this).data('instruction');
                                                        if (inst && inst.trim() !== '') {
                                                            instructions.push(inst.trim());
                                                        }
                                                    }
                                                });

                                                var combinedInstruction = instructions.join('\n\n');
                                                $('#globalPathyaInstruction').val(combinedInstruction);

                                                $('.hidden-pathya-id').val(firstPathyaId);
                                                $('.hidden-pathya-instruction').val(combinedInstruction);
                                            }

                                            function updateGlobalPathyaInstruction() {
                                                var instruction = $('#globalPathyaInstruction').val();
                                                $('.hidden-pathya-instruction').val(instruction);
                                            }
