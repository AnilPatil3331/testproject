<script>
    function toggleDiagnosis(button) {
        const section = button.closest(".section");
        const results = section.querySelector(".diagnosis-results");


        results.classList.toggle("d-none");

        // Change + to - and back
        if (results.classList.contains("d-none")) {
            button.textContent = "+";
        } else {
            button.textContent = "-";
        }
    }
</script>


<script>
    function toggleSection(btn) {
        const section = btn.closest(".section");

        if (!section) return;

        // heading वगळून बाकी सगळे child hide/show
        const children = Array.from(section.children);

        children.forEach(child => {
            if (!child.classList.contains("section-heading")) {
                child.classList.toggle("d-none");
            }
        });

        // + / - change
        btn.innerText = btn.innerText === "+" ? "-" : "+";
    }
</script>


<script>
    $(document).ready(function () {
        debugger
        var prescriptions = [];
        var deletedPrescriptionIds = [];
        var editIndex = -1;

        // 🔹 Add Mixing Row
        $(document).on("click", ".addMixing", function () {
            var newMix = `
        <div class="mixRow row col-12">
            <div class="col-md-4 form-group">
                <select class="form-control numberRight">${$(".numberRight").html()}</select>
            </div>
            <div class="col-md-4 form-group">
                <select class="form-control quantityId">${$(".quantityId").html()}</select>
            </div>
            <div class="col-md-3 form-group">
                <select class="form-control formulaId">${$(".formulaId").html()}</select>
            </div>
            <div class="col-md-1 mt-2">
                <button type="button" class="btn btn-sm btn-danger removeMix">x</button>
            </div>

        </div>`;
            $(".final-section:first").before(newMix);
        });

        // ❌ Remove Mixing Row
        $(document).on("click", ".removeMix", function () {
            $(this).closest(".mixRow").remove();
        });

        // 🔹 Add Fluid Mixing Row
        $(document).on("click", ".addFluidMixing", function () {
            var newFluidMix = `
        <div class="fluidMixRow  row col-md-12">
            <div class="col-md-4 form-group">
                <select class="form-control fluidNumber">${$("#FluidNumberID").html()}</select>
            </div>
            <div class="col-md-4 form-group">
                <select class="form-control fluidQuantity">${$("#FluidQuantityID").html()}</select>
            </div>
            <div class="col-md-3 form-group">
                <select class="form-control fluidVehicle">${$("#FluidVehicleID").html()}</select>
            </div>
            <div class="col-md-1 mt-2">
                <button type="button" class="btn btn-sm btn-danger removeFluidMix">x</button>
            </div>
        </div>`;
            $(".fluidMixSection").append(newFluidMix);
        });

        // ❌ Remove Fluid Mixing Row
        $(document).on("click", ".removeFluidMix", function () {
            $(this).closest(".fluidMixRow").remove();
        });

        // ➕ Add Prescription
        $(document).on("click", ".addPrescription", function () {
            debugger
            var form = $(".formId option:selected").text().trim();
            var pack = $(".packageId option:selected").text().trim();
            var numLeft = $(".numberLeft option:selected").text().trim();

            if (form.includes("--") || pack.includes("--") || numLeft.includes("--")) {
                alert("⚠ कृपया Form, Package, Number निवडा.");
                return;
            }

            var instruction = form + " " + pack + " " + numLeft + " = ";

            // 🔹 Normal Mixing Section
            var normalMixes = [];
            if ($(".numberRight:first").val() && $(".quantityId:first").val() && $(".formulaId:first").val()) {
                normalMixes.push({
                    NumberRightID: $(".numberRight:first").val(),
                    QuantityID: $(".quantityId:first").val(),
                    FormulaID: $(".formulaId:first").val()
                });
                instruction += $(".numberRight:first option:selected").text().trim() + " " +
                    $(".quantityId:first option:selected").text().trim() + " " +
                    $(".formulaId:first option:selected").text().trim();
            }

            $(".mixRow").each(function () {
                debugger
                var nVal = $(this).find(".numberRight").val();
                var qVal = $(this).find(".quantityId").val();
                var fVal = $(this).find(".formulaId").val();

                if (nVal && qVal && fVal) {
                    normalMixes.push({
                        NumberRightID: nVal,
                        QuantityID: qVal,
                        FormulaID: fVal
                    });
                    instruction += " + " +
                        $(this).find(".numberRight option:selected").text().trim() + " " +
                        $(this).find(".quantityId option:selected").text().trim() + " " +
                        $(this).find(".formulaId option:selected").text().trim();
                }
            });

            // 🔹 Processing Section
            var processingQty = $("#ProcessingQty").prop("disabled") ? null : $("#ProcessingQty").val();
            var processingUnit = $("#ProcessingUnit").prop("disabled") ? null : $("#ProcessingUnit").val();
            if (processingQty && processingUnit) {
                instruction += " = " + $("#ProcessingQty option:selected").text().trim() + " " +
                    $("#ProcessingUnit option:selected").text().trim();
            }

            // 🔹 Dose Section
            var doseNum = $("#DoseNumberID").val();
            var dose = $("#QuantityIDDose").val();
            var time = $("#TimeID").val();
            if (doseNum && dose && time) {
                instruction += " + " + $("#DoseNumberID option:selected").text().trim() + " " +  // ekde pan = hota me  + KELAY
                    $("#QuantityIDDose option:selected").text().trim() + " " +
                    $("#TimeID option:selected").text().trim();
            }

            // 🔹 Fluid Mixing Section
            var fluidMixes = [];

            if (!$("#FluidNumberID").prop("disabled") && $("#FluidNumberID").val()) {
                var mainFluidNumber = $("#FluidNumberID").val();
                var mainFluidQty = $("#FluidQuantityID").val();
                var mainFluidVehicle = $("#FluidVehicleID").val();
                if (mainFluidNumber && mainFluidQty && mainFluidVehicle) {
                    fluidMixes.push({
                        FluidNumberID: mainFluidNumber,
                        FluidQuantityID: mainFluidQty,
                        FluidVehicleID: mainFluidVehicle
                    });
                    instruction += " + " +  // ekde == hota me +  kely
                        $("#FluidNumberID option:selected").text().trim() + " " +
                        $("#FluidQuantityID option:selected").text().trim() + " " +
                        $("#FluidVehicleID option:selected").text().trim();
                }
            }

            $(".fluidMixRow").each(function () {
                var fnVal = $(this).find(".fluidNumber").val();
                var fqVal = $(this).find(".fluidQuantity").val();
                var fvVal = $(this).find(".fluidVehicle").val();
                if (fnVal && fqVal && fvVal) {
                    fluidMixes.push({
                        FluidNumberID: fnVal,
                        FluidQuantityID: fqVal,
                        FluidVehicleID: fvVal
                    });
                    instruction += " + " +
                        $(this).find(".fluidNumber option:selected").text().trim() + " " +
                        $(this).find(".fluidQuantity option:selected").text().trim() + " " +
                        $(this).find(".fluidVehicle option:selected").text().trim();
                }
            });

            // 🔹 Combine ALL mixing data (Normal + Fluid)
            // 👉 Capture mixing data for this specific prescription
            var mixingData = [];

            // First mixing row (only if values are selected)
            if ($(".numberRight:first").val() || $(".quantityId:first").val() || $(".formulaId:first").val()) {
                mixingData.push({
                    NumberRightID: $(".numberRight:first").val(),
                    QuantityID: $(".quantityId:first").val(),
                    FormulaID: $(".formulaId:first").val()
                });
            }

            // Additional mixing rows
            $(".mixRow").each(function () {
                if ($(this).find(".numberRight").val() || $(this).find(".quantityId").val() || $(this).find(".formulaId").val()) {
                    mixingData.push({
                        NumberRightID: $(this).find(".numberRight").val(),
                        QuantityID: $(this).find(".quantityId").val(),
                        FormulaID: $(this).find(".formulaId").val()
                    });
                }
            });




            var fluidMixing = [];
            if (!$("#FluidNumberID").prop("disabled") && $("#FluidNumberID").val()) {
                fluidMixing.push({
                    FluidNumberID: $("#FluidNumberID").val(),
                    FluidQuantityID: $("#FluidQuantityID").val(),
                    FluidVehicleID: $("#FluidVehicleID").val()
                });
            }

            // Additional fluid mixing rows
            $(".fluidMixRow").each(function () {
                fluidMixing.push({
                    FluidNumberID: $(this).find(".fluidNumber").val(),
                    FluidQuantityID: $(this).find(".fluidQuantity").val(),
                    FluidVehicleID: $(this).find(".fluidVehicle").val()
                });
            });


            var daysValue = $("#DaysNumber").val();
            var daysText = "";

            if (daysValue) {
                debugger
                daysText = " (" + $("#DaysNumber option:selected").text().trim() + " Days)";
            }

            instruction += daysText;
            //var medicineDate = $("#MedicineDate").val();




            // ... (तुमचे instruction आणि prescription object तयार करण्याचे लॉजिक सुरुवातीला तसेच ठेवा) ...

            var prescription = {
                PrescriptionID: editIndex > -1 ? prescriptions[editIndex].PrescriptionID : 0,
                FormID: $("#FormID").val(),
                PackageID: $("#PackageID").val(),
                NumberLeftID: $("#NumberLeftID").val(),
                ProcessingQty: processingQty,
                ProcessingUnit: processingUnit,
                DoseNumberID: doseNum,
                QuantityIDDose: dose,
                TimeID: time,
                FluidVehicleID: $("#FluidVehicleID").val(),
                MixingDataJson: mixingData.length > 0 ? JSON.stringify(mixingData) : null,
                MixingDataFluid: fluidMixing.length > 0 ? JSON.stringify(fluidMixing) : null,
                DaysNumber: daysValue,
                DisplayText: instruction
            };

            if (editIndex > -1) {
                // ✅ 1. UPDATE MODE: फक्त जुन्या जागी डेटा बदला
                prescriptions[editIndex] = prescription;

                // टेबलमधील ती ठराविक रो अपडेट करा
                var row = $("#prescriptionTable tbody tr[data-index='" + editIndex + "']");
                row.find("td:first").text(instruction);

                // रिसेट करा
                editIndex = -1;
                $(".addPrescription").text("Add").addClass("btn-primary").removeClass("btn-warning");
            } else {
                // ✅ 2. INSERT MODE: नवीन डेटा टाका
                prescriptions.push(prescription);
                var newIdx = prescriptions.length - 1;

                // फक्त इथेच APPEND करा (खालचा एक्स्ट्रा append काढून टाका)
                $("#prescriptionTable tbody").append(
                    //"<tr data-index='" + newIdx + "'>"
                    "<tr data-index='" + newIdx + "' data-id='" + prescription.PrescriptionID + "'>" +
                    "<td>" + instruction + "</td>" +
                    "<td>" +
                    "<i class='fa fa-edit text-primary editRow' style='cursor:pointer; margin-right:10px;'></i>" +
                    "<i class='fa fa-trash text-danger deleteRow' style='cursor:pointer;'></i>" +
                    "</td></tr>"
                );
            }

            // ✅ 3. Update hidden field
            $("#prescriptionJson").val(JSON.stringify(prescriptions));
            //alert("Added / Updated");

            // 🔹 ४. फॉर्म रीसेट करा (नवीन एन्ट्रीसाठी)
            $(".mixRow").remove();
            $(".fluidMixRow").remove();

            // ड्रॉपडाउन्स रिकामे करा
            $(".numberRight:first").val("");
            $(".quantityId:first").val("");
            $(".formulaId:first").val("");
            $("#FluidNumberID").val("");
