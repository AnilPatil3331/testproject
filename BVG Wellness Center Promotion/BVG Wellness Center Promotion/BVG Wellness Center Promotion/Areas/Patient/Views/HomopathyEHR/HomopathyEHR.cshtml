}
// ====== Sync Follow-up Date and Follow-up Days ======
$(document).ready(function () {
    var dateInput = $('#FollowUpDate');
    var daysInput = $('#FollowUpDays');

    if (!dateInput.length || !daysInput.length) return;

    function getLocalDateString(date) {
        var year = date.getFullYear();
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var day = String(date.getDate()).padStart(2, '0');
        return year + '-' + month + '-' + day;
    }

    function getTodayMidnight() {
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        return today;
    }

    // 1. Sync from Days to Date
    daysInput.on('input change', function () {
        var days = parseInt($(this).val(), 10);
        if (!isNaN(days) && days >= 0) {
            var targetDate = getTodayMidnight();
            targetDate.setDate(targetDate.getDate() + days);
            dateInput.val(getLocalDateString(targetDate));
        }
    });

    // 2. Sync from Date to Days
    dateInput.on('change', function () {
        var selectedVal = $(this).val();
        if (selectedVal) {
            var selectedDate = new Date(selectedVal);
            selectedDate.setHours(0, 0, 0, 0);
            var today = getTodayMidnight();
            var diffTime = selectedDate.getTime() - today.getTime();
            var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            if (diffDays >= 0) {
                daysInput.val(diffDays);
            } else {
                daysInput.val('');
            }
        } else {
            daysInput.val('');
        }
    });

    // 3. Initial Load Sync
    var initialDateVal = dateInput.val();
    if (initialDateVal) {
        var initialDate = new Date(initialDateVal);
        initialDate.setHours(0, 0, 0, 0);
        var today = getTodayMidnight();
        var diffTime = initialDate.getTime() - today.getTime();
        var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        if (diffDays >= 0) {
            daysInput.val(diffDays);
        }
    }
});
</script>


