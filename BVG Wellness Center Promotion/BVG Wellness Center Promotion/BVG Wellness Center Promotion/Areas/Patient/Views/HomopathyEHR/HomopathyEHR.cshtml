<script>
    $(document).ready(function () {
        // Sarva radio buttons sathi toggle logic
        $('input[type="radio"]').on('click', function () {
            var $this = $(this);

            // Jar button adhich select asel, tr tyala unselect kara
            if ($this.data('waschecked') == true) {
                $this.prop('checked', false);
                $this.data('waschecked', false);
                $this.trigger('change'); // Change event trigger kara jar kahi logic tyavar depend asel
            } else {
                // Navin select zalyas, tyachya group madhil itarancha 'waschecked' status reset kara
                $('input[name="' + $this.attr('name') + '"]').data('waschecked', false);
                $this.data('waschecked', true);
            }
        });
    });
</script>
