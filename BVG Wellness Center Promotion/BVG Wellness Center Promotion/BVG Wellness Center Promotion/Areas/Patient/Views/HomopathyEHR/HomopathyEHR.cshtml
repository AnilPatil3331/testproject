<script>
    $(document).ready(function () {
        // Utility function to show error
        function showError(msg) {
            Swal.fire({
                icon: 'error',
                title: 'Invalid Range',
                text: msg,
                confirmButtonColor: '#f44336'
            });
        }

        // Generic Range Validator
        function validateRange(id, min, max, name) {
            $(document).on("blur", "#" + id, function () {
                var val = parseFloat($(this).val());
                if (!isNaN(val)) {
                    if (val < min || val > max) {
                        showError(name + " must be between " + min + " and " + max);
                        $(this).val(""); // Clear invalid value
                    }
                }
            });
        }

        // Apply validations
        validateRange("Height", 30, 250, "Height (cm)");
        validateRange("Weight", 1, 300, "Weight (kg)");
        validateRange("Pulse", 30, 220, "Pulse (bpm)");
        validateRange("RespiratoryRate", 5, 60, "Respiratory Rate");
        validateRange("SpO2", 50, 100, "SpO₂ (%)");

        // Special Case: Blood Pressure (Systolic/Diastolic)
        $(document).on("blur", "#BPSys, #BPDia", function () {

            var sys = parseInt($('#BPSys').val());
            var dia = parseInt($('#BPDia').val());

            if (!isNaN(sys)) {
                if (sys < 50 || sys > 250) {
                    showError("Systolic BP must be between 50 and 250");
                    $('#BPSys').val('');
                }
            }

            if (!isNaN(dia)) {
                if (dia < 30 || dia > 150) {
                    showError("Diastolic BP must be between 30 and 150");
                    $('#BPDia').val('');
                }
            }
        });
        // Special Case: Temperature (Depends on Unit)
        $(document).on("blur", "#TemperatureCasepaper", function () {
            var val = parseFloat($(this).val());
            var unit = $("#TempUnitCP").val(); // DropDown ID

            if (!isNaN(val)) {
                if (unit === "°F") {
                    if (val < 86 || val > 110) {
                        showError("Temperature (°F) must be between 86 and 110");
                        $(this).val("");
                    }
                } else { // Celsius
                    if (val < 30 || val > 43) {
                        showError("Temperature (°C) must be between 30 and 43");
                        $(this).val("");
                    }
                }
            }
        });
    });
</script>
