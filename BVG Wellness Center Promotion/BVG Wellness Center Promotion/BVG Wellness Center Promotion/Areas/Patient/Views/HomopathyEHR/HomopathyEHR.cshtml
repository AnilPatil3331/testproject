                                                                                <b>@name</b>
                                                                                @if (al.AllergyHistoryDuration.HasValue)
                                                                                {<span> | <b>Duration:</b> @al.AllergyHistoryDuration @unit </span>}
                                                                            </li>
                                                                        }
                                                                    </ul>
