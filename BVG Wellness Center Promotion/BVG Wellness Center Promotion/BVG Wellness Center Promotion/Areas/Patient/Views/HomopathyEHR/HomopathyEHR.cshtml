                                                        {
                                                            <tr>
                                                                <td style="background:#f1f1f1;"><b>Trauma History:</b></td>
                                                                <td>
                                                                    <ul class="mb-0 pl-3">
                                                                        @foreach (var tr in Model.TraumaHistoryList)
                                                                        {
                                                                            var name = traumaList?.FirstOrDefault(x => x.Id == tr.TraumaHistoryId)?.Name ?? tr.TraumaHistoryId.ToString();
                                                                            var unit = durationUnitsList?.FirstOrDefault(x => x.Id == tr.TraumaHistoryDurationUnit)?.Name ?? "";
                                                                            <li>
                                                                                <b>@name</b>
                                                                                @if (tr.TraumaHistoryDuration.HasValue)
                                                                                {<span> | <b>Duration:</b> @tr.TraumaHistoryDuration @unit </span>}
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                </td>
                                                            </tr>
                                                        }

                                                        @* 6. Allergies *@
                                                        @if (Model.AllergyList != null && Model.AllergyList.Count > 0)
                                                        {
