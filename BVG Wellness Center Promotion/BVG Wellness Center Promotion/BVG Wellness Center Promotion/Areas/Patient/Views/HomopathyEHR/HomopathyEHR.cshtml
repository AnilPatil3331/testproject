<script>
    var advisedTherapyList = [];
    var editIndex = -1;


    // पेज लोड झाल्यावर आधीचा डेटा array मध्ये भरण्यासाठी
    $(document).ready(function () {
        @if (ViewBag.AdvisedTherapyResult != null)
        {
            foreach (var item in ViewBag.AdvisedTherapyResult)
            {
                <text>
                advisedTherapyList.push({
                    ATId: @item.ATId,
                    ServiceFid: '@item.ServiceFid',
                    ServiceName: '@item.ServiceName',
                    ServiceCategories: '@item.ServiceCategories',
                    DaysNumberId: '@item.DaysNumber',
                    DaysNumberText: '@item.DaysNumber',
                    DaysNumber: '@item.DaysNumber',
                    Frequency: '@item.Frequency',
                    InstructionPatinet: '@Html.Raw(item.InstructionPatinet)',
                    InstructionTherapist: '@Html.Raw(item.InstructionTherapist)'
                });
                </text>
            }
        }
        // सुरुवातीला एकदा टेबल रेंडर करा जेणेकरून DB मधला डेटा दिसेल
        renderTable();
    });
    $(document).on('click', '.ATCounter', function () {
        debugger
        var serviceText = $('#ATserviceFid option:selected').text();
        var serviceId = $('#ATserviceFid').val();

        if (!serviceId) {
            alert('Please select Service');
            return;
        }

        // Days validation
        var days = $('#ATDaysNumber').val();

        if (!days) {
            $("#daysError").show();
            $("#ATDaysNumber").focus();
            return; // data add होणार नाही
        }
        $("#daysError").hide();


        // Service Categories
        // ✅ Category - आता dropdown आहे checkbox नाही
        var categoryId   = $('#ddlServicegroup').val();
        var categoryText = $('#ddlServicegroup option:selected').text();

        if (!categoryId) {
            $("#addError").text("Please select Service Category before Add").show();
            return;
        } else {
            $("#addError").hide();
        }

        // Frequency
        var frequency = [];
        $('input[name="Frequency"]:checked').each(function () {
            frequency.push($(this).val());
        });

        var freqOther = $('input[name="FrequencyOther"]').val();
        if (freqOther) frequency.push(freqOther);

        // Consent


        // 🔥 REQUIRED VALIDATION (ADD BUTTON LEVEL)

        // 🔥 बदल: एडिट मोडमध्ये जुना ID टिकवून ठेवा, नाहीतर 0 द्या
        var currentATId = 0;
        if (editIndex >= 0) {
            currentATId = advisedTherapyList[editIndex].ATId;
        }
        var obj = {
            ATId:currentATId,
            ServiceFid: serviceId,
            ServiceName: serviceText,
            ServiceCategories: categoryText,
            ServiceGroupID:       categoryId,
            DaysNumberId: $('#ATDaysNumber').val(),
            DaysNumberText: $('#ATDaysNumber option:selected').text(),
            DaysNumber: $('#ATDaysNumber').val(),
            Frequency: frequency.join(', '),
            InstructionPatinet: $('#InstructionPatinet').val(),
            InstructionTherapist: $('#InstructionTherapist').val()
        };
        // 🔥 EDIT MODE
        if (editIndex >= 0) {
            advisedTherapyList[editIndex] = obj;
            editIndex = -1;
            $('.ATCounter').text('Add');
        } else {
            advisedTherapyList.push(obj);
        }
        //advisedTherapyList.push(obj);
        renderTable();
        $('#AdvisedTherapyJson').val(JSON.stringify(advisedTherapyList));
        // ✅ Manual Reset (form reset नाही - service dropdown blank होतो)
        $('#ddlServicegroup').val('');
        $('#ATserviceFid').empty().append('<option value="">-Select Service-</option>');
        $('#ATDaysNumber').val('');
        $('input[name="Frequency"]').prop('checked', false);
        $('input[name="FrequencyOther"]').val('');
        $('#InstructionPatinet').val('');
        $('#InstructionTherapist').val('');
        // optional clear
        $('#AdvisedTherapyForm')[0].reset();
    });

    function renderTable() {
        var tbody = $('#AdvisedTherapyTable tbody');
        tbody.empty();
        if (advisedTherapyList.length === 0) {
            tbody.append(`
            <tr>
                <td colspan="2" class="text-center text-muted">
                    No therapy added yet
                </td>
            </tr>
        `);
            return;
        }

        $.each(advisedTherapyList, function (i, item) {
            var editButton = "";
            if (!item.ATId || item.ATId == 0) {
                editButton = `<button type="button" class="btn btn-primary btn-sm mr-1" onclick="editRow1(${i})">Edit</button>`;
            }
            tbody.append(`
                <tr>
                    <td>
                        <b>Service:</b> ${item.ServiceName}<br/>
                        <b>Category:</b> ${item.ServiceCategories}<br/>
                       <b>Days:</b> ${item.DaysNumberText}
                        <b>Frequency:</b> ${item.Frequency}<br/>
                        <b>Patient:</b> ${item.InstructionPatinet}<br/>
                        <b>Therapist:</b> ${item.InstructionTherapist}<br/>

                    </td>
                <td>
                    ${editButton}
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow1(${i})">Remove</button>
                </td>
                </tr>
            `);
        });
    }

    function removeRow1(index) {
        debugger
        var item = advisedTherapyList[index];

        // 🔥 जर DB मधला record असेल तर delete call
        if (item.ATId && item.ATId != 0) {

            $.ajax({
                url: '/Patient/HomopathyEHR/DeleteAdvisedTherapyHomeopathy',
                type: 'POST',
                data: { id: item.ATId },
                success: function () {
                    console.log("Deleted from DB");
                }
            });
        }

        advisedTherapyList.splice(index, 1);
        renderTable();

        $('#AdvisedTherapyJson').val(JSON.stringify(advisedTherapyList));
    }

    function editRow1(index, e) {
        if (e) e.preventDefault();

        var item = advisedTherapyList[index];
        $('#ddlServicegroup').val(item.ServiceGroupID).trigger('change');
        $('#ATserviceFid').val(item.ServiceFid);
        $('#ATDaysNumber').val(item.DaysNumberId);

        $('#InstructionPatinet').val(item.InstructionPatinet);
        $('#InstructionTherapist').val(item.InstructionTherapist);

        $('input[name="ServiceCategories"]').prop('checked', false);
        item.ServiceCategories.split(', ').forEach(val => {
            $('input[name="ServiceCategories"][value="' + val + '"]').prop('checked', true);
        });

        $('input[name="Frequency"]').prop('checked', false);
        item.Frequency.split(', ').forEach(val => {
            $('input[name="Frequency"][value="' + val + '"]').prop('checked', true);
        });

        editIndex = index;
        $('.ATCounter').text('Update');
    }
</script>



