                                                                    <ul class="mb-0 pl-3 text-danger">
                                                                        @if (Model.RF_FeverIncrease)
                                                                        {
                                                                            <li>Fever Increase (ताप वाढणे)</li>
                                                                        }
                                                                        @if (Model.RF_SeverePain)
                                                                        {
                                                                            <li>Severe Pain (तीव्र वेदना)</li>
                                                                        }
                                                                        @if (Model.RF_SuddenWorsening)
                                                                        {
                                                                            <li>Sudden Worsening (अचानक प्रकृती बिघडणे)</li>
                                                                        }
                                                                        @if (Model.RF_VomitingBleeding)
                                                                        {
                                                                            <li>Vomiting / Bleeding (उलट्या / रक्तस्राव)</li>
                                                                        }
                                                                        @if (Model.RF_DizzinessFainting)
                                                                        {
                                                                            <li>Dizziness / Fainting (चक्कर / बेशुद्धी)</li>
                                                                        }
                                                                        @if (Model.RF_NoImprovement)
                                                                        {
                                                                            <li>No Improvement (सुधारणा न होणे)</li>
                                                                        }
                                                                    </ul>
                                                                </td>
                                                            </tr>
                                                        }

                                                        @* 12. Other Advice *@
                                                        @if (!string.IsNullOrEmpty(Model.RF_Other))
                                                        {
                                                            <tr>
                                                                <td style="background:#f1f1f1;"><b>Other Advice:</b></td>
                                                                <td>@Model.RF_Other</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>


