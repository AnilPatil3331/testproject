function removeFamilyHistoryRow(btn) {
    var row = $(btn).closest('.family-history-row');
    var container = row.closest('.family-history-container');
    var containerId = container.attr('id');

    row.remove();
    renumberFamilyRows(container);
    updateFamilyHistoryButtons(containerId);
}

function updateFamilyRowNames(row, index) {
    row.find('input, select').each(function() {
        var name = $(this).attr('name');
        if (name) {
            var newName = name.replace(/FamilyHistoryList\[\d+\]/, 'FamilyHistoryList[' + index + ']');
            $(this).attr('name', newName);
        }
    });
}

function renumberFamilyRows(container) {
    container.find('.family-history-row').each(function(idx) {
        updateFamilyRowNames($(this), idx);
    });
}

function updateFamilyHistoryButtons(containerId) {
    var container = $('#' + containerId);
    var rows = container.find('.family-history-row');
    var totalRows = rows.length;

    rows.each(function(idx) {
        var btnContainer = $(this).find('.btn-container');
        var isLast = (idx === totalRows - 1);

        var html = '';
        if (isLast) {
            if (idx === 0) {
                html = '<button type="button" class="btn btn-sm btn-success add-btn px-2" onclick="addNewFamilyHistoryRow(this, \'' + containerId + '\')"><i class="fas fa-plus"></i></button>';
            } else {
                html = '<button type="button" class="btn btn-sm btn-success add-btn px-2 mr-1" onclick="addNewFamilyHistoryRow(this, \'' + containerId + '\')"><i class="fas fa-plus"></i></button>' +
                       '<button type="button" class="btn btn-sm btn-danger remove-btn px-2" onclick="removeFamilyHistoryRow(this)"><i class="fas fa-trash"></i></button>';
            }
        } else {
            html = '<button type="button" class="btn btn-sm btn-danger remove-btn px-2" onclick="removeFamilyHistoryRow(this)"><i class="fas fa-trash"></i></button>';
        }
        btnContainer.html(html);
    });
}

