<script>
    let complaintIndex = document.querySelectorAll('.complaint-section').length;

    function addComplaint(data) {
        // --- 1. VALIDATION START (Fakt jeva manual click hoto tevach) ---
        debugger;
        if (!data) {
            let allSections = document.querySelectorAll(".complaint-section");

            if (allSections.length > 0) {
                let lastIndex = allSections.length - 1; // ✅ FIX
                let lastSection = allSections[lastIndex];

                // Mandatory fields ghene
                let complaintField = lastSection.querySelector('[name="Complaints[' + lastIndex + '].ComplaintId"]');
                let durationField = lastSection.querySelector('[name="Complaints[' + lastIndex + '].DurationC"]');
                let unitField = lastSection.querySelector('[name="Complaints[' + lastIndex + '].DurationUnitId"]');

                let isValid = true;

                // Borders Reset
                [complaintField, durationField, unitField].forEach(el => {
                    if (el) el.style.borderColor = "";
                });

                // Validation logic
                if (!complaintField || complaintField.value === "") {
                    if (complaintField) complaintField.style.borderColor = "red";
                    isValid = false;
                }
                if (!durationField || durationField.value === "") {
                    if (durationField) durationField.style.borderColor = "red";
                    isValid = false;
                }
                if (!unitField || unitField.value === "") {
                    if (unitField) unitField.style.borderColor = "red";
                    isValid = false;
                }

                if (!isValid) {
                    alert("Please complete the highlighted fields before adding a new complaint.");
                    return;
                }
            }
        }

        // 2. Template Rendering
        let template = document
            .getElementById("complaintTemplate")
            .innerHTML
            .replace(/__i__/g, complaintIndex);  // 🔥 Use complaintIndex instead of index

        document
            .getElementById("complaintsContainer")
            .insertAdjacentHTML("beforeend", template);

        let section = document.querySelectorAll(".complaint-section")[complaintIndex];

        // 3. Data Filling Logic
        if (data) {
            let complaintIdField = section.querySelector('[name="Complaints[' + complaintIndex + '].ComplaintId"]');
            if (complaintIdField) complaintIdField.value = data.ComplaintId || "";

            let durationField = section.querySelector('[name="Complaints[' + complaintIndex + '].DurationC"]');
            if (durationField) durationField.value = data.DurationC != null ? parseFloat(data.DurationC) : "";

            let unitField = section.querySelector('[name="Complaints[' + complaintIndex + '].DurationUnitId"]');
            if (unitField) unitField.value = data.DurationUnitId || "";

            let natureField = section.querySelector('[name="Complaints[' + complaintIndex + '].NatureOfIllnessId"]');
            if (natureField) natureField.value = data.NatureOfIllnessId || "";

            let progressionField = section.querySelector('[name="Complaints[' + complaintIndex + '].ProgressionId"]');
            if (progressionField) progressionField.value = data.ProgressionId || "";

            let symptomsField = section.querySelector('[name="Complaints[' + complaintIndex + '].AssociatedSymptomsId"]');
            if (symptomsField) { if (data.AssociatedSymptomsId) $(symptomsField).val(String(data.AssociatedSymptomsId).split(',')).trigger('change'); else $(symptomsField).val(null).trigger('change'); }

            let aggravatingField = section.querySelector('[name="Complaints[' + complaintIndex + '].AggravatingFactorsId"]');
            if (aggravatingField) { if (data.AggravatingFactorsId) $(aggravatingField).val(String(data.AggravatingFactorsId).split(',')).trigger('change'); else $(aggravatingField).val(null).trigger('change'); }

            let relievingField = section.querySelector('[name="Complaints[' + complaintIndex + '].RelievingFactorsId"]');
            if (relievingField) { if (data.RelievingFactorsId) $(relievingField).val(String(data.RelievingFactorsId).split(',')).trigger('change'); else $(relievingField).val(null).trigger('change'); }

            let responseField = section.querySelector('[name="Complaints[' + complaintIndex + '].ResponsePreviousTreatmentId"]');
            if (responseField) responseField.value = data.ResponsePreviousTreatmentId || "";

            let otherField = section.querySelector('[name="Complaints[' + complaintIndex + '].PreviousTreatmentOther"]');
            if (otherField) otherField.value = data.PreviousTreatmentOther || "";

            // Onset Radio
            if (data.Onset) {
                let onsetRadio = section.querySelector('[name="Complaints[' + complaintIndex + '].Onset"][value="' + data.Onset + '"]');
                if (onsetRadio) onsetRadio.checked = true;
            }
            debugger;
            // Previous Treatment Select
            if (data.PreviousTreatment) {
                let prevSelect = section.querySelector('[name="Complaints[' + complaintIndex + '].PreviousTreatment"]');
                if (prevSelect) {
                    prevSelect.value = data.PreviousTreatment;
                    $(prevSelect).trigger("change");
                }
                
                // Handle Other text field
                let selectedOption = $(prevSelect).find("option:selected").text().trim().toLowerCase();
                if (selectedOption === "other") {
                    let otherText = section.querySelector('.previousTreatmentText');
                    if (otherText) {
                        otherText.readOnly = false;
                        otherText.disabled = false;
                    }
                }
            }
        }

        complaintIndex++;  // 🔥 Increment complaintIndex



        // 2. Navin row add kelyavar Select2 parat chalu kara:
        $('.search-dropdown').select2({

            allowClear: false,
            width: '100%',
            sorter: function (data) {
                return data.sort(function (a, b) {
                    if (a.text > b.text) return 1;
                    if (a.text < b.text) return -1;
                    return 0;
                });
            }
        });
    }

    //function removeComplaint(btn){
    //    btn.closest(".complaint-section").remove();
    //    // Optional: Renumber remaining complaints
    //    renumberComplaints();
    //}

    // Optional: Renumber complaints after removal
    function renumberComplaints() {
        let sections = document.querySelectorAll(".complaint-section");
        sections.forEach((section, newIndex) => {
            section.querySelectorAll('[name*="Complaints["]').forEach(field => {
                let name = field.getAttribute('name');
                if (name) {
                    let newName = name.replace(/Complaints\[\d+\]/, 'Complaints[' + newIndex + ']');
                    field.setAttribute('name', newName);
                }
            });
        });
        complaintIndex = sections.length;
    }
</script>



