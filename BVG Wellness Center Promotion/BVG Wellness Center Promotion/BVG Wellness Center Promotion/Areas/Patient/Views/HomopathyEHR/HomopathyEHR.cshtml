        $(document).on("click", ".deleteRow", function () {

            var row = $(this).closest("tr");
            var index = row.data("index");              // array index
            var prescriptionId = row.attr("data-id");   // DB ID
            var deleteUrl = $("#deleteUrl").val();

            console.log("Deleting index:", index);
            console.log("Deleting ID:", prescriptionId);

            // ✅ 1. Array मधून remove कर
            if (index !== undefined) {
                prescriptions.splice(index, 1);
            }

            // ✅ 2. DB delete call (only if saved record)
            if (prescriptionId && prescriptionId != "0") {
                $.ajax({
                    url: deleteUrl,
                    type: 'POST',
                    data: { id: prescriptionId },
                    success: function () {
                        console.log("Deleted from DB");
                        window.location.reload();
                    },
                    error: function (err) {
                        console.log(err);
                        alert("Delete failed!");
                    }
                });
            }

            // ✅ 3. UI मधून remove
            row.remove();

            // ✅ 4. Re-index (VERY IMPORTANT)
            $("#prescriptionTable tbody tr").each(function (i) {
                $(this).attr("data-index", i);
            });

            // ✅ 5. Hidden field update
            $("#prescriptionJson").val(JSON.stringify(prescriptions));

        });
        // 📝 Edit Row
        $(document).on("click", ".editRow", function () {
            var row = $(this).closest("tr");
            editIndex = row.data("index");
            var data = prescriptions[editIndex];

            // १. मुख्य फील्ड्स सेट करा
            $("#FormID").val(data.FormID).trigger('change');
            $("#PackageID").val(data.PackageID);
            $("#NumberLeftID").val(data.NumberLeftID);
            $("#ProcessingQty").val(data.ProcessingQty);
            $("#ProcessingUnit").val(data.ProcessingUnit);
            $("#DoseNumberID").val(data.DoseNumberID);
            $("#QuantityIDDose").val(data.QuantityIDDose);
            $("#TimeID").val(data.TimeID);
            $("#DaysNumber").val(data.DaysNumber);

            // २. Mixing Data लोड करा
            $(".mixRow").remove();
            var mixData = JSON.parse(data.MixingDataJson);
            if (mixData && mixData.length > 0) {
                $(".numberRight:first").val(mixData[0].NumberRightID);
                $(".quantityId:first").val(mixData[0].QuantityID);
                $(".formulaId:first").val(mixData[0].FormulaID);

                for (var i = 1; i < mixData.length; i++) {
                    $(".addMixing").click(); // नवीन रो ॲड करा
                    var lastRow = $(".mixRow:last");
                    lastRow.find(".numberRight").val(mixData[i].NumberRightID);
                    lastRow.find(".quantityId").val(mixData[i].QuantityID);
                    lastRow.find(".formulaId").val(mixData[i].FormulaID);
                }
            }

            // ३. Fluid Mixing लोड करा
            $(".fluidMixRow").remove();
            var fluidData = JSON.parse(data.MixingDataFluid);
            if (fluidData && fluidData.length > 0) {
                $("#FluidNumberID").val(fluidData[0].FluidNumberID);
                $("#FluidQuantityID").val(fluidData[0].FluidQuantityID);
                $("#FluidVehicleID").val(fluidData[0].FluidVehicleID);

                for (var j = 1; j < fluidData.length; j++) {
                    $(".addFluidMixing").click();
                    var lastFluid = $(".fluidMixRow:last");
                    lastFluid.find(".fluidNumber").val(fluidData[j].FluidNumberID);
                    lastFluid.find(".fluidQuantity").val(fluidData[j].FluidQuantityID);
                    lastFluid.find(".fluidVehicle").val(fluidData[j].FluidVehicleID);
                }
            }

            // ४. बटनचे नाव बदला
            $(".addPrescription").text("Update").addClass("btn-warning").removeClass("btn-primary");
        });

        // 🔹 Form Based Logic (Enable/Disable)
        function toggleFields() {
            var text = $("#FormID option:selected").text().trim();
            var disableFluidForms = ["फाण्टHotInfusion", "काढाDecoction", "हिमColdInfusion"];

            if (disableFluidForms.includes(text)) {
                $("#FluidNumberID, #FluidQuantityID, #FluidVehicleID").prop("disabled", true);
                $(".addFluidMixing").prop("disabled", true).addClass("btn-secondary").removeClass("btn-primary");
                $("#ProcessingQty, #ProcessingUnit").prop("disabled", false);
            } else {
                $("#FluidNumberID, #FluidQuantityID, #FluidVehicleID").prop("disabled", false);
                $(".addFluidMixing").prop("disabled", false).addClass("btn-primary").removeClass("btn-secondary");
                $("#ProcessingQty, #ProcessingUnit").prop("disabled", true);
            }
        }

        toggleFields();
        $(document).on("change", "#FormID", toggleFields);

        // Quick date buttons
        $(".quick-date").click(function () {
            var days = parseInt($(this).data("days"));
            var newDate = new Date();
            newDate.setDate(newDate.getDate() + days);
            $("#MedicineDate").val(newDate.toISOString().split('T')[0]);
        });
    });
</script>


