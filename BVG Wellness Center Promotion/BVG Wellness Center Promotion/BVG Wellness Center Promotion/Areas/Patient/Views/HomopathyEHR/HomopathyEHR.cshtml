
@model BVG_Wellness_Center_Promotion.Areas.Patient.Models.HomopathyEHR
@using Newtonsoft.Json
@{
    ViewBag.Title = "HomeopathyEHR";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";

    var userInfo = ViewBag.UserInfo as List<dynamic> ?? new List<dynamic>();
    var answersDetail = ViewBag.AnswersDetail as List<dynamic> ?? new List<dynamic>();
    var levelCounts = ViewBag.LevelCounts as List<dynamic> ?? new List<dynamic>();
    var sectionCounts = ViewBag.SectionCounts as dynamic;
    int totalScore = ViewBag.TotalScore ?? 0;
    int patientFid = ViewBag.PatientFid ?? 0;
    if (Request.QueryString["isSummaryPopup"] == "true")
    {
        Layout = "~/Views/Shared/_LayoutPage.cshtml";
        <style>
            .topbar, .left-sidebar, .page-titles, .footer, .nav-tabs, .form-actions {
                display: none !important;
            }

            .page-wrapper {
                margin-left: 0 !important;
                padding-top: 0 !important;
                background: white !important;
            }

            body {
                visibility: hidden;
                background: white !important;
            }
        </style>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var summaryShort = document.getElementById('casePaperSummaryBlock');
                var summaryLong = document.getElementById('collapseCasePaper1');
                if (summaryShort || summaryLong) {
                    var finalHtml = '<div style="padding: 20px; visibility: visible; background: white;">';
                    if (summaryShort) {
                        finalHtml += summaryShort.innerHTML;
                    }
                    if (summaryShort && summaryLong) {
                        finalHtml += '<hr style="margin: 30px 0; border-top: 2px dashed #ccc;" />';
                    }
                    if (summaryLong) {
                        finalHtml += '<div><h4 style="margin-bottom: 20px; color: #1497de;">Detailed Appointment Summary</h4>' + summaryLong.innerHTML + '</div>';
                    }
                    finalHtml += '</div>';

                    document.body.innerHTML = finalHtml;
                    document.body.style.visibility = 'visible';
                    document.body.style.background = 'white';
                    document.documentElement.style.background = 'white';
                }
            });
        </script>
    }

    if (Request.QueryString["isCasePaperOnly"] == "true")
    {
        Layout = "~/Views/Shared/_LayoutPage.cshtml";
        <style>
            .topbar, .left-sidebar, .page-titles, .footer, .customtab2 {
                display: none !important;
            }

            .page-wrapper {
                margin-left: 0 !important;
                padding-top: 0 !important;
                background: white !important;
            }

            /* Hide all tab panes by default */
            .tab-pane {
                display: none !important;
            }

            /* Force Case Paper tab to show */
            #CasePaper {
                display: block !important;
                opacity: 1;
                visibility: visible;
            }
        </style>
    }
    int count = 1;
    double TotalAmount = 0;
    double TotalDiscount = 0;
    var PatientDetails = ViewBag.PatientDetails;
    var FinalBill = ViewBag.GetFinalBillDeatils;
    //var patient = ((IEnumerable<dynamic>)ViewBag.ViewBag.TodayPatients).FirstOrDefault();

}
