<script>
    $(document).ready(function () {

        // DOB -> Auto Age
        $("#dateOfBirth").on("change", function () {
            let dob = $(this).val();
            if (dob) {
                let birthDate = new Date(dob);
                let today = new Date();

                let age = today.getFullYear() - birthDate.getFullYear();
                let month = today.getMonth() - birthDate.getMonth();

                // Adjust if birthday not reached yet this year
                if (month < 0 || (month === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }

                // ---- DB INT ASLYAMULE HA DOCK DISPLAY LOGIC ----
                if (age <= 0) {
                    let days = today.getDate() - birthDate.getDate();
                    let totalMonths = month + (12 * (today.getFullYear() - birthDate.getFullYear()));

                    if (days < 0) { totalMonths--; }

                    if (totalMonths > 0) {
                        // Display sathi textbox madhye text dakva, pan submit hताना user change karel
                        $("#Age").val(totalMonths + " Months");
                    } else {
                        let timeDiff = today.getTime() - birthDate.getTime();
                        let diffDays = Math.floor(timeDiff / (1000 * 3600 * 24));
                        $("#Age").val(diffDays + " Days");
                    }
                } else {
                    $("#Age").val(age); // Jar 1 varsha peksha jast asel tar direct number direct basel
                }
            }
        });

        // Age -> Auto DOB
        $("#Age").on("input", function () {
            let rawInput = $(this).val().toLowerCase();
            let age = parseInt($(this).val());

            if (!isNaN(age) && age > 0) {
                let today = new Date();
                let dob = new Date();

                if (rawInput.includes("m")) {
                    dob.setMonth(today.getMonth() - age);
                }
                else if (rawInput.includes("d")) {
                    dob.setDate(today.getDate() - age);
                }
                else {
                    let dobYear = today.getFullYear() - age;
                    dob = new Date(dobYear, today.getMonth(), today.getDate());
                }

                let formatted =
                    dob.getFullYear() + "-" +
                    String(dob.getMonth() + 1).padStart(2, '0') + "-" +
                    String(dob.getDate()).padStart(2, '0');

                $("#dateOfBirth").val(formatted);

                // Form submit hताना SQL la error yeu naye mhanun fakt pure number text box madhye theva
                if (!rawInput.includes("m") && !rawInput.includes("d")) {
                    $(this).val(age);
                }
            }
        });

        // 🔥 IMPORTANT: Form submit hovaychya aadhi "Months/Days" text kadun 0 kara, nahi tar SQL crash hoil
        $("#patientDataForm").submit(function () {
            let ageField = $("#Age");
            let ageVal = ageField.val().toLowerCase();

            // Jar vayat 'months' kiva 'days' asel (mhanje mulga 1 varsha peksha lahan ahe), tar DB madhye 0 pathva
            if (ageVal.includes("m") || ageVal.includes("d")) {
                ageField.val(0);
            }
        });

    });
</script>
