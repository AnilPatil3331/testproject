        // Ek number double check hou naye mhanun hi variable thevli ahe
        var lastCheckedNumber = "";

        function checkExistingPatient() {
            var contactNo = $("#contact").val();

            // Fakt 10 digits aslyavar ani jar aadhi check kela nasel tarach AJAX call jail
            if (contactNo.length === 10 && contactNo !== lastCheckedNumber) {
                // Immediately set lastCheckedNumber to prevent duplicate calls from blur and input events
                lastCheckedNumber = contactNo;

                $.ajax({
                    url: '@Url.Action("CheckPatientExists", "AddPatient", new { area = "Patient" })',
                    type: 'POST',
