                                    $("#contact").val("");
                                    $("#mobileError").hide();
                                    $("#genderError").text("");
                                    $("#emailError").text("");
                                    $(".is-invalid").removeClass("is-invalid");
                                    
                                    $("#contact").focus();
                                    lastCheckedNumber = ""; // Reset check state
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log("AJAX Error: ", error);
                        lastCheckedNumber = ""; // Reset on error to allow retrying
                    }
                });
            }
            else if (contactNo.length < 10) {
                // User ne backspace dabun number kami kela tar reset kara
                lastCheckedNumber = "";
            }
        }

        // 'input' event support inputs (typing/paste/delete) directly
        $("#contact").on("input blur", function () {
            checkExistingPatient();
        });
    });
</script>
