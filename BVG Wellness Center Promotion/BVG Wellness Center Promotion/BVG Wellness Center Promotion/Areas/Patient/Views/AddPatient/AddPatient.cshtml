@model BVG_Wellness_Center_Promotion.Areas.Patient.Models.ClsPatient
@{
    ViewBag.Title = "AddPatient";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link href="~/assets/css/CustomeAlertCSS/customAlert.css" rel="stylesheet" />
<script src="~/assets/js/CustomeAlert/customAlert.js"></script>
<link rel="stylesheet"
      href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

<script>
    $(document).ready(function () {
        $("#dateOfBirth").datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: "1950:2026",
            dateFormat: "yy-mm-dd"
        });
    });
</script>
<style>
    .date-container {
        position: relative;
    }

        .date-container .form-control {
            padding-right: 40px;
        }

    .calendar-icon {
        position: absolute;
        right: 12px;
        top: 42px; /* Label खाली textbox मध्ये */
        color: #6c757d;
        pointer-events: none;
    }

    /* Custom SweetAlert styles for existing patient duplicates */
    .custom-swal-popup {
        width: 320px !important; /* compact width */
        border-radius: 8px !important;
        padding: 15px !important;
        font-family: inherit !important;
        box-shadow: 0 8px 20px rgba(0,0,0,0.12) !important;
    }
    .custom-swal-title {
        font-size: 15px !important;
        font-weight: 700 !important;
        color: #d69e2e !important; /* Soft orange/yellow warning theme */
        margin-bottom: 4px !important;
    }
    .custom-patient-container {
        max-height: 90px; /* even smaller list */
        overflow-y: auto;
        margin: 8px 0;
        padding: 4px 6px;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        background-color: #f7fafc;
        text-align: left;
    }
    .custom-patient-container::-webkit-scrollbar {
        width: 4px;
    }
    .custom-patient-container::-webkit-scrollbar-track {
        background: #edf2f7;
        border-radius: 4px;
    }
    .custom-patient-container::-webkit-scrollbar-thumb {
        background: #cbd5e0;
        border-radius: 4px;
    }
    .custom-patient-container::-webkit-scrollbar-thumb:hover {
        background: #a0aec0;
    }
    .custom-patient-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 6px;
        margin-bottom: 4px;
        background: #ffffff;
        border: 1px solid #edf2f7;
        border-radius: 4px;
        color: #2d3748;
        font-size: 11.5px;
        font-weight: 600;
        box-shadow: 0 1px 1px rgba(0,0,0,0.01);
        transition: all 0.2s ease;
    }
    .custom-patient-item:last-child {
        margin-bottom: 0;
    }
    .custom-patient-item:hover {
        border-color: #cbd5e0;
        background: #f8fafc;
    }
    .custom-patient-icon {
        color: #3182ce;
        font-size: 11px;
    }
    .custom-swal-text {
        font-size: 12px;
        color: #4a5568;
        line-height: 1.4;
    }
    .custom-swal-button {
        padding: 6px 12px !important;
        font-size: 11.5px !important;
        border-radius: 4px !important;
        margin: 4px !important;
    }
</style>
<style>
    #ddlPatientReference + .select2-container .select2-selection--single {
        height: 50px !important; /* Adjust as needed */
        line-height: 50px !important;
    }

    /* Increase the height of the selected text inside select2 */
    #ddlPatientReference + .select2-container .select2-selection__rendered {
        line-height: 50px !important;
        padding-top: 5px !important;
    }

    /* Increase the height of the dropdown options */
    #ddlPatientReference + .select2-container .select2-results__option {
        padding: 10px !important;
    }
</style>
