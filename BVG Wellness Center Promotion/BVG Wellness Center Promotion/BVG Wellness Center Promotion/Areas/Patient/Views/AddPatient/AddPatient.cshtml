<div class="container-fluid" style="padding-left:15px !important;">
    @*<div id="loader" class="loader hidden">
            <img src="~/assets/images/favicon-1.ico" />
        </div>*@
    <div class="row">
        <div class="col-sm-12">
            <form action="/Patient/AddPatient/SavePatient" id="patientDataForm" name="patientDataForm" novalidate="novalidate" method="post" data-parsley-validate="true" enctype="multipart/form-data">
                <div class="card p-0 shadow">
                    <!---->
                    <header class="card-header">
                        <div class="row">
                            <div class="col-sm-12 col-md-8 col-lg-8">
                                <h3 class="mb-0">
                                    @ViewBag.Update
                                </h3>
                            </div>
                            <div class="col-sm-12 col-md-4 col-lg-4">
                                <div class="d-flex justify-content-end">
                                    @*<button type="button" class="btn btn-sm btn-primary" id="btnBack">
                                            <i class="fa fa-angle-double-left">
                                            </i>
                                            Back
                                        </button>*@

                                    <a href="@Url.Action("PatientList", "AddPatient")"
                                       class="btn btn-sm btn-primary">
                                        <i class="fa fa-angle-double-left"></i> Back
                                    </a>

                                </div>
                            </div>
                        </div>
                    </header>
                    <div class="card-body">
                        @if (TempData["Message"] != null)
                        {
                            <script>
                                window.onload = function () {
                                    var message = '@TempData["Message"]';
                                    var alertType = '@TempData["Icon"]';
                                    var imageUrl = '@Url.Content("~/assets/images/check-circle.gif")';
                                    showCustomAlert(message, alertType, imageUrl);
                                };
                            </script>

                        }
                        <div id="formError" class="alert alert-danger" style="display: none; position: fixed; top: 10%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; padding: 20px; background-color: white; border: 2px solid red; border-radius: 5px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
                            <span id="formErrorMessage" style="color: black; font-size: 16px;">Please fill out all required fields.</span>
                            <button type="button" class="close" id="dismissError" aria-label="Close" style="background: none; border: none; font-size: 20px; margin-left: 10px; cursor: pointer; color: black;">
                                &times;
                            </button>
                        </div>
                        <!---->
                        @Html.HiddenFor(m => m.PatientFid)
                        @Html.HiddenFor(m => m.PatientFid_Encrypted)
                        @if (ViewBag.FromPatientContact != null)
                        {
                            <input hidden id="frompatientContact" name="FromPatientContact" value="true" />
                        }

                        <!-- Row 1: Contact, Patient Source, Referred By -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="mobile_number" class="form-control-label">
                                        Contact no.
                                        <span class="text-danger">
                                            *
                                        </span>
                                    </label>
                                    <div data-v-19351537="" id="phone_number" class="vue-phone-number-input flex"
                                         clearable="">
                                        @Html.TextBoxFor(m => m.ContactNumber, new { @class = "form-control", id = "contact", placeholder = "Enter Contact Number", required = "required", autocomplete = "off", minlength = "10", maxlength = "10", inputmode = "numeric", pattern = "[0-9]{10}", oninput = "validateMobile(this)" })
                                        <span id="mobileError" style="color:red; display:none;">Mobile number must be exactly 10 digits.</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="blood_group" class="form-control-label">
                                        Patient Source
                                    </label>
                                    @Html.DropDownListFor(m => m.PatientType, new SelectList(
                                                             new[] {
                                                                    new { Value = "", Text = "Select" },
                                                               new { Value="WalkIn", Text = "WalkIn" },
                                                               new { Value = "IVR-Outbound", Text = "IVR-Outbound" },
                                                                 new { Value = "IVR-Inbound", Text = "IVR-Inbound" },
                                                                 new { Value = "IVR-Doctor-Consulting", Text = "IVR-Doctor Consulting" },
                                                               new { Value = "Reference", Text = "Reference" },
                                                                new { Value = "CallCenter", Text = "Call Center" },
                                                                 new { Value = "Others", Text = "Others" },
                                                                 new { Value = "WhatsApp", Text = "WhatsApp" },
                                                             }, "Value", "Text"),
                                                                 new { @id = "PatientType", @class = "form-control custom-select", @required = "required" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="blood_group" class="form-control-label">
                                        Referred  By
                                    </label>
                                    @Html.TextBoxFor(m => m.PatientReference, new { @class = "form-control", id = "PatientReference", maxlength = "20" })
                                </div>
                            </div>
                        </div>

                        <!-- Row 2: First Name, Last Name, Clinic -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="first_name" class="form-control-label">
                                        First Name
                                        <span class="text-danger">*</span>
                                    </label>
                                    @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", id = "FirstName", placeholder = "Enter First Name", required = "required", maxlength = "50", autocomplete = "off", oninput = "validateName(this)" })
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="last_name" class="form-control-label">
                                        Last Name
                                        <span class="text-danger">
                                            *
                                        </span>
                                    </label>
                                    @Html.TextBoxFor(m => m.LName, new { @class = "form-control", id = "patientLastName", placeholder = "Enter Last name", required = "required", maxlength = "50", autocomplete = "off", oninput = "validateName(this)" })
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="doctor_id" class="form-control-label">
                                        Select Clinic
                                        <span class="text-danger">
                                            *
                                        </span>
                                    </label>
                                    @Html.DropDownListFor(m => m.ClinicFid, new SelectList(ViewBag.ClinicName, "Id", "Name"), new { @class = "form-control", id = "clicnicFid", required = "required" })
                                </div>
                            </div>
                        </div>

                        <!-- Row 3: Email, DOB, Age -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="email" class="form-control-label">
                                        Email-ID
                                        <span id="emailError" class="text-danger"></span>
                                    </label>
                                    @Html.TextBoxFor(m => m.Email, new
                                    {
                                        @class = "form-control",
                                        id = "patientEmail",
                                        placeholder = "Enter Email Address",
                                        name = "email",
                                        type = "email",
                                        autocomplete = "off",
                                        maxlength = "50",
                                        pattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$"
                                    })
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group date-container">
                                    <label for="dob" class="form-control-label">
                                        <span>DOB.</span>
                                    </label>

                                    @if (ViewBag.DateOfBirth != null)
                                    {
                                        @Html.TextBoxFor(m => m.DateOfBirth, new
                                        {
                                            @class = "form-control",
                                            id = "dateOfBirth",
                                            name = "Contact",
                                            placeholder = "Select Date",
                                            required = "required"
                                        })
                                    }
                                    else
                                    {
                                        @Html.TextBoxFor(m => m.DateOfBirth, new
                                        {
                                            @class = "form-control",
                                            id = "dateOfBirth",
                                            name = "Contact",
                                            placeholder = "Select Date"
                                        })
                                    }

                                    <i class="fa fa-calendar calendar-icon"></i>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="Age" class="form-control-label">
                                        Age <span class="text-danger">*</span>
                                    </label>

                                    @Html.TextBoxFor(m => m.Age, new
                                    {
                                        @class = "form-control",
                                        id = "Age",
                                        required = "required",
                                        maxlength = "10",
                                        placeholder = "Eg. 25 or 3M or 10D",
                                        autocomplete = "off"
                                    })

                                    <!-- Textbox chya agdi khali nit disnyasathi hi line -->
                                    <small class="text-muted d-block mt-1" style="font-size: 11px; font-weight: 500; color: #6c757d;">
                                        (Type: 25 for Years, 3M for Months, 10D for Days)
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Row 4: Blood Group, Gender -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="blood_group" class="form-control-label">
                                        Blood group
                                    </label>
                                    @Html.DropDownListFor(m => m.BloodGroup, new SelectList(
                                                             new[] {
                                                                   new { Value = "", Text = "Select Blood Group" },
                                                              new { Value="A+", Text = "A+" },
                                                              new { Value = "B+", Text = "B+" },
                                                              new { Value = "AB+", Text = "AB+" },
                                                               new { Value = "O+", Text = "O+" },
                                                                 new { Value = "A-", Text = "A-" },
                                                                  new { Value = "B-", Text = "B-" },
                                                                  new { Value = "AB-", Text = "AB-" },
                                                                   new { Value = "O-", Text = "O-" },
                                                                    new { Value = "Unknown", Text = "Unknown" }
                                                             }, "Value", "Text"),
                                                                 new { @id = "BloodGroup", @class = "form-control custom-select" })
                                </div>
                            </div>

                            <div id="patient_gender_div" class="col-md-4">
                                <div class="form-group">
                                    <label for="gender" class="form-control-label">
                                        Gender
                                        <span class="text-danger">
                                            *
                                        </span>
                                    </label>
                                    <div class="col-md-12 p-0">
                                        <div class="custom-control custom-radio custom-control-inline">
                                            @Html.RadioButtonFor(m => m.Gender, "Male", new { @class = "custom-control-input", id = "male", required = "required" })
                                            <label for="male" class="custom-control-label">Male</label>
                                        </div>
                                        <div class="custom-control custom-radio custom-control-inline">
                                            @Html.RadioButtonFor(m => m.Gender, "Female", new { @class = "custom-control-input", id = "female" })
                                            <label for="female" class="custom-control-label">Female</label>
                                        </div>
                                        <div class="custom-control custom-radio custom-control-inline">
                                            @Html.RadioButtonFor(m => m.Gender, "Other", new { @class = "custom-control-input", id = "other" })
                                            <label for="other" class="custom-control-label">Other</label>
                                        </div>
                                    </div>
                                    <span id="genderError" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <hr>

                        <div class="row">
                            <div class="col-md-12">
                                <h4 class="text-primary mb-4">
                                    Other details
                                </h4>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="address" class="form-control-label">
                                        Address
                                    </label>
                                    @Html.TextAreaFor(m => m.Address, new { @class = "form-control", id = "address", placeholder = "Enter address", type = "text", name = "Address", maxlength = "200", onkeyup = "validateAddress(this);" })
                                </div>
                            </div>
                        </div>
