<script>
    var isDropdownMode = true;

    $(document).ready(function () {
        // 1. Postal Code → Only numbers allow
        $("#postalCode").on("input", function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        // 2. Set default mode to dropdown on load (Edit मोडचे डिटेल्स पण इथेच फेच होतील)
        setManualMode(false);

        // 3. Pincode fetch auto-fill logic
        $("#postalCode").on("input keyup", function () {
            var pincode = $(this).val().trim();
            if (pincode.length === 6 && /^\d+$/.test(pincode)) {
                $.ajax({
                    url: 'https://api.postalpincode.in/pincode/' + pincode,
                    method: 'GET',
                    success: function (response) {
                        if (response && response[0] && response[0].Status === 'Success') {
                            var postOffice = response[0].PostOffice[0];
                            var city = postOffice.District || postOffice.Block || postOffice.Division || postOffice.Name;
                            var country = 'India';

                            // Populate hidden/original text inputs
                            $('#cityFid').val(city);
                            $('#country').val(country);

                            // Populate/select values in the dropdowns
                            updateSelectDropdowns(city, country);
                        }
                    }
                });
            }
        });

        // 4. Dropdown sync logic (Dropdown बदलल्यावर मूळ मॉडेलच्या टेक्स्टबॉक्सची व्हॅल्यू अपडेट होईल)
        $('#citySelect').on('change', function () {
            $('#cityFid').val($(this).val());
        });

        $('#countrySelect').on('change', function () {
            $('#country').val($(this).val());
        });
    });

    function toggleAddressFieldsMode() {
        isDropdownMode = !isDropdownMode;
        setManualMode(!isDropdownMode);
    }

    function setManualMode(isManual) {
        if (isManual) {
            $('#cityTextInputWrapper').show();
            $('#countryTextInputWrapper').show();
            $('#citySelectInputWrapper').hide();
            $('#countrySelectInputWrapper').hide();
            $('#btnToggleMode').text('Choose City/Country from list');
            isDropdownMode = false;
        } else {
            $('#cityTextInputWrapper').hide();
            $('#countryTextInputWrapper').hide();
            $('#citySelectInputWrapper').show();
            $('#countrySelectInputWrapper').show();

            // Edit मोड असेल तर आधीच भरलेले डिटेल्स फेच करण्यासाठी
            var currentCity = $('#cityFid').val();
            var currentCountry = $('#country').val();

            if (currentCity) {
                updateSelectDropdowns(currentCity, currentCountry);
            } else {
                $('#citySelect').val('');
            }
            if (currentCountry) {
                updateSelectDropdowns(currentCity, currentCountry);
            } else {
                $('#countrySelect').val('India');
                $('#country').val('India');
            }

            $('#btnToggleMode').text('Enter City/Country manually');
            isDropdownMode = true;
        }
    }

    function updateSelectDropdowns(city, country) {
        if (country) {
            // जर कंट्री लिस्ट मध्ये नसेल तर ती ऍड करून सिलेक्ट करा
            if ($("#countrySelect option[value='" + country + "']").length === 0) {
                $('#countrySelect').append(new Option(country, country));
            }
            $('#countrySelect').val(country);
        }
        if (city) {
            // जर सिटी लिस्ट मध्ये नसेल तर ती ऍड करून सिलेक्ट करा
            if ($("#citySelect option[value='" + city + "']").length === 0) {
                $('#citySelect').append(new Option(city, city));
            }
            $('#citySelect').val(city);
        }
    }

    function OnlyNumber(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode >= 48 && charCode <= 57) {
            return true;
        }
        return false;
    }
</script>


<script>
    function validateAddress(input) {

        var value = input.value;

        // allow A-Z a-z 0-9 space - / . ,
        value = value.replace(/[^a-zA-Z0-9\s\-\/\.,]/g, '');

        input.value = value.toUpperCase();
    }



    function onlyAlphabets(input) {

        var value = input.value;

        // allow only alphabets
        value = value.replace(/[^a-zA-Z\s]/g, '');

        input.value = value.toUpperCase();
    }

    function validateMobile(input) {
        // Keep only digits
        input.value = input.value.replace(/\D/g, '');

        // Show error if length not exactly 10
        const errorSpan = document.getElementById('mobileError');
        if (input.value.length === 10) {
            errorSpan.style.display = 'none';
        } else {
            errorSpan.style.display = 'inline';
        }
    }

    // Optional: final check on form submit
    document.querySelector('form').addEventListener('submit', function (e) {
        const input = document.getElementById('contact');
        if (input.value.length !== 10) {
            e.preventDefault();
            alert('Mobile number must be exactly 10 digits.');
            input.focus();
        }
    });


    $("form").submit(function (e) {
        var mobile = $("#contact").val();
        if (mobile.length !== 10) {
            alert("Please enter a valid 10-digit mobile number.");
            $("#contact").focus();
            e.preventDefault();
            return false;
        }
    });

    $("form").submit(function (e) {
        var pType = $("#PatientType").val();
        if (pType === "") {
            alert("Please select a Patient Type.");
            $("#PatientType").focus();
            e.preventDefault();
            return false;
        }
    });

</script>
<script>
    $("#patientEmail").on("input", function () {

        var email = $(this).val().trim();
        var emailPattern = new RegExp("^[^@@\\s]+@@[^@@\\s]+\\.[^@@\\s]+$");

        if (email === "") {
            $("#emailError").text("");
            $(this).removeClass("is-invalid");
            return;
        }

        if (!email.includes("@@")) {
            $("#emailError").text("Email must contain @@");
            $(this).addClass("is-invalid");
            return;
        }

        if (!emailPattern.test(email)) {
            $("#emailError").text("Invalid Email format");
            $(this).addClass("is-invalid");
        } else {
            $("#emailError").text("");
            $(this).removeClass("is-invalid");
        }

    });


</script>

<script>
    document.getElementById("btnSavePatinet").addEventListener("click", function (e) {

        var form = document.getElementById("patientDataForm");

        // HTML validation
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        // 🔥 CUSTOM VALIDATION START

        var isValid = true;

        // Gender check
        var gender = document.querySelector('input[name="Gender"]:checked');
        if (!gender) {
            isValid = false;
            document.getElementById("genderError").innerText = "Please select Gender";
        } else {
            document.getElementById("genderError").innerText = "";
        }

        // Age check
        var ageInput = document.getElementById("Age");
        var ageValue = ageInput.value.trim();

        if (!ageValue || ageValue === "" || ageValue === "0") {
            isValid = false;
            ageInput.classList.add("is-invalid");
        } else {
            ageInput.classList.remove("is-invalid");
        }

        if (!isValid) {
            showCustomAlert("Please fill all required fields properly", "error", "");
            return; // ❌ STOP here
        }

        // 🔥 CUSTOM VALIDATION END

        Swal.fire({
            title: "Save Patient?",
            text: "Do you want to save this patient details?",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "Yes, Save",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit(); // ✅ safe now
            }
        });
    });
</script>
<script>
    $(document).ready(function () {
