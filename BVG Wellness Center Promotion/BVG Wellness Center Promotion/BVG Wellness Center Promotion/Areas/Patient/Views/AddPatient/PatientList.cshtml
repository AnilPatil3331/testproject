<script>
    let sortDirection = {};

    function sortTable(columnIndex) {
        let table = document.getElementById("Patienttable");
        let tbody = table.querySelector("tbody");
        let rows = Array.from(tbody.querySelectorAll("tr"));

        // Toggle ASC / DESC
        sortDirection[columnIndex] = !sortDirection[columnIndex];

        let isAsc = sortDirection[columnIndex];

        rows.sort((a, b) => {
            let cellA = a.children[columnIndex].innerText.trim();
            let cellB = b.children[columnIndex].innerText.trim();

            // Date check (Registered ON column)
            if (columnIndex === 6) {
                let dateA = new Date(cellA);
                let dateB = new Date(cellB);
                return isAsc ? dateA - dateB : dateB - dateA;
            }

            // String compare (Name column)
            return isAsc
                ? cellA.localeCompare(cellB)
                : cellB.localeCompare(cellA);
        });

        // Re-append sorted rows
        rows.forEach(row => tbody.appendChild(row));
    }
</script>