<script>
    var rawPatientData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.PatientDetails));

    function excelDateToJSDate(serial) {
        if (typeof serial === 'number') {
            var utc_days = Math.floor(serial - 25569);
            var utc_value = utc_days * 86400;
            var date_info = new Date(utc_value * 1000);
            var tzOffset = date_info.getTimezoneOffset() * 60 * 1000;
            return new Date(date_info.getTime() + tzOffset);
        }
        if (typeof serial === 'string') {
            var d = new Date(serial);
            if (!isNaN(d.getTime())) return d;
        }
        return null;
    }

    function formatDateToISO(date) {
        if (!date) return null;
        var y = date.getFullYear();
        var m = String(date.getMonth() + 1).padStart(2, '0');
        var d = String(date.getDate()).padStart(2, '0');
        return y + '-' + m + '-' + d;
    }

    function parseDotNetDate(dateStr) {
        if (!dateStr) return "";
        if (typeof dateStr === 'string' && dateStr.indexOf('/Date(') !== -1) {
            var millis = parseInt(dateStr.replace(/\/Date\((\d+)\)\//, '$1'));
            return formatDateToISO(new Date(millis));
        }
        var d = new Date(dateStr);
        if (!isNaN(d.getTime())) {
            return formatDateToISO(d);
        }
        return "";
    }

    function robustParseDate(val) {
        if (!val) return null;
        
        if (val instanceof Date || Object.prototype.toString.call(val) === '[object Date]') {
            return isNaN(val.getTime()) ? null : val;
        }
        
        if (typeof val === 'number') {
            return excelDateToJSDate(val);
        }
        
        var str = String(val).trim();
        if (str === "") return null;
        
        // Check for DD/MM/YYYY or DD-MM-YYYY formats (e.g. 01/06/2000 or 1-6-2000)
        var parts = str.split(/[\/\-]/);
        if (parts.length === 3) {
            var p0 = parseInt(parts[0], 10);
            var p1 = parseInt(parts[1], 10);
            var p2 = parseInt(parts[2], 10);
            
            // Format: YYYY-MM-DD
            if (p0 > 1000 && p1 <= 12 && p2 <= 31) {
                return new Date(p0, p1 - 1, p2);
            }
            // Format: DD/MM/YYYY or MM/DD/YYYY. In India/UK, DD/MM/YYYY is default
            if (p0 <= 31 && p1 <= 12 && p2 > 1000) {
                return new Date(p2, p1 - 1, p0);
            }
            // Format with 2 digit year: DD/MM/YY
            if (p0 <= 31 && p1 <= 12 && p2 <= 99) {
                var fullYear = p2 + (p2 < 50 ? 2000 : 1900);
                return new Date(fullYear, p1 - 1, p0);
            }
        }
        
        var fallbackDate = new Date(str);
        if (!isNaN(fallbackDate.getTime())) {
            return fallbackDate;
        }
        
        return null;
    }

    function robustParseGender(val) {
        if (!val) return "Male";
        var s = String(val).trim().toLowerCase();
        if (s === "m" || s === "male" || s === "पुरुष") return "Male";
        if (s === "f" || s === "female" || s === "स्त्री") return "Female";
        if (s === "o" || s === "other" || s === "इतर") return "Other";
        return "Invalid";
    }

    function robustParseBloodGroup(val) {
        if (!val) return "";
        var s = String(val).trim().toUpperCase().replace(/\s+/g, "");
        s = s.replace(/POSITIVE|\+VE/g, "+");
        s = s.replace(/NEGATIVE|-VE/g, "-");
        return s;
    }

    $(document).ready(function () {    

        $("#btnExport").click(function () {
            if (!rawPatientData || rawPatientData.length === 0) {
                Swal.fire("Info", "No patient data available to export.", "info");
                return;
            }

            var exportData = rawPatientData.map(function(p) {
                return {
                    "UHID No": p.UHIDNO || "",
                    "First Name": p.FirstName || "",
                    "Last Name": p.LName || "",
                    "Contact Number": p.ContactNumber || "",
                    "Email": p.Email || "",
                    "Date Of Birth (YYYY-MM-DD)": parseDotNetDate(p.DateOfBirth),
                    "Age": p.Age || "",
                    "Gender": p.Gender || "",
                    "Blood Group": p.BloodGroup || "",
                    "Weight (kg)": p.Weight || 0,
                    "Pulse": p.Palse || "",
                    "Blood Pressure": p.BloodPressure || "",
                    "SpO2": p.SpO2 || "",
                    "Health Issue": p.HealthIssue || "",
                    "Address": p.Address || "",
                    "City Name": p.CityName || "",
                    "Postal Code": p.PostalCode || "",
                    "Country": p.Country || "",
                    "Patient Type": p.PatientType || "",
                    "Patient Reference": p.PatientReference || "",
                    "Status": p.Status || "",
                    "Registered On": p.FormattedDate || ""
                };
            });

            var wb = XLSX.utils.book_new();
            var ws = XLSX.utils.json_to_sheet(exportData);
            
            // Set beautiful professional column widths
            var wscols = [
                {wch: 16}, // UHID No
                {wch: 15}, // First Name
                {wch: 15}, // Last Name
                {wch: 18}, // Contact Number
                {wch: 25}, // Email
                {wch: 28}, // Date Of Birth (YYYY-MM-DD)
                {wch: 8},  // Age
                {wch: 10}, // Gender
                {wch: 14}, // Blood Group
                {wch: 14}, // Weight (kg)
                {wch: 10}, // Pulse
                {wch: 16}, // Blood Pressure
                {wch: 10}, // SpO2
                {wch: 22}, // Health Issue
                {wch: 25}, // Address
                {wch: 15}, // City Name
                {wch: 12}, // Postal Code
                {wch: 12}, // Country
                {wch: 15}, // Patient Type
                {wch: 22}, // Patient Reference
                {wch: 10}, // Status
                {wch: 18}  // Registered On
            ];
            ws['!cols'] = wscols;

            XLSX.utils.book_append_sheet(wb, ws, "Patients");
            XLSX.writeFile(wb, "PatientList.xlsx");
        });

        $("#btnDownloadTemplate").click(function () {
            var headers = [
                "First Name", "Last Name", "Contact Number", "Email", "Gender", 
                "Date Of Birth (YYYY-MM-DD)", "Age", "Blood Group", "Weight (kg)", 
                "Pulse", "Blood Pressure", "SpO2", "Health Issue", "Address", 
                "City Name", "Postal Code", "Country", "Patient Type", "Patient Reference"
            ];
            
            var sampleRow = [
                "ANIL", "PATIL", "8796489335", "ap879648@gmail.com", "Male", 
                "2000-06-01", 25, "O+", 70, 
                72, "120/80", 98, "Back Pain", "Shivaji Nagar", 
                "PUNE", "425408", "India", "WalkIn", "Friend Reference"
            ];

            var workbook = new ExcelJS.Workbook();
            var worksheet = workbook.addWorksheet("Patient Template");

            // Add headers
            var headerRow = worksheet.addRow(headers);
            headerRow.font = { name: 'Arial', size: 11, bold: true, color: { argb: 'FFFFFFFF' } };
            headerRow.fill = {
                type: 'pattern',
                pattern: 'solid',
                fgColor: { argb: 'FF007BFF' }
            };
            headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
            headerRow.height = 25;

            // Apply formatting for dates
            var dobCol = worksheet.getColumn(6); // F is 6
            dobCol.numFmt = 'yyyy-mm-dd';

            // Define validation range: from row 2 to 1000
            for (var r = 2; r <= 1000; r++) {
                // First Name Validation (A)
                worksheet.getCell('A' + r).dataValidation = {
                    type: 'custom',
                    allowBlank: true,
                    showInputMessage: true,
                    promptTitle: 'Patient First Name',
                    prompt: 'Please enter the First Name. It will be automatically capitalized upon import.',
                    formulae: ['TRUE']
                };

                // Last Name Validation (B)
                worksheet.getCell('B' + r).dataValidation = {
                    type: 'custom',
                    allowBlank: true,
                    showInputMessage: true,
                    promptTitle: 'Patient Last Name',
                    prompt: 'Please enter the Last Name. It will be automatically capitalized upon import.',
                    formulae: ['TRUE']
                };

                // Contact Number Validation (C) - must be exactly 10 digits
                worksheet.getCell('C' + r).dataValidation = {
                    type: 'textLength',
                    operator: 'equal',
                    formulae: [10],
                    allowBlank: true,
                    showErrorMessage: true,
                    errorTitle: 'Invalid Contact Number',
                    error: 'Contact number must be exactly 10 digits (numbers only, e.g., 9876543210).',
                    showInputMessage: true,
                    promptTitle: 'Contact Number',
                    prompt: 'Enter a 10-digit mobile number.'
                };

                // Email Validation (D)
                worksheet.getCell('D' + r).dataValidation = {
                    type: 'custom',
                    allowBlank: true,
                    formulae: ['AND(ISNUMBER(FIND("@@",D' + r + ')),ISNUMBER(FIND(".",D' + r + ')),ISERROR(FIND(" ",D' + r + ')))'],
                    showErrorMessage: true,
                    errorTitle: 'Invalid Email Format',
                    error: 'Please enter a valid email address (e.g., test@example.com).',
                    showInputMessage: true,
                    promptTitle: 'Email Address',
                    prompt: 'Enter a valid email address.'
                };

                // Gender Validation (E) - dropdown list
                worksheet.getCell('E' + r).dataValidation = {
                    type: 'list',
                    allowBlank: true,
                    formulae: ['"Male,Female,Other"'],
                    showErrorMessage: true,
                    errorTitle: 'Invalid Gender Value',
                    error: 'Please select Gender from the list (Male, Female, or Other).',
                    showInputMessage: true,
                    promptTitle: 'Gender Dropdown',
                    prompt: 'Choose Male, Female, or Other from the dropdown list.'
                };

                // Date of Birth Validation (F)
                worksheet.getCell('F' + r).dataValidation = {
                    type: 'date',
                    operator: 'lessThan',
                    formulae: [new Date(2099, 11, 31)], // Ensure it's a valid date
                    allowBlank: true,
                    showErrorMessage: true,
                    errorTitle: 'Invalid Date of Birth',
                    error: 'Date of Birth must be a valid date in the past formatted as YYYY-MM-DD.',
                    showInputMessage: true,
                    promptTitle: 'Date of Birth',
                    prompt: 'Enter date of birth in YYYY-MM-DD format.'
                };
            }

            // Set beautiful professional column widths
            worksheet.columns = [
                { width: 18 }, // First Name
                { width: 18 }, // Last Name
                { width: 20 }, // Contact Number
                { width: 28 }, // Email
                { width: 12 }, // Gender
                { width: 28 }, // Date Of Birth (YYYY-MM-DD)
                { width: 8 },  // Age
                { width: 14 }, // Blood Group
                { width: 14 }, // Weight (kg)
                { width: 10 }, // Pulse
                { width: 18 }, // Blood Pressure
                { width: 10 }, // SpO2
                { width: 25 }, // Health Issue
                { width: 30 }, // Address
                { width: 18 }, // City Name
                { width: 14 }, // Postal Code
                { width: 14 }, // Country
                { width: 18 }, // Patient Type
                { width: 25 }  // Patient Reference
            ];

            workbook.xlsx.writeBuffer().then(function (buffer) {
                var blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                var url = window.URL.createObjectURL(blob);
                var a = document.createElement("a");
                a.href = url;
                a.download = "Patient_Import_Template.xlsx";
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
            }).catch(function (error) {
                console.error("Error writing excel file:", error);
                Swal.fire("Error", "Could not download template. Please try again.", "error");
            });
        });

        $("#btnImport").click(function () {
            $("#importExcelFile").click();
        });

        $("#importExcelFile").change(function(e) {
            var files = e.target.files;
            if (!files || files.length === 0) return;
            var file = files[0];

            var reader = new FileReader();
            reader.onload = function(e) {
                var data = new Uint8Array(e.target.result);
                var workbook = XLSX.read(data, { type: 'array', cellDates: true });
                var sheetName = workbook.SheetNames[0];
                var worksheet = workbook.Sheets[sheetName];
                var rows = XLSX.utils.sheet_to_json(worksheet, { defval: "" });

                if (rows.length === 0) {
                    Swal.fire("Error", "The uploaded Excel file contains no data.", "error");
                    $("#importExcelFile").val("");
                    return;
                }

                var patientsList = [];
                var importErrors = [];

                for (var i = 0; i < rows.length; i++) {
                    var row = rows[i];
                    var patient = {};
                    var rowNum = i + 2;

                    for (var key in row) {
                        var normalizedKey = key.toLowerCase().replace(/[^a-z0-9]/g, "");
                        var val = row[key];

                        if (normalizedKey === "firstname" || normalizedKey === "first" || normalizedKey === "fname" || normalizedKey === "name") {
                            patient.FirstName = String(val).toUpperCase().trim();
                        } else if (normalizedKey === "lastname" || normalizedKey === "last" || normalizedKey === "lname") {
                            patient.LName = String(val).toUpperCase().trim();
                        } else if (normalizedKey === "contactnumber" || normalizedKey === "contact" || normalizedKey === "mobile" || normalizedKey === "phone" || normalizedKey === "number") {
                            patient.ContactNumber = String(val).replace(/[^0-9]/g, "");
                        } else if (normalizedKey === "email" || normalizedKey === "mailid" || normalizedKey === "emailid") {
                            patient.Email = String(val).trim();
                        } else if (normalizedKey === "gender" || normalizedKey === "sex") {
                            patient.Gender = robustParseGender(val);
                        } else if (normalizedKey.indexOf("dateofbirth") !== -1 || normalizedKey === "dob" || normalizedKey === "birthdate") {
                            var parsedDate = robustParseDate(val);
                            patient.DateOfBirth = formatDateToISO(parsedDate);
                        } else if (normalizedKey === "age") {
                            patient.Age = String(val).replace(/[^0-9]/g, "");
                        } else if (normalizedKey.indexOf("bloodgroup") !== -1 || normalizedKey === "bg") {
                            patient.BloodGroup = robustParseBloodGroup(val);
                        } else if (normalizedKey.indexOf("weight") !== -1) {
                            patient.Weight = parseInt(String(val).replace(/[^0-9]/g, "")) || 0;
                        } else if (normalizedKey === "pulse" || normalizedKey === "palse") {
                            patient.Palse = String(val).replace(/[^0-9]/g, "");
                        } else if (normalizedKey === "bloodpressure" || normalizedKey === "bp") {
                            patient.BloodPressure = String(val).replace(/\s+/g, "").replace(/[^\d\/]/g, "");
                        } else if (normalizedKey === "spo2") {
                            patient.SpO2 = String(val).replace(/[^0-9]/g, "");
                        } else if (normalizedKey === "healthissue" || normalizedKey === "issue" || normalizedKey === "disease") {
                            patient.HealthIssue = val;
                        } else if (normalizedKey === "address") {
                            patient.Address = val;
                        } else if (normalizedKey === "cityname" || normalizedKey === "city") {
                            patient.CityName = val;
                        } else if (normalizedKey === "postalcode" || normalizedKey === "pincode" || normalizedKey === "zipcode") {
                            patient.PostalCode = String(val).replace(/[^0-9]/g, "");
                        } else if (normalizedKey === "country") {
                            patient.Country = val;
                        } else if (normalizedKey === "patienttype" || normalizedKey === "type") {
                            patient.PatientType = val;
                        } else if (normalizedKey === "patientreference" || normalizedKey === "reference") {
                            patient.PatientReference = val;
                        }
                    }

                    if (!patient.FirstName) {
                        importErrors.push("Row " + rowNum + ": 'First Name' is missing.");
                        continue;
                    }
                    if (!patient.ContactNumber) {
                        importErrors.push("Row " + rowNum + " (" + patient.FirstName + "): 'Contact Number' is missing.");
                        continue;
                    }
                    if (patient.ContactNumber.length !== 10) {
                        importErrors.push("Row " + rowNum + " (" + patient.FirstName + "): 'Contact Number' (" + patient.ContactNumber + ") must be exactly 10 digits.");
                        continue;
                    }
                    if (patient.Email && patient.Email !== "") {
                        var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                        if (!emailRegex.test(patient.Email)) {
                            importErrors.push("Row " + rowNum + " (" + patient.FirstName + "): 'Email' (" + patient.Email + ") has an invalid format.");
                            continue;
                        }
                    }
                    if (patient.Gender !== "Male" && patient.Gender !== "Female" && patient.Gender !== "Other") {
                        importErrors.push("Row " + rowNum + " (" + patient.FirstName + "): 'Gender' must be Male, Female, or Other.");
                        continue;
                    }
                    if (!patient.DateOfBirth || patient.DateOfBirth === "") {
                        importErrors.push("Row " + rowNum + " (" + patient.FirstName + "): 'Date Of Birth' is invalid or missing.");
                        continue;
                    }

                    patientsList.push(patient);
                }

                if (patientsList.length === 0) {
                    Swal.fire("Error", "No valid patient rows found. Errors:<br>" + importErrors.join("<br>"), "error");
                    $("#importExcelFile").val("");
                    return;
                }

                var confirmMsg = "Found " + patientsList.length + " patients to import/update.";
                if (importErrors.length > 0) {
                    confirmMsg += " (Skipped " + importErrors.length + " invalid rows).";
                }
                confirmMsg += " Do you want to proceed?";

                Swal.fire({
                    title: 'Confirm Import',
                    text: confirmMsg,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Import!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $(".page-loader-section").show();

                        $.ajax({
                            url: '/Patient/AddPatient/ImportPatients',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ patients: patientsList }),
                            success: function(response) {
                                $(".page-loader-section").hide();
                                $("#importExcelFile").val("");

                                if (response.success) {
                                    var statusIcon = "success";
                                    var errorDetails = "";
                                    if (response.errors && response.errors.length > 0) {
                                        statusIcon = "warning";
                                        errorDetails = "<br><br><b>Warnings:</b><br>" + response.errors.join("<br>");
                                    }
                                    Swal.fire({
                                        title: 'Success',
                                        html: response.message + errorDetails,
                                        icon: statusIcon
                                    }).then(() => {
                                        window.location.reload();
                                    });
                                } else {
                                    Swal.fire("Error", response.message, "error");
                                }
                            },
                            error: function() {
                                $(".page-loader-section").hide();
                                $("#importExcelFile").val("");
                                Swal.fire("Error", "An error occurred while uploading patient data.", "error");
                            }
                        });
                    } else {
                        $("#importExcelFile").val("");
                    }
                });
            };
            reader.readAsArrayBuffer(file);
        });

    });


