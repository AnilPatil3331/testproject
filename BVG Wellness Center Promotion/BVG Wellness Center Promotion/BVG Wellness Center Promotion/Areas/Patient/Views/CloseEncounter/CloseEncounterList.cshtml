                            <div class="row">
                                <div class="col-12">
                                    <div class="d-flex align-items-center justify-content-between w-100">
                                        <!-- Logo Section -->
                                        <div class="mr-3">
                                            <img src="~/assets/images/BVG.png" style="height: 50px;" />
                                        </div>
                                        <!-- Clinic Info Section -->
                                        <div class="mr-3">
                                            <h4 class="mb-0">BVG WELLNESS CLINIC & PATH LAB</h4>
                                        </div>
                                        <!-- Address & Payment Status Section -->
                                        <div class="text-right ml-auto" style="margin-left:20px;">
                                            <p class="mb-0 text-primary">BVG Life Science Limited</p>
                                            <p class="mb-0">
                                                Sagar Complex,Opp.Kasarwadi Railway station,<br />Near Nashik Phata,Old Pune-Mumbai Road<br />
                                                Chichwad,Pune 411034,MAHARASHTRA,INDIA
                                            </p>
                                        </div>
                                    </div>
                                    <hr class="my-3" style="border: 3px solid black;">
                                    <header id="bill-details-modal___BV_modal_header_" class="modal-header" style="margin-top:-30px;">
                                        <h2 class="text-primary w-100 text-center">
                                            Invoice Details
                                        </h2>
                                    </header>
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="d-flex align-items-center justify-content-between w-100">
                                                <!-- Clinic Info Section -->
                                                <div class="mr-3">
                                                    <h5 class="mb-0"><span>Patient Name:</span> @PatientDetails.PatientName</h5>
                                                    <h5 class="mb-0"><span>Age:</span> @PatientDetails.Age</h5>
                                                    <h5 class="mb-0"><span>Gender:</span> @PatientDetails.Gender</h5>
                                                    <h5 class="mb-0"><span>Patient Contact :</span> @PatientDetails.PatientContactNumber</h5>
                                                </div>
                                                <div class="text-right ml-auto" style="margin-left:20px;">
                                                    @*<h5 class="mb-0 font-weight-bold">
                                                        Invoice id <span class="text-primary">#@PatientDetails.EncounterFid</span>
                                                    </h5>*@
                                                    <h5 class="mb-0"><span class="font-weight-bold">Created Date</span> @Convert.ToDateTime(@PatientDetails.EncounterDate).ToString("dd/MM/yyyy")</h5>
                                                    <p class="mb-0 mt-2">
                                                        Payment Status <span class="badge badge-danger">@FinalBill.Status</span>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <hr class="my-3">
                                    <div class="row">
                                        <div class="col-12 col-md-12 col-sm-12">
                                            <h3>Services</h3>
                                            <table class="table custom-table">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th>Sr no</th>
                                                        <th>Service Name</th>
                                                        <th>Quantity</th>
                                                        <th>Price</th>
                                                        <th>Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (ViewBag.GenerateBill != null)
                                                    {
                                                        int Count = 1;
                                                        foreach (var item in ViewBag.GenerateBill)
                                                        {
                                                            TotalAmount += item.Total;
                                                            <tr>
                                                                <td>@Count</td>
                                                                <td>
                                                                    @if (!string.IsNullOrEmpty(item.ServiceName))
                                                                    {
                                                                        @item.ServiceName
                                                                    }
                                                                    else if (!string.IsNullOrEmpty(item.MedicineName))
                                                                    {
                                                                        @item.MedicineName
                                                                    }
                                                                </td>
                                                                <td>@item.Quantity</td>
                                                                <td>@item.Price</td>
                                                                <td>@item.Total</td>
                                                            </tr>
                                                            Count++;
                                                        }
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr>
                                                        <th colspan="4" class="text-right">Total</th>
                                                        <th>@FinalBill.TotalAmount</th>
                                                    </tr>
                                                    <tr>
                                                        <th colspan="4" class="text-right">Discount in Percentage</th>
                                                        <th>@FinalBill.DiscountAmt %</th>
                                                    </tr>
                                                    <tr>
                                                        @{
                                                            TotalDiscount = TotalAmount * @FinalBill.DiscountAmt / 100;
                                                        }
                                                        <th colspan="4" class="text-right">Discount in Amount</th>
                                                        <th>@TotalDiscount</th>
                                                    </tr>
                                                    <tr>
                                                        <th colspan="4" class="text-right">Amount due</th>
                                                        <th>@Convert.ToDecimal(@FinalBill.PayableAmount).ToString("0.00")</th>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12">
                                            <h3>Payment Details</h3>
                                            <div class="table-responsive">
                                                <table class="table custom-table">
                                                    <thead class="thead-light">
                                                        <tr>
                                                            <th>Sr no</th>
                                                            <th>Paid Amount</th>
                                                            <th>Payment Mode</th>
                                                            <th>Refrence No</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (ViewBag.GetFinalbillDetails != null)
                                                        {
                                                            int Count = 1;
                                                            foreach (var item in ViewBag.GetFinalbillDetails)
                                                            {
                                                                <tr>
                                                                    <td>@Count</td>
                                                                    <td>@item.Amount</td>
                                                                    <td>@item.PaymentMode</td>
                                                                    <td>@item.PaymentReferenceNumber</td>
                                                                </tr>
                                                                Count++;
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Footer -->
                            <div class="d-flex justify-content-end align-items-center" id="PrintFooter">
                                <button id="sendToPatient" title="Send to patient" class="btn btn-sm btn-primary">
                                    <i class="fa fa-paper-plane"></i> Send to patient
                                </button>
                                <button id="billPrint" title="Print" class="btn btn-sm btn-primary">
                                    <i class="fa fa-print"></i> Print
                                </button>
                                <button title="Cancel" class="btn btn-sm btn-primary" id="BillDetailsModelClose">
                                    <i class="fa fa-times"></i> Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

                                                            }
</div>

<script>
    $(document).ready(function () {
        debugger;
        var PatientDeatialsData = @Html.Raw(Json.Encode(ViewBag.GetPatientEncounterDetails));
        if(PatientDeatialsData!=null || PatientDeatialsData!="")
        {
            $("#bill-details-modal___BV_modal_outer_")
                 .css("display", "block")  // Remove 'display: none' by setting it to 'block'
                 .attr("aria-hidden", "false")  // Update ARIA attribute to indicate visibility
                 .addClass("show");
        }

        $("#CancelBillDetailsModel").click(function () {
            debugger;
            // Correct the URL assignment
            const modalOuter = $("#bill-details-modal___BV_modal_outer_");

            // Hide modal and remove aria-modal attribute
            modalOuter.css("display", "none").attr("aria-hidden", "true");
            var url='@Url.Action("CloseEncounterList", "CloseEncounter")';
            window.location.href = url;
        });
        $("#BillDetailsModelClose").click(function () {
            debugger;

            const modalOuter = $("#bill-details-modal___BV_modal_outer_");

            // Hide modal and remove aria-modal attribute
