    @*===========Show File========*@
    <div class="modal fade" id="ViewReportModal" tabindex="-1" role="dialog" aria-labelledby="uploadReportLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="uploadReportLabel">View Uploaded Reports</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" id="CloseViewFileModel">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <!-- Add scroll here -->
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>File Type</th>
                                    <th>Files</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.Files != null)
                                {
                                    foreach (var item in ViewBag.Files)
                                    {
                                        <tr>
                                            <td>
                                                @item.FileType
                                            </td>
                                            @if (item.FileType == "CasePaper")
                                            {
                                                <td>
                                                    <a href="@Url.Action("showUploadedFile", "CloseEncounter", new { fileName = item.AttachFile })" target="_blank" class="fileLink">
                                                        @System.IO.Path.GetFileName(item.AttachFile)
                                                    </a>
                                                </td>
                                            }
                                            @if (item.FileType == "ConsentForm")
                                            {
                                                <td>
                                                    <a href="@Url.Action("showUploadedFile", "CloseEncounter", new { fileName = item.AttachFile })" target="_blank" class="fileLink">
                                                        @System.IO.Path.GetFileName(item.AttachFile)
                                                    </a>
                                                </td>
                                            }
                                            @if (item.FileType == "PatientReport")
                                            {
                                                <td>
                                                    <a href="@Url.Action("showUploadedFile", "CloseEncounter", new { fileName = item.AttachFile })" target="_blank" class="fileLink">
                                                        @System.IO.Path.GetFileName(item.AttachFile)
                                                    </a>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

