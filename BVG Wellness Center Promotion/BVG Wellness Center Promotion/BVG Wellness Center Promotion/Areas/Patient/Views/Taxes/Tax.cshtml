<script>
    function toggleStatus(checkbox, TaxFid_Encrypted) {
        debugger;

        if (checkbox.checked) {
            debugger;
            var Status = "Active";
            var url = '@Url.Action("ChangeTaxStatus", "Taxes")' + '?TaxFid_Encrypted=' + TaxFid_Encrypted + '&Status=' + Status;
            window.location.href = url;
        } else {
            debugger;
            var Status = "Inactive";
            var url = '@Url.Action("ChangeTaxStatus", "Taxes")' + '?TaxFid_Encrypted=' + TaxFid_Encrypted + '&Status=' + Status;
            window.location.href = url;
        }
    }
</script>
