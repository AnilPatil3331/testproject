    }
    /* Full Page Loader */
    #ehrLoaderOverlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        min-height: 100vh;
        background-color: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        z-index: 90;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .ehr-pro-spinner {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        border: 4px solid transparent;
        border-top-color: #1497de;
        border-bottom-color: #1497de;
        animation: pro-spin 1.5s ease infinite;
        position: relative;
    }

        .ehr-pro-spinner::before {
            content: '';
            position: absolute;
            top: 6px;
            left: 6px;
            right: 6px;
            bottom: 6px;
            border-radius: 50%;
            border: 3px solid transparent;
            border-left-color: #25b09b;
            border-right-color: #25b09b;
            animation: pro-spin-reverse 1s linear infinite;
        }

    @@keyframes pro-spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @@keyframes pro-spin-reverse {
        0% { transform: rotate(360deg); }
        100% { transform: rotate(0deg); }
    }
</style>

<div id="ehrLoaderOverlay">
    <div class="ehr-pro-spinner"></div>
</div>

<script>
    window.addEventListener('load', function () {
        var loader = document.getElementById('ehrLoaderOverlay');
        if (loader) loader.style.display = 'none';
    });
    document.addEventListener("DOMContentLoaded", function () {
        setTimeout(function () {
            var loader = document.getElementById('ehrLoaderOverlay');
            if (loader) loader.style.display = 'none';
        }, 3000);
    });
</script>

