    });

    $('#FilterByStatus').on('change', function() {
        var value = $(this).val();
        $('#therapyTableBody tr.master-row').filter(function() {
            var status = $(this).find('td:eq(7) .badge').text().trim();
            if (value === "") {
                $(this).show();
            } else {
                $(this).toggle(status === value);
            }
            var bookingId = $(this).find('td:eq(1)').text().trim();
            if ($(this).is(':hidden')) {
                $('#child-' + bookingId).hide();
                $(this).find('.toggle-btn').removeClass('active');
                $(this).find('.toggle-btn i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
            }
        });
        updatePagination();
    });

    // Page navigation events
    $('#PageOption').on('change', function() {
        $('#InputPage').val(1);
        updatePagination();
    });

    $('#prev-btn').click(function() {
        if (!$(this).hasClass('disabled')) {
            var currentPage = parseInt($('#InputPage').val()) || 1;
            $('#InputPage').val(currentPage - 1);
            updatePagination();
        }
    });

    $('#next-btn').click(function() {
        if (!$(this).hasClass('disabled')) {
            var currentPage = parseInt($('#InputPage').val()) || 1;
            $('#InputPage').val(currentPage + 1);
            updatePagination();
        }
    });

    $('#InputPage').on('change', function() {
        var page = parseInt($(this).val());
        var totalPages = parseInt($('#total-pages').text());
        if (!isNaN(page) && page >= 1 && page <= totalPages) {
            updatePagination();
        } else {
            $(this).val($('#total-pages').text());
            updatePagination();
        }
    });

    // Document ready
    $(document).ready(function() {
        console.log('Document ready - Initializing');
        var rowCount = $('#therapyTableBody tr.master-row').length;
        console.log('Rows found:', rowCount);

        // Store slot data from the DOM
        storeSlotData();

        // Initialize filter buttons
        initFilterButtons();

        // Initialize pagination
        updatePagination();

        // Set default active state for "Today" button and apply filter
        var todayBadge = $('#FilterButtons .badge[data-filter="today"]');
        if (todayBadge.length) {
            todayBadge.removeClass('badge-outline-primary').addClass('badge-primary');
            applyDateFilter('today');
        }
        $(document).on('click', '.revenue-card-trigger', function (e) {
            $('#revenueBreakdown').slideToggle(350, function () {
                if ($('#revenueBreakdown').is(':visible')) {
                    $('#chevronIcon').removeClass('fa-chevron-down').addClass('fa-chevron-up text-primary');
                } else {
                    $('#chevronIcon').removeClass('fa-chevron-up text-primary').addClass('fa-chevron-down');
                }
            });
        });

    });

   
</script>