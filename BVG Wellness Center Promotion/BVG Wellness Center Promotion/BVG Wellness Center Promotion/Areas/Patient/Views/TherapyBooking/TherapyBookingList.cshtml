<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Store slot data for each booking
    var bookingSlotsData = {};

    // Toggle details function with arrow rotation
    function toggleDetails(bookingId, btnElement) {
        var childRow = $('#child-' + bookingId);
        var icon = $(btnElement).find('i');

        if (childRow.is(':visible')) {
            childRow.slideUp(300);
            icon.removeClass('fa-chevron-up').addClass('fa-chevron-down');
            $(btnElement).removeClass('active');
        } else {
            childRow.slideDown(300);
            icon.removeClass('fa-chevron-down').addClass('fa-chevron-up');
            $(btnElement).addClass('active');
        }
    }

    // Delete function
    function DeleteTherapyBooking(bookingId) {
        Swal.fire({
            title: 'Are you sure?',
            text: "This booking and all its slots will be deleted!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '@Url.Action("DeleteTherapyBooking", "TherapyBooking")?id=' + bookingId;
            }
        });
    }

    // Add Booking button click
    $('#AddBooking').click(function() {
        window.location.href = '@Url.Action("TherapyBooking", "TherapyBooking")';
    });

    // Function to check if booking has slots on a specific date
    function hasSlotOnDate(slots, targetDate) {
        if (!slots || slots.length === 0) return false;
        targetDate.setHours(0, 0, 0, 0);

        for (var i = 0; i < slots.length; i++) {
            var slotDate = new Date(slots[i].SlotDate);
            slotDate.setHours(0, 0, 0, 0);
            if (slotDate.getTime() === targetDate.getTime()) {
                return true;
            }
        }
        return false;
    }

    // AJAX call to Mark Therapy as Complete
    function markTherapyComplete(bookingId) {
        Swal.fire({
            title: 'Are you sure?',
            text: "Do you want to mark this therapy as Completed?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Complete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("MarkTherapyAsComplete", "TherapyBooking")',
                    type: 'POST',
                    data: { id: bookingId },
                    success: function (res) {
                        if (res.success) {
                            Swal.fire(
                                'Completed!',
                                res.message,
                                'success'
                            ).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire(
                                'Error!',
                                res.message,
                                'error'
                            );
                        }
                    },
                    error: function (err) {
                        Swal.fire('Error!', 'Something went wrong.', 'error');
                    }
                });
            }
        });
    }

    // Function to get all slot dates from a booking
    function getAllSlotDates(slots) {
        if (!slots || slots.length === 0) return [];
        var dates = [];
        for (var i = 0; i < slots.length; i++) {
            var slotDate = new Date(slots[i].SlotDate);
            slotDate.setHours(0, 0, 0, 0);
            dates.push(slotDate);
        }
        return dates;
    }

    // Function to check if booking has any upcoming slots (after today)
    function hasUpcomingSlots(slots) {
        if (!slots || slots.length === 0) return false;
        var today = new Date();
        today.setHours(0, 0, 0, 0);

        for (var i = 0; i < slots.length; i++) {
            var slotDate = new Date(slots[i].SlotDate);
            slotDate.setHours(0, 0, 0, 0);
            if (slotDate.getTime() > today.getTime()) {
                return true;
            }
        }
        return false;
    }

    // Function to check if booking has any past slots (before today)
    function hasPastSlots(slots) {
        if (!slots || slots.length === 0) return false;
        var today = new Date();
        today.setHours(0, 0, 0, 0);

        for (var i = 0; i < slots.length; i++) {
            var slotDate = new Date(slots[i].SlotDate);
            slotDate.setHours(0, 0, 0, 0);
            if (slotDate.getTime() < today.getTime()) {
                return true;
            }
        }
        return false;
    }

    // Function to check if booking has any today slots
    function hasTodaySlots(slots) {
        if (!slots || slots.length === 0) return false;
        var today = new Date();
        today.setHours(0, 0, 0, 0);

        for (var i = 0; i < slots.length; i++) {
            var slotDate = new Date(slots[i].SlotDate);
            slotDate.setHours(0, 0, 0, 0);
            if (slotDate.getTime() === today.getTime()) {
                return true;
            }
        }
        return false;
    }

    // Store slot data from the DOM
    function storeSlotData() {
        $('#therapyTableBody tr.master-row').each(function() {
            var $row = $(this);
            var bookingId = $row.find('td:eq(1)').text().trim();

            // Extract slots from the child row
            var $childRow = $('#child-' + bookingId);
            var slots = [];

            $childRow.find('.slot-card').each(function() {
                var dateText = $(this).find('.text-primary').text().trim();
                var timeText = $(this).find('.text-muted').text().trim();

                // Parse date from "23 Apr 2026" format
                var dateParts = dateText.split(' ');
                if (dateParts.length === 3) {
                    var monthNames = {
                        'Jan': 0, 'Feb': 1, 'Mar': 2, 'Apr': 3, 'May': 4, 'Jun': 5,
                        'Jul': 6, 'Aug': 7, 'Sep': 8, 'Oct': 9, 'Nov': 10, 'Dec': 11
                    };
                    var day = parseInt(dateParts[0]);
                    var month = monthNames[dateParts[1]];
                    var year = parseInt(dateParts[2]);
                    var slotDate = new Date(year, month, day);

                    slots.push({
                        SlotDate: slotDate,
                        DisplayDate: dateText,
                        TimeRange: timeText
                    });
                }
            });

            bookingSlotsData[bookingId] = slots;
        });

        console.log('Stored slot data for bookings:', Object.keys(bookingSlotsData).length);
    }

    // Apply date filter based on slots
    function applyDateFilter(filterType) {
        console.log('Applying filter:', filterType);
        var today = new Date();
        today.setHours(0, 0, 0, 0);

        var visibleCount = 0;
        var allRows = $('#therapyTableBody tr.master-row');

        allRows.each(function() {
            var $row = $(this);
            var bookingId = $row.find('td:eq(1)').text().trim();
            var slots = bookingSlotsData[bookingId] || [];
            var showRow = false;

            switch(filterType) {
                case 'all':
                    showRow = true;
                    break;
                case 'today':
                    showRow = hasTodaySlots(slots);
                    break;
                case 'upcoming':
                    showRow = hasUpcomingSlots(slots);
                    break;
                case 'past':
                    showRow = hasPastSlots(slots);
                    break;
                default:
                    showRow = true;
            }

            if (showRow) {
                $row.show();
                visibleCount++;
                console.log('Showing booking:', bookingId, 'for filter:', filterType);
            } else {
                $row.hide();
                $('#child-' + bookingId).hide();
                $row.find('.toggle-btn').removeClass('active');
                $row.find('.toggle-btn i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
            }
        });

        console.log('Visible rows for', filterType + ':', visibleCount);
        $('#InputPage').val(1);
        updatePagination();
    }

    // Initialize filter buttons
    function initFilterButtons() {
        console.log('Initializing filter buttons');

        $('#FilterButtons .badge').off('click');

        $('#FilterButtons .badge').on('click', function() {
            console.log('Filter button clicked');
            var filterValue = $(this).data('filter');
            console.log('Filter value:', filterValue);

            $('#FilterButtons .badge').removeClass('badge-primary').addClass('badge-outline-primary');
            $(this).removeClass('badge-outline-primary').addClass('badge-primary');

            applyDateFilter(filterValue);
        });
    }

    // Pagination logic
    function updatePagination() {
        var rowsPerPage = parseInt($('#PageOption').val());
        if (isNaN(rowsPerPage) || rowsPerPage === -1) {
            $('#therapyTableBody tr.master-row:visible').show();
            $('#total-pages').text(1);
            $('#InputPage').val(1);
            $('#prev-btn').addClass('disabled');
            $('#next-btn').addClass('disabled');
            return;
        }

        var currentPage = parseInt($('#InputPage').val()) || 1;
        var rows = $('#therapyTableBody tr.master-row:visible');
        var totalRows = rows.length;
        var totalPages = Math.ceil(totalRows / rowsPerPage);

        if (totalPages === 0) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        $('#total-pages').text(totalPages);
        $('#InputPage').val(currentPage);

        var start = (currentPage - 1) * rowsPerPage;
        var end = start + rowsPerPage;

        $('#therapyTableBody tr.master-row').hide();
        rows.slice(start, end).show();

        $('[id^="child-"]').hide();
        $('#therapyTableBody tr.master-row:visible').each(function() {
            var bookingId = $(this).find('td:eq(1)').text().trim();
            if ($(this).find('.toggle-btn.active').length > 0) {
                $('#child-' + bookingId).show();
            }
        });

        $('#prev-btn').toggleClass('disabled', currentPage === 1);
        $('#next-btn').toggleClass('disabled', currentPage === totalPages);
    }

    // Global search functionality
    $('#SearchInput').on('keyup', function() {
        var value = $(this).val().toLowerCase();
        $('#therapyTableBody tr.master-row').filter(function() {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            var bookingId = $(this).find('td:eq(1)').text().trim();
            if ($(this).is(':hidden')) {
                $('#child-' + bookingId).hide();
                $(this).find('.toggle-btn').removeClass('active');
                $(this).find('.toggle-btn i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
            }
        });
        updatePagination();
    });

