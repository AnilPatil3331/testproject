<style>

    /* Add to existing style section */
.badge-primary {
    /*background-color: #007bff;*/
    color: white;
    padding: 5px 10px;
    border-radius: 5px;
    cursor: pointer;
}

.badge-outline-primary {
    background-color: transparent;
    color: #007bff;
    border: 1px solid #007bff;
    padding: 5px 10px;
    border-radius: 5px;
    cursor: pointer;
}

.badge-outline-primary:hover {
    background-color: #007bff;
    color: white;
}

.cursor-pointer {
    cursor: pointer;
}

.mr-2 {
    margin-right: 0.5rem;
}



    input[type="file"] {
        display: none;
    }

    #fileNameText {
        font-size: 14px;
        color: #555;
    }

    .footer__navigation__page-btn:hover {
        cursor: pointer !important;
    }

    .toggle-btn {
        transition: all 0.3s ease;
    }

