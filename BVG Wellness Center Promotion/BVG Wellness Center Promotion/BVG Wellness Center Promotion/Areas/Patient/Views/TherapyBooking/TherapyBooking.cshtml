<script>


    function calculateTotalAmount() {

        var fromDate = $("#FromDate").val();
        var toDate = $("#ToDate").val();
        var charges = parseFloat($("#ServiceCharges").val());

        if (!fromDate || !toDate || isNaN(charges)) {
            $("#TotalAmount").val('');
            return;
        }

        var from = new Date(fromDate);
        var to = new Date(toDate);

        // difference in days
        var diffTime = to.getTime() - from.getTime();
        var diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24)) + 1;

        if (diffDays <= 0) {
            $("#TotalAmount").val('');
            return;
        }

        var total = diffDays * charges;
        $("#TotalAmount").val(total);
    }





</script>

