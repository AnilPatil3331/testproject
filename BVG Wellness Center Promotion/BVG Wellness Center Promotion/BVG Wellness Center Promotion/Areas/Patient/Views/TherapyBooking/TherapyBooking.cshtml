    function DeleteBill(Bill_Fid_Encrapted,AppointmentFid,PatientID) {
        debugger
        Swal.fire({
            title: 'Are You Sure!',
            text: "Are you absolutely sure about this?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#f44336',
            cancelButtonColor: '#4caf50',
            confirmButtonText: 'Yes, go ahead!',
            cancelButtonText: 'No, cancel!',
            customClass: {
                popup: 'fullscreen-popup',
            },
        }).then((result) => {
            if (result.isConfirmed) {
                // Perform the desired action
                $.ajax({
                    type: 'GET',
                    dataType: 'JSON',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteBill")',
                    data: { Bill_Fid_Encrapted: Bill_Fid_Encrapted,AppointmentFid:AppointmentFid,PatientID:PatientID},
