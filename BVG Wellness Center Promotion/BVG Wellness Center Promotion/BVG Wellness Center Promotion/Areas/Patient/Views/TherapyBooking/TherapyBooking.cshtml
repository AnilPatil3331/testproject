                            });

                            // 👉 Total recalculation (optional but best)
                            var total = 0;
                            $("#tblGenerateBill tbody tr").each(function () {
                                var val = parseFloat($(this).find("td:eq(4)").text()) || 0;
                                total += val;
                            });

                            $("#txtFinalTotal").val(total.toFixed(2));
                            $("#txtFinalPaybalAmount").val(total.toFixed(2));
                            $("#txtAmount").val(total.toFixed(2));

                        } else {
                            Swal.fire('Error!', data.SuccesMsg, 'error');
                        }
                    }

                })
            }
        });

    }
</script>

