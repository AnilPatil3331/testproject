<script>
    // ============================================
    // COMPLETE VALIDATION SYSTEM WITH TIME CHECK
    // ============================================

    $(document).ready(function() {

        // ============================================
        // 1. PAST DATES DISABLE IN DATEPICKERS
        // ============================================
        var today = new Date();
        var todayFormatted = today.toISOString().split('T')[0];
        var isEditMode = (parseInt($('#IsEditMode').val()) || 0) > 0;

        if (!isEditMode) {
            // Disable past dates in FromDate
            $('#FromDate').attr('min', todayFormatted);
            // Disable past dates in ToDate as well
            $('#ToDate').attr('min', todayFormatted);
        } else {
            // In edit mode, allow existing values but prevent older dates
            var existingFromDate = $('#FromDate').val();
            if (existingFromDate) {
                $('#FromDate').attr('min', existingFromDate);
                $('#ToDate').attr('min', existingFromDate);
            }
        }

        // When FromDate changes, update ToDate min
        $('#FromDate').on('change', function() {
            var fromDate = $(this).val();
            if(fromDate) {
                $('#ToDate').attr('min', fromDate);
            } else {
                var minLimit = isEditMode ? ($('#FromDate').val() || todayFormatted) : todayFormatted;
                $('#ToDate').attr('min', minLimit);
            }

            // Refresh slots when date changes
            if(typeof createWorkingSlots === 'function') {
                createWorkingSlots();
            }
        });

        // ============================================
        // 2. CURRENT TIME CHECK - Disable past slots for today
        // ============================================
        function getCurrentTimeInMinutes() {
            var now = new Date();
            var hours = now.getHours();
            var minutes = now.getMinutes();
            return (hours * 60) + minutes;
        }

        // (Global isSlotInPast is used instead)
        // Override selectWorkingSlot function with time validation
        window.selectWorkingSlot = function(element) {
            var date = element.getAttribute('data-date');
            var startTime = element.getAttribute('data-start');

            // ⏰ TIME VALIDATION
            if(isSlotInPast(date, startTime)) {
                Swal.fire({
                    title: '⏰ Cannot Book Past Slot!',
                    html: `You cannot book slot at <strong>${startTime}</strong> because it's already passed.<br><br>Please select a future time slot for today.`,
                    icon: 'warning',
                    confirmButtonText: 'OK',
                    timer: 3000
                });
                return;
            }

            var isRedSlot = element.classList.contains('booked-red');
            var isOrangeSlot = element.classList.contains('booked-orange');

            if(isRedSlot) {
                Swal.fire('❌ Fully Booked!', 'This slot is already fully booked!', 'error');
                return;
            }
            if(isOrangeSlot && !isDoubleService) {
                Swal.fire('❌ Already Booked!', 'This slot is already booked!', 'error');
                return;
            }

            var slotsToSelect = Math.ceil(therapyDurationMinutes / 30);
            var allDateSlots = Array.from(document.querySelectorAll('.working-slot[data-date="' + date + '"]'));

            // नवीन block चा start index शोधा
            var newBlockStartIdx = -1;
            for(var k = 0; k < allDateSlots.length; k++) {
                if(allDateSlots[k].getAttribute('data-start') === startTime) {
                    newBlockStartIdx = k;
                    break;
                }
            }

            if(newBlockStartIdx === -1) return;

            // नवीन block चे slots आणि indices
            var slotsInBlock = [];
            var newBlockIndices = [];
            for(var k = newBlockStartIdx; k < newBlockStartIdx + slotsToSelect && k < allDateSlots.length; k++) {
                slotsInBlock.push(allDateSlots[k]);
                newBlockIndices.push(k);
            }

            // Check if any slot in block is fully booked
            var isAnyFullyBooked = slotsInBlock.some(function(slot) {
                return slot.classList.contains('booked-red');
            });
            if(isAnyFullyBooked) {
                Swal.fire('❌ Blocked Slot!', 'This time block has fully booked slots!', 'error');
                return;
            }

            // Check time for all slots in block
            for(var j = 0; j < slotsInBlock.length; j++) {
                if(isSlotInPast(slotsInBlock[j].getAttribute('data-date'), slotsInBlock[j].getAttribute('data-start'))) {
                    Swal.fire({
                        title: '⏰ Cannot Book Past Slot!',
                        html: `This time block includes a past slot. Please select a future time slot.`,
                        icon: 'warning',
                        confirmButtonText: 'OK'
                    });
                    return;
                }
            }

            // हा block already पूर्ण selected आहे का?
            var allSelected = slotsInBlock.every(function(slot) {
                return slot.classList.contains('selected');
            });

            if(allSelected) {
                // ✅ Same block deselect करा
                slotsInBlock.forEach(function(slot) {
                    slot.classList.remove('selected');
                    if(slot.classList.contains('booked-orange')) {
                        slot.style.background = '';
                        slot.style.borderColor = '';
                        slot.style.color = '';
                    } else {
                        slot.style.background = 'white';
                        slot.style.borderColor = '#007bff';
                        slot.style.color = '#495057';
                    }
                });
            } else {
                // ✅ FIXED OVERLAP LOGIC
                // प्रत्येक selected slot चा block start शोधा आणि overlap check करा
        
                // Step 1: सगळे existing selected slots चे block starts शोधा
                var existingBlockStarts = new Set();
                allDateSlots.forEach(function(slot, idx) {
                    if(slot.classList.contains('selected') && !slot.classList.contains('booked-orange')) {
                        // हा slot कोणत्या block चा first slot आहे का ते check करा
                        // Block start = असा index जिथून slotsToSelect slots selected आहेत
                        var isPossibleStart = true;
                        // मागे slotsToSelect-1 slots selected नाहीत याची खात्री करा
                        if(idx > 0 && allDateSlots[idx-1].classList.contains('selected') && 
                           !allDateSlots[idx-1].classList.contains('booked-orange')) {
                            // हा block चा start नाही, कुठेतरी आधी start आहे
                        } else {
                            existingBlockStarts.add(idx);
                        }
                    }
                });

                // Step 2: प्रत्येक existing block check करा - नवीन block शी overlap होतो का?
                var slotsToDeselect = new Set();
        
                existingBlockStarts.forEach(function(blockStart) {
                    var existingBlockIndices = [];
                    for(var ei = blockStart; ei < blockStart + slotsToSelect && ei < allDateSlots.length; ei++) {
                        if(allDateSlots[ei].classList.contains('selected')) {
                            existingBlockIndices.push(ei);
                        }
                    }
            
                    // Overlap check
                    var hasOverlap = existingBlockIndices.some(function(ei) {
                        return newBlockIndices.indexOf(ei) !== -1;
                    });
            
                    if(hasOverlap) {
                        existingBlockIndices.forEach(function(ei) {
                            slotsToDeselect.add(ei);
                        });
                    }
                });

                // Step 3: Overlap असलेले slots deselect करा
                slotsToDeselect.forEach(function(idx) {
                    var slot = allDateSlots[idx];
                    if(slot) {
                        slot.classList.remove('selected');
                        if(slot.classList.contains('booked-orange')) {
                            slot.style.background = '';
                            slot.style.borderColor = '';
                            slot.style.color = '';
                        } else {
                            slot.style.background = 'white';
                            slot.style.borderColor = '#007bff';
                            slot.style.color = '#495057';
                        }
                    }
                });

                // Step 4: नवीन block select करा
                slotsInBlock.forEach(function(slot) {
                    if(!slot.classList.contains('booked-red')) {
                        slot.classList.add('selected');
                        slot.style.background = '#007bff';
                        slot.style.borderColor = '#007bff';
                        slot.style.color = 'white';
                    }
                });
            }

            // Update badge
            var count = document.querySelectorAll('.working-slot.selected[data-date="' + date + '"]').length;
            var badge = document.getElementById('badge_' + date);
            if(badge) {
                badge.textContent = count + ' selected';
                badge.className = count > 0 ? 'badge bg-success' : 'badge bg-info';
            }

            updateWorkingSlotsHiddenField();
        }
        // Override selectWorkingSlot function with time validation
        //window.selectWorkingSlot = function(element) {
        //    var date = element.getAttribute('data-date');
        //    var startTime = element.getAttribute('data-start');
