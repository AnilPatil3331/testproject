function updateWorkingSlotsHiddenField() {
    var selectedSlots = [];
    var processedBlocks = new Set();

    document.querySelectorAll('.working-slot.selected').forEach(function(el) {
        var date = el.getAttribute('data-date');
        var start = el.getAttribute('data-start');
        var end = el.getAttribute('data-end');
        var blockKey = date + '|' + start;

        if(!processedBlocks.has(blockKey)) {
            processedBlocks.add(blockKey);
            selectedSlots.push({
                date: date,
                startTime: start,
                endTime: end,
                ServiceRoomID: parseInt(document.getElementById('ServiceRoomID').value) || 0,
                IsBooked: 1
            });
        }
    });

    document.getElementById('SelectedSlots').value = JSON.stringify(selectedSlots);
    console.log("Saved", selectedSlots.length, "slot blocks");
}

function loadExistingWorkingSlots() {
    var existingVal = document.getElementById('SelectedSlots').value;
    console.log("Loading existing slots from hidden field:", existingVal);
    
    if(existingVal && existingVal !== "" && existingVal !== "[]") {
        try {
            var slots = JSON.parse(existingVal);
            console.log("Parsed slots:", slots);
            console.log("Number of slots to load:", slots.length);
            
            slots.forEach(function(slot) {
                console.log("Looking for slot:", slot.date, slot.startTime);
                
                // Find matching slot elements
                var elements = document.querySelectorAll('.working-slot[data-date="' + slot.date + '"][data-start="' + slot.startTime + '"]');
                console.log("Found elements:", elements.length);
                
                elements.forEach(function(el) {
                    el.classList.add('selected');
                    el.setAttribute('data-existing', 'true');
                    var slotDate = el.getAttribute('data-date');
                    var slotStart = el.getAttribute('data-start');
                    if (isSlotInPast(slotDate, slotStart)) {
                        el.classList.remove('past-disabled');
                        el.classList.add('past-selected');
                        el.style.background = '#fff3e0';
                        el.style.borderColor = '#ff9800';
                        el.style.color = '#e65100';
                        el.style.cursor = 'not-allowed';
                        el.style.pointerEvents = 'none';
                        el.title = 'Already taken (Past slot)';
                        if (!el.innerHTML.includes('⚠️')) {
                            el.innerHTML = el.innerHTML + ' ⚠️';
                        }
                        console.log("Selected past slot loaded (orange/locked):", slotDate, slotStart);
                    } else {
                        el.style.background = '#007bff';
                        el.style.borderColor = '#007bff';
                        el.style.color = 'white';
                        console.log("Selected future slot loaded (blue):", slotDate, slotStart);
                    }
                });
                
                // Update badge
                var badge = document.getElementById('badge_' + slot.date);
                if(badge) {
                    var count = document.querySelectorAll('.working-slot.selected[data-date="' + slot.date + '"]').length;
                    badge.textContent = count + ' selected';
                    badge.className = count > 0 ? 'badge bg-success' : 'badge bg-info';
                }
            });
            
            // Also update the global selectedSlotsArray
            selectedSlotsArray = [];
            document.querySelectorAll('.working-slot.selected').forEach(function(el) {
                selectedSlotsArray.push({
                    key: el.getAttribute('data-date') + '|' + el.getAttribute('data-start'),
                    date: el.getAttribute('data-date'),
                    startTime: el.getAttribute('data-start'),
                    endTime: el.getAttribute('data-end')
                });
            });
            
            console.log("Total selected slots after load:", selectedSlotsArray.length);
        } catch(e) {
            console.log("Error parsing existing slots:", e);
        }
    } else {
        console.log("No existing slots to load");
    }
}

function markBookedSlotsFixed() {
    var roomId = document.getElementById('ServiceRoomID').value;
    var fromDate = document.getElementById('FromDate').value;
    var toDate = document.getElementById('ToDate').value;
    var therapyId = document.getElementById('IsEditMode').value || 0;
    var serviceId = document.getElementById('ddlServiceName').value;

    if(!roomId || !fromDate || !toDate) {
        console.log("Missing required fields for booked slots");
        return;
    }

    // Get IsDouble value directly from hidden field
    var isDouble = $('#IsDouble').val().toString().toLowerCase() === 'true';
    
    var url = '/TherapyBooking/GetBookedSlots?serviceRoomId=' + roomId + '&fromDate=' + fromDate + '&toDate=' + toDate + '&therapyBookingId=' + therapyId + '&serviceId=' + serviceId;
    
    console.log("Fetching booked slots from:", url);
    console.log("IsDouble Service:", isDouble);
    
    fetch(url)
        .then(function(response) { return response.json(); })
        .then(function(data) {
            console.log("Raw booked slots data:", data);
            
            // Reset all non-selected slots to default (white)
            var allSlots = document.querySelectorAll('.working-slot');
            console.log("Total working slots found:", allSlots.length);
            
            allSlots.forEach(function(el) {
                if(!el.classList.contains('selected')) {
                    el.classList.remove('booked-red', 'booked-orange');
                    el.style.background = 'white';
                    el.style.borderColor = '#007bff';
                    el.style.color = '#495057';
                    el.style.cursor = 'pointer';
                    el.onclick = function() { selectWorkingSlot(this); };
                    el.title = '';
                    // Remove icons
                    var html = el.innerHTML;
                    html = html.replace(/🔒/g, '').replace(/⚠️/g, '').replace(/<br><small>.*<\/small>/g, '');
                    el.innerHTML = html.trim();
                }
            });
            
            if(!data || data.length === 0) {
                console.log("No booked slots data");
                return;
            }
            
            // Create a map of booked slots with counts
            var bookedMap = {};
            data.forEach(function(slot) {
                var key = slot.SlotDate + '|' + slot.SlotStart;
                if(!bookedMap[key]) {
                    bookedMap[key] = { count: 0, date: slot.SlotDate, start: slot.SlotStart };
                }
                bookedMap[key].count = slot.BookingCount;
            });
            
            console.log("Booked slots map:", bookedMap);
            
            // Apply colors based on bookings
            for(var key in bookedMap) {
                var value = bookedMap[key];
                var slotDate = value.date;
                var slotStart = value.start;
                var count = value.count;
                
                console.log("Processing:", slotDate, slotStart, "Count:", count, "IsDouble:", isDouble);
                
                var elements = document.querySelectorAll('.working-slot[data-date="' + slotDate + '"][data-start="' + slotStart + '"]');
                console.log("Found elements:", elements.length);
                
                elements.forEach(function(el) {
                    if(el.classList.contains('selected')) {
                        console.log("Skipping selected slot");
                        return;
                    }
                    
                    if(isDouble) {
                        if(count >= 2) {
                            el.classList.add('booked-red');
                            el.style.background = '#f8d7da';
                            el.style.borderColor = '#dc3545';
                            el.style.color = '#721c24';
                            el.style.cursor = 'not-allowed';
                            el.onclick = null;
                            el.title = 'Fully booked (2/2)';
                            if(!el.innerHTML.includes('🔒')) {
                                el.innerHTML = el.innerHTML + ' 🔒';
                            }
                            console.log("🔴 RED applied for:", slotDate, slotStart, "Count:", count);
                        } else if(count >= 1) {
                            el.classList.add('booked-orange');
                            el.style.background = '#fff3e0';
                            el.style.borderColor = '#ff9800';
                            el.style.color = '#e65100';
                            el.style.cursor = 'pointer';
                            el.title = '1/2 booked - Click to book';
                            if(!el.innerHTML.includes('⚠️')) {
                                el.innerHTML = el.innerHTML + ' ⚠️';
                            }
                            console.log("🟠 ORANGE applied for:", slotDate, slotStart, "Count:", count);
                        }
                    } else {
                        if(count >= 1) {
                            el.classList.add('booked-red');
                            el.style.background = '#f8d7da';
                            el.style.borderColor = '#dc3545';
                            el.style.color = '#721c24';
                            el.style.cursor = 'not-allowed';
                            el.onclick = null;
                            el.title = 'Already booked';
                            if(!el.innerHTML.includes('🔒')) {
                                el.innerHTML = el.innerHTML + ' 🔒';
                            }
                            console.log("🔴 RED applied for:", slotDate, slotStart);
                        }
                    }
                });
            }
            
            // Final count
            console.log("Final - Red slots:", document.querySelectorAll('.working-slot.booked-red').length);
            console.log("Final - Orange slots:", document.querySelectorAll('.working-slot.booked-orange').length);
        })
        .catch(function(err) { console.log("Error:", err); });
}

function clearAllWorkingSlots() {
    Swal.fire({
        title: "Clear all slots?",
        text: "This will remove all selected slots.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        confirmButtonText: "Yes, clear all!"
    }).then((result) => {
        if (result.isConfirmed) {
            document.querySelectorAll('.working-slot.selected').forEach(function(el) {
                el.classList.remove('selected');
                el.style.background = '';
                el.style.borderColor = '';
                el.style.color = '';
            });
            document.querySelectorAll('[id^="badge_"]').forEach(function(badge) {
                var date = badge.id.replace('badge_', '');
                badge.textContent = "0 selected";
                badge.className = "badge bg-info";
            });
            document.getElementById('SelectedSlots').value = '[]';
            setTimeout(function() { markBookedSlotsFixed(); }, 100);
            Swal.fire("Cleared!", "All selected slots have been cleared.", "success");
        }
    });
}

$(document).ready(function() {
    $('#ServiceRoomID, #FromDate, #ToDate').on('change', function() { createWorkingSlots(); });
    $('#ddlServiceName').on('change', function() { setTimeout(function() { createWorkingSlots(); }, 500); });

    setTimeout(function() {
        var roomId = $("#ServiceRoomID").val();
        var fromDate = $("#FromDate").val();
        var toDate = $("#ToDate").val();
        if(roomId && fromDate && toDate) createWorkingSlots();
    }, 1000);

    $('#therapyForm').on('submit', function(e) {
        var selectedCount = document.querySelectorAll('.working-slot.selected').length;
        if(selectedCount === 0) {
            Swal.fire({ title: "No Slots Selected!", text: "Please select at least one time slot before saving.", icon: "warning", confirmButtonText: "OK" });
            e.preventDefault();
            return false;
        }
        // ⏰ PAST SLOT VALIDATION (ONLY FOR NEWLY SELECTED SLOTS)
        var pastSlotsFound = [];
        var selectedSlotsElements = document.querySelectorAll('.working-slot.selected');

        selectedSlotsElements.forEach(function(slot) {
            var slotDate = slot.getAttribute('data-date');
            var slotStart = slot.getAttribute('data-start');

            // जर स्लॉट आधीपासून बुक असेल तर त्याला पास्ट चेकमधून सोडा
            var isExisting = slot.getAttribute('data-existing') === 'true' || 
                             slot.classList.contains('booked-orange') || 
                             slot.classList.contains('booked-red');

            // फक्त नवीन सिलेक्ट केलेल्या स्लॉट्सचाच पास्ट टाईम चेक करा
            if(!isExisting && isSlotInPast(slotDate, slotStart)) {
                pastSlotsFound.push(slotStart + ' on ' + slotDate);
            }
        });

        if(pastSlotsFound.length > 0) {
            Swal.fire({
                title: '⏰ Cannot Book Past Slot!',
                html: `❌ Cannot book past slots: <strong>${pastSlotsFound.join(', ')}</strong><br><br>Please select future time slots only.`,
                icon: 'warning',
                confirmButtonText: 'OK'
            });
            e.preventDefault();
            return false;
        }

        return true;
    });
});

