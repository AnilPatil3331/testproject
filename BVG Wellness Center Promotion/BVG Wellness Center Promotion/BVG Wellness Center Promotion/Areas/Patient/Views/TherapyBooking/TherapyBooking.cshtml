<script>
// ============================================
// COMPLETE WORKING SLOT SYSTEM - FINAL FIXED
// ============================================

    function isSlotInPast(slotDate, slotStartTime) {
        var now = new Date();
        var yyyy = now.getFullYear();
        var mm = String(now.getMonth() + 1).padStart(2, '0');
        var dd = String(now.getDate()).padStart(2, '0');
        var todayStr = yyyy + '-' + mm + '-' + dd;

        if (slotDate < todayStr) {
            return true;
        }
        if (slotDate > todayStr) {
            return false;
        }

        // If today, check time
        var currentMinutes = (now.getHours() * 60) + now.getMinutes();
        var timeStr = slotStartTime.trim();
        var isPM = timeStr.includes('PM');
        var timeParts = timeStr.match(/(\d+):(\d+)/);

        if(!timeParts) return false;

        var hours = parseInt(timeParts[1]);
        var minutes = parseInt(timeParts[2]);

        if(isPM && hours !== 12) {
            hours += 12;
        } else if(!isPM && hours === 12) {
            hours = 0;
        }

        var slotMinutes = (hours * 60) + minutes;
        var bufferMinutes = 5;

        return slotMinutes < (currentMinutes + bufferMinutes);
    }

    let selectedSlotsArray = [];
    let bookedSlotsArray = [];
    let therapyDurationMinutes = 30;
    let isDoubleService = false;

    function createWorkingSlots() {
        var fromDate = document.getElementById('FromDate').value;
        var toDate = document.getElementById('ToDate').value;
        var roomId = document.getElementById('ServiceRoomID').value;
        var container = document.getElementById('timeSlotsContainer');
        var message = document.getElementById('noSlotsMessage');

        if(!fromDate || !toDate || !roomId) {
            if(message) {
                message.style.display = 'block';
                message.innerHTML = '<b>⚠️ Please select Room, From Date and To Date first!</b>';
            }
            if(container) container.innerHTML = '';
            return;
        }

        if(message) message.style.display = 'none';

        var durationVal = $('#Duration').val();
        therapyDurationMinutes = durationVal && durationVal !== '' ? parseInt(durationVal) : 30;
        var isDoubleVal = $('#IsDouble').val();
        isDoubleService = (isDoubleVal === 'True' || isDoubleVal === 'true' || isDoubleVal === true || isDoubleVal === '1');

        $.ajax({
            url: '/TherapyBooking/GetRoomSlots',
            type: 'GET',
            data: { roomId: roomId },
            success: function(res) {
                if(res.success && res.slots && res.slots.length > 0) {
                    renderSlotsToContainer(res.slots, fromDate, toDate, container);
                } else {
                    container.innerHTML = '<div class="alert alert-warning">No slots configured for this room.</div>';
                }
            },
            error: function() {
                container.innerHTML = '<div class="alert alert-danger">Failed to load slots.</div>';
            }
        });
    }

    function timeStringToMinutes(timeStr) {
        if(!timeStr) return 0;
        var parts = timeStr.split(':');
        return parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
    }

    function formatMinutesToAmPm(totalMins) {
        var h = Math.floor(totalMins / 60);
        var m = totalMins % 60;
        var ampm = h >= 12 ? 'PM' : 'AM';
        var dh = h % 12 || 12;
        var mStr = m < 10 ? '0' + m : m;
        return dh + ':' + mStr + ' ' + ampm;
    }

    function renderSlotsToContainer(roomConfigSlots, fromDate, toDate, container) {
        var start = new Date(fromDate);
        var end = new Date(toDate);
        var currentDate = new Date(start);
        var slotCount = 0;
        
        container.innerHTML = '';

        while(currentDate <= end) {
            var cyyyy = currentDate.getFullYear();
            var cmm = String(currentDate.getMonth() + 1).padStart(2, '0');
            var cdd = String(currentDate.getDate()).padStart(2, '0');
            var isoDate = cyyyy + '-' + cmm + '-' + cdd;
            var dateStr = currentDate.toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });

            var headerDiv = document.createElement('div');
            headerDiv.className = "col-12 mt-4 mb-2";
        
            var isHighlighted = window.highlightedDates && window.highlightedDates.includes(isoDate);
            var highlightStyle = isHighlighted ? 'border-left: 4px solid #007bff; padding-left: 10px;' : '';
        
            var badgeHtml = '<span class="badge bg-info ms-2" id="selectedCount_' + isoDate + '"></span>';
        
            headerDiv.innerHTML = '<h6 class="text-secondary fw-bold border-bottom pb-1" style="' + highlightStyle + '">' +
                '<i class="fa fa-calendar-alt me-2"></i>' + dateStr + badgeHtml + '</h6>';
            container.appendChild(headerDiv);
        
            var slotsRow = document.createElement('div');
            slotsRow.className = "row row-cols-2 row-cols-md-4 row-cols-lg-6 g-2 px-3 mb-3";
        
            // Generate 30 min slots from 00:00 to 23:30
            for(var m = 0; m < 24 * 60; m += 30) {
                var slotStartMins = m;
                var slotEndMins = m + 30;
                
                // Check if this slot falls inside any block
                var matchingBlock = null;
                for(var i = 0; i < roomConfigSlots.length; i++) {
                    var conf = roomConfigSlots[i];
                    var startStr = conf.StartTime || conf.startTime;
                    var endStr = conf.EndTime || conf.endTime;
                    
                    var blockStartMins = timeStringToMinutes(startStr);
                    var blockEndMins = timeStringToMinutes(endStr);
                    
                    if(slotStartMins >= blockStartMins && slotEndMins <= blockEndMins) {
                        matchingBlock = conf;
                        break;
                    }
                }
                
                if(matchingBlock) {
                    var startTime = formatMinutesToAmPm(slotStartMins);
                    var endTime = formatMinutesToAmPm(slotEndMins);
                    var isBreak = matchingBlock.IsBreak !== undefined ? matchingBlock.IsBreak : matchingBlock.isBreak;
                    var breakLabel = matchingBlock.BreakLabel || matchingBlock.breakLabel;
                    
                    var slotDiv = document.createElement('div');
                    slotDiv.className = "col";
                    
                    if (isBreak) {
                        slotDiv.innerHTML = '<div class="working-slot past-disabled" style="background:#e9ecef!important; border:1px dashed #ccc; cursor:not-allowed; padding:8px 5px; font-size:12px; height:100%; display:flex; flex-direction:column; justify-content:center;" data-date="' + isoDate + '" data-start="' + startTime + '" data-end="' + endTime + '"><span>' + startTime + ' - ' + endTime + '</span><small style="color:#dc3545; font-weight:bold; font-size:10px; line-height:1.2; margin-top:2px;">' + (breakLabel || 'Break') + '</small></div>';
                    } else {
                        var isPast = isSlotInPast(isoDate, startTime);
                        var pastClass = isPast ? " past-disabled" : "";
                        var onclickAttr = isPast ? "" : ' onclick="selectWorkingSlot(this)"';
                        slotDiv.innerHTML = '<div class="working-slot' + pastClass + '" style="padding:10px 5px; font-size:12px; height:100%; display:flex; align-items:center; justify-content:center;" data-date="' + isoDate + '" data-start="' + startTime + '" data-end="' + endTime + '"' + onclickAttr + '>' + startTime + ' - ' + endTime + '</div>';
                    }
                    slotsRow.appendChild(slotDiv);
                    slotCount++;
                }
            }
        
            container.appendChild(slotsRow);
            currentDate.setDate(currentDate.getDate() + 1);
        }

        console.log("✅ Generated", slotCount, "slots");
    
        loadExistingWorkingSlots();
        setTimeout(function() { markBookedSlotsFixed(); }, 200);
    
        setTimeout(function() { 
            if(typeof highlightDatesInCustomCalendar === 'function') {
                highlightDatesInCustomCalendar();
            }
        }, 500);
    }

