    /* Slot box base style */
.working-slot {
    display: inline-block;
    width: 100px;
    margin: 4px;
    padding: 8px 4px;
    border: 1px solid #007bff;
    border-radius: 6px;
    text-align: center;
    cursor: pointer;
    background: white;
    font-size: 11px;
    transition: all 0.2s;
}

/* Hover effect for all slots */
.working-slot:hover {
    background: #007bff;
    color: white;
    transform: scale(1.02);
}

/* Selected slot */
.working-slot.selected {
    background: #007bff !important;
    color: white !important;
}

/* Red slot (fully booked) */
.working-slot.booked-red {
    background: #f8d7da !important;
    border-color: #dc3545 !important;
    color: #721c24 !important;
    cursor: not-allowed !important;
}

/* Red slot hover - no change */
.working-slot.booked-red:hover {
    transform: none;
    background: #f8d7da !important;
}

/* Orange slot (partial booking for double service) */
.working-slot.booked-orange {
    background: #fff3e0 !important;
    border-color: #ff9800 !important;
    color: #e65100 !important;
    cursor: pointer !important;
}

/* Orange slot hover */
.working-slot.booked-orange:hover {
    background: #ff9800 !important;
    color: white !important;
}

/* Selected orange slot becomes blue */
.working-slot.booked-orange.selected {
    background: #007bff !important;
    border-color: #007bff !important;
    color: white !important;
}

/* Past selected slots styled orange and locked */
.working-slot.past-selected {
    background: #fff3e0 !important;
    border-color: #ff9800 !important;
    color: #e65100 !important;
    cursor: not-allowed !important;
    pointer-events: none !important;
}

