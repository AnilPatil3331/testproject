        <div class="card mb-3 border">
            <div class="card-header">
                <h5 class="mb-0 text-primary fs-2">
                    <i class="fas fa-alt me-2"></i>Advised Therapy
                </h5>
            </div>
            <div class="card-body">
                @if (ViewBag.AdvisedTherapyResult != null && ViewBag.AdvisedTherapyResult.Count > 0)
                {
                    <div class="table-responsive">
                        <!-- ✅ IMPORTANT -->
                        <table class="table table-bordered table-hover table-striped align-middle">

                            <thead class="table-dark text-center">
                                <tr>
                                    <th style="width:60px;">#</th>
                                    <th>Service Name</th>
                                    <th>Category</th>
                                    <th style="width:80px;">Days</th>
                                    <th style="width:100px;">Frequency</th>
                                    <th>Patient Instruction</th>
                                    <th>Therapist Instruction</th>
                                    <th style="width:100px;">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @{
                                    int i = 1;
                                }

                                @foreach (var item in ViewBag.AdvisedTherapyResult)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@i</td>
                                        <td>@item.ServiceName</td>
                                        <td>@item.ServiceCategories</td>
                                        <td class="text-center">@item.DaysNumber</td>
                                        <td class="text-center">@item.Frequency</td>

                                        <!-- ✅ wrap long text -->
                                        <td style="max-width:200px; white-space:normal;">
                                            @item.InstructionPatinet
                                        </td>

                                        <td style="max-width:200px; white-space:normal;">
                                            @item.InstructionTherapist
                                        </td>

                                        <td class="text-center">
                                            <button type="button"
                                                    class="btn btn-success btn-sm use-therapy-btn"
                                                    data-service-id="@item.ServiceFid"
                                                    data-service-name="@item.ServiceName"
                                                    data-service-category="@item.ServiceCategories"
                                                    data-days="@item.DaysNumber"
                                                    data-frequency="@item.Frequency"
                                                    data-patient-instr="@item.InstructionPatinet"
                                                    data-therapist-instr="@item.InstructionTherapist">
                                                <i class="fa fa-check-circle"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    i++;
