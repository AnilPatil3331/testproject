    $("#ddlBillingServiceName").change(function(){
        debugger;
        var GetServiceId=$("#ddlBillingServiceName").val();
        var selectedServiceName = $("#ddlBillingServiceName option:selected").text();
        $("#txtServiceName").val(selectedServiceName);
        $.ajax({
            type: 'GET',
            dataType: 'JSON',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetMedicinePrice", "Prescription")',
            data: { GetServiceId: GetServiceId },
            success: function (data) {
                debugger;
                if (data != null) {
                    debugger
                    var Price=data.GetServicePrice;
                    $("#txtPrice").val(data);
                    $("#txtQuantity").val(1);
                    $("#txtTotal").val(data);
                }
            }

        })
    });
    $(document).on("input", "#txtPrice, #txtQuantity, #txtTotal", function () {

        let value = $(this).val();

        // ❌ remove special char
        value = value.replace(/[^0-9.]/g, '');

        let parts = value.split('.');

        // 🔹 max 4 digit before decimal
        if (parts[0].length > 4) {
            parts[0] = parts[0].substring(0, 4);
        }

        // 🔹 max 2 decimal
        if (parts.length > 1) {
            parts[1] = parts[1].substring(0, 2);
            value = parts[0] + '.' + parts[1];
        } else {
            value = parts[0];
        }

        $(this).val(value);
    });
    $("#txtQuantity").on("keyup", function () {
        debugger
        var GetPrice = parseFloat($("#txtPrice").val()) || 0; // Ensure Price is selected correctly and defaults to 0 if empty

        var Quantity = parseFloat($(this).val()) || 0; // Parse quantity and handle non-numeric input
        var TotalPrice = GetPrice * Quantity;
        $("#txtTotal").val(TotalPrice.toFixed(2)); // Fix total to 2 decimal places
    });


    $("#txtDiscount").on("keyup", function () {
        debugger

        var totalAmount = parseFloat($("#txtFinalTotal").val()) || 0;


        // Ensure Discount is parsed correctly or defaults to 0
        var discount = parseFloat($(this).val()) || 0;

        //var totalPayableAmount = totalAmount - discount;
        var totalPayableAmount = totalAmount - (totalAmount * discount / 100);

        // Ensure the total payable amount is not negative
        if (totalPayableAmount < 0) {
            $("#txtFinalPaybalAmount").val(totalAmount.toFixed(2));
        }

        // Set the calculated total payable amount to 2 decimal places in the input field
        $("#txtFinalPaybalAmount").val(totalPayableAmount.toFixed(2));
        $("#txtAmount").val(totalPayableAmount.toFixed(2));
    });

