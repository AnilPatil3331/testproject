                            <script>
                                // 1. Optimized Filter (Hang honar nahi)
                                function filterTherapyList() {
                                    const search = document.getElementById("searchTherapy").value.toLowerCase();
                                    const fromD = document.getElementById("filterFromDate").value;
                                    const toD = document.getElementById("filterToDate").value;
                                    const rows = document.querySelectorAll("#mainBookingTable .master-row");

                                    rows.forEach(row => {
                                        const text = row.innerText.toLowerCase();
                                        const matchesSearch = text.includes(search);

                                        // Simple display toggle
                                        if (matchesSearch) {
                                            row.style.display = "";
                                        } else {
                                            row.style.display = "none";
                                            const btn = row.querySelector(".toggle-btn");
                                            const bId = btn.getAttribute("onclick").match(/\d+/)[0];
                                            document.getElementById("child-" + bId).style.display = "none";
                                            btn.innerHTML = '<i class="fa fa-plus-square"></i>';
                                        }
                                    });
                                }

                                // 2. Simple Expand/Collapse
                                function toggleDetails(id, btn) {
                                    const child = document.getElementById("child-" + id);
                                    const icon = btn.querySelector("i");

                                    if (child.style.display === "none") {
                                        // Show Details
                                        child.style.display = "table-row";
                                        btn.style.transform = "rotate(180deg)"; // Purn button rotate hoil
                                        btn.classList.remove("btn-primary");
                                        btn.classList.add("btn-dark"); // Color change kelyane ughadla aahe he samajel
                                    } else {
                                        // Hide Details
                                        child.style.display = "none";
                                        btn.style.transform = "rotate(0deg)";
                                        btn.classList.remove("btn-dark");
                                        btn.classList.add("btn-primary");
                                    }
                                }

                                // 3. Fast Sorting (Memory-efficient)
                                let currentDir = 'asc';
                                function simpleSort(colIdx) {
                                    const table = document.getElementById("mainBookingTable");
                                    const rows = Array.from(table.querySelectorAll(".master-row"));

                                    currentDir = (currentDir === 'asc') ? 'desc' : 'asc';

                                    const sortedRows = rows.sort((a, b) => {
                                        const valA = a.cells[colIdx].innerText.toLowerCase();
                                        const valB = b.cells[colIdx].innerText.toLowerCase();
                                        return currentDir === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
                                    });

                                    // Re-append sorted rows with their children
                                    sortedRows.forEach(row => {
                                        table.appendChild(row);
                                        const bId = row.querySelector(".toggle-btn").getAttribute("onclick").match(/\d+/)[0];
                                        table.appendChild(document.getElementById("child-" + bId));
                                    });
                                }

                                function resetTherapyFilter() {
                                    document.getElementById("searchTherapy").value = "";
                                    document.getElementById("filterFromDate").value = "";
                                    document.getElementById("filterToDate").value = "";
                                    filterTherapyList();
                                }
                            </script>
<script>
    function applyBillingLock() {
        var isPaid = $('#hdnIsPaid').val() === '1';
        if (isPaid) {
            // Disable or make readonly all inputs in bookingFormContainer except FromDate, ToDate, and available slots
            $('#bookingFormContainer :input').each(function() {
                var $el = $(this);
                var id = $el.attr('id');
                var type = $el.attr('type');

                if (id === 'FromDate' || id === 'ToDate') {
                    return;
                }

                if ($el.closest('#availableSlotCollapse').length > 0) {
                    return;
                }

                if (type === 'submit' || type === 'hidden') {
                    return;
                }

                if ($el.is('textarea') || type === 'text' || type === 'number') {
                    $el.prop('readonly', true);
                } else {
                    $el.prop('disabled', true);
                    if ($el.is('select')) {
                        try {
                            if ($.fn.select2) { $el.trigger('change'); }
                            if ($.fn.selectpicker) { $el.selectpicker('refresh'); }
                            $el.trigger('chosen:updated');
                        } catch(e) {}
                    }
                }
            });

            // Disable all buttons in bookingFormContainer except Save Plan and available slots
            $('#bookingFormContainer button, #bookingFormContainer a.btn').each(function() {
                var $btn = $(this);
                if ($btn.closest('#availableSlotCollapse').length === 0 && 
                    !$btn.hasClass('btn-success') && 
                    $btn.attr('type') !== 'submit') {
                    $btn.prop('disabled', true);
                }
            });

            // Disable Use Therapy buttons in Advised Therapy section
            $('.use-therapy-btn').prop('disabled', true);

            if ($('#bookingFormContainer .alert-info').length === 0) {
                $('#bookingFormContainer').prepend('<div class="alert alert-info py-2"><i class="fas fa-lock mr-2"></i><strong>Payment Done:</strong> Core billing details are locked. You can only modify Care Mode & Stay (From Date, To Date) and choose/change slot times in the calendar.</div>');
            }
        }
    }

    $(function() {
        applyBillingLock();
        $('#therapyForm').on('submit', function () {
            if ($('#hdnIsPaid').val() === '1') {
                $('#bookingFormContainer :input:disabled').prop('disabled', false);
            }
        });
    });
</script>


