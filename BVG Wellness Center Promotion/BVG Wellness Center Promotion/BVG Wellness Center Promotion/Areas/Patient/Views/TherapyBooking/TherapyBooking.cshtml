@*calculate calculateRowQuantity script*@
<script>
    function calculateRowQuantity(row) {

        var freq = row.find('input[name^="Frequncy"]').val();
        var duration = parseInt(row.find('input[name^="Duration"]').val()) || 0;
        var durationType = row.find('select[name^="DurationType"]').val();

        if (!freq || duration === 0) return;

        // 🔥 Calculate total dose per day (1-0-1 = 2)
        var totalDosePerDay = 0;

        var parts = freq.split('-');
        parts.forEach(function (p) {
            totalDosePerDay += parseInt(p) || 0;
        });

        // 🔥 Convert duration into days
        var totalDays = duration;

        if (durationType === "Week") {
            totalDays = duration * 7;
        }
        else if (durationType === "Month") {
            totalDays = duration * 30;
        }
        else if (durationType === "Year") {
            totalDays = duration * 365;
        }

        var finalQty = totalDosePerDay * totalDays;

        row.find('input[name^="Quantity"]').val(finalQty);
    }


    // 🔥 Trigger calculation
    $(document).on('keyup change',
        'input[name^="Frequncy"], input[name^="Duration"], select[name^="DurationType"]',
        function () {

            var row = $(this).closest('tr');
            calculateRowQuantity(row);
        });

</script>




