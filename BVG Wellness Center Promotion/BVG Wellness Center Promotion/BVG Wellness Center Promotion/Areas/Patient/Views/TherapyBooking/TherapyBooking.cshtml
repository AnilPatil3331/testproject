        // ============================================
        // 3. FORM SUBMIT VALIDATION WITH TIME CHECK
        // ============================================
        $('#therapyForm').on('submit', function(e) {
            var isValid = true;
            var errorMessages = [];
            var pastSlotsFound = [];

            // ===== TIME SLOT VALIDATION - Check for past slots =====
            var selectedSlotsElements = document.querySelectorAll('.working-slot.selected');

            if(selectedSlotsElements.length === 0) {
                errorMessages.push('❌ Please select at least one Time Slot for booking');
                isValid = false;
            } else {
                // Check each selected slot for past time
                selectedSlotsElements.forEach(function(slot) {
                    var slotDate = slot.getAttribute('data-date');
                    var slotStart = slot.getAttribute('data-start');
                    var isExisting = slot.getAttribute('data-existing') === 'true';

                    if(!isExisting && isSlotInPast(slotDate, slotStart)) {
                        pastSlotsFound.push(slotStart + ' on ' + slotDate);
                    }
                });

                if(pastSlotsFound.length > 0) {
                    errorMessages.push(`❌ Cannot book past slots: ${pastSlotsFound.join(', ')}<br>Please select future time slots only.`);
                    isValid = false;
                }
            }

            // ===== PATIENT NAME VALIDATION =====
            var patientName = $('.data-field:contains("Name:")').text().replace('Name:', '').trim();
            var patientFid = $('#PatientFid').val();

            if((!patientName || patientName === '') && (!patientFid || patientFid === '')) {
                errorMessages.push('❌ Please select a Patient first (Search by Name/Mobile/UHID)');
                isValid = false;
            }

            // ===== SERVICE CATEGORY VALIDATION =====
            var serviceGroup = $('#ddlServicegroup').val();
            if(!serviceGroup || serviceGroup === '' || serviceGroup === '0') {
                $('#ddlServicegroup').css('border', '2px solid #dc3545');
                errorMessages.push('❌ Please select Service Category');
                isValid = false;
            }

            // ===== SERVICE / THERAPY VALIDATION =====
            var serviceFid = $('#ddlServiceName').val();
            if(!serviceFid || serviceFid === '') {
                $('#ddlServiceName').css('border', '2px solid #dc3545');
                errorMessages.push('❌ Please select Service / Therapy');
                isValid = false;
            }

            // ===== ROOM SELECTION VALIDATION =====
            var roomId = $('#ServiceRoomID').val();
            if(!roomId || roomId === '' || roomId === '0' || roomId === '--Select Room--') {
                $('#ServiceRoomID').css('border', '2px solid #dc3545');
                errorMessages.push('❌ Please select a Room for Therapy');
                isValid = false;
            }

            // ===== FREQUENCY VALIDATION =====
            var frequency = $('#ddlFrequency').val();
            if(!frequency || frequency === '' || frequency === 'Select Frequency') {
                $('#ddlFrequency').css('border', '2px solid #dc3545');
                errorMessages.push('❌ Please select Frequency (Daily/Weekly/Monthly/Alternate Days)');
                isValid = false;
            }

            // ===== NUMBER OF SESSIONS VALIDATION =====
            var numberOfSessions = $('#TXTNumberOfSessions').val();
            if(!numberOfSessions || numberOfSessions === '' || parseInt(numberOfSessions) <= 0) {
                $('#TXTNumberOfSessions').css('border', '2px solid #dc3545');
                errorMessages.push('❌ Please enter valid Number of Sessions (greater than 0)');
                isValid = false;
            } else if(parseInt(numberOfSessions) > 365) {
                errorMessages.push('❌ Number of Sessions cannot exceed 365');
                isValid = false;
            }

            // ===== DURATION VALIDATION =====
            var duration = $('#Duration').val();
            if(!duration || duration === '' || duration === '--Select--') {
                $('#Duration').css('border', '2px solid #dc3545');
                errorMessages.push('❌ Please select Duration (in minutes)');
                isValid = false;
            }

            // ===== FROM DATE VALIDATION =====
            var fromDate = $('#FromDate').val();
            if(!fromDate || fromDate === '') {
                $('#FromDate').css('border', '2px solid #dc3545');
                errorMessages.push('❌ Please select From Date');
                isValid = false;
            } else {
                var isEditMode = (parseInt($('#IsEditMode').val()) || 0) > 0;
                if (!isEditMode) {
                    var selectedFromDate = new Date(fromDate);
                    var checkDate = new Date();
                    checkDate.setHours(0, 0, 0, 0);
                    if(selectedFromDate < checkDate) {
                        errorMessages.push('❌ From Date cannot be in the past');
                        isValid = false;
                    }
                }
            }

            // ===== TO DATE VALIDATION =====
            var toDate = $('#ToDate').val();
            if(!toDate || toDate === '') {
                errorMessages.push('❌ Please select To Date');
                isValid = false;
            }

            // ===== MEDICINES VALIDATION =====
            var anyMedicineSelected = false;
            $('.medicine-select').each(function() {
                if($(this).val() && $(this).val() !== "") {
                    anyMedicineSelected = true;
                    return false;
                }
            });

            if(!anyMedicineSelected) {
                errorMessages.push('❌ Please select at least one Medicine');
                isValid = false;
            }

            // ===== ADVISED BY VALIDATION =====
            var advisedBy = $('#advisedBy').val();
            if(!advisedBy || advisedBy === '' || advisedBy === 'Select') {
                $('#advisedBy').css('border', '2px solid #dc3545');
                errorMessages.push('❌ Please select Advised By (Doctor/Staff/Self)');
                isValid = false;
            }

            // ===== DOCTOR VALIDATION IF ADVISED BY DOCTOR =====
            if(advisedBy === 'Doctor') {
                var doctorFid = $('#doctorFid').val();
                if(!doctorFid || doctorFid === '' || doctorFid === 'Select Doctor') {
                    $('#doctorFid').css('border', '2px solid #dc3545');
                    errorMessages.push('❌ Please select Physician/Doctor');
                    isValid = false;
                }
            }

            // ===== ATTENDANT VALIDATION IF ADVISED BY STAFF =====
            if(advisedBy === 'Staff') {
                var attendantName = $('#attendantName').val();
                if(!attendantName || attendantName.trim() === '') {
                    $('#attendantName').css('border', '2px solid #dc3545');
                    errorMessages.push('❌ Please enter Attendant Name');
                    isValid = false;
                }
            }

            // ===== SELF VALIDATION IF ADVISED BY SELF =====
            if(advisedBy === 'Self') {
                var selfName = $('#selfName').val();
                if(!selfName || selfName.trim() === '') {
                    $('#selfName').css('border', '2px solid #dc3545');
                    errorMessages.push('❌ Please enter Self Name');
                    isValid = false;
                }
            }

            // ===== THERAPIST ASSIGNED VALIDATION =====
            var therapistId = $('#TherapistId').val();
            if(!therapistId || therapistId === '' || therapistId === '0' || therapistId === 'Select Receptionist') {
                $('#TherapistId').css('border', '2px solid #dc3545');
                errorMessages.push('❌ Please assign a Therapist');
                isValid = false;
            }

            // ===== SHOW ALL ERRORS WITH SWEETALERT =====
            if(!isValid) {
                e.preventDefault();

                var errorHtml = '<div style="text-align: left; max-height: 350px; overflow-y: auto;">' +
                                errorMessages.map(function(msg) {
                                    return '<div style="padding: 8px 0; border-bottom: 1px solid #eee;">' + msg + '</div>';
                                }).join('') +
                                '</div>';

                Swal.fire({
                    title: '⚠️ Validation Failed!',
                    html: errorHtml,
                    icon: 'error',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#d33',
                    width: '550px'
                });

                return false;
            }

            if (isValid) {
                // Naveen Code add kela: Enable disabled inputs inside form container so model binder receives them
                var isPaid = $('#hdnIsPaid').val() === '1';
                if (isPaid) {
                    $('#bookingFormContainer :input:disabled').prop('disabled', false);
                    $('#bookingFormContainer :input:read-only').prop('readonly', false);
                }
            }

            return true;
        });

        // ============================================
        // 4. ADD REQUIRED ATTRIBUTE TO IMPORTANT FIELDS
        // ============================================
        $('#ddlServicegroup').attr('required', true);
        $('#ddlServiceName').attr('required', true);
        $('#ServiceRoomID').attr('required', true);
        $('#ddlFrequency').attr('required', true);
        $('#TXTNumberOfSessions').attr('required', true);
        $('#Duration').attr('required', true);
        $('#FromDate').attr('required', true);
        $('#TherapistId').attr('required', true);
        $('#advisedBy').attr('required', true);

        // ============================================
        // 5. MARK ALL REQUIRED FIELDS WITH ASTERISK
        // ============================================
        $('label:contains("SERVICE CATEGORIES"), label:contains("SERVICE / THERAPY"), label:contains("select Room"), label:contains("FREQUENCY"), label:contains("NUMBER OF SESSIONS"), label:contains("DURATION"), label:contains("From Date"), label:contains("Therapist Assigned"), label:contains("Advised By")').each(function() {
            if(!$(this).html().includes('*')) {
                $(this).append(' <span class="text-danger fw-bold">*</span>');
            }
        });

        console.log('✅ All validations loaded successfully');
        console.log('✅ Current time check enabled - past slots for today cannot be booked');

    });
    function calculateNetPayable() {
        // १. ग्रँड टोटल मिळवा (उदा. ५०००)
        var total = parseFloat($("#txtFinalTotal").val()) || 0;

        // २. डिस्काउंट टक्केवारी मिळवा (उदा. १०%)
        var discountPercent = parseFloat($("#txtDiscount").val()) || 0;
    
        // ३. डिस्काउंट वजा करून येणारी रक्कम (उदा. ४५००)
        var afterDiscount = total - (total * (discountPercent / 100));

        // ४. आधी भरलेली रक्कम मिळवा (उदा. २०००)
        var prevPaid = parseFloat($("#txtPrevPaid").val()) || 0;

        // ५. 🟢 मुख्य सूत्र: (डिस्काउंट नंतरची रक्कम) - (आधी भरलेली रक्कम)
        var netPayable = afterDiscount - prevPaid;

        // जर रक्कम मायनसमध्ये येत असेल तर ० दाखवा
        if (netPayable < 0) netPayable = 0;

        // ६. निकाल 'Payable Amount' बॉक्समध्ये सेट करा
        $("#txtFinalPaybalAmount").val(netPayable.toFixed(2));

        // ७. खालील 'Amount' इनपुटमध्ये (जिथे पेमेंट मोड आहे) हीच व्हॅल्यू आपोआप टाका
        $("#txtAmount").val(netPayable.toFixed(2));
    }

    // जेव्हा पेज लोड होईल किंवा डिस्काउंट बदलला जाईल तेव्हा हे फंक्शन चालू झाले पाहिजे
    $(document).ready(function() {
        // पेज लोड झाल्यावर एकदा हिशोब करा
        calculateNetPayable();

        // डिस्काउंट बदलला की हिशोब करा
        $("#txtDiscount").on("input", function() {
            calculateNetPayable();
        });
    
        // जर सेशन्स बदलले आणि 'Total' बदलली, तर हे फंक्शन तिथेही कॉल करा
        // उदाहरण: $("#txtFinalTotal").on("change", calculateNetPayable);
    });
</script>
<script>
    $(document).ready(function () {
        // Function to toggle form state
        function toggleFormState() {
            var patientFid = $('#PatientFid').val();
            var hasPatient = (patientFid && patientFid !== '0' && patientFid !== '');

            if (!hasPatient) {
                // Disable all inputs inside the container
                $('#bookingFormContainer :input').prop('disabled', true);
                $('#bookingFormContainer').css('opacity', '0.5'); // Optional: visual cue
            } else {
                // Enable inputs
                $('#bookingFormContainer :input').prop('disabled', false);
                $('#bookingFormContainer').css('opacity', '1');
                
                // Re-apply payment lock if paid
                if (typeof applyBillingLock === 'function') {
                    applyBillingLock();
                }
            }
        }

        // Run on page load to set initial state
        toggleFormState();

        // If you have a global search result handler, call toggleFormState() inside it
        // Or, monitor the hidden field for changes
        $('#PatientFid').on('change', function() {
            toggleFormState();
        });

        // Optional: Add a warning click for the user
        $('#bookingFormContainer').on('click', function(e) {
            if ($('#PatientFid').val() === '') {
                Swal.fire({
                    icon: 'warning',
                    title: 'Action Required',
                    text: 'Please select a patient using the search box above first.'
                });
                e.preventDefault();
            }
        });
    });
</script>