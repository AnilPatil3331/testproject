<script>
// ============================================
// DATE HIGHLIGHTING BASED ON FREQUENCY - CORRECTED
// ============================================

function calculateAndHighlightDates() {
    var fromDate = document.getElementById('FromDate').value;
    var noOfSessions = document.getElementById('TXTNumberOfSessions').value;
    var frequency = document.getElementById('ddlFrequency').value;

    console.log("=== DATE CALCULATION ===");
    console.log("FromDate:", fromDate);
    console.log("No of Sessions:", noOfSessions);
    console.log("Frequency:", frequency);

    if(!fromDate || !noOfSessions || !frequency) {
        console.log("Missing required fields");
        return;
    }

    var startDate = new Date(fromDate);
    var highlightDates = [];
    var sessionsCount = parseInt(noOfSessions);

    if(frequency === "Daily") {
        console.log("Calculating Daily dates");
        // Daily: 21, 22, 23, 24 (next consecutive days)
        for(var i = 0; i < sessionsCount; i++) {
            var newDate = new Date(startDate);
            newDate.setDate(startDate.getDate() + i);
            highlightDates.push(formatDate(newDate));
            console.log("Daily date " + (i+1) + ":", formatDate(newDate));
        }
    }
    else if(frequency === "Alternate Days") {
        console.log("Calculating Alternate Days dates");
        // Alternate Days: 21, 23, 25, 27 (every 2nd day)
        for(var i = 0; i < sessionsCount; i++) {
            var newDate = new Date(startDate);
            newDate.setDate(startDate.getDate() + (i * 2));
            highlightDates.push(formatDate(newDate));
           // console.log("Alternate date " + (i+1) + ":", formatDate(newDate));
        }
    }
    else if(frequency === "Weekly") {
        console.log("Calculating Weekly dates");
        // Weekly: 21, 28, 5 May, 12 May (every 7 days)
        for(var i = 0; i < sessionsCount; i++) {
            var newDate = new Date(startDate);
            newDate.setDate(startDate.getDate() + (i * 7));
            highlightDates.push(formatDate(newDate));
            console.log("Weekly date " + (i+1) + ":", formatDate(newDate));
        }
    }
    else if(frequency === "Monthly") {
        console.log("Calculating Monthly dates");
        // Monthly: 21 April, 21 May, 21 June, 21 July (same date next month)
        for(var i = 0; i < sessionsCount; i++) {
            var newDate = new Date(startDate);
            newDate.setMonth(startDate.getMonth() + i);
            // Fix for month end issues (e.g., Jan 31 -> Feb 28)
            if(newDate.getDate() !== startDate.getDate()) {
                newDate.setDate(0); // Set to last day of previous month
            }
            highlightDates.push(formatDate(newDate));
            console.log("Monthly date " + (i+1) + ":", formatDate(newDate));
        }
    }

    console.log("Final Highlight dates:", highlightDates);
    window.highlightedDates = highlightDates;

    // Update ToDate field
    if(highlightDates.length > 0) {
        var lastDate = highlightDates[highlightDates.length - 1];
        document.getElementById('ToDate').value = lastDate;
        console.log("ToDate set to:", lastDate);

        // Reload slots to show highlights
        if(typeof createWorkingSlots === 'function') {
            createWorkingSlots();
        }
    }
}

function formatDate(date) {
    var year = date.getFullYear();
    var month = String(date.getMonth() + 1).padStart(2, '0');
    var day = String(date.getDate()).padStart(2, '0');
    return year + '-' + month + '-' + day;
}

function highlightDatesInCustomCalendar() {
    console.log("=== APPLYING HIGHLIGHTS ===");
    console.log("Highlighted dates:", window.highlightedDates);

    if(!window.highlightedDates || window.highlightedDates.length === 0) {
        console.log("No dates to highlight");
        return;
    }

    var headers = document.querySelectorAll('#timeSlotsContainer h6');
    console.log("Headers found:", headers.length);
    
    headers.forEach(function(header) {
        var text = header.innerText;
        var extractedDate = extractDateFromHeader(text);
        console.log("Header:", text, "-> Extracted:", extractedDate);
        
        if(extractedDate && window.highlightedDates.includes(extractedDate)) {
            console.log("✅ HIGHLIGHTING:", extractedDate);
            header.style.backgroundColor = '#e7f1ff';
            header.style.borderLeft = '4px solid #007bff';
            header.style.paddingLeft = '10px';
            header.style.borderRadius = '8px';
            
            if(!header.querySelector('.session-badge')) {
                var badge = document.createElement('span');
                badge.className = 'badge bg-primary ms-2 session-badge';
                badge.innerText = 'Session Day';
                header.appendChild(badge);
            }
        }
    });
}

function extractDateFromHeader(headerText) {
    var months = {
        'Jan': '01', 'Feb': '02', 'Mar': '03', 'Apr': '04', 'May': '05', 'Jun': '06',
        'Jul': '07', 'Aug': '08', 'Sep': '09', 'Oct': '10', 'Nov': '11', 'Dec': '12'
    };
    
    // Multiple patterns to match different date formats
    var patterns = [
        /(\w{3})\s+(\d{1,2}),?\s+(\d{4})/,           // "Apr 21, 2026" or "Apr 21 2026"
        /(\w{3}),?\s+(\d{1,2}),?\s+(\d{4})/,         // "Apr, 21, 2026"
        /(\d{1,2})\s+(\w{3})\s+(\d{4})/              // "21 Apr 2026"
    ];
    
    for(var p = 0; p < patterns.length; p++) {
        var match = headerText.match(patterns[p]);
        if(match) {
            var month, day, year;
            
            if(match.length === 4) {
                // Check if first group is month or day
                if(months[match[1]]) {
                    month = months[match[1]];
                    day = String(parseInt(match[2])).padStart(2, '0');
                    year = match[3];
                } else if(months[match[2]]) {
                    month = months[match[2]];
                    day = String(parseInt(match[1])).padStart(2, '0');
                    year = match[3];
                } else {
                    continue;
                }
            } else {
                continue;
            }
            
            if(month && day && year) {
                return year + '-' + month + '-' + day;
            }
        }
    }
    
    // Fallback: search for date pattern directly
    var dateMatch = headerText.match(/(Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+(\d{1,2})/i);
    if(dateMatch) {
        var currentYear = new Date().getFullYear();
        var month = months[dateMatch[1]];
        var day = String(parseInt(dateMatch[2])).padStart(2, '0');
        return currentYear + '-' + month + '-' + day;
    }
    
    return null;
}

// Wrap createWorkingSlots function
$(document).ready(function() {
    console.log("Date highlight system initialized");

    $('#ddlFrequency, #TXTNumberOfSessions, #FromDate').on('change', function() {
        calculateAndHighlightDates();
    });

    // Wrap createWorkingSlots
    if(typeof createWorkingSlots === 'function') {
        var originalCreateWorkingSlots = createWorkingSlots;
        window.createWorkingSlots = function() {
            originalCreateWorkingSlots();
            setTimeout(function() {
                highlightDatesInCustomCalendar();
            }, 300);
        };
        console.log("Successfully wrapped createWorkingSlots");
    }

    // Initial calculation
    setTimeout(function() {
        calculateAndHighlightDates();
    }, 500);
});
</script>


