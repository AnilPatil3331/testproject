<script>
    var medListGlobal = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MedicineList));
    var medicineRowIndex = 0;

    // Check if any medicine is selected in any row
    function isAnyMedicineSelected() {
        var anySelected = false;
        $('.medicine-select').each(function() {
            if($(this).val() !== "") {
                anySelected = true;
                return false; // break loop
            }
        });
        return anySelected;
    }

    // Get the last row index
    function getLastRowIndex() {
        var lastIndex = -1;
        $('.medicine-select').each(function() {
            var name = $(this).attr('name');
            if(name) {
                var match = name.match(/MedicineFid_(\d+)/);
                if(match && parseInt(match[1]) > lastIndex) {
                    lastIndex = parseInt(match[1]);
                }
            }
        });
        return lastIndex;
    }

    // Function to add new medicine row
    // Function to add new medicine row
    // Function to add new medicine row
    function addMedicineRow(medFid, medName, doseVal, qtyVal, isChargeableVal) {
        var idx = medicineRowIndex++;

        var options = '<option value="">--Select Medicine--</option>';
        for(var i = 0; i < medListGlobal.length; i++) {
            var val = medListGlobal[i].Value;
            var txt = medListGlobal[i].Text;
            var selected = (val == medFid) ? 'selected' : '';
            options += `<option value="${val}" ${selected}>${txt}</option>`;
        }

        var checkedAttr = isChargeableVal ? 'checked' : '';
        var displayQty = qtyVal || '1';
        var displayDose = doseVal || '';

        var row = `
        <tr id="medRow_${idx}" class="medicine-row">
            <td>
                <select name="MedicineFid_${idx}" class="form-control form-control-sm medicine-select" onchange="updateMedicineName(this, ${idx})">
                    ${options}
                </select>
                <input type="hidden" name="MedicineName_${idx}" class="medicine-name" value="${medName.replace(/"/g, '&quot;')}" />
            </td>
            <td>
                <input type="text" name="Doses_${idx}" class="form-control form-control-sm" placeholder="e.g. 500mg" value="${displayDose}">
            </td>
            <td>
                <input type="number" name="Quantity_${idx}" class="form-control form-control-sm" placeholder="Qty" value="${displayQty}" step="1" min="1">
            </td>
            <td class="text-center">
                <input type="checkbox" name="IsChargeable_${idx}" value="true" class="form-check-input" ${checkedAttr} style="width:18px; height:18px;">
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-danger delete-medicine-btn" data-rowid="${idx}" title="Remove">
                    <i class="fa fa-trash"></i>
                </button>
            </td>
        </tr>`;

        $("#medicineTbody").append(row);
        console.log("Row added - IDX: " + idx + ", Name: " + medName);
        return idx;
    }

    // Function to add empty row with validation
    function addEmptyMedicineRow() {
        // ✅ Validation: Check if last row has medicine selected
        var lastRowIndex = getLastRowIndex();
        if(lastRowIndex !== -1) {
            var lastMedicineFid = $(`select[name="MedicineFid_${lastRowIndex}"]`).val();
            if(!lastMedicineFid || lastMedicineFid === "") {
                Swal.fire({
                    title: "Cannot Add Row",
                    text: "Please select a medicine in the current row first before adding a new row.",
                    icon: "warning",
                    confirmButtonText: "OK"
                });
                return false;
            }
        }

        // If no rows exist, add first row
        var idx = medicineRowIndex;
        addMedicineRow(0, '', '', '', '', 'Days', '1', false);
        return true;
    }

    // Delete medicine row
    function deleteMedicineRow(rowId) {
        var row = $(`#medRow_${rowId}`);
        var totalRows = $('.medicine-row').length;

        // ✅ Validation: Can't delete if only one row exists
        if(totalRows === 1) {
            Swal.fire({
                title: "Cannot Delete",
                text: "At least one medicine row is required. You can clear the selection instead.",
                icon: "warning",
                confirmButtonText: "OK"
            });
            return;
        }

        Swal.fire({
            title: "Delete Medicine?",
            text: "Are you sure you want to remove this medicine?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                row.remove();
                console.log("Row removed - IDX: " + rowId);
                Swal.fire("Deleted!", "Medicine row has been removed.", "success");
            }
        });
    }

    // Update medicine name when dropdown changes
    function updateMedicineName(selectElement, idx) {
        var selectedOption = selectElement.options[selectElement.selectedIndex];
        var medicineName = selectedOption.text;
        var medicineFid = selectedOption.value;
        $(selectElement).closest('tr').find('.medicine-name').val(medicineName);
        console.log("Updated - IDX:" + idx + ", FID:" + medicineFid + ", Name:" + medicineName);
    }

    // Add button click event with validation
    $(document).on('click', '#addMedicineBtn', function() {
        addEmptyMedicineRow();
    });

    // Delete button click event
    $(document).on('click', '.delete-medicine-btn', function() {
        var rowId = $(this).data('rowid');
        deleteMedicineRow(rowId);
    });

    // Service select change event
    $(document).on('change', '#ddlServiceName', function() {
        if (window.isInitialLoad) {
            console.log("Skipping service data fetch on initial page load.");
            return;
        }
        var serviceId = $(this).val();
        if (!serviceId) return;

        console.log("Service Selected: " + serviceId);

        $.ajax({
            url: '@Url.Action("GetServiceAutoData", "TherapyBooking")',
            type: 'GET',
            data: { serviceId: serviceId },
            success: function(res) {
                if (!res.success) {
                    console.log("Error: " + res.message);
                    return;
                }

                var s = res.serviceData;
                var medicines = res.medicines;

                // Basic Details fill कर
                $('#LocalName').val(s.LocalName || '');
                $('#Slogan').val(s.Slogan || '');
                $('#Uses').val(s.Uses || '');
                $('#Description').val(s.Description || '');
                $('#Duration').val(s.Duration || '');
                $('#Instruments').val(s.Instruments || '');
                $('#PrerequisiteProcedure').val(s.PrerequisiteProcedure || '');
                $('#MainProcedure').val(s.MainProcedure || '');
                $('#PostProcedureCare').val(s.PostProcedureCare || '');
                $('#PatientInstructions').val(s.PatientInstructions || '');
                $('#RelativeInstructions').val(s.RelativeInstructions || '');
                $('#TherapistInstructions').val(s.TherapistInstructions || '');
                $('#Precautions').val(s.Precautions || '');
                $('#ContraIndications').val(s.ContraIndications || '');
                $('#RelatedDisorders').val(s.RelatedDisorders || '');

                if(s.IsDouble == true || s.IsDouble == 1 || s.IsDouble.toString().toLowerCase() == 'true') {
                    $('#IsDouble').val('True');
                } else {
                    $('#IsDouble').val('False');
                }

                // 🔥 CLEAR AND LOAD MEDICINES
                $("#medicineTbody").empty();
                medicineRowIndex = 0;

                if(medicines && medicines.length > 0) {
                    console.log("Loading " + medicines.length + " medicines from service");
                     for(var i = 0; i < medicines.length; i++) {
        var med = medicines[i];
        addMedicineRow(
            med.MedicineServiceFid || 0,
            med.MedicineName || '',
            med.Doses || '',
            '1',     // quantity
            false    // is chargeable
        );
    }
                } else {
                    console.log("No medicines found, adding one empty row");
                    addMedicineRow(0, '', '', '', '', 'Days', '1', false);
                }
                applyBillingLock();
            },
            error: function(xhr, status, error) {
                console.log("AJAX Error: " + error);
                alert("Error loading service data. Please try again.");
            }
        });
    });

    // Edit mode medicines load
    $(document).ready(function() {
        var isEditMode = $('#IsEditMode').val() && $('#IsEditMode').val() !== '0';

        if(isEditMode && window.editModeMedicines && window.editModeMedicines.MedicineName) {
            console.log("Edit Mode - Loading medicines");
            $("#medicineTbody").empty();
            medicineRowIndex = 0;
            for(var i = 0; i < window.editModeMedicines.MedicineName.length; i++) {
                addMedicineRow(
                    window.editModeMedicines.MedicineFid ? window.editModeMedicines.MedicineFid[i] : 0,
                    window.editModeMedicines.MedicineName[i] || '',
                    window.editModeMedicines.Doses ? window.editModeMedicines.Doses[i] : '',
                    window.editModeMedicines.Quantity ? window.editModeMedicines.Quantity[i] : '1',
                    window.editModeMedicines.IsChargeable ? window.editModeMedicines.IsChargeable[i] : false
                );
            }
        } else {
            // Initial load - add one empty row
            if($("#medicineTbody tr").length === 0) {
                addMedicineRow(0, '', '', '', '', 'Days', '1', false);
            }
        }
    });

    // Form submit validation - at least one medicine should be selected
    $(document).on('submit', '#therapyForm', function(e) {
        var anyMedicineSelected = false;
        $('.medicine-select').each(function() {
            if($(this).val() && $(this).val() !== "") {
                anyMedicineSelected = true;
                return false;
            }
        });

        if(!anyMedicineSelected) {
            Swal.fire({
                title: "Validation Error",
                text: "Please select at least one medicine before saving.",
                icon: "error",
                confirmButtonText: "OK"
            });
            e.preventDefault();
            return false;
        }
        return true;
    });
</script>


<script>
    // Auto-format frequency (111 -> 1-1-1, 100 -> 1-0-0)
    $(document).on('input', 'input[name^="Frequncy_"]', function() {
        var value = $(this).val();
        // Remove existing hyphens and non-digits
        var numbers = value.replace(/-/g, '').replace(/[^0-9]/g, '');

        if(numbers.length >= 1) {
            var formatted = numbers.substring(0,1);
            if(numbers.length >= 2) {
                formatted += '-' + numbers.substring(1,2);
            }
            if(numbers.length >= 3) {
                formatted += '-' + numbers.substring(2,3);
            }
            if(numbers.length > 3) {
                formatted = formatted.substring(0,5); // Max 5 chars: 1-1-1
            }
            $(this).val(formatted);
        }
    });
</script>

