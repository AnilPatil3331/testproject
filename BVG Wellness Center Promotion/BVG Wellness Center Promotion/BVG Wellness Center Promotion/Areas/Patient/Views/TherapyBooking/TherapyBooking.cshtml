<script>
let currentPage = 1;

function paginateTable() {
    let table = document.getElementById("therapyTable");
    if (!table) return;

    let rows = table.querySelectorAll("tbody tr");
    let rowsPerPageElem = document.getElementById("rowsPerPage");
    let rowsPerPage = rowsPerPageElem ? parseInt(rowsPerPageElem.value) : 10;

    let totalPages = Math.ceil(rows.length / rowsPerPage);
    let pageInfoElem = document.getElementById("pageInfo");
    if (pageInfoElem) {
        pageInfoElem.innerText = "Page " + currentPage + " of " + totalPages;
    }

    rows.forEach((row, index) => {
        row.style.display = (index >= (currentPage - 1) * rowsPerPage && index < currentPage * rowsPerPage) ? "" : "none";
    });
}

function nextPage() {
    currentPage++;
    paginateTable();
}

function prevPage() {
    if (currentPage > 1) {
        currentPage--;
        paginateTable();
    }
}

// Safe event listeners
$(document).ready(function() {
    var rowsPerPageElem = document.getElementById("rowsPerPage");
    if (rowsPerPageElem) {
        rowsPerPageElem.addEventListener("change", function () {
            currentPage = 1;
            paginateTable();
        });
    }

    var searchTherapyElem = document.getElementById("searchTherapy");
    if (searchTherapyElem) {
        searchTherapyElem.addEventListener("keyup", function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll("#therapyTable tbody tr");
            rows.forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(filter) ? "" : "none";
            });
        });
    }

    // Initial pagination
    setTimeout(function() {
        paginateTable();
    }, 500);
});

function exportTableToCSV(filename) {
    let csv = [];
    let rows = document.querySelectorAll("table tr");
    rows.forEach(row => {
        let cols = row.querySelectorAll("td, th");
        let rowData = [];
        cols.forEach(col => rowData.push(col.innerText));
        csv.push(rowData.join(","));
    });
    let csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
    let downloadLink = document.createElement("a");
    downloadLink.download = filename;
    downloadLink.href = window.URL.createObjectURL(csvFile);
    downloadLink.click();
}

function toggleBookingStatus(id, checkbox) {
    let status = checkbox.checked;
    fetch('/TherapyBooking/ToggleStatus', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, status: status })
    });
}
</script>


@*filterTherapyList*@
<script>
function filterTherapyList() {
    var fromDate = document.getElementById('filterFromDate').value;
    var toDate = document.getElementById('filterToDate').value;
    var table = document.getElementById('therapyTable');
    var tr = table.getElementsByTagName('tr');

    // Convert input dates to Date objects
    var fromTs = fromDate ? new Date(fromDate) : null;
    var toTs = toDate ? new Date(toDate) : null;

    if (fromTs) fromTs.setHours(0,0,0,0);       // include start of day
    if (toTs) toTs.setHours(23,59,59,999);     // include end of day

    for (var i = 1; i < tr.length; i++) { // skip header row
        var tdDate = tr[i].getElementsByTagName('td')[5]; // 6th column = SlotDate
        if (tdDate) {
            var rowDateStr = tdDate.textContent || tdDate.innerText;
            var parts = rowDateStr.split('-'); // dd-MM-yyyy
            var rowDate = new Date(parts[2], parts[1]-1, parts[0]);
            rowDate.setHours(12,0,0,0); // set midday to avoid timezone issues

            var show = true;
            if (fromTs && rowDate < fromTs) show = false;
            if (toTs && rowDate > toTs) show = false;

            tr[i].style.display = show ? "" : "none";
        }
    }
}

function resetTherapyFilter() {
    document.getElementById('filterFromDate').value = "";
    document.getElementById('filterToDate').value = "";
    filterTherapyList();
}
</script>

