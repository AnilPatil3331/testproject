         class="modal fade show" aria-modal="true" style="display: block; padding-left: 4px;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <span tabindex="0">
            </span>
            <div id="bill-modal___BV_modal_content_" tabindex="-1" class="modal-content">
