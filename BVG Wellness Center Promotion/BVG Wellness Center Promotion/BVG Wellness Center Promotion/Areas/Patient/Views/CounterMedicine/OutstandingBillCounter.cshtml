                                                <div class="input-group-text">
                                                    /-
                                                </div>
                                            </div>
                                        </div>
                                        <!---->
                                    </div>
                                </div>
                            </div>
                            <!---->
                            <div class="col-md-4 col-sm-12">
                                <div class="form-group">
                                    <label for="discount" class="form-control-label">
                                        Total Paid Amount
                                        <span class="text-danger">
