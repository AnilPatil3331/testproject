        document.getElementById("paidRadio").setAttribute("required", "required");
    });


</script>


<script>
    $("#FilterDate").on("change", function () {

        let selectedDate = $(this).val(); // yyyy-MM-dd

        if (!selectedDate) {
            $("#tblBillingRecords tbody tr").show();
            return;
        }

        $("#tblBillingRecords tbody tr").each(function () {

            // ✅ FIXED INDEX
            let rowText = $(this).find("td").eq(7).text().trim();

            if (!rowText) {
                $(this).hide();
                return;
            }

            let clean = rowText.split(" ")[0].trim();

            let parts = clean.split("/");

            if (parts.length !== 3) {
                $(this).hide();
                return;
            }

            let day = parts[0].padStart(2, '0');
            let month = parts[1].padStart(2, '0');
            let year = parts[2];

            let rowDate = `${year}-${month}-${day}`;

            if (rowDate === selectedDate) {
                $(this).show();
            } else {
                $(this).hide();
            }

        });

    });
</script>
<script>
    $(document).ready(function () {

        // =========================
        // 🔹 DISCOUNT VALIDATION
        // =========================
        $("#txtDiscount").on("keydown", function (e) {
            if (e.key === "-" || e.key === "e") {
                e.preventDefault();
            }
        });

        $("#txtDiscount").on("input", function () {

            let val = $(this).val();

            // only numbers
            val = val.replace(/[^0-9]/g, '');

            // max 100
            if (parseInt(val) > 100) {
                val = "100";
            }

            $(this).val(val);

         
        });

  
        // =========================
        // 🔹 AMOUNT VALIDATION
        // =========================
        $(document).on("keydown", ".amount", function (e) {
            if (e.key === "-" || e.key === "e") {
                e.preventDefault();
            }
        });

        $(document).on("input", ".amount", function () {

            let val = $(this).val();

            val = val.replace(/[^0-9.]/g, '');

            if ((val.match(/\./g) || []).length > 1) {
                val = val.substring(0, val.length - 1);
            }

            $(this).val(val);

            checkAmountMatch();
        });

        // =========================
        // 🔹 PAYMENT TYPE LOGIC
        // =========================
        $(document).on("change", ".paymentType", function () {

            let row = $(this).closest(".payment-row");
            let type = $(this).val();

            if (type === "Cash") {
                row.find(".referenceNumber").val("").prop("readonly", true);
            } else {
                row.find(".referenceNumber").prop("readonly", false);
            }
        });

        // =========================
        // 🔹 PAID / UNPAID (readonly)
        // =========================
        $("input[name='PaymentStatus']").change(function () {

            let status = $("input[name='PaymentStatus']:checked").val();

            if (status === "Unpaid") {

                $(".paymentType").css("pointer-events", "none");
                $(".referenceNumber").val("").prop("readonly", true);
                $(".amount").prop("readonly", true);

            } else {

                $(".paymentType").css("pointer-events", "auto");
                $(".amount").prop("readonly", false);

                $(".paymentType").each(function () {
                    let row = $(this).closest(".payment-row");
                    let type = $(this).val();

                    if (type === "Cash") {
                        row.find(".referenceNumber").val("").prop("readonly", true);
                    } else {
                        row.find(".referenceNumber").prop("readonly", false);
                    }
                });
            }
        });

    

    });
</script>
