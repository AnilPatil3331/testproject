@model BVG_Wellness_Center_Promotion.Areas.Patient.Models.Medicine

@{
    ViewBag.Title = "CounterMedicine";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";

    int count = 1;
    double TotalAmount = 0;
    double TotalDiscount = 0;
}


<style>
    .select2-container--default .select2-selection--single .select2-selection__clear {
        cursor: pointer;
        float: right;
        font-weight: bold;
        height: 38px;
        margin-right: 20px;
        padding-right: 0px;
    }


    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 26px;
        position: absolute;
        top: 7px;
        right: 1px;
        width: 20px;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #979797;
        line-height: 43px;
    }

    .select2-container--default .select2-selection--single {
        background-color: #fff;
        border: 1px solid #d0cece;
        border-radius:;
        margin-bottom: 15px;
    }

    .select2-container .select2-selection--single {
        box-sizing: border-box;
        cursor: pointer;
        display: block;
        height: 43px;
        user-select: none;
        -webkit-user-select: none;
    }
</style>

<style>
    .body {
        background-color: white !important;
    }

    .card {
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    }

    .form-group {
        position: relative;
    }

    hr {
        margin: 0;
        margin-bottom: 10px;
    }

    .form-control {
        border: 1px solid #ccc;
        background: transparent;
        width: 100%;
        color: #000;
        border-radius: 0;
        min-height: 38px;
    }

        .form-control::placeholder {
            color: transparent;
        }

        .form-control:focus {
            outline: none;
            border-color: #007bff;
            background: transparent;
        }

    .form-row .form-title {
        font-weight: 600;
        color: #000;
        margin: 10px;
    }

    .form-check {
        margin: 0 10px;
    }

    .form-check-input {
        margin-left: -1rem;
    }

    .floating-label {
        position: absolute;
        top: 0.5rem;
        left: 0.75rem;
        transition: all 0.2s ease;
        pointer-events: none;
        color: #3f5368;
        font-size: 14px;
        z-index: 2;
        padding: 0 5px;
        background-color: white;
    }

    .form-control:focus ~ .floating-label,
    .form-control:not(:placeholder-shown) ~ .floating-label {
        top: -0.6rem;
        left: 0.65rem;
        font-size: 12px;
        color: #007bff;
        z-index: 2;
        background-color: #fff;
    }

    .card-title {
        font-weight: 600;
        color: #333;
    }

    input::placeholder {
        color: gray !important;
        opacity: 1;
        /* Ensure it's not faded */
    }

    .input-group-supportx {
        height: max-content;
        padding: .375rem .75rem;
        font-size: .875rem;
        line-height: 1.5;
        color: #4F5467;
        text-align: center;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        min-height: 38px;
    }

    .data-box {
        border: 1px solid black;
        padding: 15px 20px;
        border-radius: 10px;
        margin-top: 10px;
    }

    .data-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }

    .data-field {
        display: flex;
        align-items: center;
        border-bottom: 1px solid black;
        padding-bottom: 3px;
        margin-right: 25px;
        font-size: 14px;
        color: #000;
        min-width: 290px;
        margin-bottom: 10px;
    }

    .data-label {
        font-weight: 600;
        margin-right: 5px;
    }

    .small-field {
        min-width: 80px;
    }

    /* Reduce table cell padding */
    #config-table td,
    #config-table th {
        padding: 6px 10px !important;
        vertical-align: middle;
    }

    /* Action icons */
    .action-icons i {
        cursor: pointer;
        margin: 0 5px;
        color: #007bff;
        font-size: 14px;
    }

        .action-icons i.fa-trash {
            color: red;
        }

    .btnBx {
        margin: 10px;
        display: flex;
        justify-content: end;
    }

    .customtab2 li a.nav-link {
        border: 1px solid lightgray;
    }

    .tab-content > .active {
        border: 1px solid lightgrey;
    }

    .customtab2 li a.nav-link.active {
        background-color: #1497dee5;
    }

    .customtab2 li a.nav-link:hover {
        background-color: #1497dee5;
    }

    .section {
        padding: 10px;
        border-radius: 10px;
    }

        .section .section-heading {
            background: #1497dee5;
            padding: 5px;
            margin-bottom: 10px;
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

    .section-heading .card-title {
        color: #fff;
        margin: 0;
        margin-left: 10px;
        /*font-size: 16px;*/
    }

    .section-heading button {
        color: #fff;
        font-size: 20px;
    }

        .section-heading button:hover {
            color: #f5f5f5;
        }

    .autosize-textarea {
        height: 70px !important;
        overflow: hidden !important;
    }


    /* Diagnosis Results Styles */
    .diagnosis-results {
        padding: 15px;
        background-color: #f9f9f9;
        border-radius: 5px;
    }

    .result-item {
        margin-bottom: 10px;
        padding: 8px;
        background-color: white;
        border-left: 4px solid #BE9076;
        border-radius: 3px;
    }

        .result-item h5 {
            color: #BE9076;
            margin-bottom: 15px;
        }

    .result-section {
        margin-bottom: 20px;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }


    .quick-date {
        border-radius: 0px;
        font-size: 10px;
        padding: 4px 8px;
    }

        .quick-date.btn-primary {
            color: #fff !important;
        }


    /*.fixed-card {
        position: fixed;
        top: 100px;
        left: 0;
        right: 0;
        z-index: 999;

        background-color: white;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        padding: 10px 20px;
    }*/

