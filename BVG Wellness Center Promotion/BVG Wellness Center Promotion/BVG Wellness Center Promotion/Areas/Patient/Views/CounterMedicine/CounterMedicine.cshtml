<script>
    // Name Validation (Only Alphabets + 20 char)
    $("#ManualPatientName").on("input", function () {

        var value = $(this).val();

        if (!/^[A-Za-z ]*$/.test(value)) {
            $("#nameError").text("Only alphabets allowed");
            $(this).val(value.replace(/[^A-Za-z ]/g, ""));
        }
        else if (value.length > 20) {
            $("#nameError").text("Maximum 20 characters allowed");
        }
        else if (value.trim() === "") {
            $("#nameError").text("Name is required");
        }
        else {
            $("#nameError").text("");
        }
    });


    // Mobile Validation (Only 10 digits)
    $("#ManualMobileNo").on("input", function () {

        var value = $(this).val();

        $(this).val(value.replace(/[^0-9]/g, ''));

        if (value.length > 10) {
            $("#mobileError").text("Mobile number must be 10 digits");
        }
        else {
            $("#mobileError").text("");
        }
    });


    // Age Validation (1 to 120)
    $("#ManualAge").on("input", function () {

        var age = parseInt($(this).val());

        if (age < 1 || age > 120) {
            $("#ageError").text("Age must be between 1 and 120");
        }
        else {
            $("#ageError").text("");
        }

    });
</script>




<script>
    function validateDiscount(input) {
        // Remove everything except numbers
        input.value = input.value.replace(/[^0-9]/g, '');

        let val = parseInt(input.value);

        if (isNaN(val)) return;

        // Restrict range 0–100
        if (val > 100) input.value = 100;
        if (val < 0) input.value = 0;
    }
    document.querySelectorAll(".only-digits").forEach(function (input) {

        // Typing + Paste control
        input.addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        // Key press block (extra safety)
        input.addEventListener("keypress", function (e) {
            if (e.which < 48 || e.which > 57) {
                e.preventDefault();
            }
        });
    });
</script>



