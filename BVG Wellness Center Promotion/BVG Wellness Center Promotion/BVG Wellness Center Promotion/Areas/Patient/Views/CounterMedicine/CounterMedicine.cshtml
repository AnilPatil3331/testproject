<script>
    $(document).on('click', '.deleteRow', function () {
        debugger;
    var id = $(this).data('id'); // 'data-id' मधून ID घेतला
    var row = $(this).closest('tr'); // टेबलमधील ती ओळ (Row) पकडली

    Swal.fire({
        title: "Are You Sure!",
        text: "Are you sure you want to delete this record?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#f44336",
        cancelButtonColor: "#4caf50",
        confirmButtonText: "Yes, delete it!",
        cancelButtonText: "No, cancel!",
        customClass: { popup: "fullscreen-popup" }
    }).then((result) => {
        if (result.isConfirmed) {
            if (id > 0) {
                $.ajax({
                    url: '@Url.Action("DeleteRow", "CounterMedicine")',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            row.fadeOut(500, function () { $(this).remove(); });
                            Swal.fire({
                                title: "Deleted!",
                                text: res.message || "Record removed successfully.",
                                icon: "success",
                                confirmButtonText: "OK"
                            });
                        } else {
                            Swal.fire({
                                title: "Error!",
                                text: res.message || "Could not delete record.",
                                icon: "error",
                                confirmButtonText: "OK"
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: "Error!",
                            text: "A technical error occurred while deleting.",
                            icon: "error",
                            confirmButtonText: "OK"
                        });
                    }
                });
            } else {
                row.remove();
            }
        }
    });
});
</script>
<script>
    $(document).ready(function () {
        // Prescription section मधील सर्व Dropdowns आणि Inputs वर लक्ष ठेवण्यासाठी
        $('#dropdownContainerCounter').on('mousedown focus change', 'select, input', function (e) {

            // पेशंट सिलेक्ट केला आहे का ते चेक करा
            var patientId = $('#PatientID').val();

            // मॅन्युअल पेशंटची माहिती टाकली आहे का ते चेक करा
            var manualName = $('#ManualPatientName').length ? $('#ManualPatientName').val().trim() : "";
            var manualMobile = $('#ManualMobileNo').length ? $('#ManualMobileNo').val().trim() : "";

            var isPatientSelected = (patientId && patientId !== "0" && patientId !== "");
            var isManualPatientEntered = (manualName !== "" && manualMobile !== "");

            // जर दोन्हीपैकी एकही माहिती नसेल, तर alert द्या आणि फील्ड रिकामे करा
            if (!isPatientSelected && !isManualPatientEntered) {
                Swal.fire({
                    title: "Details Required!",
                    text: "Please Select Or Enter Patient Details First!",
                    icon: "warning",
                    confirmButtonText: "OK"
                });

                // फील्डची व्हॅल्यू रीसेट करा आणि फोकस काढून टाका
                $(this).val('');
                $(this).blur();

                // जर तुम्ही Select2 वापरत असाल तर हे अनकमेंट करा:
                // $(this).trigger('change.select2');

                e.preventDefault();
                return false;
            }
        });
    });
</script>