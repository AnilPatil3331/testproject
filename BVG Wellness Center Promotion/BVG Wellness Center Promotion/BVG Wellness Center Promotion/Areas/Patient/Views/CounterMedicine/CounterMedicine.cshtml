            height:280px;
            overflow:auto;
        }*/
</style>


<div class="page-wrapper">
    <div style="padding: 9px 20px 6px 20px; color:black; margin-top:-80px; display: flex; justify-content: space-between; align-items: center;">
        <h4 style="margin: 0;"></h4>

        <div style="position: relative; width: 315px; margin-right: 40%;">
            <i class="fa fa-search" style="position: absolute; top: 50%; left: 12px; transform: translateY(-50%); color: #aaa;"></i>
            <input type="text" class="form-control" id="searchInput" placeholder="Patient Name / Mobile Number / UHID Number"
                   style="padding:10px;   padding-left: 47px; background-color: white; width: 125%; height: 36px; font-size: 14px; border-radius: 20px;" />

            <div id="searchResult"
                 style="position: absolute; top: 40px; background: white; border: 1px solid #ccc; border-radius: 5px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); z-index: 1000; font-size:small;width: 125%; display: none;">
            </div>

        </div>
    </div>




    <!-- ============================================================== -->
    <!-- Container fluid  -->
    <!-- ============================================================== -->
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <button type="button"
                                id="CloseEncounter"
                                class="btn btn-sm btn-outline-danger d-none">
                            Bill
                        </button>





                        <div class="d-flex justify-content-end">

                            <button class="btn btn-sm btn-primary" id="btnBillList">

                                Bill List
                            </button>

                        </div>


                        <!-- Patient Search Box -->


                        @if (ViewBag.Other != "null" && ViewBag.TodayPatients == null)
                        {
                            <div class="data-box">
                                <div class="data-row">

                                    <!-- Name -->
                                    <div class="data-field">
                                        <span class="data-label">Name:</span>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               name="PatientName"
                                               id="ManualPatientName"
                                               placeholder="Enter Name"
                                               maxlength="20"
                                               required />
                                        <small class="text-danger" id="nameError"></small>
                                    </div>

                                    <!-- Mobile -->
                                    <div class="data-field">
                                        <span class="data-label">Mobile No:</span>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               name="MobileNo"
                                               id="ManualMobileNo"
                                               maxlength="10"
                                               placeholder="Enter Mobile No" />
                                        <small class="text-danger" id="mobileError"></small>
                                    </div>

                                    <!-- Age -->
                                    <div class="data-field small-field">
                                        <span class="data-label">Age:</span>
                                        <input type="number"
                                               class="form-control form-control-sm"
                                               name="Age"
                                               id="ManualAge"
                                               maxlength="3"
                                               placeholder="Age" />
                                        <small class="text-danger" id="ageError"></small>
                                    </div>

                                    <!-- Gender -->
                                    <div class="data-field small-field">
                                        <span class="data-label">Gender:</span>
                                        <select class="form-control form-control-sm"
                                                name="Gender"
                                                id="ManualGender">
                                            <option value="">Select</option>
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>

                                    <!-- Visit Date -->
                                    <div class="data-field">
                                        <span class="data-label">Visit Date:</span>
                                        <input type="date"
                                               class="form-control form-control-sm"
                                               name="VisitDate"
                                               id="ManualVisitDate"
                                               value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                    </div>

                                </div>
                            </div>
                        }
                        else if (ViewBag.TodayPatients != null)
                        {
                            <div class="data-box">
                                <div class="data-row">
                                    <div class="data-field">
                                        <span class="data-label">Name:</span>@ViewBag.TodayPatients.PatientName
                                    </div>
                                    <div class="data-field">
                                        <span class="data-label">Mobile No:</span>@ViewBag.TodayPatients.ContactNumber
                                    </div>
                                    <div class="data-field small-field">
                                        <span class="data-label">Age:</span>@ViewBag.TodayPatients.Age
                                    </div>
                                    <div class="data-field small-field">
                                        <span class="data-label">Gender:</span>@ViewBag.TodayPatients.Gender
                                    </div>
                                </div>
                                <!-- Hidden Patient ID -->
                                <input type="hidden" id="PatientID" value="@ViewBag.PatientFid" />
                            </div>
                        }
                        else
                        {
                            <div class="data-box">
                                <div class="data-row">
                                    <div class="data-field">
                                        <span class="data-label">Name:</span>
                                    </div>
                                    <div class="data-field">
                                        <span class="data-label">Mobile No:</span>
                                    </div>
                                    <div class="data-field small-field">
                                        <span class="data-label">Age:</span>
                                    </div>
                                    <div class="data-field small-field">
                                        <span class="data-label">Gender:</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card mb-0">
                    <div class="card-body p-b-0">
                        <!-- Nav tabs -->
                        <ul class="nav nav-tabs customtab2" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-target="#CounterMedicine" type="button" role="tab" aria-selected="true" data-bs-toggle="tab">
                                    <span class="hidden-sm-up"><i class="ti-user"></i></span>
                                    <span class="hidden-xs-down">Counter Product</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" data-bs-target="#Dispensing" role="tab" aria-selected="true">
                                    <span class="hidden-sm-up"><i class="ti-email"></i></span>
                                    <span class="hidden-xs-down">Dispensing Medicine</span>
                                </a>
                            </li>
                        </ul>

                        <!-- Tab panes -->
                        <div class="tab-content">


                            <div class="tab-pane p-20 active" id="CounterMedicine" role="tabpanel">

                                <div class="section">
                                    <div class="section-heading">
                                        <h4 class="card-title">Medicine prescription</h4>

                                        <button type="button"
                                                class="btn btn-md toggle-btn"
                                                onclick="toggleSection(this)">
                                            +
                                        </button>

                                    </div>

                                    @*<form id="CountermedicineForm" action="/Patient/CounterMedicine/CounterMedicineMaster" method="post" enctype="">*@

                                    <div class="p-1 mt-2">
                                        <div class="section">

                                            <input type="hidden"
                                                   id="OpenBillPopup"
                                                   value="@(TempData["OpenBillPopup"] != null ? "1" : "0")" />
                                            <input type="hidden" id="editingIndexCounter" value="" />
                                            <input type="hidden" name="AppointmentFid" value="@(ViewBag.TodayPatients?.AppointmentFid ?? "")" />
                                            <input type="hidden" name="PatientFid" value="@(ViewBag.TodayPatients?.PatientFid ?? "")" />

                                            <input type="hidden" name="FlageId" value="@(ViewBag.FlagId ?? "")" />
                                            <input type="hidden" id="ManualPatientId" name="ManualPatientId" value="@(ViewBag.ManualPatientId ?? "")" />

                                            @*<input type="hidden" id="PrescriptionID" name="PrescriptionID" />*@
                                            @Html.HiddenFor(m => m.PrescriptionID)
                                            <input type="hidden" id="mixingDataJsonCounter" name="mixingDataJsonCounter" />
                                            <input type="hidden" id="MixingDataFluidCounter" name="MixingDataFluidCounter" />
                                            @*<input type="hidden" id="SelectedPatientFid" name="PatientFid" />
                                                <input type="hidden" id="IsSearchPatient" name="IsSearchPatient" value="false" />*@


                                            <div id="dropdownContainerCounter">
                                                <div class="row dropdownRow">
                                                    <!-- Form -->
                                                    <div class="col-md-4 form-group">
                                                        @Html.DropDownListFor(model => model.FormID,
            new SelectList(ViewBag.Forms, "FormID", "FormName"),
            "Select Form", new { @class = "form-control formId", id = "FormIDCounter" })
                                                        <label class="floating-label">Form</label>
                                                    </div>

                                                    <!-- Package -->
                                                    <div class="col-md-4 form-group">
                                                        @Html.DropDownListFor(model => model.PackageID,
            new SelectList(ViewBag.Packages, "PackageID", "PackageName"),
            "Select Package", new { @class = "form-control packageId", id = "PackageIDCounter" })
                                                        <label class="floating-label">Package</label>
                                                    </div>

                                                    <!-- Number (Left side) -->
                                                    <div class="col-md-3 form-group">
                                                        @Html.DropDownListFor(m => m.NumberLeftID,
                                                                  new SelectList(ViewBag.NumberLeft, "Id", "NumberValue"),
                                                                      "Select Pack Number",
                                                                     new { @class = "form-control numberLeft", id = "NumberLeftIDCounter" })
                                                        <label class="floating-label">Pack Number</label>
                                                    </div>

                                                    <div class="col-md-1 text-center"><strong>=</strong></div>


                                                    <div class="col-md-4 form-group">
                                                        @Html.DropDownListFor(model => model.FormulaID,
            new SelectList(ViewBag.MedicineList, "ID", "Name"),
            "Select Formula", new { @class = "form-control formulaId", id = "formulaIdCounter" })
                                                        <label class="floating-label">Medicine</label>
                                                    </div>



                                                    <!-- Dose Number -->
                                                    <div class="col-md-2 form-group final-section">
                                                        @Html.DropDownListFor(m => m.DoseNumberID,
        new SelectList(ViewBag.DoseNumbers, "Id", "NumberValue"),
        "Select Dose Number",
        new { @class = "form-control doseNumber", id = "DoseNumberIDCounter" })
                                                        <label class="floating-label">Dose Number</label>
                                                    </div>

                                                    <!-- Final Section (Dose=Quantity, Time, FluidVehicle) -->
                                                    <div class="col-md-2 form-group final-section">
                                                        @Html.DropDownListFor(model => model.QuantityIDDose,
            new SelectList(ViewBag.Quantities, "QuantityID", "QuantityName"),
            "Dose", new { @class = "form-control doseId", id = "QuantityIDDoseCounter" })
                                                        <label class="floating-label">Dose</label>
                                                    </div>

                                                    <div class="col-md-3 form-group final-section">
                                                        @Html.DropDownListFor(model => model.TimeID,
            new SelectList(ViewBag.Time, "TimeID", "TimeName"),
            "Select Time", new { @class = "form-control timeId", id = "TimeIDCounter" })
                                                        <label class="floating-label">Time</label>
                                                    </div>


                                                    <!-- Fluid Number -->
                                                    <div class="col-md-4 form-group final-section">
                                                        @Html.DropDownListFor(m => m.FluidNumberID,
        new SelectList(ViewBag.FluidNumbers, "Id", "NumberValue"),
        "Select Fluid Number",
        new { @class = "form-control doseNumber", id = "FluidNumberIDCounter" })
                                                        <label class="floating-label">Fluid Number</label>
                                                    </div>


                                                    <!-- Final Section (FluidVehicle) -->
                                                    <div class="col-md-4 form-group final-section">
                                                        @Html.DropDownListFor(model => model.FluidQuantityID,
            new SelectList(ViewBag.FluidQuantities, "QuantityID", "QuantityName"),
            "Quantity", new { @class = "form-control doseId", id = "FluidQuantityIDCounter" })
                                                        <label class="floating-label">Fluid Quantity</label>
                                                    </div>


                                                    <div class="col-md-3 form-group final-section">
                                                        @Html.DropDownListFor(model => model.FluidVehicleID,
            new SelectList(ViewBag.FluidVehicle, "VehicleID", "VehicleName"),
            "Select Vehicle", new { @class = "form-control fluidId", id = "FluidVehicleIDCounter" })
                                                        <label class="floating-label">Fluid Vehicle</label>
                                                    </div>


                                                    <div class="col-md-1">
                                                        <button type="button" class="btn btn-primary addFluidMixingCounter">+</button>
                                                    </div>

                                                    <div class="fluidMixSectionCounter col-md-12"></div>


                                                    <div class="col-md-4 form-group">
                                                        @Html.DropDownListFor(m => m.DaysNumber, new SelectList(ViewBag.DaysNumber, "Id", "NumberValue"), "Select Days Number", new { @class = "form-control doseNumber", id = "DaysNumberCounter" })
                                                        <label class="floating-label">Consuming Days </label>
                                                    </div>



                                                    <!-- Buttons -->
                                                    <div class="col-md-2 ">
                                                        <button type="button" class="btn btn-success addPrescriptionCounter">Add</button>
                                                    </div>
                                                </div>
                                            </div>

                                            <input type="hidden" id="prescriptionJsonCounter" name="prescriptionJsonCounter" />
                                           


                                            <hr />

                                            <div style="width:100%; overflow:auto;">
                                                <table class="table table-bordered" id="prescriptionTableCounter">
                                                    <thead>
                                                        <tr>
                                                            <th>Instruction</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (ViewBag.CounterMedicineList != null)
                                                        {
                                                            foreach (var item in ViewBag.CounterMedicineList)
                                                            {
                                                                <tr>



                                                                    <td class="text-wrap">
                                                                        @($"{item.FormName} {item.PackageName} {item.NumberLeft} {item.FormulaName} = " +
                                                                                $" {item.DoseNumber} {item.Dose} {item.TimeName} ={item.MixingDetailsFluid}" +
                                                                                $"( {item.DaysNumber} Days )" )
                                                                    </td>



                                                                    <td><i class="fa fa-trash text-danger deleteRow" data-id="@item.PrescriptionID"></i></td>
                                                                </tr>
                                                            }
                                                        }




                                                    </tbody>
                                                </table>

                                            </div>

                                        </div>
                                    </div>


                                    <div class="btnBx">
                                        @*<button type="submit" class="btn btn-md btn-success mr-1">Submit</button>*@

                                        <button type="button"
                                                id="btnSubmitCounter"
                                                class="btn btn-md btn-success">
                                            Submit
                                        </button>

                                        @*<button type="reset" class="btn btn-md btn-primary ml-1">Reset</button>
                                            <button type="button" class="btn btn-md btn-primary ml-1" onclick="window.location.href='@Url.Action("AUList", "reception")'">List</button>*@

                                    </div>
                                    @*</form>*@

                                </div>


                            </div>



                            <div class="tab-pane p-20" id="Dispensing" role="tabpanel">

                                <h3 style="margin-left:200PX; margin-top:50PX;">
                                    This section is under development and will be available soon.
                                    Thank you !!
                                </h3>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ============================================================== -->
    <!-- End Container fluid  -->
    <!-- ============================================================== -->
</div>



<div id="bill-modal___BV_modal_outer_" style="position: absolute; z-index: 1040; display: none;">
    <div id="bill-modal" role="dialog" aria-describedby="bill-modal___BV_modal_body_"
         class="modal fade show" aria-modal="true" style="display: block; padding-left: 4px;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <span tabindex="0">
            </span>
            <div id="bill-modal___BV_modal_content_" tabindex="-1" class="modal-content">
                <header id="bill-modal___BV_modal_header_" class="modal-header">
                    <h2 class="text-primary w-100 text-center">
                        Generate invoice
                    </h2>
                    <button type="button" aria-label="Close" class="close" id="Closemodel">
                        ×
                    </button>
                </header>
                <div id="bill-modal___BV_modal_body_" class="modal-body pt-0" style="height:80vh;overflow:auto;">
                    <form id="patientBillDataForm" novalidate="novalidate">
                        <div class="row">
                            <div class="col-12 mb-3">
                                <button type="button" class="btn btn-sm btn-primary float-right" id="addBill">
                                    <i class="fa fa-plus">
                                    </i>
                                    Add Bill Item
                                </button>
                            </div>
                        </div>
                        <div id="bill-item-add" style="display: none;">
                            <div class="row">


                                <input type="hidden" id="PatientID" name="PatientID" value="@(ViewBag.PatientFid != null ? ViewBag.PatientFid : 0)" />
                                <input type="hidden" id="FlagId" name="FlagId" value="@(ViewBag.FlagId  != null ?   ViewBag.FlagId  : 0)" />
                                <input type="hidden" id="FlageId" />



                                @Html.HiddenFor(m => m.Bill_Fid, new { id = "txtBill_Fid" })
                                @Html.HiddenFor(m => m.Bill_Fid_Encrapted, new { id = "txtBill_Fid_Encrapted" })
                                <input hidden name="Service_Fid" id="Service_Fid" />
                                <div class="col-md-4">
                                    <div class="form-group w-100">
                                        <!-- Added w-100 for full width -->
                                        <label for="ddlServiceName" class="form-control-label" id="MedicineName">
                                            Medicine
                                            <span class="text-danger">*</span>
                                        </label>

                                        @Html.DropDownListFor(m => m.ServiceFid, new SelectList(ViewBag.MedicineList, "ID", "Name"), "Select", new { @class = "form-control select2", @id = "ddlServiceName", @style = "width: 100%;" })

                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="price" class="form-control-label">
                                            Price
                                            <span class="text-danger">
                                                *
