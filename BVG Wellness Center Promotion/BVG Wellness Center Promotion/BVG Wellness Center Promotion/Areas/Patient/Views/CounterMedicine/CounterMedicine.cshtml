<script>
    $(document).ready(function () {
        $('#searchInput').on('input', function () {
            var query = $(this).val().trim();

            if (query.length >= 1) {
                $.ajax({
                    url: '@Url.Action("SearchOPD")',
                    type: 'GET',
                    data: { searchTerm: query },
                    success: function (data) {
                        debugger;
                        let html = "";
                        if (data.length > 0) {
                            html += "<ul class='list-group mb-0'>";

                            $.each(data, function (i, item) {
                                html += "<li class='list-group-item list-group-item-action' " + "style='cursor:pointer;' onclick='selectPatient(" + item.PatientFid + ")'>";

                                html += "<span>" + item.FullName + " | " + item.ContactNumber + " | " + item.UHIDNO + "</span>";

                                html += "</li>";

                            });

                            html += "</ul>";
                        } else {
                            //html = "<div class='p-2 text-muted'>No matches found</div>";

                            html = `
                                <div class='p-2 text-muted'
                                     style='cursor:pointer;'
                                     onclick="selectOtherPatient()">
                                     No matches found (Click to add Other)
                                </div>`;

                        }

                        $('#searchResult').html(html).show();
                    },
                    error: function () {
                        $('#searchResult').html('<div class="p-2 text-danger">Error fetching data</div>').show();
                    }
                });
            } else {
                $('#searchResult').hide();
            }
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#searchInput, #searchResult').length) {
                $('#searchResult').hide();
            }
        });
    });

