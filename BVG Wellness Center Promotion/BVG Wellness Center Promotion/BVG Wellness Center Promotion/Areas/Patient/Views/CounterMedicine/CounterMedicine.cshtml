   function DeleteBill(Bill_Fid_Encrapted, FlagId) {
    Swal.fire({
        title: 'Are You Sure!',
        text: "Are you sure you want to delete this record?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#f44336',
        cancelButtonColor: '#4caf50',
        confirmButtonText: 'Yes, go ahead!',
        cancelButtonText: 'No, cancel!',
        customClass: {
            popup: 'fullscreen-popup',
        },
    }).then((result) => {
        if (result.isConfirmed) {
            $.ajax({
                type: 'GET',
                dataType: 'JSON',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("DeleteBill")',
                data: { Bill_Fid_Encrapted: Bill_Fid_Encrapted, FlagId: FlagId },
                success: function (data) {
                    debugger;
                    if (data && data.GenerateBill) {
                        // 1. CLEAR the existing table body first
                        $("#prescriptionTableCounter tbody").empty(); 

                        // 2. FORCE the table and container to be visible
                        // Sometimes CSS 'display: none' gets stuck
                        $("#prescriptionTableCounter").show();
                        $("#prescriptionTableCounter").parents().show(); 

                        // 3. Re-bind the table
                        // Ensure you are passing the fresh list from the controller
                        GenereteBillTable(data.GenerateBill); 
        
                        Swal.fire('Deleted!', 'Record removed successfully.', 'success');
                    } else {
                        // Handle empty list case
                        $("#prescriptionTableCounter tbody").html('<tr><td colspan="10" class="text-center">No Records Found</td></tr>');
                    }
                },
                error: function() {
                    Swal.fire('Error!', 'Something went wrong while deleting.', 'error');
                }
            })
        }
    });
}
</script>

