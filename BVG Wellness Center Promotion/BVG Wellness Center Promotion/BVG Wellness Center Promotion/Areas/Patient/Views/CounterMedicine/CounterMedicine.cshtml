<script>

    function loadData() {
        let existing = $("#prescriptionJsonCounter").val();

        if (existing && existing !== "") {
            try {
                prescriptionsCounter = JSON.parse(existing);
            } catch {
                prescriptionsCounter = [];
            }
        }
    }

    function resetForm() {

        $("#FormIDCounter").val("");
        $("#PackageIDCounter").val("");
        $("#NumberLeftIDCounter").val("");
        $("#formulaIdCounter").val("");
        $("#DoseNumberIDCounter").val("");
        $("#QuantityIDDoseCounter").val("");
        $("#TimeIDCounter").val("");
        $("#DaysNumberCounter").val("");
        $("#FluidNumberIDCounter").val("");
        $("#FluidQuantityIDCounter").val("");  $("#FluidVehicleIDCounter").val("");
  
        $(".fluidMixRowCounter").remove();

        $("#editingIndexCounter").val("");

        $(".addPrescriptionCounter")
            .text("Add")
            .removeClass("btn-warning")
            .addClass("btn-success");
    }
    var prescriptionsCounter = [];

    // 🔥 LOAD FROM HIDDEN (IMPORTANT)
  
    $(document).ready(function () {
      
       
    debugger
   // let prescriptionsCounter = [];

    /* ===============================
       ➕ ADD FLUID MIX ROW
    =============================== */
    $(document).on("click", ".addFluidMixingCounter", function () {
        debugger
        if ($("#FluidNumberIDCounter").prop("disabled")) return;

        let row = `
        <div class="fluidMixRowCounter row col-md-12 mt-1">
            <div class="col-md-4 form-group">
                <select class="form-control fluidNumberCounter">
                    ${$("#FluidNumberIDCounter").html()}
                </select>
            </div>
            <div class="col-md-4 form-group">
                <select class="form-control fluidQuantityCounter">
                    ${$("#FluidQuantityIDCounter").html()}
                </select>
            </div>
            <div class="col-md-3 form-group">
                <select class="form-control fluidVehicleCounter">
                    ${$("#FluidVehicleIDCounter").html()}
                </select>
            </div>
            <div class="col-md-1 mt-2">
                <button type="button" class="btn btn-sm btn-danger removeFluidMixCounter">x</button>
            </div>
        </div>`;
        $(".fluidMixSectionCounter").append(row);
    });

    /* ===============================
       ❌ REMOVE FLUID MIX
    =============================== */
    $(document).on("click", ".removeFluidMixCounter", function () {
        debugger
        $(this).closest(".fluidMixRowCounter").remove();
    });

    /* ===============================
       ➕ ADD PRESCRIPTION
    =============================== */
    $(document).on("click", ".addPrescriptionCounter", function () {
        debugger;
        let editIndex = $("#editingIndexCounter").val();

        if (!$("#FormIDCounter").val() ||
            !$("#PackageIDCounter").val() ||
            !$("#NumberLeftIDCounter").val() ||
            !$("#formulaIdCounter").val()) {
            alert("⚠ Please select Form, Package and Pack Number");
            return;
        }

        let instruction =
            $("#FormIDCounter option:selected").text() + " " +
            $("#PackageIDCounter option:selected").text() + " " +
            $("#NumberLeftIDCounter option:selected").text() + " " +
            $("#formulaIdCounter option:selected").text() + " = " ;





        /* 🔹 DOSE */
        if ($("#DoseNumberIDCounter").val() &&
            $("#QuantityIDDoseCounter").val() &&
            $("#TimeIDCounter").val()) {

            instruction +=
                $("#DoseNumberIDCounter option:selected").text() + " " +
                $("#QuantityIDDoseCounter option:selected").text() + " " +
                $("#TimeIDCounter option:selected").text();
        }

        /* 🔹 FLUID MIXING */
        let fluidMixing = [];
        debugger
        if ($("#FluidNumberIDCounter").val() &&
            $("#FluidQuantityIDCounter").val() &&
            $("#FluidVehicleIDCounter").val()) {

            fluidMixing.push({
                FluidNumberID: $("#FluidNumberIDCounter").val(),
                FluidQuantityID: $("#FluidQuantityIDCounter").val(),
                FluidVehicleID: $("#FluidVehicleIDCounter").val()
            });

            instruction += " + " +
                $("#FluidNumberIDCounter option:selected").text() + " " +
                $("#FluidQuantityIDCounter option:selected").text() + " " +
                $("#FluidVehicleIDCounter option:selected").text();
        }

        $(".fluidMixRowCounter").each(function () {
            debugger
            let fn = $(this).find(".fluidNumberCounter").val();
            let fq = $(this).find(".fluidQuantityCounter").val();
            let fv = $(this).find(".fluidVehicleCounter").val();

            if (fn && fq && fv) {
                fluidMixing.push({
                    FluidNumberID: fn,
                    FluidQuantityID: fq,
                    FluidVehicleID: fv
                });

                instruction += " + " +
                    $(this).find(".fluidNumberCounter option:selected").text() + " " +
                    $(this).find(".fluidQuantityCounter option:selected").text() + " " +
                    $(this).find(".fluidVehicleCounter option:selected").text();
            }
        });

        /* 🔹 DAYS */
        if ($("#DaysNumberCounter").val()) {
            instruction += " (" +
                $("#DaysNumberCounter option:selected").text() +
                " Days)";
        }
        /* =========================
      🔥 EDIT MODE
   ========================= */
        if (editIndex !== null && editIndex !== undefined && editIndex !== "") {
            debugger
            // UPDATE ARRAY
            prescriptionsCounter[editIndex] = {
                FormID: $("#FormIDCounter").val(),
                PackageID: $("#PackageIDCounter").val(),
                NumberLeftID: $("#NumberLeftIDCounter").val(),
                FormulaID: $("#formulaIdCounter").val(),
                DoseNumberID: $("#DoseNumberIDCounter").val(),
                QuantityIDDose: $("#QuantityIDDoseCounter").val(),
                TimeID: $("#TimeIDCounter").val(),
                DaysNumber: $("#DaysNumberCounter").val(),
                MixingDataFluid: fluidMixing.length ? JSON.stringify(fluidMixing) : null,
                DisplayText: instruction
            };

            // reset edit mode
            $("#editingIndexCounter").val("");
            // ✅ IMPORTANT
            $("#prescriptionJsonCounter").val(JSON.stringify(prescriptionsCounter));

            // ✅ FULL TABLE REBUILD (NO APPEND)
       
            rebuildTableCounter(); 
            resetForm(); 
            console.log(prescriptionsCounter);
            $(".addPrescriptionCounter").text("Add").removeClass("btn-warning").addClass("btn-success");
            return;
        }
        else {
            /* 🔹 PUSH OBJECT */
            prescriptionsCounter.push({
                FormID: $("#FormIDCounter").val(),
                PackageID: $("#PackageIDCounter").val(),
                NumberLeftID: $("#NumberLeftIDCounter").val(),
                FormulaID : $("#formulaIdCounter").val(),
                DoseNumberID: $("#DoseNumberIDCounter").val(),
                QuantityIDDose: $("#QuantityIDDoseCounter").val(),
                TimeID: $("#TimeIDCounter").val(),
                DaysNumber: $("#DaysNumberCounter").val(),
                MixingDataFluid: fluidMixing.length ? JSON.stringify(fluidMixing) : null,
                DisplayText: instruction
            });
        }

        $("#prescriptionJsonCounter").val(JSON.stringify(prescriptionsCounter));
        //rebuildTableCounter();
        $("#prescriptionTableCounter tbody").append(`
            <tr class="js-new-row" data-index="${prescriptionsCounter.length - 1}">
                <td>${instruction}</td>
                <td>
                   <i class="fa fa-edit text-primary editRowCounter" style="cursor:pointer; margin-right:5px;"></i>
                   <i class="fa fa-trash text-danger deleteRowCounter" style="cursor:pointer;"></i></td>
            </tr>
        `);
        resetForm(); 
        console.log(prescriptionsCounter);
        /* 🔄 RESET FLUID ONLY */
        $(".fluidMixRowCounter").remove();
        $("#FluidNumberIDCounter,#FluidQuantityIDCounter,#FluidVehicleIDCounter").val("");
    });
    function rebuildTableCounter() {

        let tbody = $("#prescriptionTableCounter tbody");
        //tbody.empty();
        tbody.find(".js-new-row").remove();
        prescriptionsCounter.forEach((item, index) => {

            tbody.append(`
            <tr class="js-new-row" data-index="${index}">
                <td>${item.DisplayText}</td>
                <td>
<i class="fa fa-edit text-primary editRowCounter" style="cursor:pointer; margin-right:5px;"></i>
                <i class="fa fa-trash text-danger deleteRowCounter" style="cursor:pointer;"></i>
                </td>
            </tr>
        `);
        });
    }
    $(document).on("click", ".editRowCounter", function () {
        debugger
        loadData();
        let row = $(this).closest("tr");
        let index = row.data("index");

        let data = prescriptionsCounter[index];

        let fluids = [];

        if (data.MixingDataFluid) {
            try {
                fluids = JSON.parse(data.MixingDataFluid);
            } catch (e) {
                fluids = [];
            }
        }

        // store editing index
        $("#editingIndexCounter").val(index);

        // fill form again
        $("#FormIDCounter").val(data.FormID);
        $("#PackageIDCounter").val(data.PackageID);
        $("#NumberLeftIDCounter").val(data.NumberLeftID);
        $("#formulaIdCounter").val(data.FormulaID);

        $("#DoseNumberIDCounter").val(data.DoseNumberID);
        $("#QuantityIDDoseCounter").val(data.QuantityIDDose);
        $("#TimeIDCounter").val(data.TimeID);
        $("#DaysNumberCounter").val(data.DaysNumber);
        /* ===============================
     🔥 FLUID UI FILL (IMPORTANT)
  =============================== */
        // --- FLUID FIX START ---
       
        $(".fluidMixRowCounter").remove(); // clear old rows

        if (fluids.length > 0) {
            // Pahila data main boxes madhe bhara
            $("#FluidNumberIDCounter").val(fluids[0].FluidNumberID);
            $("#FluidQuantityIDCounter").val(fluids[0].FluidQuantityID);
            $("#FluidVehicleIDCounter").val(fluids[0].FluidVehicleID);

            // Rahilele (index 1 pasun) navin rows madhe add kara
            for (let i = 1; i < fluids.length; i++) {
                let f = fluids[i];
                let rowHtml = `
                <div class="fluidMixRowCounter row col-md-12 mt-1">
                    <div class="col-md-4 form-group">
                        <select class="form-control fluidNumberCounter">${$("#FluidNumberIDCounter").html()}</select>
                    </div>
                    <div class="col-md-4 form-group">
                        <select class="form-control fluidQuantityCounter">${$("#FluidQuantityIDCounter").html()}</select>
                    </div>
                    <div class="col-md-3 form-group">
                        <select class="form-control fluidVehicleCounter">${$("#FluidVehicleIDCounter").html()}</select>
                    </div>
                    <div class="col-md-1 mt-2">
                        <button type="button" class="btn btn-sm btn-danger removeFluidMixCounter">x</button>
                    </div>
                </div>`;
                $(".fluidMixSectionCounter").append(rowHtml);
                let lastRow = $(".fluidMixRowCounter").last();
                lastRow.find(".fluidNumberCounter").val(f.FluidNumberID);
                lastRow.find(".fluidQuantityCounter").val(f.FluidQuantityID);
                lastRow.find(".fluidVehicleCounter").val(f.FluidVehicleID);
            }
        }
        // --- FLUID FIX END ---

        // change button to Update mode
        $(".addPrescriptionCounter")
            .text("Update")
            .removeClass("btn-success")
            .addClass("btn-warning");
    });
    /* ===============================
       🗑 DELETE ROW
    =============================== */
    $(document).on("click", ".deleteRowCounter", function () {

        let row = $(this).closest("tr");
        let index = row.data("index");
        console.log("Deleting index:", index);
        prescriptionsCounter.splice(index, 1);
        // ✅ Remove from array
        if (index !== undefined) {
            prescriptionsCounter.splice(index, 1);
        }
        $("#prescriptionTableCounter tbody tr").each(function (i) {
            $(this).attr("data-index", i);
        });

        $("#prescriptionJsonCounter").val(JSON.stringify(prescriptionsCounter));
        //rebuildTableCounter();
        row.remove();
    });

});
</script>

@*table script End*@

