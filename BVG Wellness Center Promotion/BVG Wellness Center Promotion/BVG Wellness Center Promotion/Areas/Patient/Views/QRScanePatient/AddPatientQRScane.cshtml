<script>
    $(document).ready(function () {
        debugger;
        const loader = document.getElementById('loader');
        loader.classList.add('hidden');


     
        var SuccessMessage=@Html.Raw(Json.Encode(TempData["Message"]));
        var Icon=@Html.Raw(Json.Encode(TempData["Icon"]));

        if(SuccessMessage!=null)
        {
            Swal.fire({
                title: '',
                text: SuccessMessage,
                icon: Icon, // 'success', 'error', 'warning', 'info', or 'question'
                confirmButtonColor: '#4caf50', // Green color for "OK" button
                confirmButtonText: 'OK', // Single button text
                customClass: {
                    popup: 'fullscreen-popup',
                }
            });
        }

        $("#btnCancel").click(function () {
            debugger;
            var Url = '@Url.Action("AddPatientQRScane", "QRScanePatient")';
            window.location.href = Url;

        });

      

        $("#contact").on("input", function (event) {
            var GetContactCount = $(this).val(); // Get the input value
            if (GetContactCount.length === 10) { // Check length instead of value              
                debugger;
                $.ajax({
                    type: 'GET',
                    dataType: 'JSON',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("PatientExist", "QRScanePatient")',
                    data: { PatientContact: GetContactCount},
                    success: function (data) {
                        debugger;
                        var Message=data.Message;
                        var Icon=data.Icon;
                        var Number=data.PatientNumber;
                        if(Message!=null)
                        {
                            Swal.fire({
                                title: '',
                                text: Message,
                                icon: Icon, // 'success', 'error', 'warning', 'info', or 'question'
                                confirmButtonColor: '#4caf50', // Green color for "OK" button
                                confirmButtonText: 'OK', // Single button text
                                allowOutsideClick: false, // Prevent closing when clicking outside
                                allowEscapeKey: false, // Prevent closing when pressing the Escape key
                                customClass: {
                                    popup: 'fullscreen-popup',
                                }
                            }); 
                            $("#contact").val("");
                        }                       
                    }
                })
            }
        });
      
        @*$("#contact").keydown(function ()
        {

            var GetContactCount=document.getElementById("contact").value;
            if (GetContactCount === 10)
            {
                event.preventDefault();

                var Url = '@Url.Action("AddPatientQRScane", "QRScanePatient")' + '?PatientContact=' + PatientContact;
                window.location.href = Url;
            }
        })*@

    });//Ready

    function InputToUpper(obj)
    {
        if (obj.value!="")
        {
            var start = obj.selectionStart;
            var end = obj.selectionEnd;
            obj.value = obj.value.toUpperCase();
            obj.setSelectionRange(start, end);
        }
    }


    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById('QRScanepatientDataForm').addEventListener('submit', function (event) {
            event.preventDefault(); // Prevent form submission initially
            debugger;

            var form = this;
            var isValid = true;
            var formError = document.getElementById('formError');

            if (formError) {
                formError.style.display = 'none';
            }

            // Validate fields using HTML5 validity API
            form.querySelectorAll('[required]').forEach(function (input) {
                if (!input.checkValidity()) {
                    isValid = false;
                    input.classList.add('is-invalid');
                } else {
                    input.classList.remove('is-invalid');
                }
            });

            if (!isValid) {
                Swal.fire({
                    title: 'Error',
                    text: 'Please fill out all required fields.',
                    icon: 'error',
                    confirmButtonColor: '#4caf50',
                    confirmButtonText: 'OK',
                    customClass: {
                        popup: 'fullscreen-popup',
                    }
                });
            } else {
                // If Parsley.js is used, validate using Parsley before submission
                if ($(form).parsley) {
                    if (!$(form).parsley().validate()) {
                        return;
                    }
                }

                // Show loader and submit the form
                const loader = document.getElementById('loader');
                if (loader) {
                    loader.classList.remove('hidden');
                }

                form.submit(); // Manually submit if valid
            }
        });

        // Handle dismiss error click event
        $("#dismissError").click(function () {
            var formError = document.getElementById('formError');
            if (formError) {
                formError.style.display = 'none';
            }
        });
    });

</script>
