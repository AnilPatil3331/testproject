    <script>
    $(document).on("change", "select[name*='PreviousTreatment']", function () {

        let name = $(this).attr("name");
        let otherName = name.replace("PreviousTreatment", "PreviousTreatmentOther");

        let input = $("input[name='" + otherName + "']");

        if ($(this).find("option:selected").text().trim().toLowerCase() === "other") {
            input.prop("disabled", false);   // 🔥 main fix
            input.removeAttr("readonly");
        } else {
            input.val("");
            input.prop("disabled", true);    // 🔥 back disable
            input.attr("readonly", true);
        }
    });
    </script>
