    var advisedTherapyList = [];

    $("#AddTherapy").click(function () {

        var serviceId = $("#ATserviceFid").val();
        var serviceText = $("#ATserviceFid option:selected").text();
        var duration = $("#Duration option:selected").text();
        var durationUnit = $("#DurationUnit").val();
        var repetition = $("#ATDaysNumber option:selected").text();
        var repetitionUnit = $("#RepetitionUnit").val();

        if (!serviceId || serviceText === "Select Service") {
            alert("Please select Service");
            return;
        }

        var obj = {
            ServiceFid: serviceId,
            ServiceName: serviceText,
            Duration: duration,
            DurationUnit: durationUnit,
            Repetition: repetition,
            RepetitionUnit: repetitionUnit
        };

        advisedTherapyList.push(obj);

        renderTable();

        $("#AdvisedTherapyJson").val(JSON.stringify(advisedTherapyList));

        clearFields();
    });


    function renderTable() {

        var tbody = $("#AdvisedTherapyTable tbody");
        tbody.empty();

        $.each(advisedTherapyList, function (index, item) {

            var row = "<tr>" +
                "<td>" + item.ServiceName + "</td>" +
                "<td>" + item.Duration + " " + item.DurationUnit + "</td>" +
                "<td>" + item.Repetition + " " + item.RepetitionUnit + "</td>" +
                "<td><button type='button' class='btn btn-danger btn-sm' onclick='removeRow(" + index + ")'>Remove</button></td>" +
                "</tr>";

            tbody.append(row);
        });
    }

    function removeRow(index) {
        advisedTherapyList.splice(index, 1);
        renderTable();
        $("#AdvisedTherapyJson").val(JSON.stringify(advisedTherapyList));
    }

    function clearFields() {
        $("#ATserviceFid").val("");
        $("#Duration").val("");
        $("#DurationUnit").val("");
        $("#ATDaysNumber").val("");
        $("#RepetitionUnit").val("");
    }

</script>

