    <script>
function calculateBMI() {
    var hVal = $("#Height").val();
    var wVal = $("#Weight").val();
    var bmiField = $("#BMI");
    var categoryField = $("#BMICategory");

    if (hVal !== "" && wVal !== "") {

        var height = parseFloat(hVal);
        var weight = parseFloat(wVal);

        if (height >= 30 && height <= 250 && weight > 0&& weight > 1 && weight <= 300) {

            var bmi = weight / ((height / 100) * (height / 100));
            var finalBmi = bmi.toFixed(2);

            bmiField.val(finalBmi);

            // BMI Category Logic
            if (finalBmi < 18.5) {
                categoryField.text("Underweight").css("color", "blue");
            }
            else if (finalBmi >= 18.5 && finalBmi <= 24.9) {
                categoryField.text("Healthy Weight").css("color", "green");
            }
            else if (finalBmi >= 25.0 && finalBmi <= 29.9) {
                categoryField.text("Overweight").css("color", "orange");
            }
            else {
                categoryField.text("Obese").css("color", "red");
            }

        } else {
            bmiField.val("");
            categoryField.text("");
        }

    } else {
        bmiField.val("");
        categoryField.text("");
    }
}


// Height किंवा Weight change झाल्यावर auto calculate
$(document).on("input", "#Height, #Weight", function () {
    calculateBMI();
});


// Height Validation
$("#Height").on("input", function () {

    this.value = this.value.replace(/[^0-9]/g, '');

    if (this.value.length > 3) {
        this.value = this.value.slice(0, 3);
    }

    calculateBMI();
});

$("#Height").on("blur", function () {

    var val = parseInt(this.value);

    if (val && val < 30) {
        alert("Height should be minimum 30 cm");
        this.value = "";
        calculateBMI();
    }

});


// Weight Validation
$("#Weight").on("input", function () {

    this.value = this.value.replace(/[^0-9.]/g, '');

    if ((this.value.match(/\./g) || []).length > 1) {
        this.value = this.value.slice(0, -1);
    }

    if (this.value.length > 6) {
        this.value = this.value.slice(0, 6);
    }

    calculateBMI();
});


// Page refresh / Update नंतर category परत show होईल
$(document).ready(function () {
    calculateBMI();
});

    </script>

