@using BVG_Wellness_Center_Promotion.Areas.IPD.Models
@model List<IPD_WardModel>
@{
    ViewBag.Title = "Ward Master";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap4.min.css">
<style>
    .master-header {
        background: linear-gradient(135deg, #6a1b9a, #9c27b0);
        color: white;
        padding: 16px 22px;
        border-radius: 12px;
        margin-bottom: 20px;
        position: relative;
        z-index: 10;
    }
    .add-btn {
        background: #27ae60;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }
    .add-btn:hover { background: #219a52; }
    .table-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        overflow: hidden;
        position: relative;
        z-index: 10;
    }
    .badge-on {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .badge-off {
        background: #fce4ec;
        color: #c62828;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .btn-edit {
        background: #e3f2fd;
        color: #1565c0;
        border: none;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 0.82rem;
        cursor: pointer;
    }
    .btn-del {
        background: #fce4ec;
        color: #c62828;
        border: none;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 0.82rem;
        cursor: pointer;
    }
    .ward-type-badge {
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .type-general { background: #e3f2fd; color: #1565c0; }
    .type-icu { background: #fce4ec; color: #b71c1c; }
    .type-nicu { background: #f3e5f5; color: #6a1b9a; }
    .type-maternity { background: #fce4ec; color: #880e4f; }
    .type-paediatric { background: #e8f5e9; color: #1b5e20; }
    .modal-hdr {
        background: linear-gradient(135deg, #6a1b9a, #9c27b0);
        color: white;
        border-radius: 8px 8px 0 0;
    }
    .tbl-ipd th { font-size:0.74rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.3px; border-top:none; background:#f8fafc; padding:7px 10px; }
    .tbl-ipd td { font-size:0.82rem; padding:7px 10px; vertical-align:middle; border-color:#f1f5f9; }
</style>

@Html.Partial("~/Areas/IPD/Views/Shared/_IPDNav.cshtml")

<div class="container-fluid mt-2">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
            <h6 class="mb-0 text-uppercase text-muted fw-bold" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                <i class="fas fa-hospital me-1"></i> Ward Master
            </h6>
        </div>
        <div class="card-body">
            <input type="hidden" id="WardId" value="0">
            <div class="row g-2 align-items-end">
                @if (ViewBag.Settings != null && ViewBag.Settings.EnableHierarchicalMapping)
                {
                    <div class="col-md-2">
                        <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Floor <span class="text-danger">*</span></label>
                        <select id="FloorId" class="form-select form-select-sm">
                            <option value="">-- Select Floor --</option>
                            @if (ViewBag.Floors != null)
                            {
                                foreach (var f in ViewBag.Floors)
                                {
                                    <option value="@f.FloorId">@f.FloorName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Ward Name <span class="text-danger">*</span></label>
                        <input type="text" id="WardName" class="form-control form-control-sm" placeholder="e.g. Male Ward">
                    </div>
                }
                else
                {
                    <div class="col-md-3">
                        <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Ward Name <span class="text-danger">*</span></label>
                        <input type="text" id="WardName" class="form-control form-control-sm" placeholder="e.g. Male Ward, Female Ward">
                    </div>
                }
                <div class="col-md-3">
                    <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Ward Type</label>
                    <select id="WardType" class="form-select form-select-sm">
                        <option value="General">General</option>
                        <option value="ICU">ICU</option>
                        <option value="NICU">NICU</option>
                        <option value="Maternity">Maternity</option>
                        <option value="Paediatric">Paediatric</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="form-check form-switch mt-1">
                        <input class="form-check-input" type="checkbox" id="IsActive" checked>
                        <label class="form-check-label fw-semibold text-muted" style="font-size: 0.75rem;" for="IsActive">Active</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary btn-sm px-4" id="btnSave" onclick="saveWard()"><i class="fas fa-plus me-1"></i> Add Ward</button>
                    <button class="btn btn-light btn-sm px-3 ms-2 d-none" id="btnCancel" onclick="resetForm()">Cancel</button>
                </div>
            </div>
        </div>

        <div class="table-responsive border-top">
            <table id="tblWard" class="table tbl-ipd mb-0">
                <thead>
                    <tr>
                        <th>Sr No.</th>
                        @if (ViewBag.Settings != null && ViewBag.Settings.EnableHierarchicalMapping)
                        {
                            <th>Floor</th>
                        }
                        <th>Ward Name</th>
                        <th>Ward Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int index = 1; }
                    @foreach (var w in Model)
                    {
                        string typeClass = w.WardType == "ICU" ? "type-icu" :
                                           w.WardType == "NICU" ? "type-nicu" :
                                           w.WardType == "Maternity" ? "type-maternity" :
                                           w.WardType == "Paediatric" ? "type-paediatric" : "type-general";
                        
                        string floorName = "";
                        if (ViewBag.Settings != null && ViewBag.Settings.EnableHierarchicalMapping && ViewBag.Floors != null)
                        {
                            var fList = ViewBag.Floors as List<IPD_FloorModel>;
                            var fl = fList?.FirstOrDefault(x => x.FloorId == w.FloorId);
                            floorName = fl != null ? fl.FloorName : "—";
                        }
                        <tr>
                            <td>@(index++)</td>
                            @if (ViewBag.Settings != null && ViewBag.Settings.EnableHierarchicalMapping)
                            {
                                <td>@floorName</td>
                            }
                            <td><strong>@w.WardName</strong></td>
                            <td><span class="ward-type-badge @typeClass">@w.WardType</span></td>
                            <td>
                                @if (w.IsActive) { <span class="badge-on">Active</span> }
                                else { <span class="badge-off">Inactive</span> }
                            </td>
                            <td>
                                <button class="btn-edit" onclick="editWard(@w.WardId, '@w.WardName', '@w.WardType', @w.IsActive.ToString().ToLower(), @(w.FloorId?.ToString() ?? "null"))"><i class="fas fa-edit"></i> Edit</button>
                                <button class="btn-del" onclick="deleteWard(@w.WardId)"><i class="fas fa-trash"></i> Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap4.min.js"></script>
<script>
    $(document).ready(function () {
        $('#tblWard').DataTable({
            pageLength: 10,
            language: { search: "", searchPlaceholder: "Search Wards..." },
            dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rt<"d-flex justify-content-between align-items-center mt-3"ip>'
        });
        $('.dataTables_filter input').addClass('form-control form-control-sm');
        $('.dataTables_length select').addClass('form-select form-select-sm');
    });

    function editWard(id, name, type, isActive, floorId) {
        document.getElementById('WardId').value = id;
        document.getElementById('WardName').value = name;
        document.getElementById('WardType').value = type;
        if(document.getElementById('FloorId')) document.getElementById('FloorId').value = floorId || '';
        document.getElementById('IsActive').checked = isActive;
        
        document.getElementById('btnSave').innerHTML = '<i class="fas fa-save me-1"></i> Update Ward';
        document.getElementById('btnSave').classList.replace('btn-primary', 'btn-success');
        document.getElementById('btnCancel').classList.remove('d-none');
        
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    
    function resetForm() {
        document.getElementById('WardId').value = 0;
        document.getElementById('WardName').value = '';
        document.getElementById('WardType').value = 'General';
        if(document.getElementById('FloorId')) document.getElementById('FloorId').value = '';
        document.getElementById('IsActive').checked = true;
        
        document.getElementById('btnSave').innerHTML = '<i class="fas fa-plus me-1"></i> Add Ward';
        document.getElementById('btnSave').classList.replace('btn-success', 'btn-primary');
        document.getElementById('btnCancel').classList.add('d-none');
    }

    function saveWard() {
        var id = document.getElementById('WardId').value;
        var name = document.getElementById('WardName').value;
        var type = document.getElementById('WardType').value;
        var isActive = document.getElementById('IsActive').checked;
        var floorId = document.getElementById('FloorId') ? document.getElementById('FloorId').value : null;
        var btn = document.getElementById('btnSave');

        if (!name) { alert('Please enter Ward Name'); return; }
        if (document.getElementById('FloorId') && !floorId) { alert("Please select a floor for the ward."); return; }

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

        $.ajax({
            url: '/IPD/IPD_Masters/WardMaster_Save',
            type: 'POST',
            data: {
                WardId: id,
                WardName: name,
                WardType: type,
                IsActive: isActive,
                FloorId: floorId
            },
            success: function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert('Error: ' + res.message);
                    btn.disabled = false;
                    btn.innerHTML = id == 0 ? '<i class="fas fa-plus me-1"></i> Add Ward' : '<i class="fas fa-save me-1"></i> Update Ward';
                }
            }
        });
    }

    function deleteWard(id) {
        if (!confirm('Are you sure you want to delete this Ward?')) return;
        $.ajax({
            url: '/IPD/IPD_Masters/WardMaster_Delete',
            type: 'POST',
            data: { id: id },
            success: function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert('Error: ' + res.message);
                }
            }
        });
    }
</script>

