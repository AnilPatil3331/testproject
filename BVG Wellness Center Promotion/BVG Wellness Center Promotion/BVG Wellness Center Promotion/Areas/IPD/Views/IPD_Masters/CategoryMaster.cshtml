@using BVG_Wellness_Center_Promotion.Areas.IPD.Models
@model List<IPD_CategoryModel>
@{
    ViewBag.Title = "Category Master";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap4.min.css">
<style>
    .master-header {
        background: linear-gradient(135deg, #00695c, #26a69a);
        color: white;
        padding: 16px 22px;
        border-radius: 12px;
        margin-bottom: 20px;
        position: relative;
        z-index: 10;
    }

    .add-btn {
        background: #27ae60;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

    .table-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        overflow: hidden;
    }

    .badge-on {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .btn-edit {
        background: #fff8e1;
        color: #f57f17;
        border: none;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 0.82rem;
        cursor: pointer;
    }

    .btn-del {
        background: #fce4ec;
        color: #c62828;
        border: none;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 0.82rem;
        cursor: pointer;
    }

    .food-none {
        background: #f5f5f5;
        color: #616161;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .food-optional {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .food-mandatory {
        background: #fce4ec;
        color: #c62828;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .modal-hdr {
        background: linear-gradient(135deg, #00695c, #26a69a);
        color: white;
    }

    /* Light blue input fields */
    .form-control, .form-select, input[type=text], input[type=number], input[type=datetime-local], textarea, select {
        background-color: #eef5fb !important;
        border-color: #c8dff0 !important;
        color: #1e3a5f;
    }

        .form-control:focus, .form-select:focus, input:focus, select:focus, textarea:focus {
            background-color: #ddeefa !important;
            border-color: #2563eb !important;
            box-shadow: 0 0 0 2px rgba(37,99,235,0.15) !important;
            color: #1e3a5f;
        }
    /* Standard IPD table & page styles */
    .page-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1e3a5f;
    }

    .tbl-ipd th {
        font-size: 0.74rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        border-top: none;
        background: #f8fafc;
        padding: 7px 10px;
        white-space: nowrap;
    }

    .tbl-ipd td {
        font-size: 0.82rem;
        padding: 7px 10px;
        vertical-align: middle;
        border-color: #f1f5f9;
    }

    .tbl-ipd tbody tr:hover {
        background: #f0f9ff;
    }

    .badge-on {
        background: #dcfce7;
        color: #15803d;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
    }

    .badge-off {
        background: #fee2e2;
        color: #991b1b;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
    }

    .act-btn {
        font-size: 0.72rem;
        padding: 3px 9px;
        border-radius: 4px;
        font-weight: 600;
        border: 1px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        margin: 1px;
        transition: all 0.15s;
        text-decoration: none;
    }

    .act-edit {
        background: #fffbeb;
        color: #92400e;
        border-color: #fde68a;
    }

        .act-edit:hover {
            background: #92400e;
            color: #fff;
        }

    .act-del {
        background: #fef2f2;
        color: #991b1b;
        border-color: #fecaca;
    }

        .act-del:hover {
            background: #991b1b;
            color: #fff;
        }

    .act-blue {
        background: #eff6ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
    }

        .act-blue:hover {
            background: #1d4ed8;
            color: #fff;
        }

    .act-green {
        background: #f0fdf4;
        color: #166534;
        border-color: #bbf7d0;
    }

        .act-green:hover {
            background: #166534;
            color: #fff;
        }

    .modal-hdr {
        background: linear-gradient(135deg,#1e3a5f,#2563eb);
        color: #fff;
        border-radius: 8px 8px 0 0;
    }
</style>

@Html.Partial("~/Areas/IPD/Views/Shared/_IPDNav.cshtml")

<div class="container-fluid mt-2">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
            <h6 class="mb-0 text-uppercase text-muted fw-bold" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                <i class="fas fa-tags me-1"></i> Category Master
            </h6>
        </div>
        <div class="card-body">
            <input type="hidden" id="CategoryId" value="0">
            <div class="row g-2 align-items-end">
                @if (ViewBag.Settings != null && ViewBag.Settings.EnableHierarchicalMapping)
                {
                    <div class="col-md-2">
                        <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Floor <span class="text-danger">*</span></label>
                        <select id="FloorId" class="form-select form-select-sm" onchange="filterWards()">
                            <option value="">-- Select Floor --</option>
                            @if (ViewBag.Floors != null)
                            {
                                foreach (var f in ViewBag.Floors)
                                {
                                    <option value="@f.FloorId">@f.FloorName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Ward <span class="text-danger">*</span></label>
                        <select id="WardId" class="form-select form-select-sm">
                            <option value="">-- Select Ward --</option>
                            @if (ViewBag.Wards != null)
                            {
                                foreach (var w in ViewBag.Wards)
                                {
                                    <option value="@w.WardId" data-floor="@w.FloorId">@w.WardName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Category Name <span class="text-danger">*</span></label>
                        <input type="text" id="CategoryName" class="form-control form-control-sm" placeholder="e.g. General, Private">
                    </div>
                }
                else
                {
                    <div class="col-md-4">
                        <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Category Name <span class="text-danger">*</span></label>
                        <input type="text" id="CategoryName" class="form-control form-control-sm" placeholder="e.g. General, Private">
                    </div>
                }
                <div class="col-md-3">
                    <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Food Option</label>
                    <select id="FoodOption" class="form-select form-select-sm">
                        <option value="None">None</option>
                        <option value="Optional">Optional</option>
                        <option value="Mandatory">Mandatory</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <div class="form-check form-switch mt-1">
                        <input class="form-check-input" type="checkbox" id="IsActive" checked>
                        <label class="form-check-label fw-semibold text-muted" style="font-size: 0.75rem;" for="IsActive">Active</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary btn-sm px-4" id="btnSave" onclick="saveCategory()"><i class="fas fa-plus me-1"></i> Add Category</button>
                    <button class="btn btn-light btn-sm px-3 ms-2 d-none" id="btnCancel" onclick="resetForm()">Cancel</button>
                </div>
            </div>
        </div>

        <div class="table-responsive border-top">
            <table id="tblCategory" class="table tbl-ipd mb-0">
                <thead>
                    <tr>
                        <th>Sr No.</th>
                        @if (ViewBag.Settings != null && ViewBag.Settings.EnableHierarchicalMapping)
                        {
                            <th>Floor</th>
                            <th>Ward</th>
                        }
                        <th>Category Name</th>
                        <th>Food Option</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int index = 1; }
                    @foreach (var c in Model)
                    {
                        string foodClass = c.FoodOption == "Optional" ? "food-optional" : (c.FoodOption == "Mandatory" ? "food-mandatory" : "food-none");
                        
                        string floorName = "—";
                        string wardName = "—";
                        if (ViewBag.Settings != null && ViewBag.Settings.EnableHierarchicalMapping)
                        {
                            if (ViewBag.Floors != null)
                            {
                                var fl = (ViewBag.Floors as List<IPD_FloorModel>)?.FirstOrDefault(x => x.FloorId == c.FloorId);
                                floorName = fl != null ? fl.FloorName : "—";
                            }
                            if (ViewBag.Wards != null)
                            {
                                var wd = (ViewBag.Wards as List<IPD_WardModel>)?.FirstOrDefault(x => x.WardId == c.WardId);
                                wardName = wd != null ? wd.WardName : "—";
                            }
                        }
                        
                        <tr>
                            <td>@(index++)</td>
                            @if (ViewBag.Settings != null && ViewBag.Settings.EnableHierarchicalMapping)
                            {
                                <td>@floorName</td>
                                <td>@wardName</td>
                            }
                            <td><strong>@c.CategoryName</strong></td>
                            <td><span class="@foodClass">@c.FoodOption</span></td>
                            <td>
                                @if (c.IsActive) { <span class="badge-on">Active</span> }
                                else { <span class="badge-off">Inactive</span> }
                            </td>
                            <td>
                                <button class="act-btn act-edit me-1" onclick="editCategory(@c.CategoryId, '@c.CategoryName', '@c.FoodOption', @c.IsActive.ToString().ToLower(), @(c.FloorId?.ToString() ?? "null"), @(c.WardId?.ToString() ?? "null"))">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <button class="act-btn act-del" onclick="deleteCategory(@c.CategoryId)">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap4.min.js"></script>
<script>
    $(document).ready(function () { $('#tblCategory').DataTable({ pageLength: 25 }); });
    
    function filterWards() {
        var floorId = document.getElementById('FloorId').value;
        var wardSelect = document.getElementById('WardId');
        var options = wardSelect.querySelectorAll('option:not([value=""])');
        
        var firstVisible = "";
        options.forEach(opt => {
            if (!floorId || opt.getAttribute('data-floor') == floorId) {
                opt.style.display = 'block';
                if(!firstVisible) firstVisible = opt.value;
            } else {
                opt.style.display = 'none';
            }
        });
        if(wardSelect.value && wardSelect.querySelector('option[value="'+wardSelect.value+'"]').style.display === 'none') {
            wardSelect.value = firstVisible;
        }
    }

    function editCategory(id, name, food, active, floorId, wardId) {
        document.getElementById('CategoryId').value = id || 0;
        document.getElementById('CategoryName').value = name || '';
        document.getElementById('FoodOption').value = food || 'None';
        if (document.getElementById('FloorId')) {
            document.getElementById('FloorId').value = floorId || '';
            filterWards();
            document.getElementById('WardId').value = wardId || '';
        }
        document.getElementById('IsActive').checked = active !== false;
        
        document.getElementById('btnSave').innerHTML = '<i class="fas fa-save me-1"></i> Update Category';
        document.getElementById('btnSave').classList.replace('btn-primary', 'btn-success');
        document.getElementById('btnCancel').classList.remove('d-none');
        
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    
    function resetForm() {
        document.getElementById('CategoryId').value = 0;
        document.getElementById('CategoryName').value = '';
        document.getElementById('FoodOption').value = 'None';
        if (document.getElementById('FloorId')) {
            document.getElementById('FloorId').value = '';
            filterWards();
        }
        document.getElementById('IsActive').checked = true;
        
        document.getElementById('btnSave').innerHTML = '<i class="fas fa-plus me-1"></i> Add Category';
        document.getElementById('btnSave').classList.replace('btn-success', 'btn-primary');
        document.getElementById('btnCancel').classList.add('d-none');
    }

    function saveCategory() {
        var data = { 
            CategoryId: document.getElementById('CategoryId').value, 
            CategoryName: document.getElementById('CategoryName').value, 
            FoodOption: document.getElementById('FoodOption').value, 
            IsActive: document.getElementById('IsActive').checked,
            FloorId: document.getElementById('FloorId') ? document.getElementById('FloorId').value : null,
            WardId: document.getElementById('WardId') ? document.getElementById('WardId').value : null
        };
        if (!data.CategoryName.trim()) { alert('Category Name is required'); return; }
        if (document.getElementById('FloorId') && !data.FloorId) { alert('Floor is required'); return; }
        if (document.getElementById('WardId') && !data.WardId) { alert('Ward is required'); return; }
        
        fetch('/IPD/IPD_Masters/CategoryMaster_Save', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(data) })
            .then(r => r.json()).then(res => { if (res.success) { location.reload(); } else alert('Error: ' + res.message); });
    }
    function deleteCategory(id) {
        if (!confirm('Delete this category?')) return;
        fetch('/IPD/IPD_Masters/CategoryMaster_Delete', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id })
            .then(r => r.json()).then(res => { if (res.success) { location.reload(); } else alert('Error: ' + res.message); });
    }
</script>

</div>

