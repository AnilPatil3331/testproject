@Html.Partial("~/Areas/IPD/Views/Shared/_IPDNav.cshtml")

<div class="container-fluid mt-2">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
            <h6 class="mb-0 text-uppercase text-muted fw-bold" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                <i class="fas fa-receipt me-1"></i> Room Charges Master
            </h6>
        </div>
        <div class="card-body">
            <div class="info-note mb-3">
                <i class="fas fa-info-circle text-warning me-2"></i>
                <strong>How it works:</strong> First define charge types here (Nursing, TV, AC, etc.) → Then go to <strong>Room Master</strong> → Edit Room → Map which charges apply to that room and whether they are Compulsory or Optional.
            </div>
            <input type="hidden" id="ChargeId" value="0">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Charge Name <span class="text-danger">*</span></label>
                    <input type="text" id="ChargeName" class="form-control form-control-sm" placeholder="e.g. Nursing, TV, Breakfast">
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Charge Type <span class="text-danger">*</span></label>
                    <select id="ChargeType" class="form-select form-select-sm">
                        <option value="ServiceCharge">🛠️ Service Charge</option>
                        <option value="RoomCharge">🏨 Room Charge</option>
                        <option value="FoodCharge">🍽️ Food Charge</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Default Amt (₹/day)</label>
                    <input type="number" id="DefaultAmount" class="form-control form-control-sm" placeholder="0" min="0" step="0.01">
                </div>
                <div class="col-md-1">
                    <div class="form-check form-switch mt-1">
                        <input class="form-check-input" type="checkbox" id="IsActive" checked>
                        <label class="form-check-label fw-semibold text-muted" style="font-size: 0.75rem;" for="IsActive">Active</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary btn-sm px-4" id="btnSave" onclick="saveCharge()"><i class="fas fa-plus me-1"></i> Add Charge</button>
                    <button class="btn btn-light btn-sm px-3 ms-2 d-none" id="btnCancel" onclick="resetForm()">Cancel</button>
                </div>
            </div>
        </div>

        <div class="table-responsive border-top">
            <table id="tblCharges" class="table tbl-ipd mb-0">
                <thead class="table-light">
                    <tr><th>Sr No.</th><th>Charge Name</th><th>Charge Type</th><th>Default Amount</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @{ int index = 1; }
                    @foreach (var c in Model)
                    {
                        string typeClass = c.ChargeType == "FoodCharge" ? "type-food" : (c.ChargeType == "RoomCharge" ? "type-room" : "type-service");
                        string typeLabel = c.ChargeType == "FoodCharge" ? "🍽️ Food" : (c.ChargeType == "RoomCharge" ? "🏨 Room" : "🛠️ Service");
                        <tr>
                            <td>@(index++)</td>
                            <td><strong>@c.ChargeName</strong></td>
                            <td><span class="@typeClass">@typeLabel</span></td>
                            <td><strong class="text-success">₹@c.DefaultAmount.ToString("N0")/day</strong></td>
                            <td>
                                @if (c.IsActive) { <span class="badge-on">Active</span> }
                                else { <span style="background:#ffeaea;color:#c0392b;padding:3px 12px;border-radius:20px;font-size:0.78rem;font-weight:600;">Inactive</span> }
                            </td>
                            <td>
                                <button class="act-btn act-edit me-1" onclick="editCharge(@c.ChargeId, '@c.ChargeName', '@c.ChargeType', @c.DefaultAmount, @c.IsActive.ToString().ToLower())">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <button class="act-btn act-del" onclick="deleteCharge(@c.ChargeId)">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap4.min.js"></script>
<script>
    $(document).ready(function () { $('#tblCharges').DataTable({ pageLength: 25 }); });
    
    function editCharge(id, name, type, amt, active) {
        document.getElementById('ChargeId').value = id || 0;
        document.getElementById('ChargeName').value = name || '';
        document.getElementById('ChargeType').value = type || 'ServiceCharge';
        document.getElementById('DefaultAmount').value = amt || 0;
        document.getElementById('IsActive').checked = active !== false;
        
        document.getElementById('btnSave').innerHTML = '<i class="fas fa-save me-1"></i> Update Charge';
        document.getElementById('btnSave').classList.replace('btn-primary', 'btn-success');
        document.getElementById('btnCancel').classList.remove('d-none');
        
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    
    function resetForm() {
        document.getElementById('ChargeId').value = 0;
        document.getElementById('ChargeName').value = '';
        document.getElementById('ChargeType').value = 'ServiceCharge';
        document.getElementById('DefaultAmount').value = 0;
        document.getElementById('IsActive').checked = true;
        
        document.getElementById('btnSave').innerHTML = '<i class="fas fa-plus me-1"></i> Add Charge';
        document.getElementById('btnSave').classList.replace('btn-success', 'btn-primary');
        document.getElementById('btnCancel').classList.add('d-none');
    }

    function saveCharge() {
        var data = { ChargeId: document.getElementById('ChargeId').value, ChargeName: document.getElementById('ChargeName').value, ChargeType: document.getElementById('ChargeType').value, DefaultAmount: document.getElementById('DefaultAmount').value, IsActive: document.getElementById('IsActive').checked };
        if (!data.ChargeName.trim()) { alert('Charge Name is required'); return; }
        fetch('/IPD/IPD_Masters/RoomChargesMaster_Save', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(data) })
            .then(r => r.json()).then(res => { if (res.success) { location.reload(); } else alert('Error: ' + res.message); });
    }
    
    function deleteCharge(id) {
        if (!confirm('Delete this charge? It will also be removed from all room mappings.')) return;
        fetch('/IPD/IPD_Masters/RoomChargesMaster_Delete', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id })
            .then(r => r.json()).then(res => { if (res.success) { location.reload(); } else alert('Error: ' + res.message); });
    }
</script>

