@using BVG_Wellness_Center_Promotion.Areas.IPD.Models
@model List<IPD_FloorModel>
@{
    ViewBag.Title = "Floor Master";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap4.min.css">
<style>
    .page-title { font-size:1rem; font-weight:700; color:#1e3a5f; }
    .tbl-ipd th { font-size:0.74rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.3px; border-top:none; background:#f8fafc; padding:7px 10px; }
    .tbl-ipd td { font-size:0.82rem; padding:7px 10px; vertical-align:middle; border-color:#f1f5f9; }
    .tbl-ipd tbody tr:hover { background:#f0f9ff; }
    .badge-on  { background:#dcfce7; color:#15803d; padding:2px 10px; border-radius:20px; font-size:0.72rem; font-weight:700; }
    .badge-off { background:#fee2e2; color:#991b1b; padding:2px 10px; border-radius:20px; font-size:0.72rem; font-weight:700; }
    .act-btn { font-size:0.72rem; padding:3px 9px; border-radius:4px; font-weight:600; border:1px solid transparent; cursor:pointer; display:inline-flex; align-items:center; gap:3px; margin:1px; transition:all 0.15s; }
    .act-edit { background:#fffbeb; color:#92400e; border-color:#fde68a; }
    .act-edit:hover { background:#92400e; color:#fff; }
    .act-del  { background:#fef2f2; color:#991b1b; border-color:#fecaca; }
    .act-del:hover  { background:#991b1b; color:#fff; }
    .modal-hdr { background:linear-gradient(135deg,#1e3a5f,#2563eb); color:#fff; border-radius:8px 8px 0 0; }
    .form-label { font-size:0.8rem; font-weight:600; color:#374151; margin-bottom:3px; }
    .form-control, .form-select { font-size:0.83rem; padding:5px 10px; background-color:#eef5fb; border-color:#c8dff0; border-radius:5px; color:#1e3a5f; }
    .form-control:focus, .form-select:focus { background-color:#ddeefa; border-color:#2563eb; box-shadow:0 0 0 2px rgba(37,99,235,0.15); }
    
</style>

@Html.Partial("~/Areas/IPD/Views/Shared/_IPDNav.cshtml")

<div class="container-fluid mt-2">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
            <h6 class="mb-0 text-uppercase text-muted fw-bold" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                <i class="fas fa-layer-group me-1"></i> Floor Master
            </h6>
        </div>
        <div class="card-body">
            <input type="hidden" id="FloorId" value="0">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Floor Name <span class="text-danger">*</span></label>
                    <input type="text" id="FloorName" class="form-control form-control-sm" placeholder="e.g. Ground Floor">
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted" style="font-size: 0.75rem; font-weight:600;">Floor Number</label>
                    <input type="number" id="FloorNumber" class="form-control form-control-sm" placeholder="0=Ground..." min="0">
                </div>
                <div class="col-md-2">
                    <div class="form-check form-switch mt-1">
                        <input class="form-check-input" type="checkbox" id="IsActive" checked>
                        <label class="form-check-label fw-semibold text-muted" style="font-size: 0.75rem;" for="IsActive">Active</label>
                    </div>
                </div>
                <div class="col-md-5">
                    <button class="btn btn-primary btn-sm px-4" id="btnSave" onclick="saveFloor()"><i class="fas fa-plus me-1"></i> Add Floor</button>
                    <button class="btn btn-light btn-sm px-3 ms-2 d-none" id="btnCancel" onclick="resetForm()">Cancel</button>
                </div>
            </div>
        </div>
        
        <div class="table-responsive border-top">
            <table id="tblFloor" class="table tbl-ipd mb-0">
                <thead><tr><th>Sr No.</th>
                    <th>Floor Name</th>
                    <th>Floor No</th>
                    <th>Status</th>
                    <th>Actions</th>
                    </tr></thead>
                <tbody>
                    @{ int index = 1; }`n                    @foreach (var f in Model)
                    {
                        <tr>
                            <td>@(index++)</td>
                            <td><strong>@f.FloorName</strong></td>
                            <td><span class="badge bg-light text-dark border">Floor @f.FloorNumber</span></td>
                            <td>
                                @if (f.IsActive) { <span class="badge-on">Active</span> }
                                else { <span class="badge-off">Inactive</span> }
                            </td>
                            <td>
                                <button class="act-btn act-edit" onclick="editFloor(@f.FloorId,'@f.FloorName',@f.FloorNumber,@f.IsActive.ToString().ToLower())">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <button class="act-btn act-del" onclick="deleteFloor(@f.FloorId)">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap4.min.js"></script>
<script>
    $(document).ready(function () { $('#tblFloor').DataTable({ pageLength: 25 }); });
    
    function editFloor(id, name, no, active) {
        document.getElementById('FloorId').value = id || 0;
        document.getElementById('FloorName').value = name || '';
        document.getElementById('FloorNumber').value = no || 0;
        document.getElementById('IsActive').checked = active !== false && active !== 'false';
        
        document.getElementById('btnSave').innerHTML = '<i class="fas fa-save me-1"></i> Update Floor';
        document.getElementById('btnSave').classList.replace('btn-primary', 'btn-success');
        document.getElementById('btnCancel').classList.remove('d-none');
        
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    
    function resetForm() {
        document.getElementById('FloorId').value = 0;
        document.getElementById('FloorName').value = '';
        document.getElementById('FloorNumber').value = 0;
        document.getElementById('IsActive').checked = true;
        
        document.getElementById('btnSave').innerHTML = '<i class="fas fa-plus me-1"></i> Add Floor';
        document.getElementById('btnSave').classList.replace('btn-success', 'btn-primary');
        document.getElementById('btnCancel').classList.add('d-none');
    }

    function saveFloor() {
        var data = { FloorId: document.getElementById('FloorId').value, FloorName: document.getElementById('FloorName').value, FloorNumber: document.getElementById('FloorNumber').value, IsActive: document.getElementById('IsActive').checked };
        if (!data.FloorName.trim()) { alert('Floor Name required'); return; }
        fetch('/IPD/IPD_Masters/FloorMaster_Save', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(data) })
            .then(r => r.json()).then(res => { if (res.success) { location.reload(); } else alert('Error: ' + res.message); });
    }
    function deleteFloor(id) {
        if (!confirm('Delete this floor?')) return;
        fetch('/IPD/IPD_Masters/FloorMaster_Delete', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id })
            .then(r => r.json()).then(res => { if (res.success) { location.reload(); } else alert('Error: ' + res.message); });
    }
</script>


