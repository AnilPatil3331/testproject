@using BVG_Wellness_Center_Promotion.Areas.IPD.Models
@model List<IPD_StayBookingModel>
@{
    ViewBag.Title = "Discharged Patients";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap4.min.css">
<style>
    .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; margin-top:4px; }
    .page-title { font-size:1.05rem; font-weight:700; color:#1e3a5f; display:flex; align-items:center; gap:8px; }
    .badge-discharged { background:#f1f5f9; color:#475569; padding:2px 9px; border-radius:20px; font-size:0.72rem; font-weight:700; border:1px solid #cbd5e1; }
    .tbl-ipd th { font-size:0.74rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.3px; border-top:none; background:#f8fafc; padding:7px 10px; white-space:nowrap; }
    .tbl-ipd td { font-size:0.82rem; padding:7px 10px; vertical-align:middle; border-color:#f1f5f9; }
    .tbl-ipd tbody tr:hover { background:#f8fafc; }
    .loc-room { font-weight:700; color:#1e3a5f; }
    .loc-bed { color:#2563eb; font-size:0.78rem; }
    .loc-meta { color:#94a3b8; font-size:0.72rem; }
    .net-amt { font-family:'Courier New',monospace; font-weight:700; color:#166534; font-size:0.88rem; }
    .act-btn { font-size:0.72rem; padding:3px 9px; border-radius:4px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:3px; border:1px solid transparent; transition:all 0.15s; }
    .act-print { background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe; }
    .act-print:hover { background:#1d4ed8; color:#fff; }
    
</style>

@Html.Partial("~/Areas/IPD/Views/Shared/_IPDNav.cshtml")

<div class="container-fluid mt--5">
    <div class="page-header">
        <div class="page-title">
            <i class="fas fa-history text-secondary"></i>
            Discharged Patients
            <span class="badge bg-secondary rounded-pill" style="font-size:0.72rem;">@Model.Count</span>
        </div>
        <a href="/IPD/IPD_Booking/NewAdmission" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>New Admission</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table id="tblDischarged" class="table tbl-ipd mb-0">
                <thead>
                    <tr>
                        <th>Invoice No</th>
                        <th>Patient ID</th>
                        <th>Location</th>
                        <th>Admitted</th>
                        <th>Discharged</th>
                        <th>Net Payable</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td><strong class="text-secondary">@b.BookingNo</strong></td>
                            <td><span class="badge bg-light text-dark border">@b.PatientFid</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(b.FloorName)) { <span class="loc-meta">@b.FloorName &rsaquo; </span> }
                                @if (!string.IsNullOrEmpty(b.WardName)) { <span class="loc-meta">@b.WardName &rsaquo; </span> }
                                <span class="loc-room">@b.RoomNumber</span>
                                <span class="loc-bed"> / Bed @b.BedNumber</span>
                            </td>
                            <td><small>@b.AdmissionDate.ToString("dd-MMM-yy HH:mm")</small></td>
                            <td><small>@(b.ActualDischarge?.ToString("dd-MMM-yy HH:mm") ?? "-")</small></td>
                            <td><span class="net-amt">&#8377;@b.FinalBillAmount.ToString("N2")</span></td>
                            <td>
                                <a href="/IPD/IPD_Booking/PrintBill?bookingId=@b.BookingId" target="_blank" class="act-btn act-print">
                                    <i class="fas fa-print"></i> Print Bill
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap4.min.js"></script>
<script>
    .ready(function () {
        #tblDischarged.DataTable({ pageLength: 25, order: [[0, 'desc']] });
    });
</script>
