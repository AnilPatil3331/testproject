
@{
    ViewBag.Title = "Location";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

<div class="container-fluid" style="padding-left:15px !important;">
    <div class="row">
        @Html.Partial("SettingSidebar")
        <div class="col-12 col-md-9">
            <div>
                <div>
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="card p-0 shadow">
                                <!---->
                                <header class="card-header">
                                    <div class="row">
                                        <div class="col-sm-12 col-md-8 col-lg-8">
                                            <h2 class="mb-0">
                                              Location List
                                                <a href="https://apps.iqonic.design/docs/product/kivicare/clinic-admin/settings/#holidays"
                                                   target="_blank">
                                                    <i class="fa fa-question-circle">
                                                    </i>
                                                </a>
                                            </h2>
                                        </div>
                                        <div class="col-sm-12 col-md-4 col-lg-4">
                                            <div class="d-flex justify-content-end">
                                                @*<button to="[object Object]" class="btn btn-sm btn-primary" id="AddHolidays">
                                                    <i class="fa fa-plus">
                                                    </i>
                                                    Add Holidays
                                                </button>*@
                                            </div>
                                        </div>
                                    </div>
                                </header>
                                <div class="card-body p-1">
                                    <!---->
                                    <div> @*style="padding: 9px 20px 6px 20px; color:black; margin-top:-80px; display: flex; justify-content: space-between; align-items: center;">*@
                                        <h4 style="margin: 0;"></h4>

                                        <div style="position: relative; width: 315px; margin-right: 40%;">
                                            <i class="fa fa-search" style="position: absolute; top: 50%; left: 12px; transform: translateY(-50%); color: #aaa;"></i>
                                            <input type="text" class="form-control" id="searchInput" placeholder="Area / PinCode / City "
                                                   style="padding:10px;   padding-left: 47px; background-color: white; width: 125%; height: 36px; font-size: 14px; border-radius: 20px;" />

                                            <div id="searchResult"
                                                 style="position: absolute; top: 40px; background: white; border: 1px solid #ccc; border-radius: 5px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); z-index: 1000; font-size:small;width: 125%; display: none;">
                                            </div>

                                        </div>
                                    </div>
                                                                                       





                                    <table class="table table-bordered mt-3">
                                        <thead>
                                            <tr>
                                                <th>Area</th>
                                                <th>Post Office</th>
                                                <th>Pincode</th>
                                                <th>Taluka</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model != null && Model.Count > 0)
                                            {
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.Area</td>
                                                        <td>@item.PostOffice</td>
                                                        <td>@item.Pincode</td>
                                                        <td>@item.Taluka</td>
                                                         <td>
                                                             <a href="#"
                                                                data-href="@Url.Action("DeleteLocation", "Setting", new { FId = item.FId })"
                                                                class="btn btn-sm btn-danger btnDeleteLocation">
                                                                 Delete
                                                             </a>
                                                         </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center">No Data Found</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>



                                    <!---->
                                </div>
                                <!---->
                                <!---->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $("#AddHolidays").click(function () {
            debugger;
            // Toggle the visibility of the bill item add form
            $("#holiday-add-tab").slideToggle(function () {
                // Change button text based on the updated state of the form
                if ($("#holiday-add-tab").is(":visible")) {
                    // If the form is visible, change the button text to "Close"
                    $("#AddHolidays").html('<i class="fa fa-times"></i> Close Form');
                } else {
                    // If the form is hidden, change the button text back to "Add Bill Item"
                    $("#AddHolidays").html('<i class="fa fa-plus"></i> Add Holidays');
                }
            });
        });

    });
</script>



<script>
    $(document).ready(function () {
        $('#searchInput').on('input', function () {
            var query = $(this).val().trim();

            if (query.length >= 1) {
                $.ajax({
                    url: '@Url.Action("SearchLocation")',
                    type: 'GET',
                    data: { searchTerm: query },
                    success: function (data) {
                        debugger;
                        let html = "";
                        if (data.length > 0) {
                            debugger
                            html += "<ul class='list-group mb-0'>";

                            $.each(data, function (i, item) {
                                html += "<li class='list-group-item list-group-item-action' " + "style='cursor:pointer;' onclick='selectPatient(" + item.FId + ")'>";

                                html += "<span>" + item.Area + " | " + item.PostOffice + " | " + item.Pincode + " | " + item.Taluka + "</span>";

                                html += "</li>";

                            });

                            html += "</ul>";
                        } else {
                            html = "<div class='p-2 text-muted'>No matches found</div>";
                        }

                        $('#searchResult').html(html).show();
                    },
                    error: function () {
                        $('#searchResult').html('<div class="p-2 text-danger">Error fetching data</div>').show();
                    }
                });
            } else {
                $('#searchResult').hide();
            }
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#searchInput, #searchResult').length) {
                $('#searchResult').hide();
            }
        });

        $(document).on('click', '.btnDeleteLocation', function (e) {
            e.preventDefault();
            var href = $(this).attr('data-href');
            Swal.fire({
                title: 'Are You Sure!',
                text: "Are you sure you want to delete this location?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f44336',
                cancelButtonColor: '#4caf50',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, cancel!',
                customClass: { popup: 'fullscreen-popup' }
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = href;
                }
            });
        });
    });

    function selectPatient(FId) {
        window.location.href = '/Setting/Setting/SaveLocation?FId=' + FId;
    }
</script>