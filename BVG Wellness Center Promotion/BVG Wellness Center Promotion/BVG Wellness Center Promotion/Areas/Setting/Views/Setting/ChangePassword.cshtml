@model BVG_Wellness_Center_Promotion.Models.UserMaster
@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

<!-- Alert CSS & JS -->
<link href="~/assets/css/CustomeAlertCSS/customAlert.css" rel="stylesheet" />
<script src="~/assets/js/CustomeAlert/customAlert.js"></script>
<style>
   .card-body {
    padding: 30px 20px;
} /* Too much padding, causes vertical overflow */
}
</style>
<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card shadow border-0">
          
                <!-- Card Header -->
                <div class="card-header d-flex justify-content-between align-items-center" style="color: white; padding: 15px 20px;">
                    <h5 class="mb-0" style="font-size: 1.25rem;">Change Password</h5>

                    <!-- Back Button in Header -->
                    <button type="button" class="btn btn-sm" id="btnBack"
                            style="background-color: white; color: #5881ed; font-weight: bold; border: 1px solid black; border-radius: 4px; padding: 5px 15px;">
                        <i class="fa fa-angle-double-left"></i> Back
                    </button>
                </div>

                <!-- Card Body -->
                <div class="card-body" style="padding: 50px 20px;">
                    @using (Html.BeginForm("ChangePassword", "Setting", FormMethod.Post, new { id = "changePassForm", area = "Setting" }))
                    {
                        <div class="row justify-content-center">
                            <div class="col-md-6 col-lg-5">

                                <!-- Current Password -->
                             <div class="form-group mb-4">
                                 <label class="form-control-label font-weight-bold" style="color: #4e5e7a;">
                                     Current Password <span class="text-danger">*</span>
                                 </label>

                                 <div class="input-group">
                                     <input type="password" name="OldPassword" id="txtOldPass"
                                            class="form-control"
                                            placeholder="Enter Current Password">

                                     <div class="input-group-append">
                                         <span class="input-group-text toggle-password" toggle="#txtOldPass" style="cursor:pointer;">
                                             <i class="fa fa-eye"></i>
                                         </span>
                                     </div>
                                 </div>
                             </div>

                                <!-- New Password -->
                               <div class="form-group mb-4">
                                   <label class="form-control-label font-weight-bold" style="color: #4e5e7a;">
                                       New Password <span class="text-danger">*</span>
                                   </label>

                                   <div class="input-group">
                                       <input type="password" name="NewPassword" id="txtNewPass"
                                              class="form-control"
                                              placeholder="Enter New Password">

                                       <div class="input-group-append">
                                           <span class="input-group-text toggle-password" toggle="#txtNewPass" style="cursor:pointer;">
                                               <i class="fa fa-eye"></i>
                                           </span>
                                       </div>
                                   </div>
                               </div>

                                <!-- Confirm New Password -->
                              <div class="form-group mb-5">
                                  <label class="form-control-label font-weight-bold" style="color: #4e5e7a;">
                                      Confirm New Password <span class="text-danger">*</span>
                                  </label>

                                  <div class="input-group">
                                      <input type="password" id="txtConfirmPass"
                                             class="form-control"
                                             placeholder="Confirm New Password">

                                      <div class="input-group-append">
                                          <span class="input-group-text toggle-password" toggle="#txtConfirmPass" style="cursor:pointer;">
                                              <i class="fa fa-eye"></i>
                                          </span>
                                      </div>
                                  </div>
                              </div>
                                <!-- Footer Buttons -->
                                <div class="text-center">
                                    <button type="submit" class="btn btn-primary px-5" style="background-color: #5881ed; border: none; font-weight: bold; height: 45px; min-width: 180px;">
                                        <i class="fa fa-save"></i> Update
                                    </button>

                                    <button type="button" id="btnCancel" class="btn btn-outline-primary px-5 ml-2" style="font-weight: bold; height: 45px; min-width: 180px;">
                                        Cancel
                                    </button>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Redirect Logic (Back ani Cancel sathi Dashboard path)
    var dashboardUrl = '@Url.Action("Dashboard", "Dashboard", new { area = "Patient" })';

    $("#btnBack, #btnCancel").click(function () {
        window.location.href = dashboardUrl;
    });

    // 2. Form Submit nantar cha Logic (Success jhalyas Logout/Login kade pathvne)
    @if (TempData["Message"] != null)
    {
        <text>
        window.onload = function () {
            // Popup dakhva
            showCustomAlert('@TempData["Message"]', '@TempData["Icon"]', "");

            // Jar update success jhala asel, tar Login page la redirect kara
            if ('@TempData["Icon"]' === 'success') {
                setTimeout(function () {
                    window.location.href = '@Url.Action("Login", "Home", new { area = "" })';
                }, 2000); // 2 secondant login page var jail
            }
        };
        </text>
    }

    // 3. New vs Confirm Password check (Client-side validation)
    $("#changePassForm").submit(function (e) {
        var newPass = $("#txtNewPass").val();
        var confirmPass = $("#txtConfirmPass").val();

        if (newPass !== confirmPass) {
            showCustomAlert("New Password and Confirm Password do not match!", "error", "");
            e.preventDefault(); // Form submit thambva
        }
    });

    $(".toggle-password").click(function () {

        var input = $($(this).attr("toggle"));
        var icon = $(this).find("i");

        if (input.attr("type") == "password") {
            input.attr("type", "text");
            icon.removeClass("fa-eye").addClass("fa-eye-slash");
        }
        else {
            input.attr("type", "password");
            icon.removeClass("fa-eye-slash").addClass("fa-eye");
        }

    });
</script>