@model BVG_Wellness_Center_Promotion.Models.UserMaster
@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Shared/_LayoutPage.cshtml"; // Jar login page sathi layout vegli asel tar ti vapra
}

<link href="~/assets/css/CustomeAlertCSS/customAlert.css" rel="stylesheet" />
<script src="~/assets/js/CustomeAlert/customAlert.js"></script>

<div class="container-fluid" style="padding: 15px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0">
                <div class="card-header text-center" style="background-color: #5881ed; color: white; padding: 20px;">
                    <h5 class="mb-0">Forgot Password</h5>
                </div>
                <div class="card-body" style="padding: 40px 20px;">
                    <p class="text-center text-muted mb-4">Enter your registered email to receive an OTP.</p>

                    @using (Html.BeginForm("SendOTP", "Home", FormMethod.Post))
                    {
                        <div class="form-group mb-4">
                            <label class="font-weight-bold">Email Address <span class="text-danger">*</span></label>
                            <input type="email" name="Email" class="form-control" required placeholder="example@mail.com" style="height: 45px;">
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary px-5" style="background-color: #5881ed; border: none; height: 45px; width: 100%;">
                                Send OTP
                            </button>
                            <div class="mt-3">
                                <a href="@Url.Action("Login", "Home")" class="text-primary font-weight-bold">Back to Login</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <script>
        window.onload = function () {
            showCustomAlert('@TempData["Message"]', '@TempData["Icon"]', "");
        };
    </script>
}