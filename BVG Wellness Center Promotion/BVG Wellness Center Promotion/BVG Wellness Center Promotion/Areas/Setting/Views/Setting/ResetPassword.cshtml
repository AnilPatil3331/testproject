@model BVG_Wellness_Center_Promotion.Models.UserMaster
@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

<div class="container-fluid" style="padding: 15px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0">
                <div class="card-header text-center" style="background-color: #5881ed; color: white; padding: 20px;">
                    <h5 class="mb-0">Set New Password</h5>
                </div>
                <div class="card-body" style="padding: 40px 20px;">

                    @using (Html.BeginForm("UpdateForgottenPassword", "Home", FormMethod.Post, new { id = "resetForm" }))
                    {
                        <div class="form-group mb-4">
                            <label class="font-weight-bold">New Password <span class="text-danger">*</span></label>
                            <input type="password" name="NewPassword" id="txtNew" class="form-control" required placeholder="Enter New Password" style="height: 45px;">
                        </div>

                        <div class="form-group mb-5">
                            <label class="font-weight-bold">Confirm New Password <span class="text-danger">*</span></label>
                            <input type="password" id="txtConfirm" class="form-control" required placeholder="Confirm New Password" style="height: 45px;">
                        </div>

                        <button type="submit" class="btn btn-primary px-5" style="background-color: #5881ed; border: none; height: 45px; width: 100%;">
                            Update Password
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $("#resetForm").submit(function (e) {
        if ($("#txtNew").val() !== $("#txtConfirm").val()) {
            alert("Passwords do not match!");
            e.preventDefault();
        }
    });
</script>