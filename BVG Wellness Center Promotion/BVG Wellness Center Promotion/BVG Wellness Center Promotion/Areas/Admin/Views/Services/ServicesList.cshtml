                                                                    </div>
                                                                </td>
                                                                <td data-label="Charges" class="vgt-left-align">
                                                                    <div>
                                                                        @item.Charges
                                                                    </div>
                                                                </td>


                                                                <td data-label="Category" class="vgt-left-align">
                                                                    <div>
                                                                        @item.Servicecategory
                                                                    </div>
                                                                </td>
                                                                <td data-label="Status" class="vgt-left-align">
