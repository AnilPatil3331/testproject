                                                                            @if (@item.Status == "Active")
                                                                            {
                                                                                <input id="status_change_@item.ServiceFid" type="checkbox" name="check-button" class="custom-control-input" checked onclick="toggleStatus(this,'@item.ServiceId_Encrypted')">
                                                                                <label for="status_change_@item.ServiceFid" class="custom-control-label">
                                                                                </label>
                                                                            }
                                                                            else
                                                                            {
                                                                                <input id="status_change_@item.ServiceFid" type="checkbox" name="check-button" class="custom-control-input" onclick="toggleStatus(this,'@item.ServiceId_Encrypted')">
                                                                                <label for="status_change_@item.ServiceFid" class="custom-control-label">
                                                                                </label>
                                                                            }
                                                                        </div>
                                                                        @if (@item.Status == "Active")
                                                                        {
                                                                            <span class="badge badge-success">
                                                                                @item.Status
                                                                            </span>
                                                                        }
