                                                                        <a href="@Url.Action("ServicesList", "Services", new { ServiceId_Encrypted = @item.ServiceId_Encrypted })" class="btn btn-sm btn-outline-primary"
                                                                           title="Edit">
                                                                            <i class="fa fa-pen-alt">
                                                                            </i>
                                                                        </a>
                                                                        <button title="Delete" id="deleteDoctorSession" class="btn btn-outline-danger btn-sm" onclick="DeleteService('@item.ServiceId_Encrypted')">
                                                                            <i class="fa fa-trash">
                                                                            </i>
