@model BVG_Wellness_Center_Promotion.Areas.Admin.Models.ClinicService
@{
    ViewBag.Title = "ServicesList";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
    int count = 1;

}

<link href="~/assets/css/CustomeAlertCSS/customAlert.css" rel="stylesheet" />
<script src="~/assets/js/CustomeAlert/customAlert.js"></script>

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>

<style>
    .big-input {
        height: 55px !important;
        font-size: 16px;
    }
</style>

<div class="container-fluid" style="padding-left:15px !important;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card p-0 shadow">
                <!---->
                <header class="card-header">
                    <div class="row">
                        <div class="col-sm-12 col-md-8 col-lg-8">
                            <h3 class="mb-0">
                                Services/Therapies
                            </h3>
                        </div>
                        <div class="col-sm-12 col-md-4 col-lg-4">
                            <div class="d-flex justify-content-end">
                                @*<button class="float-right btn btn-sm btn-primary rtl-left">
                                    <i class="fas fa-file-import">
                                    </i>
                                    Import data
                                </button>*@
                                <button class="btn btn-sm btn-primary" id="addService">
                                    <i class="fa fa-plus">
                                    </i>
                                    Add Service
                                </button>
                            </div>
                        </div>
                    </div>
                </header>
                <div class="card-body p-0" style="margin-left:50px; margin-right:34px; ">
                    <!---->
                    <!---->
                    <div data-v-9bd3ed50="">
                        <!---->
                    </div>
                    <div id="static-data-add-tab" style="display:none;">
                        <div class="row">
                            @if (TempData["Message"] != null)
                            {
                                <script>
                                    window.onload = function () {
                                        var message = '@TempData["Message"]';
                                        var alertType = '@TempData["Icon"]';
                                        var imageUrl = '@Url.Content("~/assets/images/check-circle.gif")';
                                        showCustomAlert(message, alertType, imageUrl);
                                    };
                                </script>

                            }

                            <div class="col-sm-12">
                                <!-- form with dummy model context (simulated for UI demo) -->
                                <form action="/Admin/Services/SaveServices" id="serviceForm" name="serviceForm" novalidate="novalidate" method="post" data-parsley-validate="true" enctype="multipart/form-data">
                                    @Html.HiddenFor(m => m.ServiceFid)
                                    @Html.HiddenFor(m => m.ServiceId_Encrypted, new { id = "ServiceId_Encrypted" })

                                    <div class="row g-4">
                                        <div class="col-md-12">
                                            <div class="row g-3">
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label for="type" class="form-control-label">
                                                            Service Group <span class="text-danger">*</span> @*this will handel backend have services Category*@
                                                        </label>
                                                        @Html.DropDownListFor(m => m.Servicecategory, new SelectList(new[] {
                                                            new { Value = "OPD", Text = "OPD" },
                                                            new { Value="IPD", Text = "IPD" },
                                                            new { Value = "BOTH", Text = "BOTH" }
                                                        }, "Value", "Text"), "--Select Service Group--",
                                                        new { @id = "ddlServicecategory", @class = "form-control custom-select", @required = "required" })
                                                    </div>
                                                </div>




                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label for="type" class="form-control-label">
                                                            Service category <span class="text-danger">*</span> @*this will handel backend have services Group Coloum *@
                                                        </label>
                                                        @Html.DropDownListFor(m => m.ServiceGroupID, new SelectList(ViewBag.ServiveGroup, "Id", "Name"), new { @Class = "form-control custom-select", id = "ddlServicegroup", required = "required" })
                                                    </div>
                                                </div>




                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label for="name" class="form-control-label">
                                                            Service Name <span class="text-danger">*</span>
                                                        </label>
                                                        @Html.TextBoxFor(m => m.ServiceName, new { @class = "form-control", id = "ServiceName", type = "text", required = "required", placeholder = "Enter service name" })
                                                    </div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label for="price" class="form-control-label">
                                                            Charges <span class="text-danger">*</span>
                                                        </label>
                                                        <div role="group" class="input-group input-group-md">
                                                            <div class="input-group-prepend">
                                                                <div class="input-group-text">₹</div>
                                                            </div>
                                                            @Html.TextBoxFor(m => m.Charges, new { @class = "form-control", id = "ServiceCharges", required = "required", placeholder = "Enter charges" })
                                                            <div class="input-group-append">
                                                                <div class="input-group-text">/-</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label for="Duration" class="form-control-label">
                                                            Duration(In Min)<span class="text-danger">*</span>
                                                        </label>
                                                        @Html.DropDownListFor(m => m.Duration, new SelectList(new[] {
                                                                   new { Value = "30", Text = "30" },
                                                              new { Value="60", Text = "60" },
                                                               new { Value="120", Text = "120" },
                                                               

                                                             }, "Value", "Text"), "--Select--",
                                                                 new { @id = "Duration", @class = "form-control custom-select" })
                                                    </div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label for="telemed_service" class="form-control-label">
                                                            Is this a telemed service? <span class="text-danger">*</span>
                                                        </label>
                                                        @Html.DropDownListFor(m => m.telemed_service, new List<SelectListItem>
                                                        {
                                                            new SelectListItem { Text="No", Value="false" },
                                                            new SelectListItem { Text="Yes", Value="true" },
                                                        }.Select(x => { x.Selected = x.Value == (ViewBag.telemedservice?.ToString() ?? ""); return x; }), new { @class = "form-control custom-select", id = "telemed_service", @required = "required" })
                                                    </div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label for="status" class="form-control-label">
                                                            Status <span class="text-danger">*</span>
                                                        </label>
                                                        <div class="kivi-pr">
                                                            @Html.DropDownListFor(m => m.Status, new SelectList(new[] {
                                                                new { Value = "Active", Text = "Active" },
                                                                new { Value="InActive", Text = "InActive" },
                                                            }, "Value", "Text"), "Select Status",
                                                            new { @id = "ddlStatus", @class = "form-control custom-select", required = "required" })
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-4 mt-3">
                                                    <div class="form-group">
                                                        <div class="therapy-toggle">
                                                            <h5 class="mb-0">Is Therapy</h5>
                                                            <input type="checkbox" id="IsTherapy" name="IsTherapy" value="1" class="switch-input" @(Model != null && Model.IsTherapy == 1 ? "checked" : "") />
                                                            <small class="text-muted">Enable therapy fields</small>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-4 mt-3">
                                                    <div class="form-group">
                                                        <div class="therapy-toggle">
                                                            <h5 class="mb-0">Is Double</h5>
                                                            <input type="checkbox" id="IsDouble" name="IsDouble" value="1" class="switch-input" @(Model != null && Model.IsDouble == 1 ? "checked" : "") />
                                                            <small class="text-muted">Enable Double therapy Slot</small>
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>

                                            <!-- Therapy Form Section -->
                                            <div id="therapySection" style="display:none;">
                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <h5><i class="fas fa-language me-1"></i> Local Name</h5>
                                                        @Html.TextBoxFor(m => m.LocalName, new { @class = "form-control", placeholder = "Local language name" })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5><i class="fas fa-tag me-1"></i> Slogan / Tagline</h5>
                                                        @Html.TextBoxFor(m => m.Slogan, new { @class = "form-control", placeholder = "Catchy tagline" })
                                                    </div>
                                                </div>

                                                <div class="row g-3 mt-2">
                                                    <div class="col-md-6">
                                                        <h5><i class="fas fa-pills me-1"></i> Medicines</h5>
                                                        @Html.ListBoxFor(m => m.MedicineNamesList, (IEnumerable<SelectListItem>)ViewBag.MedicineList, new { @class = "form-control", id = "ddlMedicine", multiple = "multiple" })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5><i class="fas fa-door-open me-1"></i> Room / Place for Therapy</h5>
                                                        @Html.ListBoxFor(m => m.SelectedRoomIds, (IEnumerable<SelectListItem>)ViewBag.GetRoom, new { @class = "form-control", id = "ddlRooms", multiple = "multiple" })
                                                    </div>
                                                </div>

                                                <div class="row g-3 mt-2">
                                                    <div class="col-md-6">
                                                        <h5>Uses / Indications</h5>
                                                        @Html.TextAreaFor(m => m.Uses, new { @class = "form-control", rows = 3, placeholder = "Therapeutic uses..." })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5>Description</h5>
                                                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = "Detailed description" })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5>Prerequisite Procedure</h5>
                                                        @Html.TextAreaFor(m => m.PrerequisiteProcedure, new { @class = "form-control", rows = 3 })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5>Main Procedure</h5>
                                                        @Html.TextAreaFor(m => m.MainProcedure, new { @class = "form-control", rows = 3 })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5>Post-Procedure Care</h5>
                                                        @Html.TextAreaFor(m => m.PostProcedureCare, new { @class = "form-control", rows = 3 })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5>Instruments & Materials</h5>
                                                        @Html.TextAreaFor(m => m.Instruments, new { @class = "form-control", rows = 3 })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5>Instructions for Patient</h5>
                                                        @Html.TextAreaFor(m => m.PatientInstructions, new { @class = "form-control", rows = 3 })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5>Instructions for Relatives</h5>
                                                        @Html.TextAreaFor(m => m.RelativeInstructions, new { @class = "form-control", rows = 3 })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5>Instructions for Therapist</h5>
                                                        @Html.TextAreaFor(m => m.TherapistInstructions, new { @class = "form-control", rows = 3 })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5>Cautiousness / Precautions</h5>
                                                        @Html.TextAreaFor(m => m.Precautions, new { @class = "form-control", rows = 3 })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5>Contraindications</h5>
                                                        @Html.TextAreaFor(m => m.ContraIndications, new { @class = "form-control", rows = 3 })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h5>Related Disorders / Risks</h5>
                                                        @Html.TextAreaFor(m => m.RelatedDisorders, new { @class = "form-control", rows = 3 })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-4">
                                        <div class="col-md-12">
                                            <div class="d-flex justify-content-end gap-2">
                                                <button type="submit" class="btn btn-primary px-4">
                                                    <i class="fa fa-save me-2"></i> Save Service
                                                </button>
                                                <button type="button" class="btn btn-outline-primary px-4" id="btnCancel">
                                                    <i class="fas fa-times me-1"></i> Cancel
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>

                            </div>


                        </div>
                    </div>
