<script>
    $(document).ready(function () {
        debugger;

        $("#addService").click(function () {
            // Toggle the visibility of the bill item add form
            $("#static-data-add-tab").slideToggle(function () {
                // Change button text based on the updated state of the form
                if ($("#static-data-add-tab").is(":visible")) {
                    // If the form is visible, change the button text to "Close"
                    $("#addService").html('<i class="fa fa-times"></i> Close Form');

                } else {
                    // If the form is hidden, change the button text back to "Add Bill Item"
                    $("#addService").html('<i class="fa fa-plus"></i> Add Medicine');
                }
            });
        });

        $("#btnCancel").click(function () {
            // Toggle the visibility of the bill item add form
            $("#static-data-add-tab").slideToggle(function () {
                // Change button text based on the updated state of the form
                if ($("#static-data-add-tab").is(":visible")) {
                    // If the form is visible, change the button text to "Close"
                    $("#addService").html('<i class="fa fa-times"></i> Close Form');
                    var url = '@Url.Action("AddMedicine", "Services")'; // Ensure server-side helper is properly rendered
                    window.location.href = url; // Navigate to the new URL
                } else {
                    // If the form is hidden, change the button text back to "Add Bill Item"
                    $("#addService").html('<i class="fa fa-plus"></i> Add Service');
                    var url = '@Url.Action("AddMedicine", "Services")'; // Ensure server-side helper is properly rendered
                    window.location.href = url; // Navigate to the new URL
                }
            });
        });

        var CheckUpdate = @Html.Raw(Json.Encode(ViewBag.Update));
        if(CheckUpdate!=null)
        {
            $("#static-data-add-tab").show();
            $("#addService").html('<i class="fa fa-times"></i> Close Form');

        }

        $("#ddlClinicFid").change(function () {
