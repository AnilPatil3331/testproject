@model BVG_Wellness_Center_Promotion.Areas.Admin.Models.Pathya

@{
    ViewBag.Title = "PathyaMaster";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" />
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<link href="~/assets/css/CustomeAlertCSS/customAlert.css" rel="stylesheet" />
<script src="~/assets/js/CustomeAlert/customAlert.js"></script>
<script src="~/assets/dist/js/xlsx.full.min.js"></script>

<div class="container-fluid" style="padding-left:15px !important;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card p-0 shadow">

                <header class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <h3 class="mb-0">Pathya List</h3>
                        </div>

                        <div class="col-md-4">
                            <div class="d-flex justify-content-end">
                                <button class="btn btn-sm btn-primary"
                                        id="addPathya">
                                    <i class="fa fa-plus"></i>
                                    Add Pathya
                                </button>
                            </div>
                        </div>
                    </div>
                </header>

                <div class="card-body p-0">

                    <div id="static-data-add-tab"
                         style="display:none;">

                        <div class="row">

                            @if (TempData["Message"] != null)
                            {
                                <script>
                                    window.onload = function () {
                                        var message =
                                        '@TempData["Message"]';

                                        var alertType =
                                        '@TempData["Icon"]';

                                        var imageUrl =
                                        '@Url.Content("~/assets/images/check-circle.gif")';

                                        showCustomAlert(
                                            message,
                                            alertType,
                                            imageUrl
                                        );
                                    };
                                </script>
                            }

                            <div class="col-sm-12">

                                <form action="/Admin/Masters/SaveAddPathya"
                                      method="post"
                                      id="pathyaForm">

                                    <div class="card p-0 shadow">
                                        <div class="card-body">

                                            @Html.HiddenFor(m => m.Id)

                                            <div class="row">

                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>
                                                            Pathya Name
                                                            <span class="text-danger">*</span>
                                                        </label>

                                                        @Html.TextBoxFor(
                                                        m => m.PathyaName,
                                                        new
                                                        {
                                                            @class = "form-control",
                                                            required = "required"
                                                        })
                                                    </div>
                                                </div>

                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>
                                                            Pathya Instruction
                                                            <span class="text-danger">*</span>
                                                        </label>

                                                        @Html.TextAreaFor(
                                                        m => m.PathyaInstruction,
                                                        new
                                                        {
                                                            @class = "form-control",
                                                            rows = "4",
                                                            required = "required"
                                                        })
                                                    </div>
                                                </div>

                                            </div>

                                            <div class="row mt-3">
                                                <div class="col-md-12 text-end">

                                                    <button type="submit"
                                                            class="btn btn-primary">
                                                        <i class="fa fa-save"></i>
                                                        Save
                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-outline-primary"
                                                            id="btnCancel">
                                                        Cancel
                                                    </button>

                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </form>

                            </div>
                        </div>
                    </div>

                    <div class="p-3">

                        <div class="row mb-3">

                            <div class="col-md-6">
                                <input type="text"
                                       id="SearchInput"
                                       class="form-control"
                                       placeholder="Search Pathya..." />
                            </div>

                            @*<div class="col-md-6 text-end">
                                    <button class="btn btn-sm btn-success"
                                            id="btnExport">
                                        <i class="fa fa-file-excel"></i>
                                        Export Excel
                                    </button>
                                </div>*@
                        </div>

                        <div class="table-responsive">

                            <table id="tblPathyaList"
                                   class="table table-bordered table-striped">

                                <thead>
                                    <tr>
                                        <th>Action</th>
                                        <th>Id</th>
                                        <th> Pathya Name</th>
                                        <th>Pathya Instruction</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @if (ViewBag.PathyaList != null)
                                    {
                                        foreach (var item in ViewBag.PathyaList)
                                        {
                                            <tr>

                                                <td>

                                                    <div class="btn-group">

                                                        <a href="@Url.Action("PathyaMaster",
                                                        "Masters",
                                                        new { id = item.Id })"
                                                           class="btn btn-sm btn-outline-primary">

                                                            <i class="fa fa-pen-alt"></i>
                                                        </a>

                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger"
                                                                onclick="DeletePathya(@item.Id)">

                                                            <i class="fa fa-trash"></i>
                                                        </button>

                                                    </div>

                                                </td>

                                                <td>@item.Id</td>
                                                <td>@item.PathyaName</td>
                                                <td>@item.PathyaInstruction</td>

                                            </tr>
                                        }
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        $("#addPathya").click(function () {

            $("#static-data-add-tab")
            .slideToggle(function () {

                if ($("#static-data-add-tab")
                    .is(":visible")) {

                    $("#addPathya").html(
                        '<i class="fa fa-times"></i> Close Form'
                    );

                } else {

                    $("#addPathya").html(
                        '<i class="fa fa-plus"></i> Add Pathya'
                    );
                }
            });
        });

        $("#btnCancel").click(function () {
            location.reload();
        });

        var CheckUpdate =
        @Html.Raw(Json.Encode(ViewBag.Update));

        if (CheckUpdate != null) {

            $("#static-data-add-tab").show();

            $("#addPathya").html(
                '<i class="fa fa-times"></i> Close Form'
            );
        }

        $("#btnExport").click(function () {

            var tableClone =
            $("#tblPathyaList").clone();

            tableClone.find("th:contains('Action')")
            .remove();

            tableClone.find("td:nth-child(1)")
            .remove();

            var wb = XLSX.utils.book_new();

            var ws =
            XLSX.utils.table_to_sheet(
                tableClone[0]
            );

            XLSX.utils.book_append_sheet(
                wb,
                ws,
                "PathyaList"
            );

            XLSX.writeFile(
                wb,
                "PathyaList.xlsx"
            );
        });

    });

    function DeletePathya(id) {
        Swal.fire({
            title: 'Are You Sure!',
            text: "Are you sure you want to delete this record?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#f44336',
            cancelButtonColor: '#4caf50',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'No, cancel!',
            customClass: { popup: 'fullscreen-popup' }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("DeletePathya","Masters")',
                    type: 'GET',
                    data: { id: id },
                    success: function () {
                        Swal.fire({
                            title: 'Deleted!',
                            text: 'Record deleted successfully.',
                            icon: 'success',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            location.reload();
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Error!',
                            text: 'Error while deleting record.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                });
            }
        });
    }

    document.getElementById('SearchInput')
    .addEventListener('input', function () {

        const filterText =
        this.value.toLowerCase();

        const rows =
        document.querySelectorAll(
            '#tblPathyaList tbody tr'
        );

        rows.forEach(row => {

            const match =
            row.textContent
            .toLowerCase()
            .includes(filterText);

            row.style.display =
            match ? '' : 'none';
        });

    });

</script>
<script>
    $(document).ready(function () {
        // टेबलला DataTable मध्ये रूपांतरित करा
        $('#tblPathyaList').DataTable({
            "pageLength": 10, // एका पेजवर १० रेकॉर्ड्स
            "lengthMenu": [10, 25, 50, 100] // यूजरला सिलेक्ट करण्याचा पर्याय
        });
    });
</script>