<script>
    function toggleStatus(checkbox, Fid_Encrypted) {
        debugger;

        if (checkbox.checked) {
            debugger;
            var Status = "Active";
            var url = '@Url.Action("ChangeClinicStatus", "AddClinic")' + '?Fid_Encrypted=' + Fid_Encrypted + '&Status=' + Status;
            window.location.href = url;
        } else {
            debugger;
            var Status = "Inactive";
            var url = '@Url.Action("ChangeClinicStatus", "AddClinic")' + '?Fid_Encrypted=' + Fid_Encrypted + '&Status=' + Status;
            window.location.href = url;
        }
    }
</script>
<script>

    function DeleteClinic(Fid_Encrypted, ClinicAdminFid_Encrypted) {
        Swal.fire({
            title: 'Are You Sure!',
            text: "Are you absolutely sure about this?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#f44336',
            cancelButtonColor: '#4caf50',
            confirmButtonText: 'Yes, go ahead!',
            cancelButtonText: 'No, cancel!',
            customClass: {
                popup: 'fullscreen-popup',
            },
        }).then((result) => {
            if (result.isConfirmed) {
                // Perform the desired action
                var url = '@Url.Action("DeleteClinic", "AddClinic")' + '?Fid_Encrypted=' + Fid_Encrypted + '&ClinicAdminFid_Encrypted=' + ClinicAdminFid_Encrypted;
                window.location.href = url;

            }
        });
    }

</script>

@*===================================Filter Table =================================*@
<script>
    // Reusable function for filtering
    function filterTable(inputId, tableId) {
        document.getElementById(inputId).addEventListener('input', function () {
            const filterText = this.value.trim().toLowerCase(); // Get input text
            const table = document.getElementById(tableId);
            const rows = table.querySelectorAll('tbody tr'); // Get all rows in the table

            rows.forEach(row => {
                const cells = row.querySelectorAll('td'); // Get all cells in the row
                // Check if any cell contains the filter text
                const match = Array.from(cells).some(cell => cell.textContent.toLowerCase().includes(filterText));
                row.style.display = match ? '' : 'none'; // Show or hide the row
            });
        });
    }


    filterTable('SearchInput', 'ClinicTable'); //Type any for filter
    filterTable('FilterByEmail', 'ClinicTable');  // Filter by email
    filterTable('FilterByNumber', 'ClinicTable');  // Filter by Mobile
    filterTable('FilterByClinicName', 'ClinicTable');  // Filter by Clinic
    filterTable('FilterbyAdmin', 'ClinicTable');  // Filter by Admin Name
    filterTable('FilterByAddress', 'ClinicTable');  // Filter by Address

    document.getElementById('filetrByStatus').addEventListener('change', function () {
        debugger;
        const selectedValue = this.value; // Get the selected value from the dropdown
        const table = document.getElementById('ClinicTable'); // Get the table by ID
        const rows = table.querySelectorAll('tbody tr'); // Get all table rows


        rows.forEach(row => {
            const statusCell = row.querySelector('td:nth-child(10)'); // Assuming status is in the 8th column (Status column)

            // Get the text content of the badge (either "Active" or "Inactive")
            const statusValue = statusCell ? statusCell.querySelector('span').textContent.trim() : "";

            // Show row if the selected value matches the status value or if no value is selected
            if (selectedValue === "" || statusValue.toLowerCase() === selectedValue.toLowerCase()) {
                row.style.display = ''; // Show the row
            } else {
                row.style.display = 'none'; // Hide the row
            }
        });
    });

</script>
@*===================================Filter Table end=================================*@

<script>

    document.addEventListener("DOMContentLoaded", function () {
        const rowsPerPageSelect = document.getElementById('PageOption');
        const prevButton = document.getElementById('prev-btn');
        const nextButton = document.getElementById('next-btn');
        const currentPageInput = document.getElementById('InputPage');
        const totalPagesElement = document.getElementById('total-pages');
        const table = document.getElementById('ClinicTable');
        const rows = table.querySelectorAll('tbody tr');

        let currentPage = 1;
        let rowsPerPage = parseInt(rowsPerPageSelect.value, 10) || 10; // Default to 10 rows per page

        // Function to update the table display based on page and rows per page
        function updateTable() {
            // If "All" is selected, display all rows
            if (rowsPerPage === -1) {
                rows.forEach(row => {
                    row.style.display = ''; // Show all rows
                });
                currentPageInput.value = 1;
                totalPagesElement.textContent = 1; // Only 1 page when all rows are shown
                updateButtonStates();
            } else {
                const start = (currentPage - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                // Show rows for the current page
                rows.forEach((row, index) => {
                    if (index >= start && index < end) {
                        row.style.display = ''; // Show the row
                    } else {
                        row.style.display = 'none'; // Hide the row
                    }
                });

                // Update page info
                currentPageInput.value = currentPage;
                totalPagesElement.textContent = Math.ceil(rows.length / rowsPerPage);
                updateButtonStates();
            }
        }

        // Function to update the state of the Prev/Next buttons
        function updateButtonStates() {
            prevButton.classList.toggle('disabled', currentPage <= 1);
            nextButton.classList.toggle('disabled', currentPage >= Math.ceil(rows.length / rowsPerPage));
        }

        // Event listener for Rows per Page change
        rowsPerPageSelect.addEventListener('change', function () {
            rowsPerPage = parseInt(this.value, 10);
            currentPage = 1; // Reset to the first page
            updateTable();
        });

        // Event listener for Prev button
        prevButton.addEventListener('click', function () {
            if (currentPage > 1) {
                currentPage--;
                updateTable();
            }
        });

        // Event listener for Next button
        nextButton.addEventListener('click', function () {
            if (currentPage < Math.ceil(rows.length / rowsPerPage)) {
                currentPage++;
                updateTable();
            }
        });

        // Initial call to display the table correctly
        updateTable();
    });

</script>

