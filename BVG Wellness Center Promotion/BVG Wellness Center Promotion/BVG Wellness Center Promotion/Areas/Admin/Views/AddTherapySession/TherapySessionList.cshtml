                                    <!---->
                                    <button type="button" class="btn float-right btn btn-sm btn-primary btn-primary" id="AddTherapySession">
                                        <i class="fa fa-plus">
                                        </i>
                                        Add Session
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div id="doctor-session-tab" class="mt-2" style="display:none;">
