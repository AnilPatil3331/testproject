                window.onload = function () {
                    var message = '@TempData["Message"]';
                    var alertType = '@TempData["Icon"]';
                    var imageUrl = '@Url.Content("~/assets/images/check-circle.gif")';
                    showCustomAlert(message, alertType, imageUrl);
                };
            </script>

        }
        <div class="col-xl-12 col-lg-12 order-lg-1 order-2 col">
            <form action="/Admin/AddTherapySession/SaveTherapySession" id="DoctorSessionFormSave" name="TherapySessionForm" novalidate="novalidate" method="post" data-parsley-validate="true" enctype="multipart/form-data">
