                                                    Mon
                                                </label>
                                            </div>
                                            <div id="week_days" class="custom-control custom-checkbox kc-custom-control d-inline-block mr-2">
                                                <input id="Tuetue" name="days[]" type="checkbox" class="custom-control-input"
