                                                var isChecked = Model.SelectedDays.Contains(day) ? "checked" : "";
                                                <div class="custom-control custom-checkbox kc-custom-control d-inline-block mr-2">
                                                    <input id="@day" name="days[]" type="checkbox" class="custom-control-input" value="@day" @isChecked>
                                                    <label for="@day" class="custom-control-label text-capitalize">
