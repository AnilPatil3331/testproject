        m => m.ServiceFid,
        new SelectList(ViewBag.Getdata, "Id", "Name"),
        "Select",
        new { @class = "form-control", @id = "ddlServiceName", @style = "width: 100%;" }
    )
                                        <!---->
                                        <!---->
                                    </div>
                                </div>




                                <div class="col-md-2 form-group">
                                    <label for="time_slot" class="form-control-label">
                                        Time slot (in minute)
                                        <span class="text-danger">
                                            *
                                        </span>
                                    </label>
                              
                                          <div>
                                        @Html.DropDownListFor(m => m.TimeSlot, new SelectList(new[] {
