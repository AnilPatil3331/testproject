                                    <label for="doctor_id" class="form-control-label">
                                        Select Clinic
                                        <span class="text-danger">
                                            *
                                        </span>
                                    </label>
                                    @Html.DropDownListFor(m => m.ClinicFid, new SelectList(ViewBag.ClinicName, "Id", "Name"), "--Select Clinic--", new { @class = "form-control", id = "ddlClinicFid", required = "required" })

                                    <!---->
                                </div>
                                <div class="col-md-3 form-group">
                                    <label for="clinicSessionDoctor" class="col-md-4 form-control-label">
                                        Room
                                        <span class="text-danger">
                                            *
                                        </span>
                                    </label>
                                    <div>
                                        @Html.DropDownListFor(m => m.ServiceRoomID, new SelectList(ViewBag.GetRoom, "Id", "Name"), "--Select Room--", new { @class = "form-control", id = "ddlDoctorFid", required = "required" })
                                        <!---->
                                        <!---->
                                    </div>
                                </div>



                                <div class="col-md-1 ">
                                    <label>Capacity</label>
                                    @Html.TextBoxFor(m => m.Occupancy, new { @class = "form-control" })
                                </div>

                                <div class="col-md-3 form-group">
                                    <label for="clinicSessionDoctor" class="col-md-4 form-control-label">
                                     Services
                                        <span class="text-danger">
                                            *
                                        </span>
                                    </label>
                                    <div>
                                        @*@Html.DropDownListFor(m => m.DoctorFid, new SelectList(ViewBag.GetDoctorName, "Id", "Name"), "--Select Doctor--", new { @class = "form-control", id = "ddlDoctorFid", required = "required" })*@
