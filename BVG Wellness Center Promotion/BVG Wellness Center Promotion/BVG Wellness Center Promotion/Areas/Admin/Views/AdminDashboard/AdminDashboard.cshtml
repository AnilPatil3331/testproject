</style>

<div class="container-fluid mt--5">
    <div class="col-sm-12 col-lg">
        <div role="alert" aria-live="polite" aria-atomic="true" class="alert d-flex align-items-center justify-content-between alert-warning">
            <p class="m-0">
                <b> Please make sure your server has Email Server SMTP setup ! </b>
            </p>
            <button type="button" class="btn btn-sm btn-secondary float-right">
                <i class="fas fa-paper-plane"></i> Send Email
            </button>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-4 col-md-6">
            <a href="#/patient" class="">
                <div class="card card-stats shadow p-0">
                    <div class="card-body">
                        <div class="row">
                            <div class="col"><h5 class="card-title text-uppercase text-muted mb-0"> Total Receptionist </h5> <span class="h2 font-weight-bold mb-0">1</span></div>
                            <div class="col-auto">
                                <div class="icon icon-shape bg-gradient-red text-white rounded-circle shadow"><i class="fas fa-user-injured"></i></div>
                            </div>
                        </div>
                        <p class="mt-3 mb-0 text-sm"><span class="text-nowrap">Total clinic Receptionist</span></p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-4 col-md-6">
            <a href="#/doctor" class="">
                <div class="card card-stats shadow p-0">
                    <div class="card-body">
                        <div class="row">
                            <div class="col">
                                <h5 class="card-title text-uppercase text-muted mb-0"> Total Doctors </h5>
                                <span class="h2 font-weight-bold mb-0">1</span>
                            </div> <div class="col-auto">
                                <div class="icon icon-shape bg-gradient-orange text-white rounded-circle shadow">
                                    <i class="fas fa-user-md"></i>
                                </div>
                            </div>
                        </div> <p class="mt-3 mb-0 text-sm"><span class="text-nowrap">Total clinic doctors</span></p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-4 col-md-6">
            <a href="#/all-appointment-list" class="">
                <div class="card card-stats shadow p-0">
                    <div class="card-body">
                        <div class="row">
                            <div class="col"><h5 class="card-title text-uppercase text-muted mb-0">Total Clinic</h5> <span class="h2 font-weight-bold mb-0">0</span></div>
                            <div class="col-auto"><div class="icon icon-shape bg-gradient-green text-white rounded-circle shadow"><i class="fas fa-calendar-check"></i></div></div>
                        </div>
                        <p class="mt-3 mb-0 text-sm"><span class="text-nowrap">Total clinic </span></p>
                    </div>
                </div>
            </a>
        </div>
