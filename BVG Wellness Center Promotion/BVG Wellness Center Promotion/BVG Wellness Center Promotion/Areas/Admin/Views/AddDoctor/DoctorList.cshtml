<script>
    function DeleteDoctor(UserId_Encrypted) {
        Swal.fire({
            title: 'Are You Sure!',
            text: "Are you absolutely sure about this?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#f44336',
            cancelButtonColor: '#4caf50',
            confirmButtonText: 'Yes, go ahead!',
            cancelButtonText: 'No, cancel!',
            customClass: {
                popup: 'fullscreen-popup',
            },
        }).then((result) => {
            if (result.isConfirmed) {
                // Perform the desired action
                var url = '@Url.Action("DeleteDoctor", "AddDoctor")' + '?UserId_Encrypted=' + UserId_Encrypted;
                window.location.href = url;
            }
        });
    }
</script>

