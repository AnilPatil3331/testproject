                                    @Html.TextBoxFor(m => m.Postalcode, new { @class = "form-control", id = "postalCode", name = "cityFid", placeholder = "Enter Postal code ", required = "required" })
                                    @*@Html.DropDownListFor(m => m.Postalcode, new SelectList(""), new { @class = "form-control", id = "postalCode", required = "required" })*@
                                   
