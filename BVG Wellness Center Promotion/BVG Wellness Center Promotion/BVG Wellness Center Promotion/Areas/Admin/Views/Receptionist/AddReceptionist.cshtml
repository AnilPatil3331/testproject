                                    @*@Html.DropDownListFor(m => m.Country, new SelectList(""), new { @class = "form-control", id = "country", required = "required" })*@
                                    @Html.TextBoxFor(m => m.Country, new { @class = "form-control", id = "country", name = "country", placeholder = "Enter country", required = "required" })
                                   
