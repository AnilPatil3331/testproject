                                </div>
                            </div>
                        </div>
                    </footer>
                    <!---->
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    function showImage(event) {
        debugger;
        const file = event.target.files[0]; // Get the selected file
        if (file) {
            const reader = new FileReader(); // Create a FileReader to read the file
            reader.onload = function (e) {
                const imagePreview = document.getElementById("imagePreview");
                imagePreview.style.backgroundImage = `url(${e.target.result})`; // Set the background image
            };
            reader.readAsDataURL(file); // Read the file as a data URL
        }
    }

</script>

<script>
    // Add basic form validation for required fields
    document.getElementById('receptionistDataForm').addEventListener('submit', function (event) {
        var form = this;
        var isValid = true;

        var formError = document.getElementById('formError');
        formError.style.display = 'none';
        // Loop through each required field and check if it is empty
        form.querySelectorAll('[required]').forEach(function (input) {
            if (!input.value) {
                isValid = false;
                input.classList.add('is-invalid'); // Optional: add a class to highlight the empty field
            } else {
                input.classList.remove('is-invalid');
            }
        });


        if (!isValid) {
            event.preventDefault(); // Prevent form submission if fields are invalid

            var message = 'Please fill out all required field';
            var alertType = 'error';
            var imageUrl = '@Url.Content("~/assets/images/check-circle.gif")';
            showCustomAlert(message, alertType, imageUrl);

            //setTimeout(() => {
            //    formError.style.display = "none";
            //}, 1000);
        }

        //if (!isValid) {
        //    event.preventDefault(); // Prevent form submission if fields are invalid
        //    formError.style.display = 'block'; // Show the error message div

        //}


        $("#dismissError").click(function () {
            debugger;
            formError.style.display = 'none';
        });

        //$("#dismissError").click(function () {
        //    debugger;
        //    formError.style.display = 'none';
        //});

    });
</script>

<script>
    $(document).ready(function () {
        debugger;

        // Toggle Login fields based on Designation
        function toggleLoginFields() {
            var designation = $("#Designation").val();
            if (designation === "Receptionist" || designation === "Therapist") {
                $("#loginIdContainer").show();
                $("#loginPasswordContainer").show();
                $("#LoginId").prop('required', true);
                // Password is required only if it's a new record (UserId = 0 or empty)
                var userId = $("#UserId").val();
                if (!userId || userId === "0") {
                    $("#LoginPassword").prop('required', true);
                } else {
                    $("#LoginPassword").prop('required', false);
                }
            } else {
                $("#loginIdContainer").hide();
                $("#loginPasswordContainer").hide();
                $("#LoginId").prop('required', false).val('');
                $("#LoginPassword").prop('required', false).val('');
            }
        }

        // On change
        $("#Designation").change(function () {
            toggleLoginFields();
        });

        // Initial call
        toggleLoginFields();


        $("#btnBack").click(function () {
            debugger;
            // Correct the URL assignment
            var url = '@Url.Action("ReceptionistList", "Receptionist")'; // Ensure server-side helper is properly rendered
            window.location.href = url; // Navigate to the new URL
        });
    });

</script>

<script>
    function togglePasswordVisibility() {
        var passwordInput = document.getElementById("LoginPassword");
        var toggleIcon = document.getElementById("togglePasswordIcon");
        
        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            toggleIcon.classList.remove("fa-eye-slash");
            toggleIcon.classList.add("fa-eye");
        } else {
            passwordInput.type = "password";
            toggleIcon.classList.remove("fa-eye");
            toggleIcon.classList.add("fa-eye-slash");
        }
    }
</script>

