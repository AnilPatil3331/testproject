                                        <span class="text-danger">
                                            *
                                        </span>
                                    </label>
                                    @Html.TextBoxFor(m => m.LName, new { @class = "form-control", id = "doctorLastName", placeholder = "Enter Last name", required = "required", name = "name", type = "text", })
                                  
                                    <!---->
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="email" class="form-control-label">
                                        Email
                                        <span class="text-danger">
                                            *
                                        </span>
                                    </label>
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", id = "doctorEmail", placeholder = "Enter email", required = "required", name = "name", type = "email", })
                                    
                                    <!---->
                                </div>
                            </div>
                            <!-- ✅ New Designation Column -->
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="Designation" class="form-control-label">
                                        Designation
                                        <span class="text-danger">*</span>
                                    </label>
                                    @Html.DropDownListFor(m => m.Designation, new List<SelectListItem>
