                                        @Html.TextBoxFor(m => m.ContactNumber, new { @class = "form-control", id = "contact", placeholder = "Enter Contact Number", required = "required", name = "Contact", type = "text", maxlength = "10" })
                                    </div>
                                    <!---->
                                </div>
                            </div>
