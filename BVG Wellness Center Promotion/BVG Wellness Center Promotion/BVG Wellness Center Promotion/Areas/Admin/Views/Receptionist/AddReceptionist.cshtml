                                                    *
                                                </span>
                                            </label>
                                            @Html.TextBoxFor(m => m.ExperienceInYear, new { @class = "form-control", id = "experience", required = "required", name = "Experience", type = "text"})
                                           
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
